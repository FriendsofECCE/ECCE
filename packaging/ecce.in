#!/bin/bash
# The `ecce` command: option handling, then the Organizer session.
# Everything is parsed first; nothing starts a broker or data server
# until the plain session start at the end.
ECCE_HOME_DEFAULT=@ECCE_HOME_DIR@
ECCE_VERSION_STRING=@ECCE_VERSION_RAW@

usage() {
  cat <<'USAGE'
Usage: ecce [options]

Reporting a problem:
  --bug                Run this session with diagnostic logging on and
                       collect logs, service logs and ecce-diagnose
                       output into ~/ecce-bug-<time>/, then pack it as
                       an archive to attach to your report. Same as
                       ECCE_BUG=1.

  -admin               Edit the site-wide machine list ($ECCE_HOME/siteconfig).
                       Needs write access there (run as a user who has it,
                       e.g. with sudo). Starts no broker or data server.
                       With -remote: edit the central server's list over
                       ssh, as your login there (-l LOGIN for another one);
                       you must be allowed to write its siteconfig.
  -machine, -machines  Edit your own machine registrations (~/.ECCE),
                       without starting a session.
  -remote              Use the central data server/broker (siteconfig/
                       RemoteServer) instead of starting your own.
  --local, -local      Keep calculations in a local data folder (the one
                       set in Edit > Preferences, by default ~/.ECCE-local)
                       for this session, with no data server. For every
                       session: tick the setting in Edit > Preferences.
  -l LOGIN             Use LOGIN as your server login name instead of
                       your own username, for this session only.
  --version, -V        Show the version and exit.
  --help, -h           Show this message and exit.

With no options, starts the Organizer -- the front door for New
Structure, Register Machines, Machine Browser and Periodic Table.

Environment (set before ecce; the first two win over Edit > Preferences):

  ECCE_EDITOR          Editor for input and output files, e.g. "geany -i".
                       Otherwise Preferences, VISUAL, EDITOR, then vi.
  ECCE_BROWSER         Web browser for Help. Otherwise the desktop's opener.
  ECCE_GATEWAY_WINDOW  Set to 1 to show the old Gateway launcher window.

The editor, terminal and browser can also be set in the Organizer, under
Edit > Preferences. All variables ECCE reads are listed in:
USAGE
  echo "  ${ECCE_HOME:-$ECCE_HOME_DEFAULT}/doc/ENVIRONMENT.md"
}

admin=false
machines=false
remote=false
local=false
bug=false
login=""
case "${ECCE_BUG:-}" in ""|0) ;; *) bug=true ;; esac
while [ $# -gt 0 ]; do
  case "$1" in
    --help|-h) usage; exit 0 ;;
    --version|-V) echo "ECCE ${ECCE_VERSION_STRING#v}"; exit 0 ;;
    --bug) bug=true ;;
    -admin) admin=true ;;
    -machine|-machines) machines=true ;;
    -remote) remote=true ;;
    --local|-local) local=true ;;
    -l)
      if [ $# -lt 2 ]; then
        echo "ecce: option -l needs a login name (try --help)" >&2
        exit 2
      fi
      login="$2"; shift ;;
    *)
      echo "ecce: unknown option $1 (try --help)" >&2
      exit 2 ;;
  esac
  shift
done
if $remote && $local; then
  echo "ecce: -remote and --local exclude each other (try --help)" >&2
  exit 2
fi
if $remote; then export ECCE_REMOTE_SERVER=1; fi
# Read by every ECCE process (LocalData::dir), so the whole session uses
# the folder from the start and never needs the data server.
if $local; then export ECCE_LOCAL=1; fi

export ECCE_HOME=${ECCE_HOME:-$ECCE_HOME_DEFAULT}

# Child programs (Perl, Python, the codes) must print and read numbers with
# '.'; LC_ALL would override LC_NUMERIC, so demote it to LANG.
if [ -n "${LC_ALL:-}" ]; then LANG=$LC_ALL; export LANG; unset LC_ALL; fi
export LC_NUMERIC=C

# A site admin's maintenance notice and lock, shown for every
# invocation -- including -admin/-machine -- matching the old script's
# placement ahead of any option handling.
if [ -e "$ECCE_HOME/siteconfig/StartMessage" ]; then
  echo ""
  cat "$ECCE_HOME/siteconfig/StartMessage"
  echo ""
  if [ -t 1 ]; then
    sleep 3
  fi
  if [ -e "$ECCE_HOME/siteconfig/PreventStart" ]; then
    echo "Aborting ECCE run..."
    echo ""
    exit 1
  fi
fi

# -admin -remote changes the central server's siteconfig over ssh
# (ecce-site-admin there), so this client's own needs no write access.
if $admin && $remote; then
  if [ -n "$login" ]; then
    export ECCE_SITE_ADMIN_LOGIN="$login"
  fi
  export ECCE_NO_MESSAGING=1
  export ECCE_NO_DATASERVER=1
  exec ecce-machregister -admin
fi

if $admin; then
  if [ ! -w "$ECCE_HOME/siteconfig" ]; then
    echo "ecce -admin edits the site-wide machine list in $ECCE_HOME/siteconfig; run it as a user who can write there (e.g. with sudo)" >&2
    exit 1
  fi
  export ECCE_NO_MESSAGING=1
  export ECCE_NO_DATASERVER=1
  ecce-machregister -admin
  rc=$?
  # Put the change where the data server serves it to -remote clients (#192):
  # the PublishDir of an administrator who is not the data-server account, or
  # that account's own server.  Elsewhere it goes out at the next data-server
  # start.
  if [ -x "$ECCE_HOME/bin/ecce-site-publish" ] && {
       [ -f "$ECCE_HOME/siteconfig/PublishDir" ] ||
       [ -d "${ECCE_REALUSERHOME:-$HOME}/.ECCE/dataserver/htdocs/Ecce" ]; }; then
    "$ECCE_HOME/bin/ecce-site-publish" ||
      echo "ecce -admin: the change was not published to -remote clients" >&2
  else
    echo "ecce -admin: -remote clients see the change after the next data-server start." >&2
  fi
  exit $rc
fi

if $machines; then
  export ECCE_REALUSERHOME=${ECCE_REALUSERHOME:-$HOME}
  if [ ! -w "$ECCE_REALUSERHOME/.ECCE" ]; then
    echo "ecce -machine edits your own registrations in $ECCE_REALUSERHOME/.ECCE; that directory is not writable." >&2
    exit 1
  fi
  export ECCE_NO_MESSAGING=1
  export ECCE_NO_DATASERVER=1
  exec ecce-machregister
fi

# -l overrides the server login name for this session only: exported
# rather than written to ~/.ECCE/ServerLogin, so it can never become a
# later plain `ecce`'s remembered login (a central-server name landing
# on the local data server, where it has no account, was the bug).
# Ecce::serverUser() (src/util/genutil/Ecce.C) checks this first.
if [ -n "$login" ]; then
  export ECCE_SERVER_LOGIN="$login"
fi

# Job scripts are sh now: convert the user's csh snippets in ~/.ECCE/CONFIG.*
# once per version (ecce-csh2sh keeps the originals and leaves a message for the
# Gateway to show).  The marker is read with builtins only, so a start after the
# first one pays for no process.
c2s_dir="${ECCE_REALUSERHOME:-$HOME}/.ECCE"
c2s_seen=""
{ read -r c2s_seen < "$c2s_dir/csh2sh-done"; } 2>/dev/null
if [ "$c2s_seen" != "$ECCE_VERSION_STRING" ] && [ -d "$c2s_dir" ]; then
  set -- "$c2s_dir"/CONFIG.*
  if [ -e "$1" ] && [ -x "$ECCE_HOME/scripts/ecce-csh2sh" ]; then
    ECCE_REALUSERHOME="${ECCE_REALUSERHOME:-$HOME}" \
      "$ECCE_HOME/scripts/ecce-csh2sh" --once --stamp "$ECCE_VERSION_STRING" >/dev/null 2>&1 || true
  else
    echo "$ECCE_VERSION_STRING" > "$c2s_dir/csh2sh-done" 2>/dev/null || true
  fi
fi

# A fresh ~/.ECCE gets a CONFIG.localhost template so jobs on this machine find
# the codes.  It is a template, not a site file, and is not copied when an
# admin's siteconfig/CONFIG.<name> exists (the user's file would merge over
# it, but there is nothing to seed).  Never overwritten.
c2s_tpl="$ECCE_HOME/siteconfig/CONFIG-Examples/CONFIG.localhost"
if [ -f "$c2s_tpl" ] \
   && [ ! -e "$ECCE_HOME/siteconfig/CONFIG.localhost" ] \
   && [ ! -e "$c2s_dir/CONFIG.localhost" ]; then
  mkdir -p "$c2s_dir" 2>/dev/null && cp "$c2s_tpl" "$c2s_dir/CONFIG.localhost" 2>/dev/null || true
fi

# Every `ecce` is a session of its own (#233), even when started from a
# shell that inherited another session's id; every process it starts
# inherits this one.
. "$ECCE_HOME/bin/ecce-session-lib.sh" || exit 1
ECCE_SESSION_ID="$(ecce_new_session_id)"
export ECCE_SESSION_ID

# Only -remote reaches ecce-gateway; it has no use for the rest.
passthrough=()
if $remote; then passthrough+=(-remote); fi

if ! $bug; then
  exec ecce-gateway "${passthrough[@]}"
fi

# ---------------------------------------------------------------- bug mode
# One switch for whoever files a bug report: logging that shows what
# ECCE did, a copy of the session's output and service logs, and
# ecce-diagnose, packed into one archive.  Only variables that write
# diagnostics without changing behaviour are set.  Left out on purpose:
# ECCE_DAV_DEBUG (writes to a fixed /tmp/davtraffic shared by all users,
# with the Authorization header, i.e. the password), ECCE_LOG_ALL_EVENTS
# and ECCE_DEBUG_ATOM_COLOR (flood), ECCE_RCOM_DEBUGGING (Expect's own
# trace, flood), ECCE_DEVELOPER and the switches that change behaviour.
export ECCE_REALUSERHOME=${ECCE_REALUSERHOME:-$HOME}
stamp=$(date +%Y%m%d-%H%M%S)
bugname="ecce-bug-$stamp"
export ECCE_BUG_DIR="$ECCE_REALUSERHOME/$bugname"
mkdir -p "$ECCE_BUG_DIR" || { echo "ecce: cannot create $ECCE_BUG_DIR" >&2; exit 1; }
session_log="$ECCE_BUG_DIR/session.log"
: > "$session_log"

export ECCE_RCOM_LOGMODE=1
export ECCE_JOB_LOGMODE=yes,yes
export ECCE_JOB_LOGALL=1
export ECCE_AI_DEBUG=1
export ECCE_DEBUG_PANELS=1
export ECCE_DEBUG_GL_VISUAL=1
export ECCE_DEBUG_MACHNOTICE=1
export ECCE_DEBUG_MOSYM_LOG="$ECCE_BUG_DIR/mosym.log"
export ECCE_DEBUG_AUTHPARENT="$ECCE_BUG_DIR/authparent.log"

statedir="$ECCE_REALUSERHOME/.ECCE"
jobroot="${ECCE_TMPDIR:-/tmp}/ecce_${ECCE_REALUSER:-$(id -un)}/jobs"
# The broker log is appended to like the data server's, so
# note where each ends now and copy only what this session added.
bug_logs="$statedir/mosquitto.log $statedir/dataserver/logs/error_log $statedir/dataserver/logs/access_log"
# (bash 3.2 on macOS has no associative arrays: one variable per file.)
file_key() { printf 'startsize_%s' "$(printf '%s' "$1" | tr -c 'A-Za-z0-9' _)"; }
for f in $bug_logs; do
  eval "$(file_key "$f")=$(wc -c < "$f" 2>/dev/null | tr -d ' ' || echo 0)"
  [ -n "$(eval "echo \${$(file_key "$f"):-}")" ] || eval "$(file_key "$f")=0"
done
marker="$ECCE_BUG_DIR/.session-start"
: > "$marker"

{
  echo "ecce --bug, $(date +%Y-%m-%dT%H:%M:%S%z)"
  echo "ECCE $ECCE_VERSION_STRING, arguments: ${*:-none}"
  echo "ECCE_REMOTE_SERVER=${ECCE_REMOTE_SERVER:-<unset>}"
  echo "ECCE_SERVER_LOGIN=${ECCE_SERVER_LOGIN:-<unset, uses remembered or Unix login>}"
  echo "Set by bug mode:"
  env | grep -E '^ECCE_(RCOM_LOGMODE|JOB_LOGMODE|JOB_LOGALL|AI_DEBUG|DEBUG_[A-Z_]+|BUG_DIR)=' | sort
} > "$ECCE_BUG_DIR/bug-mode.txt"

bug_finish() {
  trap - EXIT INT TERM HUP
  echo "" >&2
  echo "ecce --bug: collecting logs (this takes about half a minute)..." >&2
  local f name off
  {
    if [ -n "${ECCE_REMOTE_SERVER:-}" ]; then
      echo "Central-server session: the broker and data server run on the server; their logs are there."
    fi
    if [ -e "$ECCE_HOME/siteconfig/SharedBroker" ]; then
      echo "Shared system broker: its log is the ecce-broker service's:"
      timeout 10 journalctl -u ecce-broker.service -n 300 --no-pager 2>&1 || echo "(journalctl not available or not readable)"
    fi
  } > "$ECCE_BUG_DIR/services.txt" 2>&1
  for f in $bug_logs; do
    name=$(basename "$f")
    if [ ! -r "$f" ]; then
      echo "$f: absent or not readable here" >> "$ECCE_BUG_DIR/services.txt"
      continue
    fi
    off=0
    case "$name" in error_log|access_log|mosquitto.log) eval "off=\${$(file_key "$f"):-0}" ;; esac
    tail -c +$((off + 1)) "$f" > "$ECCE_BUG_DIR/$name" 2>/dev/null
  done
  # Job staging directories touched during the session: the logs and the
  # configuration, not the parse scripts and inputs.
  if [ -d "$jobroot" ]; then
    local d
    for d in "$jobroot"/*/; do
      [ -d "$d" ] && [ "$d" -nt "$marker" ] || continue
      mkdir -p "$ECCE_BUG_DIR/jobs/$(basename "$d")"
      cp -p "$d"/*.log* "$d"/*.conf "$d"/parseOut "$d"/submit__* \
        "$ECCE_BUG_DIR/jobs/$(basename "$d")/" 2>/dev/null
    done
  fi
  local diag="$ECCE_HOME/bin/ecce-diagnose"
  [ -x "$diag" ] || diag=$(command -v ecce-diagnose)
  if [ -n "$diag" ]; then
    timeout 300 "$diag" -o "$ECCE_BUG_DIR" > "$ECCE_BUG_DIR/diagnose-stdout.txt" 2>&1
  else
    echo "ecce-diagnose not found" > "$ECCE_BUG_DIR/diagnose-stdout.txt"
  fi
  rm -f "$marker"
  local archive
  if command -v zip >/dev/null 2>&1; then
    archive="$ECCE_REALUSERHOME/$bugname.zip"
    ( cd "$ECCE_REALUSERHOME" && zip -qr "$archive" "$bugname" )
  else
    archive="$ECCE_REALUSERHOME/$bugname.tar.gz"
    tar -C "$ECCE_REALUSERHOME" -czf "$archive" "$bugname"
  fi
  local shown=$archive
  [ "$ECCE_REALUSERHOME" = "$HOME" ] && shown="~/$(basename "$archive")"
  echo "ECCE bug report: attach $shown to your report. It contains no passwords, but it does contain host names, user names and paths." >&2
}

# The session runs in its own process group, so that Ctrl-C can end all
# of it, and its output goes to a file that is also shown here: a job
# monitor that outlives the session would hold a pipe open and keep this
# command from returning.
# macOS has no setsid(1) and its tail has no --pid.
if command -v setsid >/dev/null 2>&1; then
  setsid ecce-gateway "${passthrough[@]}" >> "$session_log" 2>&1 < /dev/null &
else
  perl -e 'use POSIX qw(setsid); setsid(); exec @ARGV or exit 127' ecce-gateway "${passthrough[@]}" >> "$session_log" 2>&1 < /dev/null &
fi
child=$!
if tail --pid=$$ -n 0 /dev/null >/dev/null 2>&1; then
  tail -n +1 -F --pid=$child "$session_log" 2>/dev/null &
else
  tail -n +1 -F "$session_log" 2>/dev/null &
  follow_kill=true
fi
follower=$!
interrupted=false
stop_session() {
  interrupted=true
  kill -TERM -- "-$child" 2>/dev/null
}
trap stop_session INT TERM HUP
trap bug_finish EXIT
status=0
while kill -0 "$child" 2>/dev/null; do
  wait "$child"
  status=$?
done
if [ "${follow_kill:-}" = true ]; then sleep 1; kill "$follower" 2>/dev/null; fi
wait "$follower" 2>/dev/null
if $interrupted; then
  ECCE_REAP_QUIET=1 "$ECCE_HOME/bin/ecce-gateway-reap" --if-idle >/dev/null 2>&1
  exit 130
fi
exit $status
