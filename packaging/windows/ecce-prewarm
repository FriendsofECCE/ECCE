#!/usr/bin/env python3
"""ecce-prewarm: have the antivirus check ECCE's programs in the background,
once per installation (Windows, #522, #444).

    ecce-prewarm         started by ecce.cmd before anything else

Some antivirus products (WithSecure, measured on a managed laptop) hold every
program they have not seen before for 5-16 s at its first start, and every
release brings new programs.  Without this the user met that wait at the
first start (nothing on the screen) and again at the first Viewer, CalcEd,
job store, ...  The check happens when the process is created, so each
program is created suspended and ended at once: none of its code runs.  Once
a program has been checked, its later starts are not held.

Done once per installation: ~/.ECCE/prewarmed holds the size and time of
organizer.exe it was done for.
"""
import ctypes
import os
import sys
import threading
from ctypes import wintypes

ECCE_HOME = os.environ.get("ECCE_HOME") or os.path.dirname(
    os.path.dirname(os.path.abspath(__file__)))
BIN = os.path.join(ECCE_HOME, "bin")
HOME = os.environ.get("ECCE_REALUSERHOME") or os.path.expanduser("~")
MARK = os.path.join(HOME, ".ECCE", "prewarmed")
# What a session needs first: the Organizer, the first-start window's helper,
# the broker; then the tools in about the order they are opened.
FIRST = ["organizer", "ecce-localdata", "mosquitto", "mosquitto_passwd",
         "builder", "eccejobmaster", "eccejobstore", "eccejobworker", "vizthumbnail", "calced",
         "launcher", "basistool", "machregister", "ecce-qm"]
WORKERS = 1

CREATE_SUSPENDED = 0x4
CREATE_NO_WINDOW = 0x08000000


class STARTUPINFO(ctypes.Structure):
    _fields_ = [("cb", wintypes.DWORD), ("lpReserved", wintypes.LPWSTR),
                ("lpDesktop", wintypes.LPWSTR), ("lpTitle", wintypes.LPWSTR),
                ("dwX", wintypes.DWORD), ("dwY", wintypes.DWORD),
                ("dwXSize", wintypes.DWORD), ("dwYSize", wintypes.DWORD),
                ("dwXCountChars", wintypes.DWORD), ("dwYCountChars", wintypes.DWORD),
                ("dwFillAttribute", wintypes.DWORD), ("dwFlags", wintypes.DWORD),
                ("wShowWindow", wintypes.WORD), ("cbReserved2", wintypes.WORD),
                ("lpReserved2", ctypes.c_void_p), ("hStdInput", wintypes.HANDLE),
                ("hStdOutput", wintypes.HANDLE), ("hStdError", wintypes.HANDLE)]


class PROCESS_INFORMATION(ctypes.Structure):
    _fields_ = [("hProcess", wintypes.HANDLE), ("hThread", wintypes.HANDLE),
                ("dwProcessId", wintypes.DWORD), ("dwThreadId", wintypes.DWORD)]


kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
kernel32.CreateProcessW.argtypes = [
    wintypes.LPCWSTR, wintypes.LPWSTR, ctypes.c_void_p, ctypes.c_void_p,
    wintypes.BOOL, wintypes.DWORD, ctypes.c_void_p, wintypes.LPCWSTR,
    ctypes.POINTER(STARTUPINFO), ctypes.POINTER(PROCESS_INFORMATION)]
kernel32.TerminateProcess.argtypes = [wintypes.HANDLE, wintypes.UINT]
kernel32.WaitForSingleObject.argtypes = [wintypes.HANDLE, wintypes.DWORD]
kernel32.CloseHandle.argtypes = [wintypes.HANDLE]


def check(exe):
    """Create exe suspended (no handles inherited, no arguments) and end it."""
    si = STARTUPINFO()
    si.cb = ctypes.sizeof(si)
    si.dwFlags = 0x80   # STARTF_FORCEOFFFEEDBACK: no busy pointer for it
    pi = PROCESS_INFORMATION()
    cmd = ctypes.create_unicode_buffer('"%s"' % exe)
    if not kernel32.CreateProcessW(exe, cmd, None, None, False,
                                   CREATE_SUSPENDED | CREATE_NO_WINDOW,
                                   None, BIN, ctypes.byref(si), ctypes.byref(pi)):
        return False
    kernel32.TerminateProcess(pi.hProcess, 0)
    kernel32.WaitForSingleObject(pi.hProcess, 10000)
    kernel32.CloseHandle(pi.hThread)
    kernel32.CloseHandle(pi.hProcess)
    return True


def stamp():
    st = os.stat(os.path.join(BIN, "organizer.exe"))
    return "%d %d" % (st.st_size, st.st_mtime_ns)


def main():
    if sys.platform != "win32":
        return 0
    try:
        mine = stamp()
    except OSError:
        return 0
    try:
        with open(MARK) as f:
            if f.read().strip() == mine:
                return 0
    except OSError:
        pass
    names = sorted(n[:-4] for n in os.listdir(BIN) if n.lower().endswith(".exe"))
    order = [n for n in FIRST if n in names] + [n for n in names if n not in FIRST]
    todo = [os.path.join(BIN, n + ".exe") for n in order]
    lock = threading.Lock()
    failed = []

    def worker():
        while True:
            with lock:
                if not todo:
                    return
                exe = todo.pop(0)
            if not check(exe):
                with lock:
                    failed.append(exe)

    threads = [threading.Thread(target=worker) for _ in range(WORKERS)]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    if failed:
        return 1
    try:
        os.makedirs(os.path.dirname(MARK), exist_ok=True)
        with open(MARK, "w") as f:
            f.write(mine + "\n")
    except OSError:
        pass
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:   # never in the way of a start
        sys.exit(0)
