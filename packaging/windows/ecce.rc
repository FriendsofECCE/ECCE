// The application icon of the GUI programs (Explorer, shortcuts, the MSI).
// Named so it sorts first: Windows shows the first icon group of an .exe.
aaaa ICON "ecce.ico"

// wx.rc without its own manifest (an exe may have one): ours selects common
// controls v6 (else Windows draws classic Windows 95 controls), per-monitor
// DPI v2 (else the bitmap is stretched at 150-200 %, #670) and UTF-8 as the
// ANSI code page (#922).
#define wxUSE_NO_MANIFEST 1
1 24 "ecce-utf8.manifest"
#include "wx/msw/wx.rc"
