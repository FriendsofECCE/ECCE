#!/bin/bash
# ecce-dataserver-adduser: add an account to this user's ECCE data server
# (see ecce-dataserver-start). Bash port of the legacy
# build/server_admin/add_ecce_user.ecce (csh), against Debian's
# apache2-utils htpasswd instead of a vendored one, and against the
# per-user $STATEDIR this package uses instead of a shared server root.
#
# Usage:
#   ecce-dataserver-adduser                       interactive prompts
#   ecce-dataserver-adduser -b USER PASS [FIRST] [LAST]
#                                                  non-interactive (scripting/testing)
#   ecce-dataserver-adduser --from FILE            batch, e.g. for a class
#                                                  (FILE may be - for stdin)
#
# --from FILE reads CSV lines "username,password,first,last" (first/last
# optional, default to username; blank lines and #-comments are ignored;
# a header line starting with "username" is skipped). No quoting: commas
# are not allowed inside a field. An empty password is generated. Every
# generated (not admin-supplied) password is written to FILE.passwords
# (./ecce-accounts.passwords for stdin) -- hand those out, then delete
# the file.
#
# Every mode feeds the password to htpasswd on stdin (-i), never on its
# command line, which would otherwise be visible to any user via ps. The
# same account goes into the message broker's password file
# ($STATEDIR/mosquitto_passwd), which a central server's mosquitto
# authenticates its clients against (ecce-gateway-start): the password is
# hashed by mosquitto_passwd -U in a private temporary file, and the
# running broker is told to reread the file.

set -u

ECCE_REALUSERHOME="${ECCE_REALUSERHOME:-$HOME}"
STATEDIR="$ECCE_REALUSERHOME/.ECCE/dataserver"

if [ ! -d "$STATEDIR" ]; then
  echo "ecce-dataserver-adduser: $STATEDIR doesn't exist -- run ecce-dataserver-start first" >&2
  exit 1
fi

BROKER_PW="$STATEDIR/mosquitto_passwd"

# add_broker_account USER PASS: the account's entry in the broker's
# password file. Not for names the broker's topic hierarchy cannot carry.
add_broker_account() {
  local userid="$1" password="$2" tmp
  if ! command -v mosquitto_passwd >/dev/null 2>&1; then
    echo "ecce-dataserver-adduser: WARNING: mosquitto_passwd not found; '$userid' cannot log in to a central message broker until it is added to $BROKER_PW" >&2
    return 0
  fi
  if ! [[ "$userid" =~ ^[A-Za-z0-9]+$ ]]; then
    echo "ecce-dataserver-adduser: WARNING: '$userid' is not letters and digits only, so it gets no message broker account (a central broker will refuse it)" >&2
    return 0
  fi
  tmp="$(mktemp "$STATEDIR/.mqpw.XXXXXX")" || return 1
  # mosquitto_passwd has no stdin mode and -b would put the password on its
  # command line; -U hashes a file in place. printf is a builtin.
  printf '%s:%s\n' "$userid" "$password" >"$tmp"
  if ! mosquitto_passwd -U "$tmp" >/dev/null 2>&1; then
    rm -f "$tmp"
    return 1
  fi
  ( umask 077
    [ -f "$BROKER_PW" ] && grep -v "^${userid}:" "$BROKER_PW" >>"$tmp.old"
    cat "$tmp" >>"$tmp.old" && mv -f "$tmp.old" "$BROKER_PW" ) || { rm -f "$tmp" "$tmp.old"; return 1; }
  rm -f "$tmp"
  # This account's own broker rereads its password file on SIGHUP.
  local pid
  pid="$(cat "$ECCE_REALUSERHOME/.ECCE/mosquitto.pid" 2>/dev/null)"
  if [ -n "$pid" ] && [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = mosquitto ]; then
    kill -HUP "$pid" 2>/dev/null
  fi
  return 0
}

# create_account USER PASS FIRST LAST
# Creates the htpasswd entry (password read from stdin, never argv) and
# the account's home dir/.htaccess. Returns 1 without doing anything if
# USER already exists, so callers can report a skip.
create_account() {
  local userid="$1" password="$2" firstname="$3" lastname="$4"

  if [ -f "$STATEDIR/users" ] && grep -q "^${userid}:" "$STATEDIR/users"; then
    return 1
  fi
  USERDIR="$STATEDIR/htdocs/Ecce/users/$userid"
  if [ -d "$USERDIR" ]; then
    return 1
  fi

  if [ ! -f "$STATEDIR/users" ]; then
    printf '%s\n' "$password" | htpasswd -i -c "$STATEDIR/users" "$userid" || return 2
  else
    printf '%s\n' "$password" | htpasswd -i "$STATEDIR/users" "$userid" || return 2
  fi
  add_broker_account "$userid" "$password" || return 3

  mkdir -p "$USERDIR"
  cat > "$USERDIR/.htaccess" <<EOF
# ECCE .htaccess File #
#
## DO NOT EDIT ## - file automatically generated
#
#R##R#
#RW#${userid}#RW#
AuthName Ecce-${firstname}.${lastname}
<Limit OPTIONS HEAD GET PUT DELETE PROPFIND PROPPATCH MKCOL COPY MOVE LOCK UNLOCK POST>
Allow from all
require user ${userid} ecceadm
</Limit>
EOF
  return 0
}

# gen_password: 12 chars from [A-Za-z0-9] minus ambiguous 0O1lI, from
# /dev/urandom.
gen_password() {
  tr -dc 'A-Za-z0-9' < /dev/urandom | tr -d '0O1lI' | head -c 12
}

if [ "${1:-}" = "--from" ]; then
  file="${2:?FILE required (- for stdin)}"
  if [ "$file" = "-" ]; then
    passfile="./ecce-accounts.passwords"
  else
    passfile="${file}.passwords"
  fi
  if [ -e "$passfile" ]; then
    echo "ecce-dataserver-adduser: $passfile already exists -- refusing to overwrite a previous run's passwords" >&2
    exit 1
  fi

  created=0
  skipped=0
  failed=0
  lineno=0
  first_data_line=1
  # Generated passwords only; created with umask 077 before any content
  # is written.
  ( umask 077 && : > "$passfile" )

  if [ "$file" = "-" ]; then
    exec 3<&0
  else
    exec 3< "$file"
  fi
  while IFS= read -r line <&3 || [ -n "$line" ]; do
    lineno=$((lineno + 1))

    trimmed="$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    [ -z "$trimmed" ] && continue
    case "$trimmed" in
      \#*) continue ;;
    esac

    if [ "$first_data_line" = "1" ]; then
      first_data_line=0
      first_field="${trimmed%%,*}"
      first_field_lc="$(printf '%s' "$first_field" | tr '[:upper:]' '[:lower:]' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
      if [ "$first_field_lc" = "username" ]; then
        continue
      fi
    fi

    IFS=',' read -r userid password firstname lastname <<< "$trimmed"
    userid="$(printf '%s' "${userid:-}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    password="$(printf '%s' "${password:-}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    firstname="$(printf '%s' "${firstname:-}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    lastname="$(printf '%s' "${lastname:-}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"

    if ! [[ "$userid" =~ ^[A-Za-z0-9]+$ ]]; then
      echo "failed line $lineno: invalid username '$userid' (must match ^[A-Za-z0-9]+\$)"
      failed=$((failed + 1))
      continue
    fi

    [ -z "$firstname" ] && firstname="$userid"
    [ -z "$lastname" ] && lastname="$userid"

    generated=0
    if [ -z "$password" ]; then
      password="$(gen_password)"
      generated=1
    fi

    create_account "$userid" "$password" "$firstname" "$lastname"
    rc=$?
    if [ "$rc" = "1" ]; then
      echo "skipped $userid (already exists)"
      skipped=$((skipped + 1))
      continue
    elif [ "$rc" != "0" ]; then
      echo "failed line $lineno: htpasswd or mosquitto_passwd failed for '$userid'"
      failed=$((failed + 1))
      continue
    fi

    if [ "$generated" = "1" ]; then
      echo "${userid},${password}" >> "$passfile"
    fi
    echo "created $userid"
    created=$((created + 1))
  done
  exec 3<&-

  echo "$created created, $skipped skipped, $failed failed"
  echo "ecce-dataserver-adduser: generated passwords written to $passfile -- hand them out, then delete this file"
  [ "$failed" -gt 0 ] && exit 1
  exit 0
fi

batch=0
if [ "${1:-}" = "-b" ]; then
  batch=1
  shift
  userid="${1:?username required}"
  password="${2:?password required}"
  firstname="${3:-}"
  lastname="${4:-}"
else
  echo ""
  echo "Add an ECCE data server user account."
  echo ""
  read -r -p "First name? " firstname
  read -r -p "Last name? " lastname
  read -r -p "User name? " userid
  echo ""
  echo "Entry confirmation:"
  echo ""
  echo "First name: ${firstname}"
  echo "Last name: ${lastname}"
  echo "User name: ${userid}"
  echo ""
  read -r -p "Is this information correct? [yes/no] " response
  echo ""
  case "$response" in
    [Yy]|[Yy][Ee][Ss]) ;;
    *) echo "Cancelled."; exit 0 ;;
  esac
  read -r -s -p "Password? " password
  echo ""
fi

[ -z "${firstname:-}" ] && firstname="$userid"
[ -z "${lastname:-}" ] && lastname="$userid"

create_account "$userid" "$password" "$firstname" "$lastname"
rc=$?
if [ "$rc" = "1" ]; then
  echo "ecce-dataserver-adduser: account '$userid' already exists" >&2
  exit 1
elif [ "$rc" != "0" ]; then
  echo "ecce-dataserver-adduser: htpasswd or mosquitto_passwd failed for '$userid'" >&2
  exit 1
fi

echo "ecce-dataserver-adduser: account '$userid' ready at $STATEDIR/htdocs/Ecce/users/$userid"
