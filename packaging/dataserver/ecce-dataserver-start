#!/bin/bash
# ecce-dataserver-start: idempotently ensure the ECCE EDSI data server (a
# per-user, non-root Apache instance serving WebDAV over the seed
# Ecce/ tree) is running on this machine, for this user, before an ECCE
# app that needs it starts. Safe to call every time an app launches -- it
# does nothing if the data server is already up.
#
# This is the WebDAV counterpart to ecce-gateway-start (which handles the
# JMS/ActiveMQ message server -- a separate, independent piece of old
# ECCE's server side). See packaging/dataserver/httpd.conf.ecce for the
# full rationale behind running as a per-user, non-root instance rather
# than a shared system service.

set -u

ECCE_HOME="${ECCE_HOME:-/opt/ecce}"
export ECCE_HOME
export ECCE_REALUSERHOME="${ECCE_REALUSERHOME:-$HOME}"
export ECCE_REALUSER="${ECCE_REALUSER:-$(id -un)}"

STATEDIR="$ECCE_REALUSERHOME/.ECCE/dataserver"
DATAROOT="$STATEDIR/htdocs"
PORT="${ECCE_DATASERVER_PORT:-8096}"
PIDFILE="$STATEDIR/logs/httpd.pid"

# Debian only puts /usr/sbin (where the apache2 binary lives) on PATH for
# root -- a regular user's login/desktop session PATH does not include it
# (confirmed via `systemctl --user show-environment` and gnome-session's
# own /proc/<pid>/environ). Relying on bare `apache2` here silently fails
# with "command not found" for any non-root, non-customized-PATH user,
# which then surfaces downstream as bin/gateway's opaque "cannot
# establish a connection to the ECCE Server" dialog instead of an actual
# error from this script. Resolve a full path instead.
APACHE2_BIN="$(command -v apache2 2>/dev/null || echo /usr/sbin/apache2)"
if [ ! -x "$APACHE2_BIN" ]; then
  echo "ecce-dataserver-start: no apache2 binary found (looked on PATH and at /usr/sbin/apache2) -- install apache2" >&2
  exit 1
fi

port_open() {
  # The connect runs in a subshell, so fd 3 is closed when that subshell
  # exits and there is nothing to clean up here.
  #
  # There used to be an "exec 3<&- 3>&- 2>/dev/null" cleanup line below.
  # `exec` with redirections and no command applies them to the CURRENT
  # shell, permanently -- so from the first port check onward this script's
  # stderr went to /dev/null, and every error message after that point was
  # silently discarded. That included the ones that matter most, like
  # "did not report ready within 20s -- see <log>".
  (exec 3<>"/dev/tcp/localhost/$1") >/dev/null 2>&1
}

if port_open "$PORT"; then
  # An httpd holding the port with no live pidfile is an ORPHAN -- typically
  # left behind when a previous run was killed. It keeps serving whatever
  # config it started with, and because this script exits early on a live
  # port, nothing ever replaces it. That is genuinely confusing to debug:
  # httpd.conf and the .htaccess files on disk are correct and simply have
  # no effect, and ecce-dataserver-status reports the contradictory pair
  # "data server running" / "httpd not running". Say so plainly.
  if [ ! -f "$PIDFILE" ] || ! kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
    echo "ecce-dataserver-start: WARNING -- something is listening on $PORT but" >&2
    echo "  it is not a data server this script started ($PIDFILE is missing or" >&2
    echo "  stale). It is probably an orphan from a killed run, and it is still" >&2
    echo "  serving its OLD configuration -- edits to httpd.conf or to any" >&2
    echo "  .htaccess will appear to be ignored. Stop it and start again:" >&2
    echo "    ecce-dataserver-stop   # or: pkill -f 'apache2 -f $STATEDIR'" >&2
  fi
  echo "ecce-dataserver-start: data server already listening on $PORT"
  exit 0
fi

mkdir -p "$STATEDIR/logs" "$STATEDIR/cgi-bin"

# Seed the DocumentRoot from the vendored tree the first time only --
# never re-extract over live user data on a subsequent start.
if [ ! -d "$DATAROOT/Ecce" ]; then
  SEED_TAR="$ECCE_HOME/data/admin/dataserver/server_config/data_server_files.tar"
  if [ ! -f "$SEED_TAR" ]; then
    echo "ecce-dataserver-start: no seed data at $SEED_TAR -- cannot initialize data server" >&2
    exit 1
  fi
  echo "ecce-dataserver-start: seeding data server document root..."
  mkdir -p "$DATAROOT"
  tar -xf "$SEED_TAR" -C "$DATAROOT"
fi

# An empty htpasswd file so AuthUserFile always points at something that
# exists (Apache errors on a missing AuthUserFile even before a login is
# attempted). Use ecce-dataserver-adduser to actually add an account.
[ -f "$STATEDIR/users" ] || : > "$STATEDIR/users"

# Seed the context-sensitive help CGI scripts (toolhelp/cshelp -- see
# CMakeLists.txt's ecce_help_cgi_patch step for how these get patched for
# this install) the first time only, same idempotency rule as the
# DocumentRoot seed above. The account-creation CGI this same cgi-bin/
# could eventually also host is deliberately still not seeded here.
HELP_CGI_SRC="$ECCE_HOME/data/client/WebHelp/EcceHelp/cgi-bin"
if [ ! -e "$STATEDIR/cgi-bin/EcceHelp" ] && [ -d "$HELP_CGI_SRC" ]; then
  cp -r "$HELP_CGI_SRC" "$STATEDIR/cgi-bin/EcceHelp"
  chmod +x "$STATEDIR/cgi-bin/EcceHelp/toolhelp" "$STATEDIR/cgi-bin/EcceHelp/cshelp"
fi

# Resolve the packaged config template's per-user placeholders. See the
# comment at the top of httpd.conf.ecce for why this can't be done at
# package-install time.
CONF_TEMPLATE="$ECCE_HOME/server/httpd-conf/httpd.conf.ecce"
if [ ! -f "$CONF_TEMPLATE" ]; then
  echo "ecce-dataserver-start: no config template at $CONF_TEMPLATE" >&2
  exit 1
fi
sed -e "s|##HTTPDROOT##|$STATEDIR|g" \
    -e "s|##DATAROOT##|$DATAROOT|g" \
    -e "s|##PORT##|$PORT|g" \
    -e "s|##EMAIL##|$ECCE_REALUSER@localhost|g" \
    -e "s|##SERVER##|localhost|g" \
    "$CONF_TEMPLATE" > "$STATEDIR/httpd.conf"

echo "ecce-dataserver-start: starting data server on port $PORT..."
"$APACHE2_BIN" -f "$STATEDIR/httpd.conf" -k start
i=0
while [ $i -lt 40 ]; do
  if port_open "$PORT"; then break; fi
  i=$((i + 1))
  sleep 0.5
done
if ! port_open "$PORT"; then
  echo "ecce-dataserver-start: data server did not come up within 20s -- see $STATEDIR/logs/error_log" >&2
  exit 1
fi

exit 0
