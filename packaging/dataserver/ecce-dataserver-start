#!/bin/bash
# ecce-dataserver-start: idempotently ensure the ECCE EDSI data server (a
# per-user, non-root Apache instance serving WebDAV over the seed
# Ecce/ tree) is running on this machine, for this user, before an ECCE
# app that needs it starts. Safe to call every time an app launches -- it
# does nothing if the data server is already up.
#
# This is the WebDAV counterpart to ecce-gateway-start (which handles the
# mosquitto message broker -- a separate, independent piece of old
# ECCE's server side). See packaging/dataserver/httpd.conf.ecce for the
# full rationale behind running as a per-user, non-root instance rather
# than a shared system service.

set -u

ECCE_HOME="${ECCE_HOME:-/opt/ecce}"
export ECCE_HOME
export ECCE_REALUSERHOME="${ECCE_REALUSERHOME:-$HOME}"
export ECCE_REALUSER="${ECCE_REALUSER:-$(id -un)}"

STATEDIR="$ECCE_REALUSERHOME/.ECCE/dataserver"
DATAROOT="$STATEDIR/htdocs"

# NOTE: this runs BEFORE the "already listening" check below, which
# exits 0. Putting it after meant it never ran on a machine whose data
# server was already up -- which is every machine that has used ECCE
# before. Seeding does not need the server stopped, so it belongs here.
# Keep the Gaussian basis set library in step with the installed package.
#
# With a data server, clients do not read $ECCE_HOME/data/admin/basissets
# directly (only local mode, #216, does): siteconfig/DataServers points
# <BasisSet> at
# http://localhost:8096/Ecce/system/GaussianBasisSetLibrary, so the library
# has to live under the document root to be reachable at all.  Nothing used
# to put it there -- installs only worked because their htdocs tree was
# inherited from an original PNNL distribution.
#
# SYNCED, not merely seeded.  Installing a release must deliver that
# release's basis sets even when a library is already present, or a
# correction to the shipped data never reaches anybody -- which is exactly
# what happened to the Fortran D-notation fix.  A content stamp decides:
# when the packaged library differs from what was last copied, it is copied
# again.
#
# Files are copied OVER the existing ones rather than the directory being
# replaced, so anything a site has added of its own survives; only files
# the package also ships are overwritten.
#
# This runs BEFORE the "already listening" check below, which exits 0.
# After it, the sync would never run on a machine whose data server was
# already up -- which is every machine that has used ECCE before.
# Seed the DocumentRoot from the vendored tree the first time only --
# never re-extract over live user data on a subsequent start.
#
# BEFORE the basis-library sync below.  The sync creates $DATAROOT/Ecce
# (it writes Ecce/system/GaussianBasisSetLibrary), and this test is for
# that directory -- so with the sync first, a brand-new install never got
# its seed: a library and no users/ or share/ tree.
if [ ! -d "$DATAROOT/Ecce" ]; then
  SEED_TAR="$ECCE_HOME/data/admin/dataserver/server_config/data_server_files.tar"
  if [ ! -f "$SEED_TAR" ]; then
    echo "ecce-dataserver-start: no seed data at $SEED_TAR -- cannot initialize data server" >&2
    exit 1
  fi
  echo "ecce-dataserver-start: seeding data server document root..."
  mkdir -p "$DATAROOT"
  tar -xf "$SEED_TAR" -C "$DATAROOT"
fi

GBS_SRC="$ECCE_HOME/data/admin/basissets"
GBS_DEST="$DATAROOT/Ecce/system/GaussianBasisSetLibrary"
GBS_STAMP="$GBS_DEST/.ecce-library-stamp"
if [ -d "$GBS_SRC" ]; then
  gbs_want=$(cd "$GBS_SRC" && find . -type f -print0 2>/dev/null | LC_ALL=C sort -z \
             | xargs -0 sha256sum 2>/dev/null | sha256sum | cut -d' ' -f1)
  gbs_have=$(cat "$GBS_STAMP" 2>/dev/null || true)
  if [ -n "$gbs_want" ] && [ "$gbs_want" != "$gbs_have" ]; then
    echo "ecce-dataserver-start: updating the basis set library"
    mkdir -p "$GBS_DEST"
    cp -r "$GBS_SRC"/. "$GBS_DEST"/
    # Editor backups and the maintenance odds and ends that live alongside
    # the data in the repository have no business being web-served.
    find "$GBS_DEST" -maxdepth 1 \( -name '*~' -o -name '*.sh' -o -name '*.py' \
         -o -name 'history' -o -name '*.rev' \) -delete 2>/dev/null || true
    printf '%s\n' "$gbs_want" > "$GBS_STAMP"
  fi
fi

# Publish this install's site machine list (issue #188): a central-server
# client's ecce-remote-setup fetches these so machines registered with
# "ecce -admin" on the server reach clients without hand copying. Placed
# here, before the "already listening" exit below, for the same reason as
# the basis set sync above -- it has to run on every real start, including
# one that finds the server already up. ecce-site-admin runs the same step
# after an administrator's change from a client.
PUBLISH="$(dirname "$0")/ecce-site-publish"
[ -x "$PUBLISH" ] || PUBLISH="$ECCE_HOME/bin/ecce-site-publish"
"$PUBLISH" "$DATAROOT/Ecce/system/siteconfig" ||
  echo "ecce-dataserver-start: WARNING -- the site machine list was not published to -remote clients" >&2

PORT="${ECCE_DATASERVER_PORT:-8096}"
PIDFILE="$STATEDIR/logs/httpd.pid"

# WHICH ADDRESSES TO LISTEN ON (issue #138).
#
# ECCE has two deployments and they want opposite answers:
#
#   * PER-USER (the default): every user runs their own Apache, started by
#     their own ecce-* wrapper, serving only their own data, and every
#     client of it -- the gateway and the apps it launches -- is on this
#     machine by construction. Nothing off this machine ever needs to
#     reach it, and it is protected only by HTTP Basic over plain HTTP.
#     So it listens on loopback and nowhere else.
#
#   * CENTRAL SERVER (the original PNNL deployment, and the teaching one:
#     one server, a class of clients on other machines running
#     "ecce -remote"). This is the same script run by the account hosting
#     the server; there is nothing else that distinguishes the server
#     machine. It MUST listen outward, or it serves nobody.
#
# A script cannot tell those apart by looking, so the outward bind is an
# explicit setting on the server, never a guess:
#
#   ECCE_DATASERVER_LISTEN     environment, wins if set, else
#   $STATEDIR/listen           one line in the hosting account's own
#                              state directory, for a server that is
#                              started by more than one path
#
# Values:
#   loopback        (default) 127.0.0.1, plus ::1 when this host has IPv6
#                   loopback configured
#   all             every interface -- the behaviour before #138, and
#                   what a central server normally wants
#   <addr> ...      loopback plus these addresses (e.g. the server's
#                   campus-facing address only)
#
# Why ::1 as well as 127.0.0.1: "localhost" resolves to both on Debian and
# ::1 comes first. The C++ client resolves IPv4 only (CIPCcsock.C,
# gethostbyname/AF_INET), but the help pages ECCE_HELP opens in a browser,
# Python's urllib (tests) and anything else that uses getaddrinfo try ::1
# first. They would fall back to 127.0.0.1, but binding both keeps what the
# old all-interfaces bind gave them. It is only added when the host
# actually has ::1: "Listen [::1]:port" on a host without IPv6 loopback is
# a fatal Apache error, and the data server would not start at all.
#
# Loopback is ALWAYS included, even with an explicit address list, because
# this script, ecce-dataserver-status and ecce-gateway-* probe the port at
# localhost, and a user running ECCE on the server machine itself reaches
# it at the http://localhost:<port>/Ecce siteconfig/DataServers ships.
LISTEN_FILE="$STATEDIR/listen"
LISTEN_SETTING="${ECCE_DATASERVER_LISTEN:-}"
LISTEN_FROM="ECCE_DATASERVER_LISTEN"
if [ -z "$LISTEN_SETTING" ] && [ -f "$LISTEN_FILE" ]; then
  LISTEN_SETTING="$(sed -e 's/#.*//' "$LISTEN_FILE" | tr -s ' \t\n' '   ')"
  LISTEN_SETTING="${LISTEN_SETTING# }"; LISTEN_SETTING="${LISTEN_SETTING% }"
  LISTEN_FROM="$LISTEN_FILE"
fi
[ -n "$LISTEN_SETTING" ] || { LISTEN_SETTING="loopback"; LISTEN_FROM="default"; }

has_ipv6_loopback() {
  [ -r /proc/net/if_inet6 ] &&
    grep -q '^00000000000000000000000000000001 ' /proc/net/if_inet6
}

# Apache "Listen" lines, one per element, into LISTEN_LINES (array).
LISTEN_LINES=()
add_listen() {
  local line="Listen $1" l
  for l in "${LISTEN_LINES[@]+"${LISTEN_LINES[@]}"}"; do
    [ "$l" = "$line" ] && return 0
  done
  LISTEN_LINES+=("$line")
}
# Loopback on the given ports.
listen_loopback() {
  local p
  for p in "$@"; do
    add_listen "127.0.0.1:$p"
    if has_ipv6_loopback; then add_listen "[::1]:$p"; fi
  done
}

# TLS (#236, ecce-remote-setup --server --tls). Opt-in; with it on, the
# plain port is loopback only and every non-loopback bind serves HTTPS on
# its own port instead, so no password crosses the network in clear. There
# is no fallback to plain HTTP if the certificate is unusable. The key
# lives here, shared with the broker, never under the web-served root.
TLS_DIR="$ECCE_REALUSERHOME/.ECCE/tls"
TLS=0
if [ "${ECCE_DATASERVER_TLS:-}" = 1 ] || [ -f "$TLS_DIR/enabled" ]; then TLS=1; fi
TLS_PORT="${ECCE_DATASERVER_TLS_PORT:-8443}"
NETPORT="$PORT"
if [ "$TLS" = 1 ]; then
  NETPORT="$TLS_PORT"
  case "$TLS_PORT" in ''|*[!0-9]*)
    echo "ecce-dataserver-start: ECCE_DATASERVER_TLS_PORT '$TLS_PORT' is not a port number" >&2
    exit 1 ;;
  esac
  for f in server.pem server.key; do
    if [ ! -r "$TLS_DIR/$f" ]; then
      echo "ecce-dataserver-start: TLS is on but $TLS_DIR/$f is missing -- run ecce-remote-setup --server --tls" >&2
      exit 1
    fi
  done
  chmod 700 "$TLS_DIR" 2>/dev/null; chmod 600 "$TLS_DIR/server.key" 2>/dev/null
fi

case "$LISTEN_SETTING" in
  loopback|localhost)
    listen_loopback "$PORT"
    [ "$TLS" = 1 ] && listen_loopback "$TLS_PORT"
    ;;
  all|'*'|0.0.0.0|::|'[::]')
    if [ "$TLS" = 1 ]; then
      # The plain port must not be a wildcard, or it would be outward too.
      listen_loopback "$PORT"
      add_listen "$TLS_PORT"
    else
      # A wildcard bind already covers loopback, and adding a specific
      # address on the same port as well would fail with "Address already
      # in use" -- so this is the one case with a single line.
      add_listen "$PORT"
    fi
    ;;
  *)
    listen_loopback "$PORT"
    [ "$TLS" = 1 ] && listen_loopback "$TLS_PORT"
    set -f   # a '*' in the setting must not expand against the cwd
    for addr in $LISTEN_SETTING; do
      # This text is written into httpd.conf. Accept address material only,
      # so a stray setting cannot inject configuration.
      case "$addr" in
        *[!0-9A-Za-z.:\[\]-]*|'')
          echo "ecce-dataserver-start: invalid listen address '$addr' (from $LISTEN_FROM)" >&2
          exit 1 ;;
      esac
      case "$addr" in
        all|'*'|0.0.0.0|::|'[::]')
          echo "ecce-dataserver-start: '$addr' cannot be combined with other addresses (from $LISTEN_FROM); use 'all' on its own" >&2
          exit 1 ;;
        loopback|localhost) continue ;;
        \[*\]) add_listen "$addr:$NETPORT" ;;
        *:*)   add_listen "[$addr]:$NETPORT" ;;    # bare IPv6 literal
        *)     add_listen "$addr:$NETPORT" ;;
      esac
    done
    set +f
    ;;
esac

# /usr/sbin is on PATH only for root on Debian, so a bare name would fail
# for users as "command not found" and surface as the gateway's opaque
# "cannot establish a connection" dialog. Debian calls the binary apache2
# and keeps modules in /usr/lib/apache2/modules; RHEL calls it httpd and
# uses /usr/lib64/httpd/modules (#193).
APACHE2_BIN=""
for cand in "$(command -v apache2 2>/dev/null)" /usr/sbin/apache2 \
            "$(command -v httpd 2>/dev/null)" /usr/sbin/httpd; do
  if [ -n "$cand" ] && [ -x "$cand" ]; then APACHE2_BIN="$cand"; break; fi
done
if [ -z "$APACHE2_BIN" ]; then
  echo "ecce-dataserver-start: no Apache found (apache2 or httpd, on PATH or in /usr/sbin) -- install apache2 (Debian/Ubuntu) or httpd (RHEL/Fedora)" >&2
  exit 1
fi
MODULES_DIR=""
for cand in /usr/lib/apache2/modules /usr/lib64/httpd/modules \
            /usr/lib/httpd/modules /usr/lib64/apache2/modules; do
  if [ -f "$cand/mod_dav.so" ]; then MODULES_DIR="$cand"; break; fi
done
if [ -z "$MODULES_DIR" ]; then
  echo "ecce-dataserver-start: found $APACHE2_BIN but no Apache module directory with mod_dav.so (looked in /usr/lib/apache2/modules, /usr/lib64/httpd/modules, /usr/lib/httpd/modules)" >&2
  exit 1
fi

port_open() {
  # The connect runs in a subshell, so fd 3 is closed when that subshell
  # exits and there is nothing to clean up here.
  #
  # There used to be an "exec 3<&- 3>&- 2>/dev/null" cleanup line below.
  # `exec` with redirections and no command applies them to the CURRENT
  # shell, permanently -- so from the first port check onward this script's
  # stderr went to /dev/null, and every error message after that point was
  # silently discarded. That included the ones that matter most, like
  # "did not report ready within 20s -- see <log>".
  (exec 3<>"/dev/tcp/localhost/$1") >/dev/null 2>&1
}

if port_open "$PORT"; then
  # An httpd holding the port with no live pidfile is an ORPHAN -- typically
  # left behind when a previous run was killed. It keeps serving whatever
  # config it started with, and because this script exits early on a live
  # port, nothing ever replaces it. That is genuinely confusing to debug:
  # httpd.conf and the .htaccess files on disk are correct and simply have
  # no effect, and ecce-dataserver-status reports the contradictory pair
  # "data server running" / "httpd not running". Say so plainly.
  if [ ! -f "$PIDFILE" ] || ! kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
    echo "ecce-dataserver-start: WARNING -- something is listening on $PORT but" >&2
    echo "  it is not a data server this script started ($PIDFILE is missing or" >&2
    echo "  stale). It is probably an orphan from a killed run, and it is still" >&2
    echo "  serving its OLD configuration -- edits to httpd.conf or to any" >&2
    echo "  .htaccess will appear to be ignored. Stop it and start again:" >&2
    echo "    ecce-dataserver-stop   # or: pkill -f -- '-f $STATEDIR/httpd.conf'" >&2
  fi
  # The listen setting only takes effect when Apache starts, and this early
  # exit means changing it has no effect on a running server. Say so rather
  # than leave a central server silently loopback-only (or the reverse).
  if [ -f "$STATEDIR/httpd.conf" ]; then
    running_listen="$(grep '^Listen ' "$STATEDIR/httpd.conf" 2>/dev/null)"
    wanted_listen="$(printf '%s\n' "${LISTEN_LINES[@]}")"
    if [ "$running_listen" != "$wanted_listen" ]; then
      echo "ecce-dataserver-start: WARNING -- the running data server was started with" >&2
      echo "  a different listen setting than the current one ($LISTEN_FROM:" >&2
      echo "  '$LISTEN_SETTING'). It keeps its old addresses until restarted:" >&2
      echo "    ecce-dataserver-stop && ecce-dataserver-start" >&2
    fi
  fi
  echo "ecce-dataserver-start: data server already listening on $PORT"
  exit 0
fi

mkdir -p "$STATEDIR/logs" "$STATEDIR/cgi-bin"

# An empty htpasswd file so AuthUserFile always points at something that
# exists (Apache errors on a missing AuthUserFile even before a login is
# attempted). Use ecce-dataserver-adduser to actually add an account.
[ -f "$STATEDIR/users" ] || : > "$STATEDIR/users"

# Seed the context-sensitive help CGI scripts (toolhelp/cshelp -- see
# CMakeLists.txt's ecce_help_cgi_patch step for how these get patched for
# this install) the first time only, same idempotency rule as the
# DocumentRoot seed above. The account-creation CGI this same cgi-bin/
# could eventually also host is deliberately still not seeded here.
HELP_CGI_SRC="$ECCE_HOME/data/client/WebHelp/EcceHelp/cgi-bin"
if [ ! -e "$STATEDIR/cgi-bin/EcceHelp" ] && [ -d "$HELP_CGI_SRC" ]; then
  cp -r "$HELP_CGI_SRC" "$STATEDIR/cgi-bin/EcceHelp"
  chmod +x "$STATEDIR/cgi-bin/EcceHelp/toolhelp" "$STATEDIR/cgi-bin/EcceHelp/cshelp"
fi

# Resolve the packaged config template's per-user placeholders. See the
# comment at the top of httpd.conf.ecce for why this can't be done at
# package-install time.
CONF_TEMPLATE="$ECCE_HOME/server/httpd-conf/httpd.conf.ecce"
if [ ! -f "$CONF_TEMPLATE" ]; then
  echo "ecce-dataserver-start: no config template at $CONF_TEMPLATE" >&2
  exit 1
fi
if ! grep -q '^##LISTEN##$' "$CONF_TEMPLATE"; then
  # An older template (a bare "Listen ##PORT##") would bind every
  # interface regardless of the setting above. Refuse rather than do that.
  echo "ecce-dataserver-start: $CONF_TEMPLATE has no ##LISTEN## line -- it is" >&2
  echo "  older than this script, and would listen on every interface" >&2
  exit 1
fi
if [ "$TLS" = 1 ]; then
  if ! grep -q '^#TLS-BEGIN$' "$CONF_TEMPLATE"; then
    echo "ecce-dataserver-start: $CONF_TEMPLATE has no TLS block -- it is older than this script" >&2
    exit 1
  fi
  tls_sed=(-e '/^#TLS-\(BEGIN\|END\)$/d')
else
  tls_sed=(-e '/^#TLS-BEGIN$/,/^#TLS-END$/d')
fi
# GNU sed turns "\n" in a replacement into a newline: one Listen per line.
listen_repl="$(printf '%s\\n' "${LISTEN_LINES[@]}")"
listen_repl="${listen_repl%\\n}"
sed "${tls_sed[@]}" \
    -e "s|^##LISTEN##\$|$listen_repl|" \
    -e "s|##TLSPORT##|$TLS_PORT|g" \
    -e "s|##TLSDIR##|$TLS_DIR|g" \
    -e "s|##HTTPDROOT##|$STATEDIR|g" \
    -e "s|##DATAROOT##|$DATAROOT|g" \
    -e "s|##PORT##|$PORT|g" \
    -e "s|##EMAIL##|$ECCE_REALUSER@localhost|g" \
    -e "s|##SERVER##|localhost|g" \
    -e "s|##MODULES##|$MODULES_DIR|g" \
    "$CONF_TEMPLATE" > "$STATEDIR/httpd.conf"
# Newer httpd (Fedora 44, 2.4.69) has no mod_dav_lock.so any more.
if [ ! -f "$MODULES_DIR/mod_dav_lock.so" ]; then
  sed '/^LoadModule dav_lock_module /d' "$STATEDIR/httpd.conf" > "$STATEDIR/httpd.conf.new" &&
    mv -f "$STATEDIR/httpd.conf.new" "$STATEDIR/httpd.conf"
fi

if [ "$TLS" = 1 ]; then
  echo "ecce-dataserver-start: TLS on: HTTPS on port $TLS_PORT for non-loopback addresses, plain HTTP on port $PORT for loopback only"
  case "$LISTEN_SETTING" in loopback|localhost)
    echo "ecce-dataserver-start: WARNING -- the listen setting is loopback only, so nothing serves HTTPS to other machines; set it (ecce-remote-setup --server all --tls)" >&2 ;;
  esac
fi
case "$LISTEN_SETTING" in
  loopback|localhost)
    echo "ecce-dataserver-start: starting data server on port $PORT (loopback only)..." ;;
  all|'*'|0.0.0.0|::|'[::]')
    echo "ecce-dataserver-start: starting data server on port $PORT," \
         "listening on EVERY interface ($LISTEN_FROM)..." ;;
  *)
    echo "ecce-dataserver-start: starting data server on port $PORT," \
         "listening on: ${LISTEN_LINES[*]#Listen } ($LISTEN_FROM)..." ;;
esac
"$APACHE2_BIN" -f "$STATEDIR/httpd.conf" -k start
i=0
while [ $i -lt 40 ]; do
  if port_open "$PORT"; then break; fi
  i=$((i + 1))
  sleep 0.5
done
if ! port_open "$PORT"; then
  echo "ecce-dataserver-start: data server did not come up within 20s -- see $STATEDIR/logs/error_log" >&2
  exit 1
fi

exit 0
