#!/bin/bash
#
# Point this ECCE installation at a central server.
#
# ECCE was originally deployed with one server for a whole group: a
# shared data server holding everyone's calculations and structure
# library, and a shared message broker.  The old launcher selected that
# with "ecce -remote", which set ECCE_REMOTE_SERVER and made the client
# read siteconfig/RemoteServer/ instead of the local configuration.
#
# The client still supports it in full -- EDSIServerCentral and
# Ecce::ecceAutoAccounts/ecceStoreTrajectories all branch on that
# variable -- but nothing wrote the RemoteServer configuration, so it
# had to be assembled by hand.  This writes it.
#
# Run once per CLIENT installation, as whoever owns $ECCE_HOME
# (normally root).  It does not touch anything on the server.
#
#   ecce-remote-setup <server-host> [data-port]
#
# Afterwards, users run:
#
#   ecce -remote
#
# which skips starting a per-user data server and broker and talks to
# the central ones instead.

set -u

usage() {
  cat <<'USAGE'
Usage: ecce-remote-setup <server-host> [data-port] [--tls TRUST]
       ecce-remote-setup --refresh
       ecce-remote-setup <server-host[:port]> --user [--auto] [--tls TRUST]
       ecce-remote-setup --server [listen] [--tls [--new-cert | --cert F --key F]]

  --server      on the SERVER, as the account running it: mark its broker
                as a central server's. It then listens on TCP port 8088
                (ECCE_BROKER_PORT) beside the data server, for the accounts
                of this data server (its users file), and its plain quit leaves it
                running; listen (all, loopback or addresses) goes to
                dataserver/listen and applies to the data server and the
                broker alike
  --tls         on the SERVER: serve the data server (port 8443,
                ECCE_DATASERVER_TLS_PORT) and the broker (port 8883,
                ECCE_BROKER_TLS_PORT) over TLS. The plain ports then
                accept loopback connections only; there is no fallback
                to plain for clients. The certificate lives in
                ~/.ECCE/tls/: --new-cert makes a self-signed one (10
                years; also made when there is none yet), --cert and
                --key supply one (e.g. from Let's Encrypt). Restart the
                services afterwards.
                on a CLIENT: use TLS to the server (data port default
                8443). TRUST is how the server's certificate is known,
                and one is required:
                  --pin FILE    the server's server.pem, as the server's
                                administrator gave it (installed as
                                $ECCE_HOME/siteconfig/RemoteServer/server.pem;
                                only this exact certificate is accepted)
                  --fetch-pin   take the certificate the server presents
                                now, and print its fingerprint to check
                  --system-ca   the server has a CA-signed certificate
                                (host name checked, no pin)
  --user        write the user's own ~/.ECCE/RemoteServer instead of the
                installation's (no root needed; what ECCE's first-start
                window uses). Fails unless the server answers. ECCE_REMOTE_DIR
                names that folder to the programs of a session
  --auto        with --user: try a certificate the system trusts, then
                pin the server's certificate as first presented, then
                plain http; the first that works is written
  --refresh     no longer needed: a -remote client takes the server's
                site configuration itself (issue #192); prints a note
  server-host   host name of the central ECCE server
  data-port     data server port      (default 8096)

Writes $ECCE_HOME/siteconfig/RemoteServer/ (the server's address and, with
--tls, its certificate pin), and nothing else: the server's machine list is
no longer copied into siteconfig/ (issue #192).
Run "ecce -remote" afterwards.
USAGE
}

#  The SERVER's step: run once as the account that runs the central data
#  server and broker.  It marks that account's broker as a server's, so
#  the account's own plain quit never stops it under its clients; only
#  its Quit and Stop Server does.  The mark is also what makes
#  ecce-gateway-start give that broker a TCP listener (logins checked against the data server's users file by server/ecce_users_auth.so, access rules from server/mosquitto.acl).  A mark, not a guess from the listen
#  address, because clients may reach a loopback-only server through ssh
#  tunnels.  The optional listen value is written to dataserver/listen.
if [ "${1:-}" = "--server" ]; then
  shift
  WANT_TLS=false NEW_CERT=false CERT="" KEY="" LISTEN=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --tls) WANT_TLS=true ;;
      --new-cert) NEW_CERT=true ;;
      --cert) CERT="${2:-}"; shift ;;
      --key) KEY="${2:-}"; shift ;;
      -*) echo "ecce-remote-setup: unknown option $1" >&2; exit 2 ;;
      *) LISTEN="$1" ;;
    esac
    shift
  done
  if [ "$WANT_TLS" = false ] && { [ "$NEW_CERT" = true ] || [ -n "$CERT$KEY" ]; }; then
    echo "ecce-remote-setup: --new-cert, --cert and --key are for --tls" >&2
    exit 2
  fi
  if [ -n "$CERT$KEY" ] && { [ -z "$CERT" ] || [ -z "$KEY" ] || [ "$NEW_CERT" = true ]; }; then
    echo "ecce-remote-setup: --cert and --key go together, and not with --new-cert" >&2
    exit 2
  fi
  STATEDIR="${ECCE_REALUSERHOME:-$HOME}/.ECCE"
  mkdir -p "$STATEDIR" || exit 1
  if [ "$WANT_TLS" = true ]; then
    TLSDIR="$STATEDIR/tls"
    if ! command -v openssl >/dev/null 2>&1; then
      echo "ecce-remote-setup: --tls needs the openssl command (package openssl)" >&2
      exit 1
    fi
    mkdir -p "$TLSDIR" && chmod 700 "$TLSDIR" || exit 1
    if [ -n "$CERT" ]; then
      for f in "$CERT" "$KEY"; do
        [ -r "$f" ] || { echo "ecce-remote-setup: cannot read $f" >&2; exit 1; }
      done
      a="$(openssl x509 -in "$CERT" -noout -pubkey 2>/dev/null | openssl pkey -pubin -outform der 2>/dev/null | openssl dgst -sha256)"
      b="$(openssl pkey -in "$KEY" -pubout -outform der 2>/dev/null | openssl dgst -sha256)"
      if [ -z "$a" ] || [ "$a" != "$b" ]; then
        echo "ecce-remote-setup: $KEY is not the private key of $CERT" >&2
        exit 1
      fi
      install -m 644 "$CERT" "$TLSDIR/server.pem" &&
        install -m 600 "$KEY" "$TLSDIR/server.key" || exit 1
      echo "Installed the certificate $CERT in $TLSDIR."
    elif [ "$NEW_CERT" = true ] || [ ! -r "$TLSDIR/server.pem" ] || [ ! -r "$TLSDIR/server.key" ]; then
      fqdn="$(hostname -f 2>/dev/null || hostname)"
      san="DNS:$fqdn,DNS:$(hostname),DNS:localhost,IP:127.0.0.1"
      for ip in $(hostname -I 2>/dev/null); do
        case "$ip" in *:*) ;; *) san="$san,IP:$ip" ;; esac
      done
      if ! (umask 077; openssl req -x509 -newkey rsa:3072 -nodes -days 3650 \
              -subj "/CN=$fqdn/O=ECCE central server" -addext "subjectAltName=$san" \
              -keyout "$TLSDIR/server.key" -out "$TLSDIR/server.pem" 2>"$TLSDIR/openssl.err"); then
        echo "ecce-remote-setup: openssl could not make a certificate:" >&2
        cat "$TLSDIR/openssl.err" >&2
        exit 1
      fi
      rm -f "$TLSDIR/openssl.err"
      chmod 644 "$TLSDIR/server.pem"
      echo "Made a self-signed certificate for $fqdn, valid 10 years."
    else
      echo "Keeping the certificate already in $TLSDIR (--new-cert replaces it;"
      echo "clients must then be given the new server.pem)."
    fi
    echo "# TLS is on for this account's data server and broker (ecce-remote-setup --server --tls)" \
      >"$TLSDIR/enabled" || exit 1
    echo "TLS is on. Give every client installation this file:"
    echo "    $TLSDIR/server.pem"
    echo "and set the clients up with:"
    echo "    ecce-remote-setup <this-host> --tls --pin server.pem"
    echo "    (for a certificate from a CA, --tls --system-ca instead)"
    echo "Fingerprint: $(openssl x509 -in "$TLSDIR/server.pem" -noout -fingerprint -sha256 2>/dev/null)"
  elif [ -e "$STATEDIR/tls/enabled" ]; then
    rm -f "$STATEDIR/tls/enabled"
    echo "TLS is off again for this account; the data server and broker listen as before."
  fi
  echo "# ECCE central server: plain quits leave this broker running (ecce-remote-setup --server)" \
    >"$STATEDIR/mosquitto.server" || exit 1
  echo "Marked $STATEDIR/mosquitto.server: this account's broker is a central server's."
  echo "ecce-gateway-start (run by \"ecce\") starts it on TCP port ${ECCE_BROKER_PORT:-8088}, checking"
  echo "logins against this data server's users file, and restarts a broker that"
  echo "already runs here without that listener. Existing accounts work as they are."
  if [ -n "$LISTEN" ]; then
    mkdir -p "$STATEDIR/dataserver" || exit 1
    echo "$LISTEN" >"$STATEDIR/dataserver/listen" || exit 1
    echo "Wrote $STATEDIR/dataserver/listen ($LISTEN): the data server and broker listen there."
  fi
  if [ -n "$LISTEN" ] || [ "$WANT_TLS" = true ]; then
    echo "Restart them for it to take effect:"
    echo "    ecce-dataserver-stop; ecce-gateway-stop"
  fi
  echo "Remove that file to make it a per-user broker again."
  exit 0
fi

#  curl's options for an https URL: the pinned certificate when this
#  installation has one (its public key is compared; the host name is not,
#  as in the C++ client), the system CAs otherwise. Never "-k" alone.
#  Plain http gets none.
pin_hash() {
  openssl x509 -in "$1" -noout -pubkey 2>/dev/null | openssl pkey -pubin -outform der 2>/dev/null |
    openssl dgst -sha256 -binary | openssl enc -base64
}
curl_tls_args() {
  CURL_TLS=()
  case "$1" in https:*) ;; *) return 0 ;; esac
  local pin="${2:-$REMOTE/server.pem}"
  if [ -e "$pin" ]; then
    local h
    h="$(pin_hash "$pin")"
    if [ -z "$h" ]; then
      echo "ecce-remote-setup: cannot read a public key from $pin" >&2
      return 1
    fi
    CURL_TLS=(--insecure --pinnedpubkey "sha256//$h")
  fi
}

if [ $# -lt 1 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  usage
  exit 2
fi

REFRESH=false
USER_MODE=false AUTO=false
WANT_TLS=false TRUST="" PINFILE=""
POS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --refresh) REFRESH=true ;;
    --user) USER_MODE=true ;;
    --auto) AUTO=true ;;
    --tls) WANT_TLS=true ;;
    --pin) TRUST=pin; PINFILE="${2:-}"; shift ;;
    --fetch-pin) TRUST=fetch ;;
    --system-ca) TRUST=ca ;;
    -*) echo "ecce-remote-setup: unknown option $1" >&2; usage; exit 2 ;;
    *) POS+=("$1") ;;
  esac
  shift
done
HOST="${POS[0]:-}"
HPORT=""
case "$HOST" in
  *:*) HPORT="${HOST##*:}"; HOST="${HOST%:*}" ;;
esac
if [ -n "$HPORT" ] && [ -z "${POS[1]:-}" ]; then POS[1]="$HPORT"; fi
if [ "$AUTO" = true ]; then
  if [ "$USER_MODE" = false ] || [ "$REFRESH" = true ] || [ -z "$HOST" ]; then
    echo "ecce-remote-setup: --auto needs a server host and --user" >&2
    exit 2
  fi
  #  No port given: each way uses its own default. A port given is tried in each way.
  PORTARG=()
  [ -n "${POS[1]:-}" ] && PORTARG=("${POS[1]}")
  self="$0"
  for way in "--tls --system-ca" "--tls --fetch-pin" ""; do
    # shellcheck disable=SC2086
    if "$self" "$HOST" "${PORTARG[@]}" --user $way >/dev/null 2>&1; then
      case "$way" in
        *system-ca*) echo "trusted" ;;
        *fetch-pin*) echo "pinned" ;;
        *) echo "plain" ;;
      esac
      exit 0
    fi
  done
  echo "ecce-remote-setup: nothing answered at $HOST" >&2
  exit 1
fi
if [ "$WANT_TLS" = true ]; then DATA_PORT="${POS[1]:-8443}"; else DATA_PORT="${POS[1]:-8096}"; fi
if [ "$WANT_TLS" = false ] && [ -n "$TRUST" ]; then
  echo "ecce-remote-setup: --pin, --fetch-pin and --system-ca are for --tls" >&2
  exit 2
fi
if [ "$WANT_TLS" = true ] && [ -z "$TRUST" ]; then
  echo "ecce-remote-setup: --tls needs to know how to trust the server: --pin FILE," >&2
  echo "  --fetch-pin or --system-ca (see --help)" >&2
  exit 2
fi
if [ "$TRUST" = pin ] && [ ! -r "$PINFILE" ]; then
  echo "ecce-remote-setup: cannot read the certificate '$PINFILE'" >&2
  exit 2
fi
if [ "$REFRESH" = false ] && [ -z "$HOST" ]; then usage; exit 2; fi

: "${ECCE_HOME:=/opt/ecce}"
SITE="$ECCE_HOME/siteconfig"
REMOTE="$SITE/RemoteServer"
if [ "$USER_MODE" = true ]; then
  REMOTE="${ECCE_REALUSERHOME:-$HOME}/.ECCE/RemoteServer"
fi

#  --refresh: the machine list is not copied any more (issue #192).  A copy
#  left by an earlier version stays in siteconfig/ as the lowest layer;
#  local-machines.orig, if present, holds what the install had before it.
if [ "$REFRESH" = true ]; then
  echo "ecce-remote-setup --refresh: nothing to do. The server's machine list is"
  echo "  not copied into $SITE any more; it is read from the server."
  echo "  A copy from an earlier ecce-remote-setup is still in $SITE;"
  echo "  the original files are in $SITE/local-machines.orig, if that exists."
  exit 0
fi


if [ ! -d "$SITE" ]; then
  echo "ecce-remote-setup: no siteconfig at $SITE" >&2
  echo "  Set ECCE_HOME to the installation you want to configure." >&2
  exit 1
fi

if [ "$USER_MODE" = false ] && [ ! -w "$SITE" ]; then
  echo "ecce-remote-setup: cannot write $SITE" >&2
  echo "  Run this as the owner of the installation (usually root)." >&2
  exit 1
fi

SCHEME=http
if [ "$WANT_TLS" = true ]; then
  SCHEME=https
  if ! command -v openssl >/dev/null 2>&1 || ! command -v curl >/dev/null 2>&1; then
    echo "ecce-remote-setup: --tls needs the openssl and curl commands" >&2
    exit 1
  fi
  NEWPIN=""
  case "$TRUST" in
    pin) NEWPIN="$PINFILE" ;;
    fetch)
      NEWPIN="$(mktemp)" || exit 1
      trap 'rm -f "$NEWPIN"' EXIT
      if ! openssl s_client -connect "$HOST:$DATA_PORT" -servername "$HOST" </dev/null 2>/dev/null |
           openssl x509 >"$NEWPIN" 2>/dev/null || [ ! -s "$NEWPIN" ]; then
        echo "ecce-remote-setup: could not get a certificate from $HOST:$DATA_PORT -- is the server up with TLS on?" >&2
        exit 1
      fi
      echo "Certificate presented by $HOST:$DATA_PORT:"
      openssl x509 -in "$NEWPIN" -noout -subject -enddate -fingerprint -sha256 | sed 's/^/  /'
      echo "Compare the fingerprint with the one the server's administrator gave;"
      echo "this installation will trust only this certificate."
      ;;
  esac
  if [ -n "$NEWPIN" ] && ! openssl x509 -in "$NEWPIN" -noout 2>/dev/null; then
    echo "ecce-remote-setup: $NEWPIN is not a PEM certificate" >&2
    exit 1
  fi
fi

#  A quick look before writing anything.  Getting the host wrong is the
#  likeliest mistake and the symptom is a login box that never accepts
#  anything, which does not point at the cause.  With TLS a refused
#  certificate is an error, not a warning: nothing is written.
URL="$SCHEME://$HOST:$DATA_PORT/Ecce"
echo "Central server: $URL"
if command -v curl >/dev/null 2>&1; then
  CURL_TLS=()
  [ "$WANT_TLS" = true ] && [ -n "$NEWPIN" ] && { curl_tls_args "$URL" "$NEWPIN" || exit 1; }
  curl -s -o /dev/null --connect-timeout 5 "${CURL_TLS[@]}" "$SCHEME://$HOST:$DATA_PORT/"
  rc=$?
  if [ $rc -eq 0 ]; then
    echo "  reachable"
  elif [ "$USER_MODE" = true ]; then
    echo "ecce-remote-setup: cannot connect to $HOST:$DATA_PORT (curl exit $rc)." >&2
    exit 1
  elif [ "$WANT_TLS" = true ] && [ $rc -ne 7 ] && [ $rc -ne 28 ]; then
    echo "ecce-remote-setup: TLS to $HOST:$DATA_PORT failed (curl exit $rc):" >&2
    if [ $rc -eq 90 ]; then
      echo "  the server's certificate is not the one given with --pin/--fetch-pin." >&2
    else
      echo "  the server does not present a certificate this installation can trust." >&2
    fi
    echo "  Nothing was written; ECCE does not fall back to plain HTTP." >&2
    exit 1
  else
    echo "  WARNING: nothing answered on $HOST:$DATA_PORT."
    echo "  Writing the configuration anyway -- the server may not be up yet."
    # Since #138 a data server listens on loopback unless told otherwise,
    # so a server that is up but was never marked central looks exactly
    # like one that is down from here.
    echo "  If it is up, it may be listening on loopback only: on the server,"
    echo "  as the account that runs it, put 'all' in ~/.ECCE/dataserver/listen"
    echo "  (or export ECCE_DATASERVER_LISTEN=all), then"
    echo "  ecce-dataserver-stop && ecce-dataserver-start."
  fi
fi

mkdir -p "$REMOTE" || exit 1
[ "$USER_MODE" = true ] && chmod 700 "$REMOTE"

#  The pinned certificate, or none: a pin left from an earlier run would
#  make a CA-signed server unreachable.
if [ "$WANT_TLS" = true ] && [ -n "$NEWPIN" ]; then
  install -m 644 "$NEWPIN" "$REMOTE/server.pem" || exit 1
  [ "$TRUST" = fetch ] && rm -f "$NEWPIN"
else
  rm -f "$REMOTE/server.pem"
fi

#  DataServers: the same file the local mode uses, with the URLs moved
#  to the central host.  The structure library and basis set library
#  live on that server too, which is the point of running one.
if [ -f "$SITE/DataServers" ]; then
  sed -e "s|https\{0,1\}://[^:/]*:[0-9]*/Ecce|$URL|g" \
      -e "s|<Desc>[^<]*</Desc>|<Desc>ECCE Data Server on $HOST</Desc>|" \
      "$SITE/DataServers" > "$REMOTE/DataServers"
else
  echo "ecce-remote-setup: no $SITE/DataServers to base this on" >&2
  exit 1
fi

#  site_runtime: same again for the help URL, which is served by the
#  same Apache.
if [ -f "$SITE/site_runtime" ]; then
  sed -e "s|https\{0,1\}://[^:/]*:[0-9]*|$SCHEME://$HOST:$DATA_PORT|g" \
      "$SITE/site_runtime" > "$REMOTE/site_runtime"
fi

#  The broker needs no file of its own: under -remote it is on the data
#  server's host (ecce-gateway-start), at ECCE_BROKER_PORT (default 8088),
#  and takes the data server login as its account.

echo
echo "Wrote:"
echo "  $REMOTE/DataServers"
[ -f "$REMOTE/site_runtime" ] && echo "  $REMOTE/site_runtime"
[ -f "$REMOTE/server.pem" ] && echo "  $REMOTE/server.pem  (the only certificate this installation accepts)"
if [ "$USER_MODE" = true ]; then
  echo "This is your own setting; ECCE uses it at its next start."
  exit 0
fi
echo
echo "Users on this machine now run:"
echo
echo "    ecce -remote"
echo
echo "which uses the central data server and broker and starts neither"
echo "locally.  Plain \"ecce\" still runs the per-user local servers."
echo
echo "Each user needs an account on the central server; create them"
echo "there with ecce-dataserver-adduser."
