#!/bin/bash
#
# Point this ECCE installation at a central server.
#
# ECCE was originally deployed with one server for a whole group: a
# shared data server holding everyone's calculations and structure
# library, and a shared message broker.  The old launcher selected that
# with "ecce -remote", which set ECCE_REMOTE_SERVER and made the client
# read siteconfig/RemoteServer/ instead of the local configuration.
#
# The client still supports it in full -- EDSIServerCentral and
# Ecce::ecceAutoAccounts/ecceStoreTrajectories all branch on that
# variable -- but nothing wrote the RemoteServer configuration, so it
# had to be assembled by hand.  This writes it.
#
# Run once per CLIENT installation, as whoever owns $ECCE_HOME
# (normally root).  It does not touch anything on the server.
#
#   ecce-remote-setup <server-host> [data-port]
#
# Afterwards, users run:
#
#   ecce -remote
#
# which skips starting a per-user data server and broker and talks to
# the central ones instead.

set -u

usage() {
  cat <<'USAGE'
Usage: ecce-remote-setup <server-host> [data-port]
       ecce-remote-setup --refresh
       ecce-remote-setup --server [listen]

  --server      on the SERVER, as the account running it: mark its broker
                as a central server's. It then listens on TCP port 8088
                (ECCE_BROKER_PORT) beside the data server, for the accounts
                of this data server (its users file), and its plain quit leaves it
                running; listen (all, loopback or addresses) goes to
                dataserver/listen and applies to the data server and the
                broker alike
  --refresh     fetch the server's machine list again, from the server
                configured by an earlier run (ecce -admin on a -remote client
                does this after a change)
  server-host   host name of the central ECCE server
  data-port     data server port      (default 8096)

Writes $ECCE_HOME/siteconfig/RemoteServer/ and copies the server's registered site machine list (Machines, Queues,
CONFIG.*, *.Q) and, from a server that publishes them, submit.site and
QueueManagers into siteconfig/. Re-run after
the admin changes that list on the server.
Run "ecce -remote" afterwards.
USAGE
}

#  The SERVER's step: run once as the account that runs the central data
#  server and broker.  It marks that account's broker as a server's, so
#  the account's own plain quit never stops it under its clients; only
#  its Quit and Stop Server does.  The mark is also what makes
#  ecce-gateway-start give that broker a TCP listener (logins checked against the data server's users file by server/ecce_users_auth.so, access rules from server/mosquitto.acl).  A mark, not a guess from the listen
#  address, because clients may reach a loopback-only server through ssh
#  tunnels.  The optional listen value is written to dataserver/listen.
if [ "${1:-}" = "--server" ]; then
  STATEDIR="${ECCE_REALUSERHOME:-$HOME}/.ECCE"
  mkdir -p "$STATEDIR" || exit 1
  echo "# ECCE central server: plain quits leave this broker running (ecce-remote-setup --server)" \
    >"$STATEDIR/mosquitto.server" || exit 1
  echo "Marked $STATEDIR/mosquitto.server: this account's broker is a central server's."
  echo "ecce-gateway-start (run by \"ecce\") starts it on TCP port ${ECCE_BROKER_PORT:-8088}, checking"
  echo "logins against this data server's users file, and restarts a broker that"
  echo "already runs here without that listener. Existing accounts work as they are."
  if [ -n "${2:-}" ]; then
    mkdir -p "$STATEDIR/dataserver" || exit 1
    echo "$2" >"$STATEDIR/dataserver/listen" || exit 1
    echo "Wrote $STATEDIR/dataserver/listen ($2): the data server and broker listen there."
    echo "Restart them for it to take effect:"
    echo "    ecce-dataserver-stop; ecce-gateway-stop"
  fi
  echo "Remove that file to make it a per-user broker again."
  exit 0
fi

#  Site machine list (issue #188).  ecce-site-publish (run by the server's
#  ecce-dataserver-start and ecce-site-admin) publishes the server's
#  siteconfig/{Machines,Queues,submit.site,QueueManagers,CONFIG.*,*.Q} under
#  Ecce/system, which is served without a login -- same tree the basis set
#  library comes from -- so this needs no credentials.  All-or-nothing: a
#  partial copy would leave CONFIG.* files with no matching Machines entry, or
#  vice versa, which is worse than not copying at all.  The client fetches
#  what the MANIFEST lists, so a server too old to list submit.site and
#  QueueManagers leaves the client's own copies in place.  A CONFIG.* or *.Q
#  the previous fetch brought and the server no longer publishes is removed.
fetch_machine_list() {
  local URL="$1" names ok name count old
  MACHINES_MSG=""
  if ! command -v curl >/dev/null 2>&1; then
    echo "WARNING: curl not found -- cannot copy the server's machine list;" >&2
    echo "  register machines by hand, or install curl and re-run this script." >&2
    return 1
  fi
  FETCHDIR=$(mktemp -d) || return 1
  trap 'rm -rf "$FETCHDIR"' EXIT
  if ! curl -sf --connect-timeout 5 "$URL/system/siteconfig/MANIFEST" \
       -o "$FETCHDIR/MANIFEST" 2>/dev/null; then
    echo "WARNING: no machine list published at $URL/system/siteconfig/MANIFEST"
    echo "  (an older server, or the server is not up yet). Machines were NOT"
    echo "  copied -- register them by hand, or re-run ecce-remote-setup once"
    echo "  the server is running 8.17.0 or later."
    return 1
  fi
  names="" ok=true
  while IFS= read -r name || [ -n "$name" ]; do
    [ -n "$name" ] || continue
    case "$name" in
      */*|.*|*[[:space:]]*)
        echo "WARNING: ignoring bad name '$name' in the server's MANIFEST" >&2
        continue ;;
    esac
    if ! curl -sf --connect-timeout 5 \
           "$URL/system/siteconfig/$name" -o "$FETCHDIR/$name" 2>/dev/null; then
      echo "WARNING: could not fetch $name from the server -- machine list not copied." >&2
      ok=false
      break
    fi
    names="$names $name"
  done <"$FETCHDIR/MANIFEST"
  names="${names# }"
  [ "$ok" = true ] && [ -n "$names" ] || return 1
  #  Back up the client's own machine files once, so a re-run keeps the
  #  pristine pre-server-copy original rather than overwriting it again.
  BACKUP="$SITE/local-machines.orig"
  if [ ! -d "$BACKUP" ]; then
    mkdir -p "$BACKUP"
    for f in "$SITE/Machines" "$SITE/Queues" "$SITE/submit.site" \
             "$SITE/QueueManagers" "$SITE"/CONFIG.* "$SITE"/*.Q; do
      [ -f "$f" ] && cp -p "$f" "$BACKUP/"
    done
  fi
  for name in $names; do
    install -m 644 "$FETCHDIR/$name" "$SITE/$name" || return 1
  done
  if [ -f "$REMOTE/MANIFEST" ]; then
    while IFS= read -r old || [ -n "$old" ]; do
      case "$old" in
        */*|.*|*[[:space:]]*) continue ;;
        CONFIG.*|*.Q) ;;
        *) continue ;;
      esac
      case " $names " in *" $old "*) continue ;; esac
      rm -f -- "$SITE/$old"
    done <"$REMOTE/MANIFEST"
  fi
  printf '%s\n' $names >"$REMOTE/MANIFEST"
  count=0
  if [ -f "$SITE/Machines" ]; then
    count=$(grep -cve '^[[:space:]]*#' -e '^[[:space:]]*$' "$SITE/Machines")
  fi
  MACHINES_MSG="Copied the server's machine list: $count machine(s) ($(echo "$names" | tr -s ' ' ','))"
  echo "$MACHINES_MSG"
  return 0
}

if [ $# -lt 1 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  usage
  exit 2
fi

REFRESH=false
[ "$1" = "--refresh" ] && REFRESH=true
HOST="$1"
DATA_PORT="${2:-8096}"

: "${ECCE_HOME:=/opt/ecce}"
SITE="$ECCE_HOME/siteconfig"
REMOTE="$SITE/RemoteServer"

if [ ! -d "$SITE" ]; then
  echo "ecce-remote-setup: no siteconfig at $SITE" >&2
  echo "  Set ECCE_HOME to the installation you want to configure." >&2
  exit 1
fi

if [ ! -w "$SITE" ]; then
  echo "ecce-remote-setup: cannot write $SITE" >&2
  echo "  Run this as the owner of the installation (usually root)." >&2
  exit 1
fi

#  --refresh: the server configured by an earlier run, machine list only.
if [ "$REFRESH" = true ]; then
  URL="$(sed -n 's|.*<Url>[ \t]*\(https\{0,1\}://[^/<]*\).*|\1|p' \
         "$REMOTE/DataServers" 2>/dev/null | head -n1)"
  if [ -z "$URL" ]; then
    echo "ecce-remote-setup: no central server configured ($REMOTE/DataServers);" >&2
    echo "  run ecce-remote-setup <server-host> first." >&2
    exit 1
  fi
  fetch_machine_list "$URL/Ecce" || exit 1
  exit 0
fi

#  A quick look before writing anything.  Getting the host wrong is the
#  likeliest mistake and the symptom is a login box that never accepts
#  anything, which does not point at the cause.
URL="http://$HOST:$DATA_PORT/Ecce"
echo "Central server: $URL"
if command -v curl >/dev/null 2>&1; then
  if curl -s -o /dev/null --connect-timeout 5 "http://$HOST:$DATA_PORT/" ; then
    echo "  reachable"
  else
    echo "  WARNING: nothing answered on $HOST:$DATA_PORT."
    echo "  Writing the configuration anyway -- the server may not be up yet."
    # Since #138 a data server listens on loopback unless told otherwise,
    # so a server that is up but was never marked central looks exactly
    # like one that is down from here.
    echo "  If it is up, it may be listening on loopback only: on the server,"
    echo "  as the account that runs it, put 'all' in ~/.ECCE/dataserver/listen"
    echo "  (or export ECCE_DATASERVER_LISTEN=all), then"
    echo "  ecce-dataserver-stop && ecce-dataserver-start."
  fi
fi

mkdir -p "$REMOTE" || exit 1

#  DataServers: the same file the local mode uses, with the URLs moved
#  to the central host.  The structure library and basis set library
#  live on that server too, which is the point of running one.
if [ -f "$SITE/DataServers" ]; then
  sed -e "s|http://[^:/]*:[0-9]*/Ecce|$URL|g" \
      -e "s|http://[^:/]*:[0-9]*/Ecce/system|$URL/system|g" \
      -e "s|<Desc>[^<]*</Desc>|<Desc>ECCE Data Server on $HOST</Desc>|" \
      "$SITE/DataServers" > "$REMOTE/DataServers"
else
  echo "ecce-remote-setup: no $SITE/DataServers to base this on" >&2
  exit 1
fi

#  site_runtime: same again for the help URL, which is served by the
#  same Apache.
if [ -f "$SITE/site_runtime" ]; then
  sed -e "s|http://[^:/]*:[0-9]*|http://$HOST:$DATA_PORT|g" \
      "$SITE/site_runtime" > "$REMOTE/site_runtime"
fi

#  The broker needs no file of its own: under -remote it is on the data
#  server's host (ecce-gateway-start), at ECCE_BROKER_PORT (default 8088),
#  and takes the data server login as its account.

MACHINES_MSG=""
fetch_machine_list "$URL"

echo
echo "Wrote:"
echo "  $REMOTE/DataServers"
[ -f "$REMOTE/site_runtime" ] && echo "  $REMOTE/site_runtime"
echo
echo "Users on this machine now run:"
echo
echo "    ecce -remote"
echo
echo "which uses the central data server and broker and starts neither"
echo "locally.  Plain \"ecce\" still runs the per-user local servers."
echo
echo "Each user needs an account on the central server; create them"
echo "there with ecce-dataserver-adduser."
