#!/bin/bash
# ecce-dataserver-stop: stop the per-user data server started by
# ecce-dataserver-start.
#
#   ecce-dataserver-stop --if-unused   as a session's Quit and Stop Server
#       runs it: refuse (status 3) while another ECCE session of this
#       account, on any display, or a running job still uses the server.

set -u

ECCE_HOME="${ECCE_HOME:-/opt/ecce}"
ECCE_REALUSERHOME="${ECCE_REALUSERHOME:-$HOME}"
STATEDIR="$ECCE_REALUSERHOME/.ECCE/dataserver"
CONF="$STATEDIR/httpd.conf"
PIDFILE="$STATEDIR/logs/httpd.pid"

if [ "${1:-}" = --if-unused ]; then
  _lib="$(dirname "$0")/ecce-session-lib.sh"
  [ -r "$_lib" ] || _lib="$ECCE_HOME/bin/ecce-session-lib.sh"
  if ! . "$_lib"; then
    echo "ecce-dataserver-stop: cannot read $_lib -- data server left running" >&2
    exit 3
  fi
  others="$(STATEDIR="$ECCE_REALUSERHOME/.ECCE" ecce_others_using_services |
            awk '{ printf "%s%s %s", sep, $2, $1; sep = ", " }')"
  if [ -n "$others" ]; then
    echo "ecce-dataserver-stop: another ECCE session or a job of this user is still running ($others) -- data server left running"
    exit 3
  fi
fi

if [ ! -f "$CONF" ]; then
  echo "ecce-dataserver-stop: data server not running (no config at $CONF)"
  exit 0
fi

PID=""
if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
  PID="$(cat "$PIDFILE")"
else
  # Pidfile missing or stale -- seen live: a long-running instance was
  # still genuinely bound to its port with no pidfile at all, and this
  # script reported "not running" and gave up, leaving no way to stop
  # it short of a manual `kill`. Fall back to finding the actual master
  # process directly by its exact config path (a unique-enough
  # substring of its command line -- deliberately not anchoring on the
  # apache2 binary's own path, since that can be invoked via different
  # prefixes/aliases than what shows up in `ps`) rather than trusting
  # the pidfile alone. -o picks the oldest match, i.e. the prefork
  # master rather than one of its forked workers, which share the
  # exact same command line.
  PID="$(pgrep -f -o -- "-f $CONF -k start" 2>/dev/null)"
fi

if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
  kill -TERM "$PID"
  echo "ecce-dataserver-stop: stopped data server (pid $PID)"
else
  echo "ecce-dataserver-stop: data server not running"
fi
