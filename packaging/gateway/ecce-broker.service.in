# ECCE's shared message broker (deployment mode 3): one mosquitto for
# every ECCE user of this machine, instead of one per user. Enabled by
# `ecce-broker-setup`, which writes the siteconfig/SharedBroker
# declaration this reads its port from; accounts are added with
# `ecce-broker-setup --user NAME`. See GETTING_STARTED.md, "Deployment
# modes". Without that file the service does not start.
#
# Its own instance on the declared port (8088 by default), not Debian's
# mosquitto.service on 1883. No user session starts, reaps or stops this
# broker; only systemctl does.

[Unit]
Description=ECCE shared message broker (mosquitto)
After=network.target
ConditionPathExists=@ECCE_HOME_DIR@/siteconfig/SharedBroker

[Service]
Type=simple
# Its own account, created on demand; its files are in /var/lib/ecce-broker.
DynamicUser=yes
User=ecce-broker
StateDirectory=ecce-broker
Environment=ECCE_HOME=@ECCE_HOME_DIR@
# "+": as root, because the account list is root's
# (siteconfig/SharedBroker.passwd) and the service user cannot read it.
ExecStartPre=+@ECCE_HOME_DIR@/bin/ecce-broker-run --sync %S/ecce-broker
ExecStart=@ECCE_HOME_DIR@/bin/ecce-broker-run --shared %S/ecce-broker
# `systemctl reload ecce-broker` after ecce-broker-setup --user.
ExecReload=+@ECCE_HOME_DIR@/bin/ecce-broker-run --reload %S/ecce-broker $MAINPID
Restart=on-failure
RestartSec=5
# It needs the network and its files, nothing else.
CapabilityBoundingSet=
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
UMask=0077

[Install]
WantedBy=multi-user.target
