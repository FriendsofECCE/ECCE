#!/bin/bash
# ecce-gateway-reap: shut down JMSDispatcher relays that no longer belong
# to a live ECCE session, and, on an explicit stop, the ActiveMQ broker.
#
# Issue #102. The gateway used to start the broker and the dispatcher as
# detached background processes and tear them down only from
# ecce-gateway-stop -- i.e. only on a *clean* exit. When the gateway
# aborted instead (SIGABRT from the JMSMessage.C:497 assertion, in the
# reported case) the two Java processes were simply left behind, and
# nothing on the next start noticed: ecce-gateway-start early-exits when
# it sees the broker port already listening, so the next session silently
# adopted the orphan rather than cleaning it up. On beryllium that
# accumulated ~3.2 GB of resident memory over ten days in which nobody
# had an ECCE session open.
#
# Two call sites, matching the two halves of the fix:
#
#   ecce-gateway-reap              full sweep. Called at the top of
#                                  ecce-gateway-start, so a session that
#                                  died badly is cleaned up before the
#                                  next one decides what to adopt.
#
#   ecce-gateway-reap --if-idle    called from every messaging app
#                                  wrapper's EXIT trap. Does nothing
#                                  while any ECCE app is still running on
#                                  this display; when the last one exits
#                                  -- however it exits, including on an
#                                  abort, because the trap is in the
#                                  wrapper shell and not in the app --
#                                  it stops that display's relay.
#
#   ecce-gateway-reap --stop       from ecce-gateway-stop ("Quit and
#                                  Stop Server"). As the full sweep, and
#                                  also stops the broker once no display
#                                  has a live relay left.
#
# Only --stop ever stops the broker. A session ending, cleanly or not,
# takes down its own relay and leaves the broker running, exactly as the
# data server is left running: a broker can be shared by other machines'
# sessions (a central server, #185), and nothing here can tell reliably
# whether it is. An idle broker left up is the accepted cost, as it is
# for the data server; a dead session's relay is still reaped.
#
# Liveness is decided by looking for running ECCE binaries, not by
# reference counting, deliberately: a pid-file scheme only knows about
# processes started after it shipped, and would have to be correct on
# every abnormal-exit path to avoid the very leak it is meant to prevent.
# Asking the process table cannot go stale.

set -u

ECCE_HOME="${ECCE_HOME:-/opt/ecce}"
ECCE_REALUSERHOME="${ECCE_REALUSERHOME:-$HOME}"
STATEDIR="$ECCE_REALUSERHOME/.ECCE"
HOST="${ECCE_HOST:-${HOST:-$(hostname)}}"
BROKER_PORT="${ECCE_BROKER_PORT:-8088}"
ACTIVEMQ_BASE="$STATEDIR/activemq"
UID_="$(id -u)"

IF_IDLE=0
EXPLICIT_STOP=0
case "${1:-}" in
  --if-idle) IF_IDLE=1 ;;
  --stop)    EXPLICIT_STOP=1 ;;   # ecce-gateway-stop: the user asked
esac

# An escape hatch for anything that manages the services itself.
#
# The reaper's rule -- only the last app out turns the lights off -- is
# right for a user's session and wrong for a harness that runs apps one
# at a time, where EVERY app is the last one out and the broker is torn
# down between them.  That is what the GUI smoke suite does, and what
# made it report a dozen apps as unable to open a window.
#
# Anything setting this takes on stopping the services itself.
if [ -n "${ECCE_NO_REAP:-}" ]; then
  exit 0
fi

[ -d "$STATEDIR" ] || exit 0

say() { [ -n "${ECCE_REAP_QUIET:-}" ] || echo "ecce-gateway-reap: $*"; }

# The data server credential AuthCache shares between this session's
# processes (AuthCache::sessionFile). It holds a password, so it must go
# when the session's services do -- same lifetime as the port file, same
# per-display key, and sanitised the same way the C++ side sanitises it.
authfile() {
  printf '%s/authcache_%s' "$STATEDIR" \
    "$(printf '%s_%s' "$HOST" "$1" | tr -c 'A-Za-z0-9._-' '_')"
}

BINDIR="$(readlink -f "$ECCE_HOME/bin" 2>/dev/null || echo "$ECCE_HOME/bin")"

# Is this resolved executable one of $ECCE_HOME/bin's? Also true when
# bin/<name> is a symlink to it, as in an overlay pointing into a build
# tree -- the same rule the gateway applies when deciding its session is
# over, so the two agree.
is_ecce_exe() {
  local exe="${1% (deleted)}" name
  case "$exe" in "$BINDIR"/*) return 0 ;; esac
  name="${exe##*/}"
  [ -e "$ECCE_HOME/bin/$name" ] || return 1
  [ "$(readlink -f "$ECCE_HOME/bin/$name" 2>/dev/null)" = "$exe" ]
}

# Pids of ECCE app binaries running for a given DISPLAY, for this user.
#
# Identified by /proc/<pid>/exe, NOT by matching the command line. Apps
# launched from the gateway are spawned as `cd $ECCE_HOME/bin && ./builder`
# (WxJMSMessageDispatch.C), so their command line is the bare "./builder"
# -- a path match would miss every gateway-launched app and conclude the
# session was idle while the user had windows open. /proc/<pid>/exe is the
# resolved binary either way.
#
# DISPLAY is not on the command line either, so it is read back out of the
# process's own environment; both are readable without privilege for one's
# own processes.
apps_for_display() {
  local want="$1" pid exe disp
  for pid in $(ls /proc 2>/dev/null | grep -E '^[0-9]+$'); do
    [ -O "/proc/$pid" ] || continue
    exe="$(readlink "/proc/$pid/exe" 2>/dev/null)" || continue
    is_ecce_exe "$exe" || continue
    [ -r "/proc/$pid/environ" ] || continue
    disp="$(tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null |
            sed -n 's/^DISPLAY=//p' | head -n1)"
    if [ "$disp" = "$want" ]; then echo "$pid"; fi
  done
}

# Wait for a pid to actually go away, escalating if it will not.
reap_pid() {
  local pid="$1" i=0
  kill "$pid" 2>/dev/null
  while [ $i -lt 40 ] && kill -0 "$pid" 2>/dev/null; do
    i=$((i + 1)); sleep 0.25
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill -9 "$pid" 2>/dev/null
  fi
}

# --- 1. JMSDispatcher relays, one per display --------------------------
dispatchers_left=0
for pidfile in "$STATEDIR"/jmsdispatcher_*.pid; do
  [ -e "$pidfile" ] || continue

  disp="${pidfile##*/jmsdispatcher_}"
  disp="${disp%.pid}"
  pid="$(cat "$pidfile" 2>/dev/null)"

  if [ -z "${pid:-}" ] || ! kill -0 "$pid" 2>/dev/null; then
    # Dispatcher already gone; only the bookkeeping is stale. Drop the
    # port file too, or JMSMessage.C reads a dead port out of it.
    rm -f "$pidfile" "$STATEDIR/${HOST}_${disp}" "$(authfile "$disp")" "$(authfile "$disp")".tmp.*
    continue
  fi

  if [ -n "$(apps_for_display "$disp")" ]; then
    # Still in use. In --if-idle mode that includes the display we were
    # called for, which is the whole point: the wrapper trap fires when
    # each app exits, and only the last one finds nothing left.
    dispatchers_left=$((dispatchers_left + 1))
    continue
  fi

  say "no ECCE app left on $disp -- stopping JMSDispatcher (pid $pid)"
  reap_pid "$pid"
  rm -f "$pidfile" "$STATEDIR/${HOST}_${disp}" "$(authfile "$disp")" "$(authfile "$disp")".tmp.*
done

# Pidfile written before the gateway was made per-display; it cannot be
# attributed to a session, so it is only ever noise.
rm -f "$STATEDIR/jmsdispatcher.pid"

# --- 1b. Session credential files with no session left ------------------
# The loop above removes a display's credential file along with its
# dispatcher, which covers the ordinary per-user session. It does not
# cover a session that never HAD a local dispatcher: "ecce -remote" (the
# central-server client, whose credential is the central server's
# password) and ECCE_NO_MESSAGING both skip ecce-gateway-start, so there
# is no pidfile for the loop to find, and the file would outlive the
# session indefinitely (#120). So also sweep by the thing that actually
# defines a session here -- a live ECCE app on that display -- and keep
# only the files that one of them could be using. Limited to this HOST's
# files, since a home directory shared over NFS holds other machines'.
live_auth=""
for pid in $(ls /proc 2>/dev/null | grep -E '^[0-9]+$'); do
  [ -O "/proc/$pid" ] || continue
  exe="$(readlink "/proc/$pid/exe" 2>/dev/null)" || continue
  is_ecce_exe "$exe" || continue
  [ -r "/proc/$pid/environ" ] || continue
  d="$(tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null |
       sed -n 's/^DISPLAY=//p' | head -n1)"
  [ -n "$d" ] && live_auth="$live_auth $(authfile "$d")"
done
auth_prefix="$(authfile "")"      # .../authcache_<host>_
for f in "$auth_prefix"*; do
  [ -e "$f" ] || continue
  base="${f%.tmp.*}"              # a stranded writer's temporary, too
  case " $live_auth " in *" $base "*) continue ;; esac
  [ "$f" = "$base" ] &&
    say "no ECCE app left for $(basename "$base") -- removing session credential"
  rm -f "$f"
done

# --- 2. The broker, shared by every display ----------------------------
# Only on an explicit stop (see the header), and only once no display has
# a live dispatcher, so no session of this account is still using it.
if [ "$EXPLICIT_STOP" = 0 ] || [ "$dispatchers_left" -gt 0 ]; then
  exit 0
fi

brokerpid=""
if [ -f "$STATEDIR/activemq.pid" ]; then
  brokerpid="$(cat "$STATEDIR/activemq.pid" 2>/dev/null)"
  if [ -n "${brokerpid:-}" ] && ! kill -0 "$brokerpid" 2>/dev/null; then
    brokerpid=""
    rm -f "$STATEDIR/activemq.pid"
  fi
fi

if [ -z "${brokerpid:-}" ]; then
  # No usable pidfile: either an orphan predating this script, or one
  # whose pidfile was removed. Match on -Dactivemq.base, which names this
  # user's own state directory -- precise enough not to touch another
  # user's broker, or a second instance of our own on another base.
  brokerpid="$(pgrep -u "$UID_" -f "activemq.base=$ACTIVEMQ_BASE" 2>/dev/null | head -n1)"
fi

if [ -n "${brokerpid:-}" ]; then
  say "stop requested, no ECCE session left -- stopping ActiveMQ broker (pid $brokerpid)"
  reap_pid "$brokerpid"
  rm -f "$STATEDIR/activemq.pid"

  # ecce-gateway-start decides whether to start a broker by probing the
  # port, so do not return until it has actually been released, or a
  # restart immediately after a reap adopts a socket that is going away.
  i=0
  while [ $i -lt 40 ]; do
    (exec 3<>"/dev/tcp/localhost/$BROKER_PORT") >/dev/null 2>&1 || break
    i=$((i + 1)); sleep 0.25
  done
fi

exit 0
