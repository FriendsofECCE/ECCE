#!/bin/bash
# ecce-gateway-reap: clean up after ECCE sessions that are over, and stop
# this user's own broker once none is left.
#
#   ecce-gateway-reap              full sweep, from ecce-gateway-start: a
#                                  session that died badly (#102) is
#                                  cleaned up before the next one decides
#                                  what to adopt. Never stops a broker.
#   ecce-gateway-reap --if-idle    from every messaging wrapper's EXIT
#                                  trap, however the app ended: stops a
#                                  PER-USER broker once no ECCE app of this
#                                  user is left anywhere.
#   ecce-gateway-reap --stop       from ecce-gateway-stop (Quit and Stop
#                                  Server): as the sweep, and stops this
#                                  account's broker, a server's included.
#
# Which broker a plain quit may stop is decided only by declarations,
# never by guessing who is connected (a central server's clients may
# come in over loopback ssh tunnels):
#   - siteconfig/SharedBroker (mode 3): the site's service. Nothing here
#     ever stops it, not even --stop.
#   - $STATEDIR/mosquitto.server, written by `ecce-remote-setup --server`
#     (mode 2): a server's. Only --stop stops it.
#   - anything else this account started (mode 1): stopped with the
#     user's last session, so idle per-user brokers do not pile up on a
#     machine with many users.
#
# Liveness is read from the programs' session leases (a lock the kernel
# drops when a program ends, SessionLease.H) and, on Linux, the process
# table (/proc/<pid>/exe) -- not from reference counts, which would have
# to be right on every abnormal exit to avoid the very leak they are meant
# to prevent.

set -u

ECCE_HOME="${ECCE_HOME:-/opt/ecce}"
ECCE_REALUSERHOME="${ECCE_REALUSERHOME:-$HOME}"
STATEDIR="$ECCE_REALUSERHOME/.ECCE"
UID_="$(id -u)"
_lib="$(dirname "$(readlink -f "$0")")/ecce-session-lib.sh"
[ -r "$_lib" ] || _lib="$ECCE_HOME/bin/ecce-session-lib.sh"
. "$_lib" || { echo "ecce-gateway-reap: cannot read $_lib" >&2; exit 1; }

IF_IDLE=0
EXPLICIT_STOP=0
case "${1:-}" in
  --if-idle) IF_IDLE=1 ;;
  --stop)    EXPLICIT_STOP=1 ;;   # ecce-gateway-stop: the user asked
esac

# An escape hatch for anything that manages the services itself.
#
# The reaper's rule -- only the last app out turns the lights off -- is
# right for a user's session and wrong for a harness that runs apps one
# at a time, where EVERY app is the last one out and the broker is torn
# down between them.  That is what the GUI smoke suite does, and what
# made it report a dozen apps as unable to open a window.
#
# Anything setting this takes on stopping the services itself.
if [ -n "${ECCE_NO_REAP:-}" ]; then
  exit 0
fi

[ -d "$STATEDIR" ] || exit 0

say() { [ -n "${ECCE_REAP_QUIET:-}" ] || echo "ecce-gateway-reap: $*"; }

# Serialised with ecce-gateway-start, which holds this lock across its own
# decisions and says so when it calls us.
if [ -z "${ECCE_GATEWAY_LOCKED:-}" ]; then
  exec 9>>"$STATEDIR/.gateway.lock"
  flock -w 90 9 || say "could not lock $STATEDIR/.gateway.lock; continuing"
fi


# In /proc, ECCE processes are identified by their exe (ecce_is_ecce_exe in
# ecce-session-lib.sh), NOT by matching the command line. Apps launched
# from the gateway are spawned as
# `cd $ECCE_HOME/bin && ./builder` (WxJMSMessageDispatch.C), so their
# command line is the bare "./builder" -- a path match would miss every
# gateway-launched app and conclude the session was idle while the user
# had windows open. The session id and ECCE_REALUSERHOME are read back out
# of the process's own environment; both are readable without privilege
# for one's own processes.

# Is any ECCE app of this state directory running, in any session? Keyed
# by ECCE_REALUSERHOME, which every wrapper exports, so a second instance
# of the same account (another ECCE_REALUSERHOME) does not count.
apps_for_state() {
  local pid exe home
  # Leases live in this state directory, so they are its programs.
  if ecce_use_lease; then
    ecce_session_leases | head -n1
  fi
  ecce_use_proc || return 0
  for pid in $(ls /proc 2>/dev/null | grep -E '^[0-9]+$'); do
    [ -O "/proc/$pid" ] || continue
    exe="$(readlink "/proc/$pid/exe" 2>/dev/null)" || continue
    ecce_is_ecce_exe "$exe" || continue
    [ -r "/proc/$pid/environ" ] || continue
    home="$(tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null |
            sed -n 's/^ECCE_REALUSERHOME=//p' | head -n1)"
    if [ "${home:-$HOME}" = "$ECCE_REALUSERHOME" ]; then echo "$pid"; fi
  done
}

# Wait for a pid to actually go away, escalating if it will not.
reap_pid() {
  local pid="$1" i=0
  kill "$pid" 2>/dev/null
  while [ $i -lt 40 ] && kill -0 "$pid" 2>/dev/null; do
    i=$((i + 1)); sleep 0.25
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill -9 "$pid" 2>/dev/null
  fi
}

# --- 1. Session credential files with no session left -------------------
# The data server credential outlives its session unless swept (#120), and
# "ecce -remote" and ECCE_NO_MESSAGING never start a local broker to tie
# it to. A session is a live ECCE app with its id (eccejobstore included,
# so a running job keeps its session's broker file), so keep only the
# files one of those could be using. Limited to this HOST's files, since
# a home directory shared over NFS holds other machines'. Files of the
# DISPLAY-keyed 9.0.0-alpha scheme match no live id and are swept too.
live_auth="" live_broker=""
while read -r pid name sid; do
  ecce_session_id_valid "$sid" || continue
  live_auth="$live_auth $(ecce_auth_file "$sid")"
  live_broker="$live_broker $(ecce_broker_file "$sid")"
done < <(ecce_session_procs)
auth_prefix="$STATEDIR/authcache_$(ecce_session_prefix)"      # .../authcache_<host>_
for f in "$auth_prefix"*; do
  [ -e "$f" ] || continue
  base="${f%.tmp.*}"              # a stranded writer's temporary, too
  case " $live_auth " in *" $base "*) continue ;; esac
  [ "$f" = "$base" ] &&
    say "no ECCE app left for $(basename "$base") -- removing session credential"
  rm -f "$f"
done

# The broker files of sessions with no app left. One written a minute ago
# belongs to a session whose first app is about to start (the start script
# writes it, then releases the lock, then the wrapper launches the app).
broker_prefix="$STATEDIR/broker_$(ecce_session_prefix)"
for f in "$broker_prefix"*; do
  [ -e "$f" ] || continue
  case " $live_broker " in *" $f "*) continue ;; esac
  [ -n "$(find "$f" -mmin +1 2>/dev/null)" ] && rm -f "$f"
done

# --- 2. The broker, shared by every session ----------------------------
if [ -e "$ECCE_HOME/siteconfig/SharedBroker" ]; then
  [ "$EXPLICIT_STOP" = 1 ] &&
    say "the broker is the site's shared service (siteconfig/SharedBroker) -- left running"
  exit 0
fi
# The sweep never stops one.
if [ "$IF_IDLE$EXPLICIT_STOP" = 00 ]; then
  exit 0
fi
# A plain quit waits for the last app; Quit and Stop Server is the user's
# say-so and runs while the Organizer that asked is still closing.
if [ "$IF_IDLE" = 1 ]; then
  [ -z "$(apps_for_state)" ] || exit 0
  [ -e "$STATEDIR/mosquitto.server" ] && exit 0
fi

brokerpid=""
if [ -f "$STATEDIR/mosquitto.pid" ]; then
  brokerpid="$(cat "$STATEDIR/mosquitto.pid" 2>/dev/null)"
  if [ -z "${brokerpid:-}" ] ||
     [ "$(cat "/proc/$brokerpid/comm" 2>/dev/null)" != mosquitto ]; then
    brokerpid=""
    rm -f "$STATEDIR/mosquitto.pid"
  fi
fi

if [ -z "${brokerpid:-}" ]; then
  # No usable pidfile: match on the config path, which names this user's
  # own state directory -- precise enough not to touch another user's
  # broker, or a second instance of our own on another state directory.
  brokerpid="$(pgrep -u "$UID_" -f "mosquitto -c $STATEDIR/mosquitto.conf( |$)" 2>/dev/null | head -n1)"
fi

if [ -n "${brokerpid:-}" ]; then
  if [ "$EXPLICIT_STOP" = 1 ]; then
    say "stop requested, no ECCE session left -- stopping mosquitto broker (pid $brokerpid)"
  else
    say "last ECCE session of this user ended -- stopping its mosquitto broker (pid $brokerpid)"
  fi
  reap_pid "$brokerpid"
  # ecce-gateway-start decides whether a broker is running by pid, but
  # leave no stale socket or broker files for a process that starts later.
  rm -f "$STATEDIR/mosquitto.pid" "$STATEDIR/mosquitto.sock" "$STATEDIR"/broker_*
fi

exit 0
