#!/bin/bash
# ecce-broker-run: the site's shared message broker (deployment mode 3), a
# mosquitto of its own, as ecce-broker.service runs it.
#
#   ecce-broker-run --shared <base-dir>
#       Runs in the FOREGROUND. Port and bind address come from
#       siteconfig/SharedBroker, so the declaration the clients read is the
#       one the broker obeys. State, the account list and the generated
#       configuration live under <base-dir>.
#   ecce-broker-run --sync <base-dir>
#       Copies the account list the administrator maintains
#       (siteconfig/SharedBroker.passwd, ecce-broker-setup --user) into
#       <base-dir>, owned like it. Run as root by the unit: the service
#       user cannot read the master.
#   ecce-broker-run --reload <base-dir> <pid>
#       --sync, then SIGHUP to the broker, which rereads the list.
#
# Every client authenticates with its data server login and may touch only
# ecce/<its name>/ (server/mosquitto.acl). The system's own mosquitto
# service (Debian runs one on 1883) is neither used nor affected.

set -u

ECCE_HOME="${ECCE_HOME:-/opt/ecce}"
MASTER="$ECCE_HOME/siteconfig/SharedBroker.passwd"
ACL="$ECCE_HOME/server/mosquitto.acl"

die() { echo "ecce-broker-run: $*" >&2; exit 1; }

sync_accounts() {
  local base="$1"
  mkdir -p "$base" || die "cannot create $base"
  if [ -r "$MASTER" ]; then
    # 0600 from the start: it holds password hashes.
    ( umask 077; cp "$MASTER" "$base/passwd.new" ) || die "cannot copy $MASTER"
    [ "$(id -u)" = 0 ] && chown --reference="$base" "$base/passwd.new"
    mv -f "$base/passwd.new" "$base/passwd"
  fi
  # mosquitto does not start on a missing file; no accounts is a valid state.
  [ -e "$base/passwd" ] || ( umask 077; : >"$base/passwd" )
  [ "$(id -u)" = 0 ] && chown --reference="$base" "$base/passwd"
  return 0
}

case "${1:-}" in
  --sync)
    [ $# -eq 2 ] || die "usage: ecce-broker-run --sync <base-dir>"
    sync_accounts "$2"; exit 0 ;;
  --reload)
    [ $# -eq 3 ] || die "usage: ecce-broker-run --reload <base-dir> <pid>"
    sync_accounts "$2"; kill -HUP "$3"; exit $? ;;
  --shared) [ $# -eq 2 ] || die "usage: ecce-broker-run --shared <base-dir>" ;;
  *) die "usage: ecce-broker-run --shared <base-dir>" ;;
esac
BASE="$2"

decl="$("$ECCE_HOME/bin/ecce-broker-setup" --show)" ||
  die "no shared broker declared in $ECCE_HOME/siteconfig/SharedBroker (run ecce-broker-setup)"
set -- $decl
PORT="$2"

command -v mosquitto >/dev/null 2>&1 || die "mosquitto is not installed (apt install mosquitto)"
[ -f "$ACL" ] || die "no access rules at $ACL (ecce-server not installed)"

sync_accounts "$BASE"

# A broker declared by a loopback name serves this machine only; any other
# name is for other machines too.
binds=""
case "$1" in
  localhost|127.*|::1)
    binds="127.0.0.1"
    if [ -r /proc/net/if_inet6 ] &&
       grep -q '^00000000000000000000000000000001 ' /proc/net/if_inet6; then
      binds="$binds ::1"
    fi ;;
  *) binds="*" ;;
esac

conf="$BASE/mosquitto.conf"
{
  echo "per_listener_settings true"
  echo "persistence false"
  echo "log_dest stderr"
  for b in $binds; do
    if [ "$b" = "*" ]; then echo "listener $PORT"; else echo "listener $PORT $b"; fi
    echo "allow_anonymous false"
    echo "password_file $BASE/passwd"
    echo "acl_file $ACL"
  done
} >"$conf" || die "cannot write $conf"

# exec, so the caller's $! and systemd's MainPID are the broker.
exec mosquitto -c "$conf"
