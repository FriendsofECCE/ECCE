#!/bin/bash
# ecce-gateway-stop: stop the per-user JMSDispatcher relay and the
# ActiveMQ broker started by ecce-gateway-start.

set -u

ECCE_REALUSERHOME="${ECCE_REALUSERHOME:-$HOME}"
STATEDIR="$ECCE_REALUSERHOME/.ECCE"
DISPLAY="${DISPLAY:-:0}"
# Per-display, matching ecce-gateway-start; see the note there.
PIDFILE="$STATEDIR/jmsdispatcher_${DISPLAY}.pid"
HOST="${ECCE_HOST:-$(hostname)}"
PORTFILE="$STATEDIR/${HOST}_${DISPLAY}"

if [ -f "$PIDFILE" ]; then
  pid="$(cat "$PIDFILE")"
  if kill -0 "$pid" 2>/dev/null; then
    kill "$pid"
    echo "ecce-gateway-stop: stopped JMSDispatcher (pid $pid)"
  else
    echo "ecce-gateway-stop: JMSDispatcher not running"
  fi
  rm -f "$PIDFILE" "$PORTFILE"
else
  echo "ecce-gateway-stop: JMSDispatcher not running for $DISPLAY (no pidfile)"
fi

# Pidfiles written before the per-display fix have no display in the name;
# clean one up so it cannot be mistaken for this session's.
rm -f "$STATEDIR/jmsdispatcher.pid"

# The broker is shared by every display, so stopping it here would cut
# messaging out from under a session running on another one. Hand that
# decision to ecce-gateway-reap, which stops it only once no display has
# a live dispatcher left -- which, having just stopped ours, is the
# common case for a single-display machine.
#
# ecce-gateway-start now records the broker's pid in $STATEDIR/activemq.pid;
# before that it had to be found by matching "org.apache.activemq" in the
# process table, which could not tell our broker apart from another
# user's, or from a second instance of our own.
ECCE_HOME="${ECCE_HOME:-/opt/ecce}"
if [ -x "$ECCE_HOME/bin/ecce-gateway-reap" ]; then
  "$ECCE_HOME/bin/ecce-gateway-reap" || true
else
  echo "ecce-gateway-stop: ecce-gateway-reap not installed -- leaving the broker running" >&2
fi
