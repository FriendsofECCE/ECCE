#!/bin/bash
# ecce-gateway-stop: stop this display's gateway and, once no session of
# this account is left, its mosquitto broker (never the site's shared one).

set -u

ECCE_REALUSERHOME="${ECCE_REALUSERHOME:-$HOME}"
STATEDIR="$ECCE_REALUSERHOME/.ECCE"
DISPLAY="${DISPLAY:-:0}"
# Prefer an inherited HOST over hostname(1): that is what the wrappers
# export and what the C++ side reads back (AuthCache::sessionFile), so deriving it differently here can name a
# file that does not exist. Same resolution order as ecce-gateway-reap.
HOST="${ECCE_HOST:-${HOST:-$(hostname)}}"
# The data server credential this session's processes share through
# AuthCache::sessionFile(). It holds a password, so its lifetime is the
# session's: same per-display key as the session's other state, sanitised the same
# way the C++ side sanitises it.
AUTHFILE="$STATEDIR/authcache_$(printf '%s_%s' "$HOST" "$DISPLAY" |
                                tr -c 'A-Za-z0-9._-' '_')"

# Held until this script exits, and taken by ecce-gateway-reap in the
# EXIT trap of the wrapper that ran the gateway: so `ecce` returns only
# after everything below has been done and said, not with its prompt
# printed ahead of this script's output.
if [ -d "$STATEDIR" ]; then
  exec 9>>"$STATEDIR/.gateway.lock"
  flock -w 90 9 || echo "ecce-gateway-stop: could not lock $STATEDIR/.gateway.lock; continuing" >&2
fi

# Stop the gateway APPLICATION first, not just the services it owns.
#
# Reported from a live session 2026-09-22: the Organizer's new "Quit and
# Stop Server" ran this and ecce-dataserver-stop, and left the Gateway
# window sitting there -- now with no broker and no data server,
# i.e. a visible window that cannot do anything, which is worse than not
# having stopped the services at all.
#
# Identified by /proc/<pid>/exe rather than by command line, for the same
# reason ecce-gateway-reap does it: the gateway is spawned as a relative
# "./gateway" from $ECCE_HOME/bin, so a path match on the command line
# finds nothing. Only this display's gateway is touched.
ECCE_HOME="${ECCE_HOME:-/opt/ecce}"
_bindir="$(readlink -f "$ECCE_HOME/bin" 2>/dev/null || echo "$ECCE_HOME/bin")"
for _pid in $(ls /proc 2>/dev/null | grep -E '^[0-9]+$'); do
  [ -O "/proc/$_pid" ] || continue
  _exe="$(readlink "/proc/$_pid/exe" 2>/dev/null)" || continue
  _exe="${_exe% (deleted)}"
  # bin/gateway may be a symlink into a build tree (an overlay).
  [ "$_exe" = "$_bindir/gateway" ] ||
    [ "$_exe" = "$(readlink -f "$ECCE_HOME/bin/gateway" 2>/dev/null)" ] || continue
  [ -r "/proc/$_pid/environ" ] || continue
  _disp="$(tr '\0' '\n' <"/proc/$_pid/environ" 2>/dev/null |
           sed -n 's/^DISPLAY=//p' | head -n1)"
  [ "$_disp" = "$DISPLAY" ] || continue
  echo "ecce-gateway-stop: stopping gateway (pid $_pid)"
  kill "$_pid" 2>/dev/null
done

# Unconditionally, not only when there was a pidfile to stop: the session
# is over either way and this file holds a password.
rm -f "$AUTHFILE" "$AUTHFILE".tmp.*

# The explicit "Quit and Stop Server": this account's broker goes too once
# no ECCE app is left -- unless it is the site's shared service
# (siteconfig/SharedBroker), which no user stops. The reaper decides.
ECCE_HOME="${ECCE_HOME:-/opt/ecce}"
if [ -x "$ECCE_HOME/bin/ecce-gateway-reap" ]; then
  ECCE_GATEWAY_LOCKED=1 "$ECCE_HOME/bin/ecce-gateway-reap" --stop || true
else
  echo "ecce-gateway-stop: ecce-gateway-reap not installed -- leaving the broker running" >&2
fi
