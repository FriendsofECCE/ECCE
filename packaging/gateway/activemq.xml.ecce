<!--
    ECCE's own ActiveMQ broker config, for use with the Debian-packaged
    activemq/libactivemq-java (5.17.6 as of this writing), not the
    old vendored 5.1.0 distribution this used to ship. Installed into each
    user's own STATEDIR/activemq/conf/activemq.xml by ecce-gateway-start,
    not the package-owned tree, since ACTIVEMQ_BASE is per-user; see
    that script for the full rationale.

    Note for editors: this file is parsed by a strict XML parser that
    rejects a literal double-hyphen anywhere inside a comment (this one
    included), so avoid that in edits here.

    Based on the Debian package's own default
    (/etc/activemq/instances-available/main/activemq.xml) rather than the
    old vendored config, since the persistence adapter changed from the
    5.1.0-era amqPersistenceAdapter element (removed in later ActiveMQ
    releases) to kahaDB. Port and the destinationPolicy/systemUsage tuning
    are carried over from the old vendored config unchanged; siteconfig
    jndi.properties' java.naming.provider.url and ecce-gateway-start's
    own BROKER_PORT both hardcode port 8088, so if you ever change the
    port here, update those too.
-->
<beans
  xmlns="http://www.springframework.org/schema/beans"
  xmlns:amq="http://activemq.apache.org/schema/core"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-2.0.xsd
  http://activemq.apache.org/schema/core http://activemq.apache.org/schema/core/activemq-core.xsd">

    <!-- Allows us to use system properties as variables in this configuration file -->
    <bean class="org.springframework.beans.factory.config.PropertyPlaceholderConfigurer"/>

    <broker xmlns="http://activemq.apache.org/schema/core"
            useJmx="false"
            brokerName="localhost"
            dataDirectory="${activemq.base}/data">

        <!-- Destination specific policies using destination names or wildcards -->
        <destinationPolicy>
            <policyMap>
                <policyEntries>
                    <policyEntry queue=">" memoryLimit="5mb"/>
                    <policyEntry topic=">" memoryLimit="5mb">
                        <dispatchPolicy>
                            <strictOrderDispatchPolicy/>
                        </dispatchPolicy>
                        <subscriptionRecoveryPolicy>
                            <lastImageSubscriptionRecoveryPolicy/>
                        </subscriptionRecoveryPolicy>
                    </policyEntry>
                </policyEntries>
            </policyMap>
        </destinationPolicy>

        <persistenceAdapter>
            <kahaDB directory="${activemq.base}/data/kahadb"/>
        </persistenceAdapter>

        <!-- The maximum about of space the broker will use before slowing down producers -->
        <systemUsage>
            <systemUsage>
                <memoryUsage>
                    <memoryUsage limit="20 mb"/>
                </memoryUsage>
                <storeUsage>
                    <storeUsage limit="1 gb" name="foo"/>
                </storeUsage>
                <tempUsage>
                    <tempUsage limit="100 mb"/>
                </tempUsage>
            </systemUsage>
        </systemUsage>

        <!-- The transport connectors ActiveMQ will listen to -->
        <transportConnectors>
            <transportConnector name="openwire" uri="tcp://localhost:8088"/>
        </transportConnectors>

    </broker>
</beans>
