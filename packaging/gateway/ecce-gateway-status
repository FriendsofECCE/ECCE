#!/bin/bash
# ecce-gateway-status: report which message broker this account's ECCE
# processes use, and whether it is running.

set -u

ECCE_REALUSERHOME="${ECCE_REALUSERHOME:-$HOME}"
STATEDIR="$ECCE_REALUSERHOME/.ECCE"

ECCE_HOME="${ECCE_HOME:-/opt/ecce}"
shared=""
[ -x "$ECCE_HOME/bin/ecce-broker-setup" ] &&
  shared="$("$ECCE_HOME/bin/ecce-broker-setup" --show 2>/dev/null)"

# The broker file is what the processes actually use: this session's, or
# failing that any one of this account's.
# Beside the script, else beside its symlink target (plain readlink: no -f
# on macOS 10.15), else in $ECCE_HOME/bin.
_lib="$(dirname "$0")/ecce-session-lib.sh"
if [ ! -r "$_lib" ] && _t=$(readlink "$0" 2>/dev/null); then
  case $_t in /*) ;; *) _t="$(dirname "$0")/$_t" ;; esac
  _lib="$(dirname "$_t")/ecce-session-lib.sh"
fi
[ -r "$_lib" ] || _lib="$ECCE_HOME/bin/ecce-session-lib.sh"
. "$_lib" || { echo "ecce-gateway-status: cannot read $_lib" >&2; exit 1; }
bfile="$(ecce_broker_file)" || bfile=""
[ -n "$bfile" ] && [ -e "$bfile" ] ||
  bfile="$(ls "$STATEDIR"/broker_* 2>/dev/null | head -n1)"
bsock="$(sed -n 's/^socket=//p' "$bfile" 2>/dev/null | head -n1)"
bhost="$(sed -n 's/^host=//p' "$bfile" 2>/dev/null | head -n1)"
bport="$(sed -n 's/^port=//p' "$bfile" 2>/dev/null | head -n1)"

pid="$(cat "$STATEDIR/mosquitto.pid" 2>/dev/null)"
if [ -n "$shared" ]; then
  set -- $shared
  if (exec 3<>"/dev/tcp/$1/$2") >/dev/null 2>&1; then
    echo "Broker:  the site's shared broker $1:$2, answering"
  else
    echo "Broker:  the site's shared broker $1:$2, NOT answering (systemctl status ecce-broker)"
  fi
elif [ -n "$bhost" ]; then
  if (exec 3<>"/dev/tcp/$bhost/$bport") >/dev/null 2>&1; then
    echo "Broker:  $bhost:$bport (central server), answering"
  else
    echo "Broker:  $bhost:$bport (central server), NOT answering"
  fi
elif [ -n "$pid" ] && [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = mosquitto ]; then
  kind="this user's; stopped with the last session"
  [ -e "$STATEDIR/mosquitto.server" ] && kind="a server's; stopped only by Quit and Stop Server"
  echo "Broker:  mosquitto running (pid $pid, socket ${bsock:-unknown}, $kind)"
else
  echo "Broker:  not running"
fi
