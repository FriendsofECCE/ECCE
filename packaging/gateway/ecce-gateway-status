#!/bin/bash
# ecce-gateway-status: report whether the ActiveMQ broker and the
# JMSDispatcher gateway relay are currently running.

set -u

ECCE_REALUSERHOME="${ECCE_REALUSERHOME:-$HOME}"
STATEDIR="$ECCE_REALUSERHOME/.ECCE"
DISPLAY="${DISPLAY:-:0}"
# Per-display, matching ecce-gateway-start; see the note there.
PIDFILE="$STATEDIR/jmsdispatcher_${DISPLAY}.pid"
BROKER_PORT=8088

port_open() {
  # The connect runs in a subshell, so fd 3 is closed when that subshell
  # exits and there is nothing to clean up here.
  #
  # There used to be an "exec 3<&- 3>&- 2>/dev/null" cleanup line below.
  # `exec` with redirections and no command applies them to the CURRENT
  # shell, permanently -- so from the first port check onward this script's
  # stderr went to /dev/null, and every error message after that point was
  # silently discarded. That included the ones that matter most, like
  # "did not report ready within 20s -- see <log>".
  (exec 3<>"/dev/tcp/localhost/$1") >/dev/null 2>&1
}

if port_open "$BROKER_PORT"; then
  echo "ActiveMQ broker:  running (port $BROKER_PORT)"
else
  echo "ActiveMQ broker:  not running"
fi

if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
  echo "JMSDispatcher:    running for $DISPLAY (pid $(cat "$PIDFILE"))"
else
  echo "JMSDispatcher:    not running for $DISPLAY"
fi
