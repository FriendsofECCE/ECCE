#!/bin/bash
# ecce-gateway-start: idempotently make sure this session has a message
# broker, and tell the ECCE processes where it is, before an ECCE app that
# needs messaging starts. Safe to call every time an app launches -- it
# does nothing if the broker is already up.
#
# The processes find the broker through $STATEDIR/broker_<host>_<id>
# (MqttLink.C), one file per session: "socket=<path>" for this user's own
# mosquitto, "host=" and "port=" for a central or shared one. Those are TCP
# and take the data server login as their account (MqttLink, AuthCache).
#
# Which broker, and whether one is started here, depends on the deployment
# mode; see "--- 1." below.

set -u

ECCE_HOME="${ECCE_HOME:-/opt/ecce}"
export ECCE_HOME
export ECCE_REALUSERHOME="${ECCE_REALUSERHOME:-$HOME}"
export ECCE_REALUSER="${ECCE_REALUSER:-$(id -un)}"
export HOST="${HOST:-$(hostname)}"

# Beside the script, else beside its symlink target (plain readlink: no -f
# on macOS 10.15), else in $ECCE_HOME/bin.
_lib="$(dirname "$0")/ecce-session-lib.sh"
if [ ! -r "$_lib" ] && _t=$(readlink "$0" 2>/dev/null); then
  case $_t in /*) ;; *) _t="$(dirname "$0")/$_t" ;; esac
  _lib="$(dirname "$_t")/ecce-session-lib.sh"
fi
[ -r "$_lib" ] || _lib="$ECCE_HOME/bin/ecce-session-lib.sh"
. "$_lib" || { echo "ecce-gateway-start: cannot read $_lib" >&2; exit 1; }
ecce_session_ensure

STATEDIR="$ECCE_REALUSERHOME/.ECCE"
mkdir -p "$STATEDIR"

# Read by every ECCE process of this session (MqttLink.C, Ecce::sessionKey).
BROKERFILE="$(ecce_broker_file)"

# Windows (MSYS2 or the bundled bash): a local session's broker is TCP on
# loopback with a generated login; there is no Unix-socket mosquitto, and
# no flock or /proc for the rest of this script. Only the local case is
# handed over.
case "$(uname -s)" in
  MSYS*|MINGW*|CYGWIN*)
    if [ -z "${ECCE_REMOTE_SERVER:-}" ] && [ ! -e "$ECCE_HOME/siteconfig/SharedBroker" ]; then
      exec "$(dirname "$(readlink -f "$0")")/ecce-broker-win" start
    fi
    ;;
esac

# The central broker's port: where a -remote client finds it on the data
# server's host, and where a server account (ecce-remote-setup --server)
# starts it. 8088 was ActiveMQ's, so existing firewall rules still apply.
# The per-user broker has no port. Debian's own mosquitto.service is on
# 1883 and is neither used nor disturbed.
BROKER_PORT="${ECCE_BROKER_PORT:-8088}"
# With TLS (#236) the network port is this one and the plain port above is
# loopback only; a client that was set up for TLS never uses the plain one.
BROKER_TLS_PORT="${ECCE_BROKER_TLS_PORT:-8883}"

# Whether host:port takes a TCP connection within 5 s; if not, PORT_WHY
# says why ("Connection refused", "No route to host", a failed name
# lookup). Perl, because macOS has no timeout(1) and a remote host that
# drops packets would hang a plain connect for minutes.
PORT_WHY=""
port_open_remote() {
  PORT_WHY=$(perl -MIO::Socket::IP -e '
    my ($h, $p) = @ARGV;
    $SIG{ALRM} = sub { print "no answer within 10 s"; exit 1 };
    alarm 10;   # the name lookup, which Timeout does not cover
    my $s = IO::Socket::IP->new(PeerHost => $h, PeerPort => $p,
                                Proto => "tcp", Timeout => 5);
    exit 0 if $s;
    my $e = $@ || "$!";
    $e =~ s/^IO::Socket::IP: (connect: )?//;
    $e =~ s/\s+$//;
    print $e; exit 1;' "$1" "$2" 2>/dev/null)
  case $? in 0) return 0 ;; 1) return 1 ;; esac
  # No perl or no IO::Socket::IP: bash's /dev/tcp.
  PORT_WHY="no connection"
  if command -v timeout >/dev/null 2>&1; then
    timeout 5 bash -c '(exec 3<>"/dev/tcp/$1/$2")' _ "$1" "$2" >/dev/null 2>&1
  else
    bash -c '(exec 3<>"/dev/tcp/$1/$2")' _ "$1" "$2" >/dev/null 2>&1
  fi
}
port_open_at() { port_open_remote "$@"; }

# -remote: the central server's broker and data server, as
# ecce-remote-setup wrote the data server's address. Checked first so that a server that is down
# gets one message naming it, rather than every app failing to connect.
# Leaves the broker's host and port in RBHOST/RBPORT.
check_central_server() {
  local ds="${ECCE_REMOTE_DIR:-$ECCE_HOME/siteconfig/RemoteServer}/DataServers"
  local bhost="" bport="$BROKER_PORT" dhost="" dport="" url down="" host=""
  RBHOST="" RBPORT="" RBTLS=0
  url="$(sed -n 's|.*<Url>[[:space:]]*\(https\{0,1\}://[^/<]*\).*|\1|p' "$ds" 2>/dev/null | head -n1)"
  if [ -n "$url" ]; then
    dport=80; case "$url" in https:*) dport=443; RBTLS=1 ;; esac
    url="${url#*://}"
    dhost="${url%%:*}"
    case "$url" in *:*) dport="${url##*:}" ;; esac
  fi
  if [ -z "$dhost" ]; then
    echo "ecce-gateway-start: -remote, but this client has no central server configured ($ds) -- run ecce-remote-setup <server> first" >&2
    return 1
  fi
  bhost="$dhost"
  # The data server's URL (https) is what ecce-remote-setup --tls wrote; it
  # decides for the broker as well, so the two cannot disagree.
  [ "$RBTLS" = 1 ] && bport="$BROKER_TLS_PORT"
  local why="" hint=""
  if ! port_open_remote "$bhost" "$bport"; then
    down="$bhost:$bport (broker)"; why="broker $bhost:$bport: $PORT_WHY"
  fi
  if ! port_open_remote "$dhost" "$dport"; then
    down="${down:+$down and }$dhost:$dport (data server)"
    why="${why:+$why; }data server $dhost:$dport: $PORT_WHY"
  fi
  RBHOST="$bhost"; RBPORT="$bport"
  [ -z "$down" ] && return 0
  host="$bhost"
  [ "$bhost" = "$dhost" ] || host="$bhost / $dhost"
  # macOS refuses connections into the local network to a program that has
  # not been allowed to make them; the error is then "No route to host".
  case "$(uname -s):$why" in
    Darwin:*"No route to host"*)
      hint=" On macOS this can also mean that ECCE, or the terminal it was started from, is not allowed under System Settings > Privacy & Security > Local Network." ;;
  esac
  echo "ecce-gateway-start: the central ECCE server $host is not answering -- $why. Is it running? (on the server: ecce-dataserver-status, ecce-gateway-status)$hint" >&2
  return 1
}

# ecce-gateway-reap (called below, and from every wrapper's EXIT trap)
# may stop this user's broker when their last session ends. Hold one
# lock across the decision and the start, so a session starting as the
# previous one ends cannot adopt a broker that is being stopped. Nothing
# started from here may inherit the descriptor, or the lock outlives us.
# Windows has neither flock nor /proc, and a -remote session there starts no
# broker of its own to guard, so it goes without the lock and the sweep.
case "$(uname -s)" in MSYS*|MINGW*|CYGWIN*) ON_WINDOWS=1 ;; *) ON_WINDOWS=0 ;; esac
if [ "$ON_WINDOWS" = 0 ]; then
exec 9>>"$STATEDIR/.gateway.lock"
ecce_flock -w 90 9 || echo "ecce-gateway-start: could not lock $STATEDIR/.gateway.lock; continuing" >&2

# --- 0. Clean up after a session that died badly -----------------------
# Issue #102: an aborted session's leftovers were adopted by the next one.
# The sweep only touches sessions with no live ECCE app.
if [ -x "$ECCE_HOME/bin/ecce-gateway-reap" ]; then
  # It would wait for the lock we hold; tell it we hold it.
  ECCE_GATEWAY_LOCKED=1 "$ECCE_HOME/bin/ecce-gateway-reap" 9>&- || true
fi
fi

# --- 1. Which broker ----------------------------------------------------
# Three deployment modes (GETTING_STARTED.md, "Deployment modes"):
#   3. siteconfig/SharedBroker declares the site's broker, a system
#      service. It wins over -remote, so an app server can use a central
#      data server with its own local broker.
#   2. -remote: the central server's broker, on the host of the data
#      server in siteconfig/RemoteServer/DataServers, at $BROKER_PORT.
#   1. otherwise this user's own mosquitto on a Unix socket, started here.
SHARED=""
if [ -x "$ECCE_HOME/bin/ecce-broker-setup" ]; then
  SHARED="$("$ECCE_HOME/bin/ecce-broker-setup" --show 2>/dev/null)" || SHARED=""
fi
if [ -z "$SHARED" ] && [ -e "$ECCE_HOME/siteconfig/SharedBroker" ]; then
  echo "ecce-gateway-start: $ECCE_HOME/siteconfig/SharedBroker is unreadable or not host:port -- fix it (ecce-broker-setup); not starting a broker of our own over it" >&2
  SHARED="invalid"
fi

# Atomic, so a process starting now never reads half of it.
# A session's first broker file also makes it the newest session, which an
# app started without a session id joins (ecce_session_ensure).
write_broker_file() {
  local tmp="$BROKERFILE.tmp.$$" ptr new=0
  [ -e "$BROKERFILE" ] || new=1
  { printf 'user=%s\n' "${BROKER_USER:-$ECCE_REALUSER}"; printf '%s\n' "$@"; } >"$tmp" &&
    mv -f "$tmp" "$BROKERFILE" || return
  if [ "$new" = 1 ]; then
    ptr="$(ecce_session_pointer)"
    printf '%s\n' "$ECCE_SESSION_ID" >"$ptr.tmp.$$" && mv -f "$ptr.tmp.$$" "$ptr"
  fi
}

# The socket must fit sun_path (107 bytes); a deep state directory gets a
# short private directory under the runtime dir instead.
broker_socket() {
  local sock="$STATEDIR/mosquitto.sock" dir
  if [ "${#sock}" -gt 100 ]; then
    dir="${XDG_RUNTIME_DIR:-/tmp}/ecce-$(id -u)-$(printf '%s' "$STATEDIR" | cksum | cut -d' ' -f1)"
    mkdir -p "$dir" && chmod 700 "$dir"
    sock="$dir/mosquitto.sock"
  fi
  echo "$sock"
}

own_broker_pid() {
  local pid
  pid="$(cat "$STATEDIR/mosquitto.pid" 2>/dev/null)"
  if [ -n "$pid" ] && [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = mosquitto ]; then
    echo "$pid"; return
  fi
  pgrep -u "$(id -u)" -f "mosquitto -c $STATEDIR/mosquitto.conf( |$)" 2>/dev/null | head -n1
}

if [ -n "$SHARED" ]; then
  if [ "$SHARED" != "invalid" ]; then
    set -- $SHARED
    if port_open_at "$1" "$2"; then
      echo "ecce-gateway-start: using the site's shared broker $1:$2 (siteconfig/SharedBroker)"
    else
      echo "ecce-gateway-start: the site's shared broker $1:$2 (siteconfig/SharedBroker) is not answering ($PORT_WHY) -- ask the administrator to check 'systemctl status ecce-broker'" >&2
    fi
    write_broker_file "host=$1" "port=$2"
  fi
elif [ -n "${ECCE_REMOTE_SERVER:-}" ]; then
  check_central_server || exit 2
  if [ "$RBTLS" = 1 ]; then
    echo "ecce-gateway-start: -remote -- using the central broker over TLS"
    pin="$ECCE_HOME/siteconfig/RemoteServer/server.pem"
    if [ -e "$pin" ]; then
      trust=("cafile=$pin" "pinned=1")
    else
      trust=()
      for d in /etc/ssl/certs /etc/pki/tls/certs; do
        [ -d "$d" ] && { trust=("capath=$d"); break; }
      done
      if [ "${#trust[@]}" = 0 ]; then
        echo "ecce-gateway-start: TLS to the central server, but there is neither a pinned certificate ($pin) nor a system CA directory" >&2
        exit 2
      fi
    fi
    write_broker_file "host=$RBHOST" "port=$RBPORT" "tls=1" "${trust[@]}"
  else
    echo "ecce-gateway-start: -remote -- using the central broker"
    write_broker_file "host=$RBHOST" "port=$RBPORT"
  fi
elif ! MOSQUITTO="$("$ECCE_HOME/bin/ecce-find-mosquitto")"; then
  echo "ecce-gateway-start: no mosquitto broker installed and neither ECCE_REMOTE_SERVER nor siteconfig/SharedBroker is set." >&2
  echo "ecce-gateway-start: install mosquitto for a local broker, or point this client at a central one (ecce-remote-setup, then 'ecce -remote')." >&2
  exit 1
else
  SOCK="$(broker_socket)"
  CONF="$STATEDIR/mosquitto.conf"
  MARKER="$STATEDIR/mosquitto.server"
  # An 8.x central server was marked under activemq/; without carrying the
  # mark over, its upgraded account would serve no clients at all.
  if [ ! -e "$MARKER" ] && [ -e "$STATEDIR/activemq/server" ]; then
    cp "$STATEDIR/activemq/server" "$MARKER" &&
      echo "ecce-gateway-start: carried the 8.x central-server mark over to $MARKER"
  fi

  # The addresses of the data server's listen setting (ecce-dataserver-
  # start), so a server's broker is reachable exactly where its data
  # server is. "*" is every interface.
  server_binds() {
    local setting="${ECCE_DATASERVER_LISTEN:-}" b
    if [ -z "$setting" ] && [ -f "$STATEDIR/dataserver/listen" ]; then
      setting="$(sed -e 's/#.*//' "$STATEDIR/dataserver/listen" | tr -s ' \t\n' '   ')"
    fi
    setting="${setting# }"; setting="${setting% }"
    case "${setting:-loopback}" in
      loopback|localhost) setting="" ;;
      all|'*'|0.0.0.0|::|'[::]') echo "*"; return 0 ;;
    esac
    echo "127.0.0.1"
    if [ -r /proc/net/if_inet6 ] &&
       grep -q '^00000000000000000000000000000001 ' /proc/net/if_inet6; then
      echo "::1"
    fi
    set -f   # "*" among the words must not expand against the cwd
    for b in $setting; do
      case "$b" in
        *[!A-Za-z0-9.:_-]*) echo "ecce-gateway-start: ignoring '$b' in the listen setting" >&2 ;;
        *) echo "$b" ;;
      esac
    done
    set +f
  }

  # The configuration this account's broker should have right now. The
  # Unix socket is anonymous: the 0700 directory is what keeps other
  # users out, and this account's own processes need no login. A server
  # account (ecce-remote-setup --server) adds a TCP listener for its
  # clients, with the accounts of its data server (the plugin reads its users file) and the per-user rules.
  # per_listener_settings, so the socket and the TCP listener differ.
  # With TLS (ecce-remote-setup --server --tls; $TLS_DIR/enabled) the
  # plain TCP listener is loopback only and every other address gets the
  # TLS port instead, so no password crosses the network in clear.
  TLS_DIR="$STATEDIR/tls"
  TLS=0
  if [ "${ECCE_DATASERVER_TLS:-}" = 1 ] || [ -f "$TLS_DIR/enabled" ]; then TLS=1; fi
  make_conf() {
    echo "per_listener_settings true"
    echo "persistence false"
    echo "log_dest file $STATEDIR/mosquitto.log"
    echo "listener 0 $SOCK"
    echo "allow_anonymous true"
    [ -e "$MARKER" ] || return 0
    local b
    local loop
    while IFS= read -r b; do
      loop=0
      case "$b" in 127.0.0.1|::1) loop=1 ;; esac
      if [ "$TLS" = 1 ]; then
        if [ "$b" = "*" ]; then
          # The wildcard TLS listener does not cover the plain port.
          broker_listener "$BROKER_TLS_PORT" "" tls
          broker_listener "$BROKER_PORT" 127.0.0.1 plain
          grep -q '^00000000000000000000000000000001 ' /proc/net/if_inet6 2>/dev/null &&
            broker_listener "$BROKER_PORT" ::1 plain
        else
          broker_listener "$BROKER_TLS_PORT" "$b" tls
          [ "$loop" = 1 ] && broker_listener "$BROKER_PORT" "$b" plain
        fi
      elif [ "$b" = "*" ]; then broker_listener "$BROKER_PORT" "" plain
      else broker_listener "$BROKER_PORT" "$b" plain; fi
    done < <(server_binds)
  }
  broker_listener() {   # port address(or empty) plain|tls
    echo "listener $1${2:+ $2}"
    echo "allow_anonymous false"
    echo "plugin $ECCE_HOME/server/ecce_users_auth.so"
    echo "plugin_opt_users_file $STATEDIR/dataserver/users"
    echo "acl_file $ECCE_HOME/server/mosquitto.acl"
    if [ "$3" = tls ]; then
      echo "certfile $TLS_DIR/server.pem"
      echo "keyfile $TLS_DIR/server.key"
    fi
  }

  if [ -e "$MARKER" ]; then
    if [ ! -f "$ECCE_HOME/server/mosquitto.acl" ]; then
      echo "ecce-gateway-start: $ECCE_HOME/server/mosquitto.acl is missing -- install ecce-server; a central broker is not started without its access rules" >&2
      exit 1
    fi
    if [ ! -f "$ECCE_HOME/server/ecce_users_auth.so" ]; then
      echo "ecce-gateway-start: $ECCE_HOME/server/ecce_users_auth.so is missing -- install ecce-server; a central broker is not started without its login check" >&2
      exit 1
    fi
  fi
  if [ "$TLS" = 1 ] && [ -e "$MARKER" ]; then
    for f in server.pem server.key; do
      if [ ! -r "$TLS_DIR/$f" ]; then
        echo "ecce-gateway-start: TLS is on but $TLS_DIR/$f is missing -- run ecce-remote-setup --server --tls; not starting the central broker without it" >&2
        exit 1
      fi
    done
    chmod 700 "$TLS_DIR" 2>/dev/null; chmod 600 "$TLS_DIR/server.key" 2>/dev/null
  fi
  NEWCONF="$(make_conf)"

  running="$(own_broker_pid)"
  if [ -n "$running" ] && [ -S "$SOCK" ] &&
     [ "$NEWCONF" = "$(cat "$CONF" 2>/dev/null)" ]; then
    echo "ecce-gateway-start: broker already running (pid $running)"
  else
    if [ -n "$running" ]; then
      echo "ecce-gateway-start: restarting the mosquitto broker (its configuration changed)..."
    else
      echo "ecce-gateway-start: starting mosquitto broker..."
    fi
    chmod 700 "$STATEDIR"
    printf '%s\n' "$NEWCONF" >"$CONF"
    if [ -n "$running" ]; then
      kill "$running" 2>/dev/null
      i=0
      while [ $i -lt 40 ] && kill -0 "$running" 2>/dev/null; do
        i=$((i + 1)); sleep 0.25
      done
    fi
    rm -f "$SOCK"
    (
      umask 077
      nohup "$MOSQUITTO" -c "$CONF" \
        >"$STATEDIR/mosquitto.out" 2>&1 9>&- &
      echo $! >"$STATEDIR/mosquitto.pid"
    )
    i=0
    while [ $i -lt 40 ] && [ ! -S "$SOCK" ]; do
      i=$((i + 1))
      sleep 0.25
    done
    if [ ! -S "$SOCK" ]; then
      echo "ecce-gateway-start: broker did not come up within 10s -- see $STATEDIR/mosquitto.log and mosquitto.out" >&2
      exit 1
    fi
    if [ -e "$MARKER" ] && ! port_open_at 127.0.0.1 "$BROKER_PORT"; then
      echo "ecce-gateway-start: this server's broker is not answering on port $BROKER_PORT -- see $STATEDIR/mosquitto.log and mosquitto.out (is another program using it? set ECCE_BROKER_PORT)" >&2
    fi
  fi
  # This account's own broker: no other user can reach it, so the topic
  # user need not be personal, and a fixed name stays a valid MQTT topic
  # level whatever the OS account is called (Windows names may hold '#').
  BROKER_USER=local write_broker_file "socket=$SOCK"
fi

exit 0
