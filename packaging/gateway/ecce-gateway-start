#!/bin/bash
# ecce-gateway-start: idempotently ensure the ECCE JMS gateway (the
# ActiveMQ broker plus the per-user JMSDispatcher relay) is running on
# this machine, for this user, before an ECCE app that needs messaging
# starts. Safe to call every time an app launches -- it does nothing if
# the gateway is already up.
#
# This replaces the "-remote"-unaware half of the old install_ecce/
# scripts/ecce launcher (see build/install_ecce, scripts/ecce) for the
# common case this modern package targets: client and server on the same
# machine, single user. It does not implement the old "-remote" flag /
# siteconfig/RemoteServer split for pointing at a separate ECCE server
# host -- set ECCE_NO_MESSAGING=1 and manage that by hand if you need it.

set -u

ECCE_HOME="${ECCE_HOME:-/opt/ecce}"
export ECCE_HOME
export ECCE_REALUSERHOME="${ECCE_REALUSERHOME:-$HOME}"
export ECCE_REALUSER="${ECCE_REALUSER:-$(id -un)}"
export HOST="${HOST:-$(hostname)}"
export DISPLAY="${DISPLAY:-:0}"

STATEDIR="$ECCE_REALUSERHOME/.ECCE"
mkdir -p "$STATEDIR"

ACTIVEMQ_HOME="/usr/share/activemq"

# The broker's listening port must match packaging/gateway/activemq.xml.ecce's
# <transportConnector name="openwire" uri="tcp://localhost:PORT"/>, and
# siteconfig/jndi.properties' java.naming.provider.url. Our shipped config
# uses 8088 -- if you repoint it, update those too.
BROKER_PORT=8088

port_open() {
  (exec 3<>"/dev/tcp/localhost/$1") >/dev/null 2>&1
  status=$?
  exec 3<&- 3>&- 2>/dev/null
  return $status
}

# --- 1. ActiveMQ broker -----------------------------------------------
if port_open "$BROKER_PORT"; then
  echo "ecce-gateway-start: broker already listening on $BROKER_PORT"
else
  # The Debian activemq package ships /usr/bin/activemq as its own launcher
  # script, but that script's invokeJar() has a real quoting bug on this
  # system (its `sh -c "$JAVACMD ..."` construction fails with a bare
  # "command not found" -- confirmed directly, not theorized; some
  # interaction between its DOIT_PREFIX handling and this shell/version
  # combination). Rather than depend on that, invoke java directly
  # ourselves with the same JVM args and activemq.* system properties that
  # script would have computed -- verified this launches identically by
  # capturing the script's own (correct, up to the quoting bug) computed
  # command line before it fails, and testing this exact invocation
  # standalone: broker actually comes up and accepts connections.
  #
  # ACTIVEMQ_HOME is a shared, package-owned install (root:root, not
  # group/other-writable) since it's meant to be installed once and used
  # by every user on the machine -- so activemq.base (persistence store,
  # lock file, log file) must NOT default to it, or every user's broker
  # instance fails writing there. Point ACTIVEMQ_BASE at this user's own
  # per-user state dir instead, matching how JMSDispatcher's own PID/port
  # files already work. Unlike the old vendored 5.1.0 tarball (which
  # shipped its own conf/ alongside bin/, letting this be a symlink back
  # to $ACTIVEMQ_HOME/conf), the Debian package keeps its own default
  # config under /etc/activemq/ entirely separately from
  # /usr/share/activemq -- and we don't want that shared, root-owned,
  # single-instance config anyway (it defaults to port 61616, not the
  # 8088 siteconfig/jndi.properties expects). So ship and copy our own
  # known-working config instead of symlinking to anything
  # system-provided.
  if [ ! -d "$ACTIVEMQ_HOME" ]; then
    echo "ecce-gateway-start: no ActiveMQ broker installed (apt install activemq) -- messaging will not work" >&2
  else
    echo "ecce-gateway-start: starting ActiveMQ broker..."
    ACTIVEMQ_BASE="$STATEDIR/activemq"
    mkdir -p "$ACTIVEMQ_BASE/data" "$ACTIVEMQ_BASE/conf"
    [ -e "$ACTIVEMQ_BASE/conf/activemq.xml" ] || cp "$ECCE_HOME/server/activemq-conf/activemq.xml" "$ACTIVEMQ_BASE/conf/activemq.xml"
    export ACTIVEMQ_BASE
    CP=""
    for f in "$ACTIVEMQ_HOME"/lib/*.jar; do CP="$f:$CP"; done
    (
      cd "$ACTIVEMQ_HOME" || exit 1
      nohup java -Xms512M -Xmx512M -Dorg.apache.activemq.UseDedicatedTaskRunner=true \
        --add-reads=java.xml=java.logging \
        --add-opens java.base/java.security=ALL-UNNAMED \
        --add-opens java.base/java.net=ALL-UNNAMED \
        --add-opens java.base/java.lang=ALL-UNNAMED \
        --add-opens java.base/java.util=ALL-UNNAMED \
        --add-opens java.naming/javax.naming.spi=ALL-UNNAMED \
        --add-opens java.rmi/sun.rmi.transport.tcp=ALL-UNNAMED \
        --add-opens java.base/java.util.concurrent=ALL-UNNAMED \
        --add-opens java.base/java.util.concurrent.atomic=ALL-UNNAMED \
        --add-exports=java.base/sun.net.www.protocol.http=ALL-UNNAMED \
        --add-exports=java.base/sun.net.www.protocol.https=ALL-UNNAMED \
        --add-exports=java.base/sun.net.www.protocol.jar=ALL-UNNAMED \
        --add-exports=jdk.xml.dom/org.w3c.dom.html=ALL-UNNAMED \
        --add-exports=jdk.naming.rmi/com.sun.jndi.url.rmi=ALL-UNNAMED \
        -Dactivemq.classpath="$ACTIVEMQ_BASE/conf:$CP" \
        -Dactivemq.home="$ACTIVEMQ_HOME" \
        -Dactivemq.base="$ACTIVEMQ_BASE" \
        -Dactivemq.conf="$ACTIVEMQ_BASE/conf" \
        -Dactivemq.data="$ACTIVEMQ_BASE/data" \
        -jar "$ACTIVEMQ_HOME/bin/activemq.jar" start \
        >"$STATEDIR/activemq.log" 2>&1 &
    )
    i=0
    while [ $i -lt 60 ]; do
      if port_open "$BROKER_PORT"; then break; fi
      i=$((i + 1))
      sleep 0.5
    done
    if ! port_open "$BROKER_PORT"; then
      echo "ecce-gateway-start: broker did not come up within 30s -- see $STATEDIR/activemq.log" >&2
    fi
  fi
fi

# --- 2. Per-session JMSDispatcher gateway relay ------------------------
PIDFILE="$STATEDIR/jmsdispatcher.pid"
PORTFILE="$STATEDIR/${HOST}_${DISPLAY}"

running=0
if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
  running=1
fi

if [ "$running" = "1" ]; then
  echo "ecce-gateway-start: JMSDispatcher already running (pid $(cat "$PIDFILE"))"
else
  echo "ecce-gateway-start: starting JMSDispatcher..."
  CP=""
  for f in "$ECCE_HOME"/java/lib/*.jar; do CP="$f:$CP"; done
  rm -f "$PORTFILE"
  (
    nohup java -DECCE_HOST="$HOST" -DDISPLAY="$DISPLAY" \
      -DECCE_HOME="$ECCE_HOME" -DECCE_USERHOME="$ECCE_REALUSERHOME" \
      -cp "$CP:$ECCE_HOME/siteconfig" \
      gov.pnnl.emsl.ecce.jms.JMSDispatcher \
      >"$STATEDIR/jmsdispatcher.log" 2>&1 &
    echo $! >"$PIDFILE"
  )
  i=0
  while [ ! -f "$PORTFILE" ] && [ $i -lt 40 ]; do
    i=$((i + 1))
    sleep 0.5
  done
  if [ ! -f "$PORTFILE" ]; then
    echo "ecce-gateway-start: JMSDispatcher did not report ready within 20s -- see $STATEDIR/jmsdispatcher.log" >&2
    exit 1
  fi
fi

exit 0
