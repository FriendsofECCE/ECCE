#!/bin/bash
# ecce-gateway-start: idempotently ensure the ECCE JMS gateway (the
# ActiveMQ broker plus the per-user JMSDispatcher relay) is running on
# this machine, for this user, before an ECCE app that needs messaging
# starts. Safe to call every time an app launches -- it does nothing if
# the gateway is already up.
#
# Which broker the relay talks to, and whether one is started here,
# depends on the deployment mode; see "--- 1." below.

set -u

ECCE_HOME="${ECCE_HOME:-/opt/ecce}"
export ECCE_HOME
export ECCE_REALUSERHOME="${ECCE_REALUSERHOME:-$HOME}"
export ECCE_REALUSER="${ECCE_REALUSER:-$(id -un)}"
export HOST="${HOST:-$(hostname)}"
export DISPLAY="${DISPLAY:-:0}"

STATEDIR="$ECCE_REALUSERHOME/.ECCE"
mkdir -p "$STATEDIR"

# ACTIVEMQ_HOME: Debian/Ubuntu package path by default; set it to an
# upstream ActiveMQ Classic install (e.g. on RHEL, which packages none).
ACTIVEMQ_HOME="${ACTIVEMQ_HOME:-/usr/share/activemq}"

# The broker's listening port. Three things have to agree on it: this
# script's check, activemq.xml's <transportConnector>, and
# jndi.properties' java.naming.provider.url. They used to agree by all
# three hardcoding 8088, which meant the port could not be changed without
# editing installed files -- and so two ECCE instances could never run at
# once, on one machine or in a test.
#
# Now only this variable is authoritative: the per-user copies of
# activemq.xml and jndi.properties are resolved from it below. The C++ side
# needs nothing, because it never reads either file -- it finds the
# dispatcher through $STATEDIR/${HOST}_${DISPLAY} (see JMSMessage.C).
BROKER_PORT="${ECCE_BROKER_PORT:-8088}"

port_open() {
  # The connect runs in a subshell, so fd 3 is closed when that subshell
  # exits and there is nothing to clean up here.
  #
  # There used to be an "exec 3<&- 3>&- 2>/dev/null" cleanup line below.
  # `exec` with redirections and no command applies them to the CURRENT
  # shell, permanently -- so from the first port check onward this script's
  # stderr went to /dev/null, and every error message after that point was
  # silently discarded. That included the ones that matter most, like
  # "did not report ready within 20s -- see <log>".
  (exec 3<>"/dev/tcp/localhost/$1") >/dev/null 2>&1
}
port_open_at() { (exec 3<>"/dev/tcp/$1/$2") >/dev/null 2>&1; }

# ecce-gateway-reap (called below, and from every wrapper's EXIT trap)
# may stop this user's broker when their last session ends. Hold one
# lock across the decision and the start, so a session starting as the
# previous one ends cannot adopt a broker that is being stopped. Nothing
# started from here may inherit the descriptor, or the lock outlives us.
exec 9>>"$STATEDIR/.gateway.lock"
flock -w 90 9 || echo "ecce-gateway-start: could not lock $STATEDIR/.gateway.lock; continuing" >&2

# --- 0. Clean up after a session that died badly -----------------------
# Issue #102: an aborted gateway's relay was left running and adopted by
# the next session. The sweep only touches relays whose display has no
# live ECCE app, so it cannot disturb a running session.
if [ -x "$ECCE_HOME/bin/ecce-gateway-reap" ]; then
  # It would wait for the lock we hold; tell it we hold it.
  ECCE_GATEWAY_LOCKED=1 "$ECCE_HOME/bin/ecce-gateway-reap" 9>&- || true
fi

# --- 1. Which broker ----------------------------------------------------
# Three deployment modes (GETTING_STARTED.md, "Deployment modes"):
#   3. siteconfig/SharedBroker declares the site's broker, a system
#      service. It wins over -remote, so an app server can use a central
#      data server with its own local broker.
#   2. -remote: the central server's broker, as ecce-remote-setup wrote
#      it into siteconfig/jndi.properties.
#   1. otherwise this user's own broker on BROKER_PORT, started here.
SHARED=""
if [ -x "$ECCE_HOME/bin/ecce-broker-setup" ]; then
  SHARED="$("$ECCE_HOME/bin/ecce-broker-setup" --show 2>/dev/null)" || SHARED=""
fi
if [ -z "$SHARED" ] && [ -e "$ECCE_HOME/siteconfig/SharedBroker" ]; then
  echo "ecce-gateway-start: $ECCE_HOME/siteconfig/SharedBroker is unreadable or not host:port -- fix it (ecce-broker-setup); not starting a broker of our own over it" >&2
  SHARED="invalid"
fi

own_broker_pid() {
  local pid
  pid="$(cat "$STATEDIR/activemq.pid" 2>/dev/null)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then echo "$pid"; return; fi
  pgrep -u "$(id -u)" -f "activemq.base=$STATEDIR/activemq( |$)" 2>/dev/null | head -n1
}

if [ -n "$SHARED" ]; then
  if [ "$SHARED" != "invalid" ]; then
    set -- $SHARED
    if port_open_at "$1" "$2"; then
      echo "ecce-gateway-start: using the site's shared broker $1:$2 (siteconfig/SharedBroker)"
    else
      echo "ecce-gateway-start: the site's shared broker $1:$2 (siteconfig/SharedBroker) is not answering -- ask the administrator to check 'systemctl status ecce-broker'" >&2
    fi
  fi
elif [ -n "${ECCE_REMOTE_SERVER:-}" ]; then
  echo "ecce-gateway-start: -remote -- using the central broker"
elif port_open "$BROKER_PORT"; then
  if [ -n "$(own_broker_pid)" ]; then
    echo "ecce-gateway-start: broker already listening on $BROKER_PORT"
  else
    # Someone else's -- most likely another user's per-user broker, which
    # goes when their last session ends, taking this session's messaging
    # with it. A machine shared by several users wants a shared broker.
    echo "ecce-gateway-start: port $BROKER_PORT is held by a broker this account did not start; using it, but it may stop when its owner quits. On a machine with several ECCE users, declare a shared broker (ecce-broker-setup), or set ECCE_BROKER_PORT." >&2
  fi
elif [ ! -f "$ECCE_HOME/server/activemq-conf/activemq.xml" ] ||
     [ ! -x "$ECCE_HOME/bin/ecce-broker-run" ]; then
  # A client-only install (split packaging): nothing to start locally.
  echo "ecce-gateway-start: no local broker (ecce-server not installed) and neither ECCE_REMOTE_SERVER nor siteconfig/SharedBroker is set." >&2
  echo "ecce-gateway-start: install ecce-server for a local broker, or point this client at a central one (ecce-remote-setup, then 'ecce -remote')." >&2
elif [ ! -d "$ACTIVEMQ_HOME" ]; then
  echo "ecce-gateway-start: no ActiveMQ at $ACTIVEMQ_HOME (apt install activemq, or set ACTIVEMQ_HOME to an upstream ActiveMQ Classic install) -- messaging will not work" >&2
else
  echo "ecce-gateway-start: starting ActiveMQ broker..."
  # A central server's broker must be reachable by its clients: it
  # follows the data server's listen setting (#138, #167) -- loopback by
  # default, every interface for anything else.
  _listen="${ECCE_DATASERVER_LISTEN:-}"
  if [ -z "$_listen" ] && [ -f "$STATEDIR/dataserver/listen" ]; then
    _listen="$(sed -e 's/#.*//' "$STATEDIR/dataserver/listen" | tr -d ' \t\n')"
  fi
  case "${_listen:-loopback}" in
    loopback) _amq_host=localhost ;;
    *)        _amq_host=0.0.0.0 ;;
  esac
  (
    nohup "$ECCE_HOME/bin/ecce-broker-run" "$STATEDIR/activemq" \
      "$_amq_host" "$BROKER_PORT" >"$STATEDIR/activemq.log" 2>&1 9>&- &
    # The reaper identifies this broker by it. ecce-broker-run execs the
    # JVM, so $! is the broker itself.
    echo $! >"$STATEDIR/activemq.pid"
  )
  i=0
  while [ $i -lt 60 ]; do
    if port_open "$BROKER_PORT"; then break; fi
    i=$((i + 1))
    sleep 0.5
  done
  if ! port_open "$BROKER_PORT"; then
    echo "ecce-gateway-start: broker did not come up within 30s -- see $STATEDIR/activemq.log" >&2
  fi
fi

# --- 2. Per-session JMSDispatcher gateway relay ------------------------
# The JMSDispatcher is per SESSION, not per user: it is started with a
# -DDISPLAY and writes its port to "$STATEDIR/${HOST}_${DISPLAY}", which
# JMSMessage.C reads back and asserts on (EE_FATAL) when it is missing.
# The pidfile therefore has to be per-display too.  It was not, so with a
# dispatcher already running for one display, starting ECCE on a SECOND
# display -- a VNC session, an X-forwarded session, a second seat --
# reported "JMSDispatcher already running", never wrote that display's
# port file, and every app then died on
#   JMSMessage.C:497 Assertion (infile.good()) failed
# Found by tests/apps, which runs the apps on an Xvfb display.
PIDFILE="$STATEDIR/jmsdispatcher_${DISPLAY}.pid"
PORTFILE="$STATEDIR/${HOST}_${DISPLAY}"

running=0
if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null \
   && [ -f "$PORTFILE" ]; then
  running=1
fi

if [ "$running" = "1" ]; then
  echo "ecce-gateway-start: JMSDispatcher already running for $DISPLAY (pid $(cat "$PIDFILE"))"
else
  echo "ecce-gateway-start: starting JMSDispatcher..."
  CP=""
  for f in "$ECCE_HOME"/java/lib/*.jar; do CP="$f:$CP"; done

  # Same story as activemq.xml: give the dispatcher a jndi.properties that
  # names this instance's broker port, and put it ahead of the installed
  # one on the classpath. $ECCE_HOME/siteconfig is root-owned and shared,
  # so it cannot be rewritten per user or per instance anyway.
  mkdir -p "$STATEDIR/siteconfig"
  if [ -n "$SHARED" ] && [ "$SHARED" != "invalid" ] && [ -f "$ECCE_HOME/siteconfig/jndi.properties" ]; then
    set -- $SHARED
    sed -e "s|\(java\.naming\.provider\.url[ \t]*=[ \t]*\).*|\1tcp://$1:$2|" \
        "$ECCE_HOME/siteconfig/jndi.properties" \
        >"$STATEDIR/siteconfig/jndi.properties"
  elif [ -n "${ECCE_REMOTE_SERVER:-}" ] && [ -f "$ECCE_HOME/siteconfig/jndi.properties" ]; then
    # Keep the central broker's URL as ecce-remote-setup wrote it.
    cp "$ECCE_HOME/siteconfig/jndi.properties" "$STATEDIR/siteconfig/jndi.properties"
  elif [ -f "$ECCE_HOME/siteconfig/jndi.properties" ]; then
    sed -e "s|\(java\.naming\.provider\.url[ \t]*=[ \t]*\).*|\1tcp://localhost:$BROKER_PORT|" \
        "$ECCE_HOME/siteconfig/jndi.properties" \
        >"$STATEDIR/siteconfig/jndi.properties"
  fi
  rm -f "$PORTFILE"
  (
    nohup java -DECCE_HOST="$HOST" -DDISPLAY="$DISPLAY" \
      -DECCE_HOME="$ECCE_HOME" -DECCE_USERHOME="$ECCE_REALUSERHOME" \
      -cp "$STATEDIR/siteconfig:$CP:$ECCE_HOME/siteconfig" \
      gov.pnnl.emsl.ecce.jms.JMSDispatcher \
      >"$STATEDIR/jmsdispatcher.log" 2>&1 9>&- &
    echo $! >"$PIDFILE"
  )
  i=0
  while [ ! -f "$PORTFILE" ] && [ $i -lt 40 ]; do
    i=$((i + 1))
    sleep 0.5
  done
  if [ ! -f "$PORTFILE" ]; then
    echo "ecce-gateway-start: JMSDispatcher did not report ready within 20s -- see $STATEDIR/jmsdispatcher.log" >&2
    exit 1
  fi
fi

exit 0
