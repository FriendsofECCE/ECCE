#!/bin/bash
# ecce-gateway-start: idempotently make sure this session has a message
# broker, and tell the ECCE processes where it is, before an ECCE app that
# needs messaging starts. Safe to call every time an app launches -- it
# does nothing if the broker is already up.
#
# The processes find the broker through $STATEDIR/broker_<host>_<display>
# (MqttLink.C), one file per session: "socket=<path>" for this user's own
# mosquitto, "host=" and "port=" for a central or shared one.
#
# Which broker, and whether one is started here, depends on the deployment
# mode; see "--- 1." below.

set -u

ECCE_HOME="${ECCE_HOME:-/opt/ecce}"
export ECCE_HOME
export ECCE_REALUSERHOME="${ECCE_REALUSERHOME:-$HOME}"
export ECCE_REALUSER="${ECCE_REALUSER:-$(id -un)}"
export HOST="${HOST:-$(hostname)}"
export DISPLAY="${DISPLAY:-:0}"

STATEDIR="$ECCE_REALUSERHOME/.ECCE"
mkdir -p "$STATEDIR"

# Written by ecce-gateway-start, read by every ECCE process (MqttLink.C),
# which sanitises the name the same way.
BROKERFILE="$STATEDIR/broker_$(printf '%s_%s' "$HOST" "$DISPLAY" | tr -c 'A-Za-z0-9._-' '_')"

# The central broker's port under -remote. The per-user broker has no port;
# a central one is at the data server's host.
BROKER_PORT="${ECCE_BROKER_PORT:-8883}"

port_open_at() { (exec 3<>"/dev/tcp/$1/$2") >/dev/null 2>&1; }
# A remote host that drops packets would hang a plain connect for minutes.
port_open_remote() {
  timeout 5 bash -c '(exec 3<>"/dev/tcp/$1/$2")' _ "$1" "$2" >/dev/null 2>&1
}

# -remote: the central server's broker and data server, as
# ecce-remote-setup wrote the data server's address. Checked first so that a server that is down
# gets one message naming it, rather than every app failing to connect.
# Leaves the broker's host and port in RBHOST/RBPORT.
check_central_server() {
  local ds="$ECCE_HOME/siteconfig/RemoteServer/DataServers"
  local bhost="" bport="$BROKER_PORT" dhost="" dport="" url down="" host=""
  RBHOST="" RBPORT=""
  url="$(sed -n 's|.*<Url>[ \t]*\(https\{0,1\}://[^/<]*\).*|\1|p' "$ds" 2>/dev/null | head -n1)"
  if [ -n "$url" ]; then
    dport=80; case "$url" in https:*) dport=443 ;; esac
    url="${url#*://}"
    dhost="${url%%:*}"
    case "$url" in *:*) dport="${url##*:}" ;; esac
  fi
  if [ -z "$dhost" ]; then
    echo "ecce-gateway-start: -remote, but this client has no central server configured ($ds) -- run ecce-remote-setup <server> first" >&2
    return 1
  fi
  bhost="$dhost"
  if ! port_open_remote "$bhost" "$bport"; then down="$bhost:$bport (broker)"; fi
  if ! port_open_remote "$dhost" "$dport"; then
    down="${down:+$down and }$dhost:$dport (data server)"
  fi
  RBHOST="$bhost"; RBPORT="$bport"
  [ -z "$down" ] && return 0
  host="$bhost"
  [ "$bhost" = "$dhost" ] || host="$bhost / $dhost"
  echo "ecce-gateway-start: the central ECCE server $host is not answering on $down -- is it running? (on the server: ecce-dataserver-status, ecce-gateway-status)" >&2
  return 1
}

# ecce-gateway-reap (called below, and from every wrapper's EXIT trap)
# may stop this user's broker when their last session ends. Hold one
# lock across the decision and the start, so a session starting as the
# previous one ends cannot adopt a broker that is being stopped. Nothing
# started from here may inherit the descriptor, or the lock outlives us.
exec 9>>"$STATEDIR/.gateway.lock"
flock -w 90 9 || echo "ecce-gateway-start: could not lock $STATEDIR/.gateway.lock; continuing" >&2

# --- 0. Clean up after a session that died badly -----------------------
# Issue #102: an aborted session's leftovers were adopted by the next one.
# The sweep only touches displays with no live ECCE app.
if [ -x "$ECCE_HOME/bin/ecce-gateway-reap" ]; then
  # It would wait for the lock we hold; tell it we hold it.
  ECCE_GATEWAY_LOCKED=1 "$ECCE_HOME/bin/ecce-gateway-reap" 9>&- || true
fi

# --- 1. Which broker ----------------------------------------------------
# Three deployment modes (GETTING_STARTED.md, "Deployment modes"):
#   3. siteconfig/SharedBroker declares the site's broker, a system
#      service. It wins over -remote, so an app server can use a central
#      data server with its own local broker.
#   2. -remote: the central server's broker, on the host of the data
#      server in siteconfig/RemoteServer/DataServers, at $BROKER_PORT.
#   1. otherwise this user's own mosquitto on a Unix socket, started here.
SHARED=""
if [ -x "$ECCE_HOME/bin/ecce-broker-setup" ]; then
  SHARED="$("$ECCE_HOME/bin/ecce-broker-setup" --show 2>/dev/null)" || SHARED=""
fi
if [ -z "$SHARED" ] && [ -e "$ECCE_HOME/siteconfig/SharedBroker" ]; then
  echo "ecce-gateway-start: $ECCE_HOME/siteconfig/SharedBroker is unreadable or not host:port -- fix it (ecce-broker-setup); not starting a broker of our own over it" >&2
  SHARED="invalid"
fi

# Atomic, so a process starting now never reads half of it.
write_broker_file() {
  local tmp="$BROKERFILE.tmp.$$"
  { printf 'user=%s\n' "$ECCE_REALUSER"; printf '%s\n' "$@"; } >"$tmp" &&
    mv -f "$tmp" "$BROKERFILE"
}

# The socket must fit sun_path (107 bytes); a deep state directory gets a
# short private directory under the runtime dir instead.
broker_socket() {
  local sock="$STATEDIR/mosquitto.sock" dir
  if [ "${#sock}" -gt 100 ]; then
    dir="${XDG_RUNTIME_DIR:-/tmp}/ecce-$(id -u)-$(printf '%s' "$STATEDIR" | cksum | cut -d' ' -f1)"
    mkdir -p "$dir" && chmod 700 "$dir"
    sock="$dir/mosquitto.sock"
  fi
  echo "$sock"
}

own_broker_pid() {
  local pid
  pid="$(cat "$STATEDIR/mosquitto.pid" 2>/dev/null)"
  if [ -n "$pid" ] && [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = mosquitto ]; then
    echo "$pid"; return
  fi
  pgrep -u "$(id -u)" -f "mosquitto -c $STATEDIR/mosquitto.conf( |$)" 2>/dev/null | head -n1
}

if [ -n "$SHARED" ]; then
  if [ "$SHARED" != "invalid" ]; then
    set -- $SHARED
    if port_open_at "$1" "$2"; then
      echo "ecce-gateway-start: using the site's shared broker $1:$2 (siteconfig/SharedBroker)"
    else
      echo "ecce-gateway-start: the site's shared broker $1:$2 (siteconfig/SharedBroker) is not answering -- ask the administrator to check 'systemctl status ecce-broker'" >&2
    fi
    write_broker_file "host=$1" "port=$2"
  fi
elif [ -n "${ECCE_REMOTE_SERVER:-}" ]; then
  check_central_server || exit 2
  echo "ecce-gateway-start: -remote -- using the central broker"
  write_broker_file "host=$RBHOST" "port=$RBPORT"
elif ! command -v mosquitto >/dev/null 2>&1; then
  echo "ecce-gateway-start: no mosquitto broker installed and neither ECCE_REMOTE_SERVER nor siteconfig/SharedBroker is set." >&2
  echo "ecce-gateway-start: install mosquitto for a local broker, or point this client at a central one (ecce-remote-setup, then 'ecce -remote')." >&2
  exit 1
else
  SOCK="$(broker_socket)"
  if [ -n "$(own_broker_pid)" ] && [ -S "$SOCK" ]; then
    echo "ecce-gateway-start: broker already running (pid $(own_broker_pid))"
  else
    echo "ecce-gateway-start: starting mosquitto broker..."
    # No TCP listener and no authentication: the 0700 directory is what
    # keeps other users out.
    chmod 700 "$STATEDIR"
    cat >"$STATEDIR/mosquitto.conf" <<EOF
listener 0 $SOCK
allow_anonymous true
persistence false
log_dest file $STATEDIR/mosquitto.log
EOF
    stale="$(own_broker_pid)"
    [ -n "$stale" ] && kill "$stale" 2>/dev/null
    rm -f "$SOCK"
    (
      umask 077
      nohup mosquitto -c "$STATEDIR/mosquitto.conf" \
        >"$STATEDIR/mosquitto.out" 2>&1 9>&- &
      echo $! >"$STATEDIR/mosquitto.pid"
    )
    i=0
    while [ $i -lt 40 ] && [ ! -S "$SOCK" ]; do
      i=$((i + 1))
      sleep 0.25
    done
    if [ ! -S "$SOCK" ]; then
      echo "ecce-gateway-start: broker did not come up within 10s -- see $STATEDIR/mosquitto.log and mosquitto.out" >&2
      exit 1
    fi
  fi
  write_broker_file "socket=$SOCK"
fi

exit 0
