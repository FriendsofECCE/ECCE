#!/usr/bin/env python3
"""ecce-first-start: where does this user keep their work? (#240)

    ecce-first-start             ask once, at the first start, if nothing is set up
    ecce-first-start --check     print "ask" or "skip: <why>"; exit 0 to ask, 1 not
    ecce-first-start --change    the Edit > Change Server... window
    ecce-first-start --apply local|server:<host[:port]>
                                 make the choice with no window (tests)

Exit status of the plain form: 0 go on, 3 the user chose Quit.  Anything
else (no wxPython, no display) goes on with what ECCE would have done.

The question is asked at every start, with the current choice preselected
(Continue on it changes nothing); only explicit configuration skips it (see
skip_reason()).  The answer is still recorded in ~/.ECCE/first-start-answer.  Data from before the question (a local folder, a
server already chosen, ~/.ECCE/dataserver) only preselects the matching
choice.  The choice itself is kept as the state ECCE already reads:

  Store data on this computer  the LocalData preference on (ecce-localdata
                               pref on), the folder ~/.ECCE-local made
  Connect to a server          ~/.ECCE/RemoteServer/ (ecce-remote-setup
                               --user --auto), the preference off

Test hooks: ECCE_NO_FIRST_START=1 never asks; ECCE_FIRST_START_ANSWER=local
or server:<host[:port]> answers the window as if its button was pressed,
"continue" presses Continue on what is preselected;
ECCE_FIRST_START_SHOT=<file.png> saves a picture of the window first.
"""
import http.client
import os
import queue
import re
import shutil
import socket
import ssl
import subprocess
import sys
import threading
import time

HOME = os.environ.get("ECCE_REALUSERHOME") or os.path.expanduser("~")
ECCE_HOME = os.environ.get("ECCE_HOME") or "/opt/ecce"
STATE = os.path.join(HOME, ".ECCE")
MINE = os.path.join(STATE, "RemoteServer")
ANSWER = os.path.join(STATE, "first-start-answer")
WINDOWS = sys.platform == "win32"
# The folder the Windows start script (ecce.cmd) already uses.
LOCAL_DEFAULT = os.path.join(HOME, "ecce-local" if WINDOWS else ".ECCE-local")


def tool(name):
    for n in (name, name + ".exe"):
        p = os.path.join(ECCE_HOME, "bin", n)
        if os.path.exists(p):
            return p
    return shutil.which(name) or os.path.join(ECCE_HOME, "bin", name)


# pythonw has no standard streams, and its children need no console window.
if sys.stdout is None:
    sys.stdout = open(os.devnull, "w")
if sys.stderr is None:
    # What went wrong is then in ~/.ECCE/first-start.log.
    try:
        os.makedirs(STATE, exist_ok=True)
        sys.stderr = open(os.path.join(STATE, "first-start.log"), "a")
    except OSError:
        sys.stderr = open(os.devnull, "w")


def run(cmd, timeout=30):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout,
                           stdin=subprocess.DEVNULL,
                           creationflags=0x08000000 if WINDOWS else 0)
        return r.returncode, r.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return 127, ""


# Read here, not through ecce-localdata: this runs before the window shows,
# and on a machine whose antivirus checks each new program on its first run
# (WithSecure on a managed laptop: ~12 s) that kept the screen empty (#522).
# Mirrors Preferences (KEY:<tab>value, keys in upper case) and LocalData::dir.
def global_pref(key):
    try:
        with open(os.path.join(STATE, "EcceGlobal"), encoding="utf-8",
                  errors="replace") as f:
            for line in f:
                k, sep, v = line.partition(":")
                if sep and not k.startswith("#") and k.strip().upper() == key:
                    return v.strip()
    except OSError:
        pass
    return None


def pref_state():
    v = (global_pref("LOCALDATA") or "").lower()
    if v.startswith("1") or v == "true":
        return "on"
    if v.startswith("0") or v == "false":
        return "off"
    return "unset"


def local_data_dir():
    """What `ecce-localdata` prints: the session's local data folder or ''."""
    def expand(p):
        p = p.strip()
        return HOME + p[1:] if p == "~" or p.startswith("~/") else p

    def pref_folder():
        f = global_pref("LOCALDATA.FOLDER") or ""
        return expand(f) if f.strip() else HOME + "/.ECCE-local"

    env = os.environ
    if "ECCE_LOCAL_DATA" in env:
        return expand(env["ECCE_LOCAL_DATA"]) if env["ECCE_LOCAL_DATA"] else ""
    if env.get("ECCE_LOCAL"):
        return pref_folder()
    if env.get("ECCE_REMOTE_SERVER"):
        return ""
    state = pref_state()
    on = state == "on" or (state == "unset" and sys.platform == "darwin")
    return pref_folder() if on else ""


def skip_reason():
    """Why the question is not asked, or None to ask."""
    env = os.environ
    if env.get("ECCE_NO_FIRST_START"):
        return "ECCE_NO_FIRST_START is set"
    if env.get("ECCE_REMOTE_SERVER"):
        return "a -remote session (ECCE_REMOTE_SERVER)"
    if "ECCE_LOCAL_DATA" in env or env.get("ECCE_LOCAL"):
        return "the data folder is given (ECCE_LOCAL_DATA or --local)"
    if not (WINDOWS or sys.platform == "darwin" or
            env.get("DISPLAY") or env.get("WAYLAND_DISPLAY")):
        return "no display"
    if os.path.exists(os.path.join(ECCE_HOME, "siteconfig", "RemoteServer", "DataServers")):
        return "the installation has a server configured (siteconfig/RemoteServer)"
    if os.path.exists(os.path.join(ECCE_HOME, "siteconfig", "SharedBroker")):
        return "a shared broker is declared (siteconfig/SharedBroker)"
    if os.path.exists(os.path.join(STATE, "mosquitto.server")):
        return "this account runs a central server"
    # Existing data says how ECCE was used, not that the user never wants
    # the other way: it only preselects the window's choice.
    # A recorded answer does not skip it: a laptop is used at home and on
    # campus, so the question comes at every start with the choice preselected.
    return None


def record(answer):
    """The answer, so the question is not asked again."""
    try:
        os.makedirs(STATE, exist_ok=True)
        with open(ANSWER, "w", newline="\n") as f:
            f.write(answer + "\n")
    except OSError:
        pass


def existing_setup():
    """Whether this user has used ECCE before the question existed."""
    return (os.path.exists(os.path.join(MINE, "DataServers")) or
            os.path.isdir(LOCAL_DEFAULT) or
            os.path.isdir(os.path.join(STATE, "dataserver")) or
            pref_state() != "unset")


def current_state():
    """(mode, text) for the Change Server window."""
    if os.path.exists(os.path.join(MINE, "DataServers")):
        host = ""
        try:
            t = open(os.path.join(MINE, "DataServers")).read()
            host = t.split("<Url>", 1)[1].split("</Url>", 1)[0].split("://", 1)[1].split("/", 1)[0]
        except (OSError, IndexError):
            pass
        return "server", ("Your calculations are kept on the server %s." % host), host
    folder = local_data_dir()
    if pref_state() == "on" or os.environ.get("ECCE_LOCAL_DATA") or folder:
        folder = folder or LOCAL_DEFAULT
        return "local", ("Your calculations are kept on this computer,\n"
                         "in the folder %s" % folder), ""
    return "here", ("Your calculations are kept by the data server on this computer,\n"
                    "in the folder %s" % os.path.join(STATE, "dataserver")), ""


def choose_local():
    os.makedirs(LOCAL_DEFAULT, mode=0o700, exist_ok=True)
    if os.path.exists(MINE):
        old = MINE + ".off"
        shutil.rmtree(old, ignore_errors=True)
        os.rename(MINE, old)
    rc, _ = run([tool("ecce-localdata"), "pref", "on"])
    if rc == 0:
        record("local")
    return rc == 0


def _resolve_host(host, timeout=5):
    """Resolve HOST with a deadline; getaddrinfo itself has no timeout."""
    result = queue.Queue(maxsize=1)

    def lookup():
        try:
            value = socket.getaddrinfo(host, None, type=socket.SOCK_STREAM)
        except OSError:
            value = []
        try:
            result.put_nowait(value)
        except queue.Full:
            pass

    threading.Thread(target=lookup, daemon=True).start()
    try:
        return result.get(timeout=timeout)
    except queue.Empty:
        return None


def _connect_resolved(addresses, port, timeout=5):
    """Connect to already-resolved addresses, sharing one deadline."""
    deadline = time.monotonic() + timeout
    last_error = None
    for family, socktype, proto, _, sockaddr in addresses:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        sock = socket.socket(family, socktype, proto)
        sock.settimeout(remaining)
        peer = (sockaddr[0], port) + tuple(sockaddr[2:])
        try:
            sock.connect(peer)
            return sock
        except OSError as error:
            last_error = error
            sock.close()
    if last_error:
        raise last_error
    raise OSError("no usable address for server")


class _ResolvedHTTPConnection(http.client.HTTPConnection):
    """HTTPConnection that uses the bounded DNS result from _resolve_host."""
    def __init__(self, host, port, addresses, **kwargs):
        self._addresses = addresses
        super().__init__(host, port, **kwargs)

    def connect(self):
        self.sock = _connect_resolved(self._addresses, self.port, self.timeout)


class _ResolvedHTTPSConnection(http.client.HTTPSConnection):
    """HTTPSConnection preserving HOST for SNI while connecting by IP."""
    def __init__(self, host, port, addresses, **kwargs):
        self._addresses = addresses
        super().__init__(host, port, **kwargs)

    def connect(self):
        sock = _connect_resolved(self._addresses, self.port, self.timeout)
        try:
            self.sock = self._context.wrap_socket(sock, server_hostname=self.host)
        except BaseException:
            sock.close()
            raise


def _reachable(host, port, https, context, addresses):
    """The first HTTP(S) answer's peer certificate (DER) or b"", else None."""
    try:
        if https:
            c = _ResolvedHTTPSConnection(host, port, addresses, timeout=5,
                                         context=context)
        else:
            c = _ResolvedHTTPConnection(host, port, addresses, timeout=5)
        c.request("GET", "/")
        c.getresponse().read(1)
        der = c.sock.getpeercert(True) if https else b""
        c.close()
        return der or b""
    except (OSError, ssl.SSLError, http.client.HTTPException):
        return None


def remote_setup(host, port, certificate=None, addresses=None):
    """~/.ECCE/RemoteServer for HOST, as `ecce-remote-setup HOST --user --auto`
    writes it: TLS with a certificate the system trusts, else TLS pinned to
    the certificate the server presents now, else plain http; the first that
    answers. With CERTIFICATE, require the server's TLS certificate to match
    that PEM file exactly; do not fall back to an unpinned connection.
    Returns which one, or None with nothing written."""
    pem = None
    way, scheme, dport = None, "http", port or 8096
    tport = port or 8443
    if addresses is None:
        addresses = _resolve_host(host)
    if addresses is None:
        return "resolve-timeout"
    if not addresses:
        return "resolve-failed"
    if certificate:
        try:
            with open(certificate, encoding="ascii") as f:
                pem = f.read()
            pinned = ssl.PEM_cert_to_DER_cert(pem)
            # PEM_cert_to_DER_cert returns DER bytes on current Python, but
            # older versions returned a hex string.
            pinned_der = pinned if isinstance(pinned, bytes) else bytes.fromhex(pinned)
        except (OSError, UnicodeError, ValueError):
            return "invalid-certificate"
        loose = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
        loose.check_hostname = False
        loose.verify_mode = ssl.CERT_NONE
        if _reachable(host, tport, True, loose, addresses) != pinned_der:
            return "certificate-mismatch"
        pem = ssl.DER_cert_to_PEM_cert(pinned_der)
        way, scheme, dport = "pinned", "https", tport
    else:
        ctx = ssl.create_default_context()
        # As lenient as curl was about certificate extensions; the chain and
        # the host name are still checked.
        ctx.verify_flags &= ~getattr(ssl, "VERIFY_X509_STRICT", 0)
        if _reachable(host, tport, True, ctx, addresses) is not None:
            way, scheme, dport = "trusted", "https", tport
        else:
            loose = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
            loose.check_hostname = False
            loose.verify_mode = ssl.CERT_NONE
            peer = _reachable(host, tport, True, loose, addresses)
            if peer:
                pem = ssl.DER_cert_to_PEM_cert(peer)
                way, scheme, dport = "pinned", "https", tport
        if way is None:
            pem = None
            if _reachable(host, dport, False, None, addresses) is None:
                return None
            way = "plain"
    if not broker_answers(host, way != "plain", addresses):
        return "nobroker-tls" if way != "plain" else "nobroker"

    site = os.path.join(ECCE_HOME, "siteconfig")
    try:
        base = open(os.path.join(site, "DataServers"), "rb").read()
    except OSError:
        return None
    url = ("%s://%s:%d/Ecce" % (scheme, host, dport)).encode()
    lines = []
    for ln in base.splitlines(True):
        ln = re.sub(rb"https?://[^:/]*:[0-9]*/Ecce", lambda m: url, ln)
        ln = re.sub(rb"<Desc>[^<]*</Desc>",
                    lambda m: b"<Desc>ECCE Data Server on " + host.encode() + b"</Desc>",
                    ln, count=1)
        lines.append(ln)
    os.makedirs(MINE, mode=0o700, exist_ok=True)
    pin = os.path.join(MINE, "server.pem")
    if pem:
        with open(pin, "w", newline="\n") as f:
            f.write(pem)
    elif os.path.exists(pin):
        os.remove(pin)
    try:
        rt = open(os.path.join(site, "site_runtime"), "rb").read()
        rt = re.sub(rb"https?://[^:/]*:[0-9]*",
                    lambda m: ("%s://%s:%d" % (scheme, host, dport)).encode(), rt)
        with open(os.path.join(MINE, "site_runtime"), "wb") as f:
            f.write(rt)
    except OSError:
        pass
    with open(os.path.join(MINE, "DataServers"), "wb") as f:
        f.write(b"".join(lines))
    return way


def server_installed():
    return os.path.exists(os.path.join(ECCE_HOME, "bin", "ecce-dataserver-start"))


def is_this_computer(host):
    h = host.strip("[]").lower()
    if h in ("localhost", "127.0.0.1", "::1"):
        return True
    name = socket.gethostname().lower()
    if h == name or h == name.split(".")[0]:
        return True
    #  getfqdn() does a reverse lookup that can hang for many seconds on
    #  macOS; only a dotted name can be this computer's full name.
    return "." in h and h.split(".")[0] == name.split(".")[0] and \
        h == socket.getfqdn().lower()


def broker_port(tls):
    return int(os.environ.get("ECCE_BROKER_TLS_PORT", 8883) if tls
               else os.environ.get("ECCE_BROKER_PORT", 8088))


def broker_answers(host, tls=False, addresses=None):
    try:
        if addresses is None:
            addresses = _resolve_host(host)
        if not addresses:
            return False
        _connect_resolved(addresses, broker_port(tls), timeout=5).close()
        return True
    except OSError:
        return False


def last_server():
    """Host of the server used before, also when it is switched off."""
    for d in (MINE, MINE + ".off"):
        try:
            t = open(os.path.join(d, "DataServers")).read()
            u = t.split("<Url>", 1)[1].split("</Url>", 1)[0]
            return u.split("://", 1)[1].split("/", 1)[0].rsplit(":", 1)[0]
        except (OSError, IndexError):
            pass
    return ""


def choose_peruser():
    """This computer's own per-user data server: the state of the "here" mode."""
    if os.path.exists(MINE):
        old = MINE + ".off"
        shutil.rmtree(old, ignore_errors=True)
        os.rename(MINE, old)
    run([tool("ecce-localdata"), "pref", "off"])
    record("server this computer")


def choose_server(address, certificate=None):
    """None when connected, else a sentence for the user."""
    address = address.strip()
    if not address or any(c.isspace() for c in address) or "/" in address:
        return "Type the address of the server, for example ecce.example.edu"
    if address.startswith(("http:", "https:")):
        return "Type only the name of the server, without http://"
    host, _, port = address.partition(":")
    if not host or (port and not port.isdigit()):
        return "Type the address of the server, for example ecce.example.edu"
    addresses = _resolve_host(host)
    if addresses is None:
        return "Looking up %s timed out. Check the server address or DNS and try again." % host
    if not addresses:
        return "Could not resolve the server address %s. Check the address and try again." % host
    if (not certificate and is_this_computer(host) and server_installed() and
            not broker_answers(host, addresses=addresses)):
        choose_peruser()
        return None
    way = remote_setup(host, int(port) if port else None, certificate, addresses)
    if way == "resolve-timeout":
        return "Looking up %s timed out. Check the server address or DNS and try again." % host
    if way == "resolve-failed":
        return "Could not resolve the server address %s. Check the address and try again." % host
    if way == "invalid-certificate":
        return "Select a readable PEM certificate provided by the server administrator."
    if way == "certificate-mismatch":
        return ("The server certificate does not match the selected file, or the server's "
                "TLS endpoint could not be reached. Check the address and certificate.")
    if way and way.startswith("nobroker"):
        return ("ECCE could not reach the message broker of %s (port %d).\n"
                "Ask the administrator whether the server is set up for other "
                "computers (ecce-remote-setup --server)."
                % (host, broker_port(way == "nobroker-tls")))
    if way:
        print(way)
    else:
        return ("ECCE could not connect to \"%s\".\n"
                "Check the address and your network connection, then try again."
                % address)
    run([tool("ecce-localdata"), "pref", "off"])
    record("server " + address)
    return None


def build_dialog(wx, change):
    # The first time too: what is set up already is preselected.
    mode, text, host = current_state()
    # The address field offers the last server, else this computer when it
    # has a server package; "host" stays the active server for Continue.
    #  The own data server is reached as "a server on this computer".
    suggested = host or ("localhost" if mode == "here" else "") or \
        last_server() or ("localhost" if server_installed() else "")
    if not change and not existing_setup():
        mode, text = "", ""

    dlg = wx.Dialog(None, title="Change server" if change else "Welcome to ECCE")
    panel = wx.Panel(dlg)
    top = wx.BoxSizer(wx.VERTICAL)
    box = wx.BoxSizer(wx.VERTICAL)
    panel.SetSizer(box)

    def label(s, bold=False, size=0):
        t = wx.StaticText(panel, label=s)
        f = t.GetFont()
        if bold:
            f.SetWeight(wx.FONTWEIGHT_BOLD)
        if size:
            f.SetPointSize(f.GetPointSize() + size)
        t.SetFont(f)
        return t

    if text:
        box.Add(label(text), 0, wx.BOTTOM, 16)
    box.Add(label("Where do you want to work?", True, 3), 0, wx.BOTTOM, 12)

    r_local = wx.RadioButton(panel, label="Store data on this computer", style=wx.RB_GROUP)
    r_server = wx.RadioButton(panel, label="Connect to a server")
    for r in (r_local, r_server):
        f = r.GetFont()
        f.SetWeight(wx.FONTWEIGHT_BOLD)
        r.SetFont(f)
    box.Add(r_local, 0)
    box.Add(label("Your calculations are saved in a folder on this computer."),
            0, wx.LEFT | wx.BOTTOM, 24)
    box.Add(r_server, 0, wx.TOP, 8)
    box.Add(label("Your calculations are kept on an ECCE server. Enter its address;\n"
                  "this computer's own server is filled in if it has one."),
            0, wx.LEFT, 24)
    row = wx.BoxSizer(wx.HORIZONTAL)
    row.Add(wx.StaticText(panel, label="Server address:"), 0,
            wx.ALIGN_CENTER_VERTICAL | wx.RIGHT, 8)
    addr = wx.TextCtrl(panel, size=(280, -1), value=suggested)
    row.Add(addr, 1)
    box.Add(row, 0, wx.EXPAND | wx.LEFT | wx.TOP, 24)
    box.Add(label("for example  ecce.example.edu"), 0, wx.LEFT | wx.TOP, 4)

    cert_row = wx.BoxSizer(wx.HORIZONTAL)
    cert_row.Add(wx.StaticText(panel, label="Server certificate:"), 0,
                 wx.ALIGN_CENTER_VERTICAL | wx.RIGHT, 8)
    cert_value = wx.TextCtrl(panel, size=(280, -1), style=wx.TE_READONLY)
    cert_row.Add(cert_value, 1, wx.RIGHT, 8)
    cert_button = wx.Button(panel, label="Choose file...")
    cert_row.Add(cert_button, 0)
    box.Add(cert_row, 0, wx.EXPAND | wx.LEFT | wx.TOP, 24)
    box.Add(label("Optional: select the PEM certificate provided by the server administrator."),
            0, wx.LEFT | wx.TOP, 4)

    def choose_certificate(_evt=None):
        wildcard = ("Certificate files (*.pem;*.crt;*.cer)|*.pem;*.crt;*.cer|"
                    "All files (*.*)|*.*")
        dlg_file = wx.FileDialog(dlg, "Select the server certificate",
                                 wildcard=wildcard,
                                 style=wx.FD_OPEN | wx.FD_FILE_MUST_EXIST)
        try:
            if dlg_file.ShowModal() == wx.ID_OK:
                cert_value.SetValue(dlg_file.GetPath())
                r_server.SetValue(True)
                sync()
        finally:
            dlg_file.Destroy()

    cert_button.Bind(wx.EVT_BUTTON, choose_certificate)

    status = wx.StaticText(panel, label="")
    status.SetForegroundColour(wx.Colour(168, 32, 32))
    box.Add(status, 0, wx.TOP, 12)

    r_server.SetValue(mode in ("server", "here"))
    r_local.SetValue(mode not in ("server", "here"))

    def sync(_evt=None):
        addr.Enable(r_server.GetValue())
        cert_value.Enable(r_server.GetValue())
        cert_button.Enable(r_server.GetValue())
        status.SetLabel("")
        panel.Layout()
    r_local.Bind(wx.EVT_RADIOBUTTON, sync)
    r_server.Bind(wx.EVT_RADIOBUTTON, sync)
    sync()

    btns = wx.BoxSizer(wx.HORIZONTAL)
    btns.AddStretchSpacer()
    cancel = wx.Button(dlg, wx.ID_CANCEL, "Cancel" if change else "Quit")
    go = wx.Button(dlg, wx.ID_OK, "Continue")
    go.SetDefault()
    btns.Add(cancel, 0, wx.RIGHT, 8)
    btns.Add(go, 0)

    top.Add(panel, 1, wx.EXPAND | wx.ALL, 20)
    top.Add(btns, 0, wx.EXPAND | wx.LEFT | wx.RIGHT | wx.BOTTOM, 20)
    dlg.SetSizerAndFit(top)
    dlg.CentreOnScreen()

    result = {}

    def finish(_evt=None):
        status.SetLabel("")
        if r_local.GetValue():
            if mode == "local":
                result["changed"] = False
            elif not choose_local():
                status.SetLabel("ECCE could not save this choice.")
                panel.Layout()
                return
            else:
                result["changed"] = True
        elif mode == "here" and is_this_computer(addr.GetValue().strip().split(":")[0]):
            record("server this computer")   # the own data server, kept
            result["changed"] = False
        elif (mode == "server" and addr.GetValue().strip() == host and
              not cert_value.GetValue().strip()):
            result["changed"] = False   # the server already set up
        else:
            go.Disable()
            cancel.Disable()
            status.SetLabel("Connecting to %s ..." % addr.GetValue().strip())
            panel.Layout()
            wx.GetApp().Yield()
            err = choose_server(addr.GetValue(), cert_value.GetValue().strip() or None)
            go.Enable()
            cancel.Enable()
            if err:
                status.SetLabel(err)
                panel.Layout()
                dlg.Fit()
                return
            result["changed"] = True
        dlg.EndModal(wx.ID_OK)
    go.Bind(wx.EVT_BUTTON, finish)

    def picture(path):
        w, h = dlg.GetSize()
        bmp = wx.Bitmap(w, h)
        mem = wx.MemoryDC(bmp)
        mem.Blit(0, 0, w, h, wx.ScreenDC(), *dlg.GetPosition())
        mem.SelectObject(wx.NullBitmap)
        bmp.SaveFile(path, wx.BITMAP_TYPE_PNG)

    def refused():
        # An answered window that is still open was refused: leave, so a
        # test never waits for a click.
        if not dlg.IsShown():
            return

        def leave():
            result["refused"] = status.GetLabel()
            dlg.EndModal(wx.ID_CANCEL)
        wx.CallLater(800, leave)

    shot = os.environ.get("ECCE_FIRST_START_SHOT")

    def hooks():
        if shot:
            picture(shot)
        ans = os.environ.get("ECCE_FIRST_START_ANSWER", "")
        if ans:
            sys.stderr.write("ecce-first-start: preselected %s\n" %
                             ("server" if r_server.GetValue() else "local"))
            sys.stderr.write("ecce-first-start: address %s\n" % addr.GetValue())
        if ans == "continue":
            finish()
        elif ans == "local":
            r_local.SetValue(True)
            sync()
            finish()
        elif ans.startswith("server:"):
            r_server.SetValue(True)
            sync()
            addr.SetValue(ans[7:])
            finish()
        if ans:
            wx.CallLater(1500, refused)
    wx.CallLater(700, hooks)
    return dlg, result


def main(argv):
    change = "--change" in argv
    if "--apply" in argv:
        ans = argv[argv.index("--apply") + 1] if argv.index("--apply") + 1 < len(argv) else ""
        if ans == "local":
            return 0 if choose_local() else 1
        if ans.startswith("server:"):
            err = choose_server(ans[7:])
            if err:
                sys.stderr.write("ecce-first-start: " + err + "\n")
            return 1 if err else 0
        return 2
    why = None if change else skip_reason()
    if "--check" in argv:
        print("ask" if why is None else "skip: " + why)
        return 0 if why is None else 1
    if os.environ.get("ECCE_FIRST_START_ANSWER"):
        sys.stderr.write("ecce-first-start: %s\n" % ("asking" if why is None else "not asking: " + why))
    if why is not None:
        return 0
    try:
        import wx
    except ImportError:
        sys.stderr.write("ecce-first-start: wxPython is not installed; not asking.\n")
        return 0
    app = wx.App(False)
    if not wx.GetDisplaySize()[0]:
        return 0
    dlg, result = build_dialog(wx, change)
    answer = dlg.ShowModal()
    dlg.Destroy()
    if result.get("refused"):
        sys.stderr.write("ecce-first-start: refused: %s\n" % result["refused"])
        return 4
    if answer != wx.ID_OK:
        return 0 if change else 3
    if change and result.get("changed"):
        m = wx.MessageDialog(None,
                             "The change takes effect the next time you start ECCE.\n"
                             "Close all ECCE windows, then start ECCE again.",
                             "Change server", wx.OK | wx.ICON_INFORMATION)
        if not os.environ.get("ECCE_FIRST_START_ANSWER"):
            m.ShowModal()
        m.Destroy()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except SystemExit:
        raise
    except Exception as e:  # never keep ECCE from starting over this window
        sys.stderr.write("ecce-first-start: %s; going on without asking.\n" % e)
        sys.exit(0)
