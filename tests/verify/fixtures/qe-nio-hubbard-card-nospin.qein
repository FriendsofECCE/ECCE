&CONTROL
  calculation = 'scf'
  prefix = 'nio'
  outdir = './qe.scratch'
  pseudo_dir = '/usr/share/espresso/pseudo/'
  tprnfor = .true.
  tstress = .false.
/
&SYSTEM
  ibrav = 0
  nat = 2
  ntyp = 2
  ecutwfc = 30.0
  ecutrho = 240
  occupations = 'smearing'
  smearing = 'gaussian'
  degauss = 0.01
/
&ELECTRONS
  conv_thr = 1e-7
  mixing_beta = 0.3
/
ATOMIC_SPECIES
  Ni     58.6934  ni_pbe_v1.4.uspp.F.UPF
  O      15.9994  O.pbe-n-kjpaw_psl.0.1.UPF
CELL_PARAMETERS angstrom
      0.0000000000     2.0850000000     2.0850000000
      2.0850000000     0.0000000000     2.0850000000
      2.0850000000     2.0850000000     0.0000000000
ATOMIC_POSITIONS angstrom
  Ni      0.0000000000     0.0000000000     0.0000000000
  O       2.0850000000     2.0850000000     2.0850000000
K_POINTS automatic
  2 2 2 0 0 0
HUBBARD {ortho-atomic}
  U Ni-3d 4.0
