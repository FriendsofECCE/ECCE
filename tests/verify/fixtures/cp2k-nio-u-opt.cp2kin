&GLOBAL
  PROJECT nio
  RUN_TYPE GEO_OPT
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    CHARGE 0
    UKS
    MULTIPLICITY 3
    &MGRID
      NGRIDS 4
      CUTOFF 150
      REL_CUTOFF 30
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-10
    &END QS
    &POISSON
      PERIODIC XYZ
    &END POISSON
    &SCF
      SCF_GUESS ATOMIC
      MAX_SCF 300
      EPS_SCF 1.0E-6
      &OT
        PRECONDITIONER FULL_ALL
        MINIMIZER CG
        LINESEARCH 2PNT
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &PBE
        &END PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A [angstrom] 0.0000000000 2.0850000000 2.0850000000
      B [angstrom] 2.0850000000 0.0000000000 2.0850000000
      C [angstrom] 2.0850000000 2.0850000000 0.0000000000
      PERIODIC XYZ
    &END CELL
    &COORD
      Ni      0.0000000000     0.0000000000     0.0000000000
      O       2.1350000000     2.1150000000     2.0850000000
    &END COORD
    &KIND Ni
      BASIS_SET SZV-MOLOPT-SR-GTH-q18
      POTENTIAL GTH-PBE-q18
      &DFT_PLUS_U
        L 2
        U_MINUS_J [eV] 4.0
      &END DFT_PLUS_U
    &END KIND
    &KIND O
      BASIS_SET SZV-MOLOPT-SR-GTH-q6
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT
&END FORCE_EVAL
&MOTION
  &GEO_OPT
    OPTIMIZER BFGS
    MAX_ITER 3
    MAX_FORCE 4.5E-4
    RMS_FORCE 0.0003
    MAX_DR 3.0E-3
    RMS_DR 0.0015
  &END GEO_OPT
  &PRINT
    &TRAJECTORY
      FILENAME __STD_OUT__
      FORMAT XYZ
    &END TRAJECTORY
  &END PRINT
&END MOTION
