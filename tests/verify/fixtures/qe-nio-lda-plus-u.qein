&CONTROL
  calculation = 'scf'
  prefix = 'nio'
  outdir = './qe.scratch'
  pseudo_dir = '/usr/share/espresso/pseudo/'
  tprnfor = .true.
  tstress = .false.
/
&SYSTEM
  ibrav = 0
  nat = 2
  ntyp = 2
  ecutwfc = 30.0
  ecutrho = 240
  occupations = 'smearing'
  smearing = 'gaussian'
  degauss = 0.01
  nspin = 2
  starting_magnetization(1) = 0.5
  starting_magnetization(2) = 0.5
  lda_plus_u = .true.
  lda_plus_u_kind = 0
  U_projection_type = 'ortho-atomic'
  Hubbard_U(1) = 4.0
/
&ELECTRONS
  conv_thr = 1e-7
  mixing_beta = 0.3
/
ATOMIC_SPECIES
  Ni     58.6934  ni_pbe_v1.4.uspp.F.UPF
  O      15.9994  O.pbe-n-kjpaw_psl.0.1.UPF
CELL_PARAMETERS angstrom
      0.0000000000     2.0850000000     2.0850000000
      2.0850000000     0.0000000000     2.0850000000
      2.0850000000     2.0850000000     0.0000000000
ATOMIC_POSITIONS angstrom
  Ni      0.0000000000     0.0000000000     0.0000000000
  O       2.0850000000     2.0850000000     2.0850000000
K_POINTS automatic
  2 2 2 0 0 0
