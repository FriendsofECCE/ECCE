%begin%input file%1%char
Title "water-opt"

Start  water-opt

echo


charge 0

geometry autosym units angstrom
 O     0.000000     0.000000     0.000000
 H     0.766044     0.642788     0.000000
 H     -0.766044     0.642788     0.000000
end

ecce_print /home/user/ecce-runs/water-opt-project/water-opt/ecce.out

basis "ao basis" cartesian print
  H library "6-31G*"
  O library "6-31G*"
END



scf
  RHF
  nopen 0
end






driver
  default
end




task scf optimize
scf
end
task scf gradient
%end%input file%1%char
