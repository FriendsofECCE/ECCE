&CONTROL
  calculation = 'scf'
  prefix = 'si'
  pseudo_dir = '/usr/share/espresso/pseudo'
  outdir = './tmp'
  tstress = .true.
/
&SYSTEM
  ibrav = 2
  celldm(1) = 10.20
  nat = 2
  ntyp = 1
  ecutwfc = 12.0
/
&ELECTRONS
  conv_thr = 1.0d-6
/
ATOMIC_SPECIES
 Si 28.086 Si.pbe-n-rrkjus_psl.1.0.0.UPF
ATOMIC_POSITIONS alat
 Si 0.00 0.00 0.00
 Si 0.25 0.25 0.25
K_POINTS automatic
 2 2 2 0 0 0
