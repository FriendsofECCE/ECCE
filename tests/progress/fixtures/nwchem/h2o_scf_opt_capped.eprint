%begin%input file%1%char
Title "h2o opt capped"

Start  h2o

echo

charge 0

geometry autosym units angstrom
 O     0.000000     0.000000     0.000000
 H     0.900000     0.000000     0.900000
 H     -0.900000     0.000000     0.900000
end

ecce_print ecce.out

basis "ao basis" cartesian print
  H library "STO-3G"
  O library "STO-3G"
END

scf
  RHF
  nopen 0
end

driver
  maxiter 2
end

task scf optimize
%end%input file%1%char
%begin%version%1%char
Mon_May_12_21:20:53_2025 Version 7.2.3
%end%version%1%char
