%begin%input file%1%char
start nh3x


echo


charge 0

geometry noautosym units angstrom
 N     0.0     0.0     0.1
 H     0.0     0.94     -0.3
 H     0.81     -0.47     -0.3
 H     -0.81     -0.47     -0.3
 X     0.0     0.0     1.1
 zcoord
    angle 5 1 2 113.0 constant
    angle 5 1 3 113.0 constant
 end
end


basis "ao basis" cartesian print
N library "3-21G"
H library "3-21G"
END



scf
  RHF
  nopen 0
end









ecce_print nh3x_opt.eprint
task scf optimize 

%end%input file%1%char
