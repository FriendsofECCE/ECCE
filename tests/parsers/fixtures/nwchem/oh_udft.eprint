%begin%input file%1%char
start ohudft
title "OH radical UB3LYP single point ecce_print"
echo
charge 0
geometry units angstroms
  O   0.000000   0.000000   0.000000
  H   0.000000   0.000000   0.970000
end
basis
  * library STO-3G
end
ecce_print ohudft.eprint
dft
  mult 2
  xc b3lyp
  mulliken
end
task dft
%end%input file%1%char
