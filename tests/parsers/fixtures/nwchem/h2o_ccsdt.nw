Title "h2o"

Start  h2o

echo


charge 0

geometry noautosym units angstrom
 O     0.0     0.0     0.1173
 H     0.0     0.7572     -0.4692
 H     0.0     -0.7572     -0.4692
end

ecce_print h2o_ccsdt.eprint

basis "ao basis" cartesian print
  H library "6-31G*"
  O library "6-31G*"
END



scf
  rhf
  nopen 0
  maxiter 30
end


ccsd
  thresh 1e-6
  maxiter 20
end








task ccsd(t) energy
