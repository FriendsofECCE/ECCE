&CONTROL
  calculation = 'md'
  prefix = 'si'
  outdir = './qe.scratch'
  pseudo_dir = '/usr/share/espresso/pseudo/'
  tprnfor = .true.
  tstress = .false.
  dt = 20.6707
  nstep = 5
/
&SYSTEM
  ibrav = 0
  nat = 2
  ntyp = 1
  ecutwfc = 18.0
  ecutrho = 144
  occupations = 'fixed'
/
&ELECTRONS
  conv_thr = 1.0e-6
  mixing_beta = 0.7
/
&IONS
  ion_dynamics = 'verlet'
  ion_temperature = 'berendsen'
  tempw = 600
  nraise = 1
/
ATOMIC_SPECIES
  Si     28.0855  Si.pbe-n-rrkjus_psl.1.0.0.UPF
CELL_PARAMETERS angstrom
     -2.7150000000     0.0000000000     2.7150000000
      0.0000000000     2.7150000000     2.7150000000
     -2.7150000000     2.7150000000     0.0000000000
ATOMIC_POSITIONS angstrom
  Si      0.0000000000     0.0000000000     0.0000000000
  Si     -1.3000000000     1.4000000000     1.3500000000
K_POINTS automatic
  2 2 2 0 0 0
