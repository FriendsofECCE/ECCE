&CONTROL
  calculation = 'relax'
  prefix = 'h2o_relax'
  outdir = './qe.scratch'
  pseudo_dir = '/usr/share/espresso/pseudo/'
  tprnfor = .true.
  forc_conv_thr = 1.0d-3
/
&SYSTEM
  ibrav = 0
  nat = 3
  ntyp = 2
  ecutwfc = 30.0
  occupations = 'fixed'
/
&ELECTRONS
  conv_thr = 1e-06
  mixing_beta = 0.7
/
&IONS
  ion_dynamics = 'bfgs'
/
ATOMIC_SPECIES
  O      15.9994  O.pbe-n-kjpaw_psl.0.1.UPF
  H       1.0079  H.pbe-rrkjus_psl.1.0.0.UPF
CELL_PARAMETERS angstrom
     10.0000000000     0.0000000000     0.0000000000
      0.0000000000    10.0000000000     0.0000000000
      0.0000000000     0.0000000000    10.0000000000
ATOMIC_POSITIONS angstrom
  O       5.0000000000     5.0000000000     5.0000000000
  H       5.9000000000     5.0000000000     5.7000000000
  H       4.2413980000     5.0000000000     5.5858820000
K_POINTS gamma
