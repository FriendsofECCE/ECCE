; Flexible SPC water as ClayFF uses it (Cygan et al. 2004, Tables 1 and 2):
; q(O) -0.82, q(H) 0.41, O-H 1.0 A with 554.1349 kcal/mol/A^2 (GROMACS
; kb = 2 k = 463700 kJ/mol/nm^2) and H-O-H 109.47 deg with 45.7696
; kcal/mol/rad^2 (ktheta = 2 k = 383.0 kJ/mol/rad^2). -DRIGID_WATER gives
; the rigid SPC geometry instead.
[ moleculetype ]
; molname	nrexcl
SOL		2

[ atoms ]
;   nr   type  resnr residue  atom   cgnr     charge       mass
     1     Ow      1    SOL     OW      1      -0.82   15.99940
     2     Hw      1    SOL    HW1      1       0.41    1.00800
     3     Hw      1    SOL    HW2      1       0.41    1.00800

#ifdef RIGID_WATER
[ settles ]
; OW	funct	doh	dhh
1	1	0.1	0.16330

[ exclusions ]
1	2	3
2	1	3
3	1	2
#else
[ bonds ]
; i	j	funct	length	force.c.
1	2	1	0.1	463700
1	3	1	0.1	463700

[ angles ]
; i	j	k	funct	angle	force.c.
2	1	3	1	109.47	383.00
#endif
