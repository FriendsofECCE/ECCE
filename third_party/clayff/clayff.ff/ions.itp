; Aqueous ions of ClayFF (Cygan et al. 2004, Table 1; their Lennard-Jones
; parameters are in ffnonbonded.itp, Na and Cl from Smith and Dang, K and Ca
; from Koneshan et al., Cs from Smith and Dang, Ba from Aqvist). Molecule and
; atom names follow min.ff's ions.itp, so the Prepare job treats them alike.

[ moleculetype ]
; molname   nrexcl
Na      1

[ atoms ]
; id  at type  res nr  residu name  at name  cg nr  charge
1  Na     1   Na     Na+    1   1.00000

#ifdef POSRES_ION
[ position_restraints ]
1 1 1000 1000 1000
#endif

[ moleculetype ]
; molname   nrexcl
K       1

[ atoms ]
; id  at type  res nr  residu name  at name  cg nr  charge
1  K      1   K      K+     1   1.00000

#ifdef POSRES_ION
[ position_restraints ]
1 1 1000 1000 1000
#endif

[ moleculetype ]
; molname   nrexcl
Cs      1

[ atoms ]
; id  at type  res nr  residu name  at name  cg nr  charge
1  Cs     1   Cs     Cs+    1   1.00000

#ifdef POSRES_ION
[ position_restraints ]
1 1 1000 1000 1000
#endif

[ moleculetype ]
; molname   nrexcl
Ca      1

[ atoms ]
; id  at type  res nr  residu name  at name  cg nr  charge
1  Ca     1   Ca     Ca2+   1   2.00000

#ifdef POSRES_ION
[ position_restraints ]
1 1 1000 1000 1000
#endif

[ moleculetype ]
; molname   nrexcl
Ba      1

[ atoms ]
; id  at type  res nr  residu name  at name  cg nr  charge
1  Ba     1   Ba     Ba2+   1   2.00000

#ifdef POSRES_ION
[ position_restraints ]
1 1 1000 1000 1000
#endif

[ moleculetype ]
; molname   nrexcl
Cl      1

[ atoms ]
; id  at type  res nr  residu name  at name  cg nr  charge
1  Cl     1   Cl     Cl-    1   -1.00000

#ifdef POSRES_ION
[ position_restraints ]
1 1 1000 1000 1000
#endif
