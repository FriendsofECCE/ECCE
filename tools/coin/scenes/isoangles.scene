# Synthetic pi field seen from the front, 45 and 90 degrees about the
# vertical axis, in each transparency mode (tools/coin/angles.py).
labels none
style Ball And Stick
viewall
isotest
transparency SCREEN_DOOR
snap @SYS@-sd-a000
rotate 45
snap @SYS@-sd-a045
rotate 45
snap @SYS@-sd-a090
rotate -90
transparency DELAYED_ADD
snap @SYS@-da-a000
rotate 45
snap @SYS@-da-a045
rotate 45
snap @SYS@-da-a090
rotate -90
transparency SORTED_OBJECT_BLEND
snap @SYS@-sb-a000
rotate 45
snap @SYS@-sb-a045
rotate 45
snap @SYS@-sb-a090
rotate -90
# Coin only: depth peeling (the vendored column stays the per-object sort).
transparency SORTED_OBJECT_BLEND
coin: transparency SORTED_LAYERS_BLEND
coin: layerpasses 6
snap @SYS@-sl-a000
exportiso @SYS@-ref-a000
rotate 45
snap @SYS@-sl-a045
exportiso @SYS@-ref-a045
rotate 45
snap @SYS@-sl-a090
exportiso @SYS@-ref-a090
# Thumbnail path (Coin: EGL offscreen) in the same mode.
thumb @SYS@-sl-thumb
