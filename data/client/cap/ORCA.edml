<?xml version="1.0" encoding="utf-8" ?>

<!--
   See online documenation at http://www.emsl.pnl.gov:2080/docs/ecce

   ORCA support (issue #38), reduced-scope first cut: RHF/UHF/RDFT/UDFT
   crossed with Energy/Gradient/Geometry/Vibration/GeoVib only, no MP2/
   CC/CI. Cloned from Gaussian-16.edml. All of <Editor>'s dialog
   scripts (orcatheory.py/orcaruntype.py) and <IntegrationFiles>
   targets (ai.orca, std2ORCA, orca.tpl, ORCA.desc's underlying
   scripts) now exist and the input-generation half has been verified
   end to end against a real ORCA 6.1.1 install (2026-09-06 session):
   ai.orca's generated input files were run for real and converged.
   The ORCA.expt output importer (for reading externally-run jobs back
   into ECCE, as opposed to parsing jobs ECCE itself submitted) is not
   yet written. GaussianBasisSetRules/MOOrdering below are still
   placeholders carried over unmodified from Gaussian-16.edml and have
   not been checked against ORCA's actual basis-set/MO conventions.
-->

<appdescriptor>

<GaussianBasisSetRules>
  <MaxLValue>6</MaxLValue>
  <ECPS>True</ECPS>
  <GeneralContractions>False</GeneralContractions>
  <PreferOptimization>	True</PreferOptimization>
  <MaxPrimitives>100 100 100 100 100 100</MaxPrimitives>
  <MaxSharedExponent>      1 </MaxSharedExponent>
  <SphericalCoordinates>	True </SphericalCoordinates>
  <DFTFitting>		False</DFTFitting>
  <RecommendDFTCharge>	False </RecommendDFTCharge>
  <RequireFullDFT>         False </RequireFullDFT>
  <MaxTotalFunctions>	64000</MaxTotalFunctions>
  <MaxTotalPrimitives>	7500</MaxTotalPrimitives>
  <MultipleOrbitals>	false</MultipleOrbitals>
  <LibraryNames>	True</LibraryNames>
  <AllowMultipleOrbitals>False</AllowMultipleOrbitals>
</GaussianBasisSetRules>


<!--
  Enables Geometry and Partial Charge sub dialogs if runtype is appropriate
-->
<SupportsConstraints>true</SupportsConstraints>


<GeometryConstraintRules>
  <SupportsAtomConstraints>true</SupportsAtomConstraints>
  <SupportsConstrainBonds>true</SupportsConstrainBonds>
  <SupportsConstrainAngles>true</SupportsConstrainAngles>
  <SupportsConstrainTorsions>true</SupportsConstrainTorsions>
  <SupportsRestrainBonds>false</SupportsRestrainBonds>
  <SupportsRestrainAngles>false</SupportsRestrainAngles>
  <SupportsRestrainTorsions>false</SupportsRestrainTorsions>
  <SupportsFixedAtomsAndConstraints>true</SupportsFixedAtomsAndConstraints>
  <SupportsFixedAtomsAndRestraints>false</SupportsFixedAtomsAndRestraints>
  <SupportsMixedConstraintsAndRestraints>false</SupportsMixedConstraintsAndRestraints>
</GeometryConstraintRules>


<MOOrdering type="cartesian" >
   <lshell lval="0" a1="1"></lshell>
   <lshell lval="1" a1="x" a2="y" a3="z"></lshell>
   <lshell lval="2" a1="xx" a2="yy" a3="zz" a4="xy" a5="xz"
    a6="yz"></lshell>
   <lshell lval="3" a1="xxx" a2="yyy" a3="zzz" a4="xyy" a5="xxy" a6="xxz"
    a7="xzz" a8="yzz" a9="yyz" a10="xyz"></lshell>
   <lshell lval="4" a1="zzzz" a2="yzzz" a3="yyzz" a4="yyyz" a5="yyyy"
    a6="xzzz" a7="xyzz" a8="xyyz" a9="xyyy" a10="xxzz"
    a11="xxyz" a12="xxyy" a13="xxxz" a14="xxxy"
    a15="xxxx"></lshell>
</MOOrdering>

<MOOrdering type="spherical" >
   <lshell lval="0" a1="1"></lshell>
   <lshell lval="1" a1="x" a2="y" a3="z"></lshell>
   <lshell lval="2" a1="-xx/2-yy/2+zz" a2="xz" a3="yz" a4="xx/2-yy/2"
    a5="xy"></lshell>
   <lshell lval="3" a1="-3xxz/2-3yyz/2+zzz" a2="-xxx/2-xyy/2+2xzz"
    a3="-xxy/2-yyy/2+2yzz" a4="xxz/2-yyz/2" a5="xyz"
    a6="xxx/2-3xyy/2" a7="3xxy/2-yyy/2"></lshell>
</MOOrdering>


<!-- Minimum-support method list per issue #38: RHF/UHF and RDFT/UDFT,
     each with Energy/Gradient/Geometry/Vibration/GeoVib runtypes, plus
     Magnetic (NMR shielding) for the closed-shell theories only. NMR
     shielding is a closed-shell property in ORCA (open-shell magnetic
     properties are EPR, a different keyword/property set, not covered
     here). Extend with MP2/CC/CI categories once the basics round-trip. -->
<Editor theorydialog="orcatheory.py" runtypedialog="orcaruntype.py">
  <Theory category="SCF" name="RHF">
    <runtype>Energy</runtype>
    <runtype>Gradient</runtype>
    <runtype>Geometry</runtype>
    <runtype>Vibration</runtype>
    <runtype>GeoVib</runtype>
    <runtype>Magnetic</runtype>
  </Theory>
  <Theory category="SCF" name="UHF">
    <runtype>Energy</runtype>
    <runtype>Gradient</runtype>
    <runtype>Geometry</runtype>
    <runtype>Vibration</runtype>
    <runtype>GeoVib</runtype>
  </Theory>
  <Theory category="DFT" name="RDFT">
    <runtype>Energy</runtype>
    <runtype>Gradient</runtype>
    <runtype>Geometry</runtype>
    <runtype>Vibration</runtype>
    <runtype>GeoVib</runtype>
    <runtype>Magnetic</runtype>
  </Theory>
  <Theory category="DFT" name="UDFT">
    <runtype>Energy</runtype>
    <runtype>Gradient</runtype>
    <runtype>Geometry</runtype>
    <runtype>Vibration</runtype>
    <runtype>GeoVib</runtype>
  </Theory>

  <!-- MP2 and coupled cluster (issue #91). Runtypes are deliberately
       NOT copied from the SCF/DFT blocks above:

       MP2 has analytic gradients in ORCA, so Gradient and Geometry are
       genuine. Vibration and GeoVib are omitted because the frequencies
       would be numerical, which is a different cost class the user
       should opt into knowingly rather than discover.

       Coupled cluster offers Energy only. CCSD and CCSD(T) gradients
       are not available for the general case here, and a numerical
       geometry optimisation at CCSD(T) is not something to offer from
       a menu.

       Magnetic is absent from both: NMR shielding in ORCA is an SCF/DFT
       property. -->
  <Theory category="MP2" name="RMP2">
    <runtype>Energy</runtype>
    <runtype>Gradient</runtype>
    <runtype>Geometry</runtype>
  </Theory>
  <Theory category="MP2" name="UMP2">
    <runtype>Energy</runtype>
    <runtype>Gradient</runtype>
    <runtype>Geometry</runtype>
  </Theory>
  <Theory category="CC" name="CCSD">
    <runtype>Energy</runtype>
  </Theory>
  <Theory category="CC" name="CCSD(T)">
    <runtype>Energy</runtype>
  </Theory>

  <!-- DLPNO: domain-based local pair natural orbital methods, the
       reason this code was wanted in the first place (issue #38 cites
       Paulechka and Kazakov 2017). They give near-canonical accuracy at
       a fraction of the cost, which is what makes coupled cluster
       usable on a real molecule rather than a test case.

       Verified against ORCA 6.1.1 on water/def2-SVP: DLPNO-CCSD(T)
       gives -76.174731 against canonical CCSD(T)'s -76.174709, a
       difference of 22 microhartree, which is the expected size of the
       DLPNO approximation.

       All three REQUIRE a correlation-fitting auxiliary basis; without
       one they die at runtime with exit 55, exactly as the double
       hybrids do. ai.orca's AuxCBasisToken adds it. -->
  <Theory category="MP2" name="DLPNO-MP2">
    <runtype>Energy</runtype>
  </Theory>
  <Theory category="CC" name="DLPNO-CCSD">
    <runtype>Energy</runtype>
  </Theory>
  <Theory category="CC" name="DLPNO-CCSD(T)">
    <runtype>Energy</runtype>
  </Theory>

  <TheorySummary>
    <item key="ES.Theory.SCF.Direct" label="SCF Integrals"></item>
  </TheorySummary>
  <TheorySummary>
    <item key="ES.Theory.SCF.ConvergenceAlgorithm" label="SCF Conv. Algorithm"></item>
  </TheorySummary>
  <TheorySummary topLabel="SCF Convergence-">
    <item key="ES.Theory.SCF.ConvergenceDensity.Value" label="Density"></item>
  </TheorySummary>
  <TheorySummary>
    <item key="ES.Theory.SCF.ConvergenceIterations" label="SCF Max. Iterations"></item>
  </TheorySummary>
  <TheorySummary>
    <item key="ES.Theory.DFT.XCFunctionals" label="DFT Combined Func."></item>
  </TheorySummary>
  <TheorySummary>
    <item key="ES.Theory.DFT.ExchangeFunctionals" label="DFT Exchange Func."></item>
  </TheorySummary>
  <TheorySummary>
    <item key="ES.Theory.DFT.CorrelationFunctionals" label="DFT Corr Func."></item>
  </TheorySummary>

  <RuntypeSummary topLabel="Geom. Convergence-">
    <item key="ES.Runtype.GeomOpt.ConvergenceGradient.Value" label="Gradient"></item>
  </RuntypeSummary>
  <RuntypeSummary>
    <item key="ES.Runtype.GeomOpt.SearchFor" label="Search for"></item>
  </RuntypeSummary>
  <RuntypeSummary>
    <item key="ES.Runtype.GeomOpt.MaximumStepsValue" label="Max. Steps"></item>
  </RuntypeSummary>
</Editor>


<!-- Raw File Naming Conventions
-->

<!-- .orcain/.orcaout, not the generic .in/.out first tried here: Apache
     has no built-in MIME mapping for those, so the file's Content-Type
     silently fell back to text/plain, and ECCE's mimetype-filtered
     lookup for the primary input file couldn't match it against
     chemical/x-orca-input even though the file existed on disk (see
     packaging/dataserver/httpd.conf.ecce's ORCA AddType lines, added
     alongside this fix). Every other code's DataFiles block uses an
     equally distinctive extension for the same reason. -->
<DataFiles>
  <Input   type="primary" mimetype="chemical/x-orca-input" comment="true" commentstring="#">orca.orcain</Input>
  <Output type="primary" mimetype="chemical/x-orca-output">orca.orcaout</Output>
  <Output type="parse" verifypattern="O   R   C   A" mimetype="chemical/x-orca-output">orca.orcaout</Output>
</DataFiles>

<!-- Names of files required for code integration.  These files are
     assumed to be in the ecce path as managed by the ecce_env script.
     All exist under scripts/parsers except ORCA.expt (issue #38,
     output importer not yet written). -->
<IntegrationFiles>
  <Template>orca.tpl</Template>
  <InputGenerator>ai.orca</InputGenerator>
  <Importer>ORCA.expt</Importer>
  <ParseSpecification>orca.desc</ParseSpecification>
  <BasisTranslationScript>std2ORCA</BasisTranslationScript>
  <LaunchPreprocessor>orca.launchpp</LaunchPreprocessor>
</IntegrationFiles>

</appdescriptor>
