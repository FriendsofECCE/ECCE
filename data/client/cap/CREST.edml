<?xml version="1.0" encoding="utf-8" ?>

<!--
   CREST (Grimme group conformer-rotamer ensemble sampling tool)
   registration: conformer search, protonation sites, tautomers and the QCG solvation shell.  Modeled on xTB.edml.

   CREST drives xtb itself, so the job script gets the xtb path from the
   xTB entry of the same machine (its xtb option).  Semiempirical, so no basis set.

   The input file is one file in two parts, as for xtb: line 1 is the crest
   command line (options only), the rest is an xyz file; scripts/gensub
   splits it before the run.  The name must be .crestin for the Apache MIME
   mapping.

   CREST writes the ensemble to crest_conformers.xyz, not to its output, so
   gensub appends the conformers (with their relative energies) and
   crest_best.xyz to the output file between ECCE-CREST-FRAME markers;
   crest.desc reads the geometry trace from there.  The file is crest_conformers.xyz,
   protonated.xyz, tautomers.xyz or the QCG ensemble, by run type.
-->

<appdescriptor>

<SupportsConstraints>false</SupportsConstraints>

<Editor theorydialog="cresttheory.py" runtypedialog="crestruntype.py">
  <Theory category="SE" name="GFN2-xTB" needsBasis="false">
    <runtype>Conformer Search</runtype>
    <runtype>Protonation Sites</runtype>
    <runtype>Tautomers</runtype>
    <runtype>Solvation Shell</runtype>
  </Theory>
  <Theory category="SE" name="GFN-FF" needsBasis="false">
    <runtype>Conformer Search</runtype>
    <runtype>Solvation Shell</runtype>
  </Theory>
  <Theory category="SE" name="GFN2//GFN-FF" needsBasis="false">
    <runtype>Conformer Search</runtype>
  </Theory>

  <TheorySummary>
    <item key="ES.Theory.Solvent.Model" label="Solvent Model"></item>
  </TheorySummary>
  <TheorySummary>
    <item key="ES.Theory.Solvent.Name" label="Solvent"></item>
  </TheorySummary>
  <RuntypeSummary>
    <item key="ES.Runtype.Conformers.EnergyWindow" label="Energy Window (kcal/mol)"></item>
  </RuntypeSummary>
  <RuntypeSummary>
    <item key="ES.Runtype.QCG.Solvent" label="Solvent Molecule"></item>
  </RuntypeSummary>
  <RuntypeSummary>
    <item key="ES.Runtype.QCG.Number" label="Number of Solvent Molecules"></item>
  </RuntypeSummary>
  <RuntypeSummary>
    <item key="ES.Runtype.QCG.Ensemble" label="Ensemble of Clusters"></item>
  </RuntypeSummary>
</Editor>

<DataFiles>
  <Input  type="primary" mimetype="chemical/x-crest-input" comment="false">crest.crestin</Input>
  <Output type="primary" mimetype="chemical/x-crest-output">crest.crestout</Output>
  <Output type="parse" verifypattern="C R E S T" mimetype="chemical/x-crest-output">crest.crestout</Output>
</DataFiles>

<IntegrationFiles>
  <Template>crest.tpl</Template>
  <InputGenerator>ai.crest</InputGenerator>
  <ParseSpecification>crest.desc</ParseSpecification>
  <LaunchPreprocessor>crest.launchpp</LaunchPreprocessor>
</IntegrationFiles>

</appdescriptor>
