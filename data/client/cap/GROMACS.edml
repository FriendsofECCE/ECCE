<?xml version="1.0" encoding="utf-8" ?>
<!--
   GROMACS code registration: the MD study path, as NWChemMD uses it.

   A GROMACS calculation is a task in a GROMACS MD study (gromacs_md_study
   in ResourceDescriptor.xml and ResourceDescriptorRxn.xml), edited with the
   MD task editors.  There is no <InputGenerator> on purpose: that key is
   what makes CalcEd offer a code in its code switch, and a GROMACS task is
   not a CalcEd calculation.  The .mdp is written by <TaskInputGenerator>
   (md.gmxtask, which hands ai.gromacs the values); see docs/GROMACS.md.

   SCOPE: the user brings the topology (.top, with any .itp it includes)
   and the starting structure (.gro) from pdb2gmx or elsewhere and attaches
   them on the task's Files tab.  grompp turns .mdp + .top + .gro into the
   binary .tpr that mdrun runs; the .tpr is a build artefact and is not
   declared here.

   FILE TYPES.  A GROMACS topology is stored as ".gmxtop", not ".top": ".top"
   is NWChem's topology type in the data server's configuration, and giving
   it a second meaning would change what NWChem MD files resolve to.  The
   Files tab renames on attach; the job script writes it back as topol.top.
   Include files (.itp, .ndx) and the run log (.gmxlog) have their own types
   too, because a file the server cannot type is stored as text/plain and a
   lookup by type then cannot find it.
-->
<appdescriptor>

<DataFiles>
  <Input  type="primary" mimetype="chemical/x-gromacs-mdp" comment="true" commentstring=";">gromacs.mdp</Input>
  <!-- Attached by the user, matched by type: .itp and .ndx files the
       topology includes. -->
  <Input  type="auxiliary" mimetype="chemical/x-gromacs-include"></Input>
  <Output type="primary" mimetype="chemical/x-gromacs-log">gromacs.gmxlog</Output>
  <Output type="parse" verifypattern="GROMACS:" mimetype="chemical/x-gromacs-log">gromacs.gmxlog</Output>
  <!-- Attached by the user, matched by type.  "topology" and "restart" are
       the names the MD launch code looks up the study's earlier tasks by:
       a task finds its topology and starting structure on itself or on an
       earlier task, and a finished task's final structure is the next
       one's start. -->
  <Output type="topology" mimetype="chemical/x-gromacs-topology"></Output>
  <Output type="restart" mimetype="chemical/x-gromacs-coordinates"></Output>
  <!-- The final structure as PDB, which is what the Builder shows. -->
  <Output type="fragment" mimetype="chemical/x-pdb"></Output>
</DataFiles>

<!-- <LaunchPreprocessor> is required unconditionally:
     Launch::postProcessInput() shells out to JCode::launchPPScript() with
     no empty-string check.  Here it checks the topology and structure and
     runs grompp on the launching machine when gmx is there, so a mistake
     is reported at launch rather than found in the job log. -->
<IntegrationFiles>
  <Template>gromacs.tpl</Template>
  <TaskInputGenerator>md.gmxtask</TaskInputGenerator>
  <ParseSpecification>gromacs.desc</ParseSpecification>
  <LaunchPreprocessor>gromacs.launchpp</LaunchPreprocessor>
</IntegrationFiles>

</appdescriptor>
