#
# System defaults for run-state colours, for light and dark themes.
# Okabe-Ito hues, darkened (light) or lightened (dark) to reach 4.5:1
# against the theme background.  States that share an icon shape differ
# in lightness as well as hue, so they stay apart for colour-blind users.
# WxState.C holds the same values as a fallback.  Checked by
# tests/look/contrast.py.
#
RUNSTATE.COMPLETED:       #007e5c
RUNSTATE.CREATED:         #995b7d
RUNSTATE.FAILED:          #c23b22
RUNSTATE.KILLED:          #6b6b6b
RUNSTATE.LOADED:          #007e5c
RUNSTATE.READY:           #003f63
RUNSTATE.RUNNING:         #634400
RUNSTATE.SUBMITTED:       #387597
RUNSTATE.SYSTEM:          #000000
RUNSTATE.UNSUCCESSFUL:    #3f3c00
RUNSTATE.COMPLETED.DARK:  #36b290
RUNSTATE.CREATED.DARK:    #e6bcd4
RUNSTATE.FAILED.DARK:     #ff8f73
RUNSTATE.KILLED.DARK:     #b0b0b0
RUNSTATE.LOADED.DARK:     #36b290
RUNSTATE.READY.DARK:      #61a8cf
RUNSTATE.RUNNING.DARK:    #e69f00
RUNSTATE.SUBMITTED.DARK:  #a9dbf6
RUNSTATE.SYSTEM.DARK:     #ffffff
RUNSTATE.UNSUCCESSFUL.DARK: #f0e442
