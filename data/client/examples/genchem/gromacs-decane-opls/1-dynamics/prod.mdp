; 5 ns NPT production, positions every 1 ps (500 steps)
cutoff-scheme = Verlet
coulombtype = PME
rcoulomb = 1.0
fourierspacing = 0.12
vdwtype = Cut-off
vdw-modifier = Potential-shift
rvdw = 1.0
DispCorr = EnerPres
pbc = xyz
integrator = md
dt = 0.002
constraints = h-bonds
constraint-algorithm = lincs
tcoupl = v-rescale
tc-grps = System
tau-t = 0.5
ref-t = 298
pcoupl = C-rescale
pcoupltype = isotropic
tau-p = 2.0
compressibility = 1e-4
comm-mode = Linear
nstcomm = 100
nstcalcenergy = 100
nstenergy = 500
nstlog = 5000
ref-p = 1.0
nsteps = 2500000
gen-vel = no
continuation = yes
nstxout-compressed = 500
compressed-x-precision = 1000
