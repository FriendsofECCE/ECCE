&CONTROL
  calculation = 'scf'
  prefix = 'al_fcc'
  outdir = './qe.scratch'
  pseudo_dir = '/usr/share/espresso/pseudo/'
  tstress = .true.
/
&SYSTEM
  ibrav = 0
  nat = 4
  ntyp = 1
  ecutwfc = 40
  occupations = 'smearing'
  smearing = 'marzari-vanderbilt'
  degauss = 0.02
/
&ELECTRONS
  conv_thr = 1e-08
  mixing_beta = 0.7
/
ATOMIC_SPECIES
  Al  26.9815  Al.pbe-n-kjpaw_psl.1.0.0.UPF
CELL_PARAMETERS angstrom
  4.0500000000 0.0000000000 0.0000000000
  0.0000000000 4.0500000000 0.0000000000
  0.0000000000 0.0000000000 4.0500000000
ATOMIC_POSITIONS angstrom
  Al 0.0000000000 0.0000000000 0.0000000000
  Al 0.0000000000 2.0250000000 2.0250000000
  Al 2.0250000000 0.0000000000 2.0250000000
  Al 2.0250000000 2.0250000000 0.0000000000
K_POINTS automatic
  10 10 10 0 0 0
