&CONTROL
  calculation = 'scf'
  prefix = 'na_bcc'
  outdir = './qe.scratch'
  pseudo_dir = '/usr/share/espresso/pseudo/'
  tstress = .true.
/
&SYSTEM
  ibrav = 0
  nat = 2
  ntyp = 1
  ecutwfc = 50
  occupations = 'smearing'
  smearing = 'marzari-vanderbilt'
  degauss = 0.02
/
&ELECTRONS
  conv_thr = 1e-08
  mixing_beta = 0.7
/
ATOMIC_SPECIES
  Na  22.98977  na_pbe_v1.5.uspp.F.UPF
CELL_PARAMETERS angstrom
  4.2250000000 0.0000000000 0.0000000000
  0.0000000000 4.2250000000 0.0000000000
  0.0000000000 0.0000000000 4.2250000000
ATOMIC_POSITIONS angstrom
  Na 0.0000000000 0.0000000000 0.0000000000
  Na 2.1125000000 2.1125000000 2.1125000000
K_POINTS automatic
  12 12 12 0 0 0
