&CONTROL
  calculation = 'scf'
  prefix = 'po_sc'
  outdir = './qe.scratch'
  pseudo_dir = '/usr/share/espresso/pseudo/'
  tstress = .true.
/
&SYSTEM
  ibrav = 0
  nat = 8
  ntyp = 1
  ecutwfc = 60
  occupations = 'smearing'
  smearing = 'marzari-vanderbilt'
  degauss = 0.02
/
&ELECTRONS
  conv_thr = 1e-08
  mixing_beta = 0.7
/
