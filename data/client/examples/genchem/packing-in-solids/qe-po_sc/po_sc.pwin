  Po 0.0000000000 3.3590000000 0.0000000000
  Po 0.0000000000 3.3590000000 3.3590000000
  Po 3.3590000000 0.0000000000 0.0000000000
  Po 3.3590000000 0.0000000000 3.3590000000
  Po 3.3590000000 3.3590000000 0.0000000000
