&CONTROL
  calculation = 'relax'
  prefix = 'urea'
  outdir = './qe.scratch'
  pseudo_dir = '/usr/share/espresso/pseudo/'
  tprnfor = .true.
  tstress = .false.
  forc_conv_thr = 1.0d-3
  nstep = 50
/
&SYSTEM
  ibrav = 0
  nat = 16
  ntyp = 4
  ecutwfc = 60.0
  ecutrho = 480.0
  occupations = 'fixed'
  vdw_corr = 'grimme-d3'
  dftd3_version = 4
/
&ELECTRONS
  conv_thr = 1e-06
  mixing_beta = 0.7
  electron_maxstep = 100
/
&IONS
  ion_dynamics = 'bfgs'
/
