&CONTROL
  calculation = 'relax'
  prefix = 'graphite'
  outdir = './qe.scratch'
  pseudo_dir = '/usr/share/espresso/pseudo/'
  tprnfor = .true.
  tstress = .false.
  forc_conv_thr = 1.0d-3
  nstep = 50
/
&SYSTEM
  ibrav = 0
  nat = 4
  ntyp = 1
  ecutwfc = 60.0
  ecutrho = 480.0
  occupations = 'fixed'
  vdw_corr = 'grimme-d3'
  dftd3_version = 4
/
&ELECTRONS
  conv_thr = 1e-06
  mixing_beta = 0.7
  electron_maxstep = 100
/
&IONS
  ion_dynamics = 'bfgs'
/
ATOMIC_SPECIES
  C      12.0107  C.pbe-n-kjpaw_psl.1.0.0.UPF
CELL_PARAMETERS angstrom
      2.4640000000     0.0000000000     0.0000000000
     -1.2320000000     2.1338865900     0.0000000000
      0.0000000000     0.0000000000     6.7110000000
ATOMIC_POSITIONS angstrom
  C       0.0000000000     0.0000000000     1.6777500000
  C       0.0000000000     0.0000000000     5.0332500000
  C       0.0000000000     1.4225910600     1.6777500000
  C       1.2320000000     0.7112955300     5.0332500000
K_POINTS automatic
  10 10 4 0 0 0
