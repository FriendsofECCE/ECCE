; 2 ns NVT production; x and v written every 1 ps (500 steps) to the .trr
cutoff-scheme = Verlet
nstlist = 20
coulombtype = Cut-off
rcoulomb = 1.2
vdwtype = Cut-off
vdw-modifier = Potential-shift
rvdw = 1.2
DispCorr = EnerPres
pbc = xyz
integrator = md
dt = 0.002
tcoupl = v-rescale
tc-grps = System
tau-t = 1.0
ref-t = 300
pcoupl = no
comm-mode = Linear
nstcomm = 100
nstcalcenergy = 100
nstenergy = 500
nstlog = 5000
nsteps = 1000000
gen-vel = no
continuation = yes
nstxout = 500
nstvout = 500
nstfout = 0
