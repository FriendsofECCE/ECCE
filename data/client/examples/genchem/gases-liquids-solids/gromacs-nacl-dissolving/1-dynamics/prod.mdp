; 100 ns NPT, 300 K, 1 bar, unrestrained; positions every 10 ps (5000 steps)
cutoff-scheme = Verlet
coulombtype = PME
rcoulomb = 1.0
fourierspacing = 0.12
vdwtype = Cut-off
vdw-modifier = Potential-shift
rvdw = 1.0
DispCorr = EnerPres
pbc = xyz
integrator = md
dt = 0.002
constraint-algorithm = lincs
tc-grps = System
ref-t = 300
comm-mode = Linear
nstcomm = 100
nstcalcenergy = 100
nstenergy = 5000
nstlog = 5000
tcoupl = v-rescale
tau-t = 1.0
pcoupl = C-rescale
pcoupltype = isotropic
tau-p = 2.0
ref-p = 1.0
compressibility = 4.5e-5
nsteps = 50000000
gen-vel = no
continuation = yes
nstxout-compressed = 5000
compressed-x-precision = 1000
