# ORCA Runtype Details for the native engine (bin/ecce-dialog), the same dialog
# as orcaruntype.py.  Keep the two in step: tests/dialogs/native_test.py compares
# what they send.

list GEO = Geometry|GeoVib
list NEB = Transition State (NEB-TS)|Transition State (NEB-TS) + Frequencies
list FREQ = Vibration|GeoVib|Transition State (NEB-TS) + Frequencies

dialog title="ECCE ORCA Editor: Runtype Details" minwidth=380

box label="Geometry Optimization" cols=2 when="runtype in @GEO"
check name=ES.Runtype.GeomOpt.MaximumSteps label=" Max Steps:" default=0
int name=ES.Runtype.GeomOpt.MaximumStepsValue default=20 hard="[1..)" soft="[1..100]" export=1 enable_if="ES.Runtype.GeomOpt.MaximumSteps==1"

box label="Convergence" cols=1 when="runtype in @GEO"
combo name=ES.Runtype.GeomOpt.ConvergenceGradient label="Gradient:" choices="Loose|Normal|Tight|Very Tight" default=Normal export=1

# Reactant, product and TS guess are picked in the Calculation Editor.
box label="Transition State (NEB-TS)" cols=1 when="runtype in @NEB"
int name=ES.Runtype.NEB.Images label="Images:" default=8 hard="[2..)" soft="[2..32]" export=1

box label="Frequencies" cols=1 when="runtype in @FREQ"
combo name=ES.Runtype.Vibration.Method label="Method:" choices="Analytic|Numerical" default=Analytic export=1
check name=ES.Runtype.Vibration.UseRaman label=" Raman activities" default=0 export=1

box label="Reaction Path" cols=1 when="runtype==IRC"
int name=ES.Runtype.IRC.MaximumStepsValue label="Max Steps per direction:" default=20 hard="[1..)" soft="[1..200]" export=1
combo name=ES.Runtype.IRC.Direction label="Direction:" choices="Both|Forward|Backward" default=Both export=1
combo name=ES.Runtype.IRC.InitHess label="Initial Hessian:" choices="Analytic|Numerical" default=Analytic export=1

box label="Partial Charges" cols=1
check name=ES.Runtype.ORCA.UseCHELPG label=" CHELPG charges (ESP fit)" default=0 export=1
check name=ES.Runtype.ORCA.UseHirshfeld label=" Hirshfeld charges" default=0 export=1
check name=ES.Runtype.ORCA.UseMBIS label=" MBIS charges" default=0 export=1
check name=ES.Runtype.ORCA.UseNBO label=" NBO analysis (natural charges)" default=0 export=1
