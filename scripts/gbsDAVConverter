#!/usr/bin/env python3
"""Prepare local basis-set data and metadata for the separate load_tgbs uploader."""

import glob
import os
import re
import sys


PERIODIC_TABLE = """H He Li Be B C N O F Ne Na Mg Al Si P S Cl Ar
K Ca Sc Ti V Cr Mn Fe Co Ni Cu Zn Ga Ge As Se Br Kr
Rb Sr Y Zr Nb Mo Tc Ru Rh Pd Ag Cd In Sn Sb Te I Xe
Cs Ba La Ce Pr Nd Pm Sm Eu Gd Tb Dy Ho Er Tm Yb Lu
Hf Ta W Re Os Ir Pt Au Hg Tl Pb Bi Po At Rn
Fr Ra Ac Th Pa U Np Pu Am Cm Bk Cf Es Fm Md No Lr
Rf Db Sg Bh Hs Mt Ds Rg Cn Nh Fl Mc Lv Ts Og""".split()

USAGE = """Usage: master2bas [-h] [-s sourceDir] [-d destDir]
\t-h\tDisplay this message.
\t-s\tSpecify the source directory for the data files
\t\tThis defaults to /msrc/dist/gbasis-1.0
\t-d\tSpecify the destination directory for the data files
\t\tThis defaults to $ECCE_HOME/data/admin/basissets/testNewData
"""


def match(pattern, text):
    return re.search(pattern, text, re.ASCII)


def sub(pattern, replacement, text):
    return re.sub(pattern, replacement, text, flags=re.ASCII)


_NUM = re.compile(r'[ \t\n\r\f\v]*([+-]?(?:\d+\.?\d*|\.\d+)(?:[eE][+-]?\d+)?)', re.ASCII)


def perl_number(text):
    # Perl reads a non-numeric field as its numeric prefix or 0 (#1331).
    m = _NUM.match(text)
    return float(m.group(1)) if m else 0.0


def element(atom):
    # Perl's $periodic[$atom-1]: -1 is the last element, and an index past the
    # table is empty.
    index = int(perl_number(atom) - 1)
    if -len(PERIODIC_TABLE) <= index < len(PERIODIC_TABLE):
        return PERIODIC_TABLE[index]
    return ''


def out(text):
    sys.stdout.write(text)
    sys.stdout.flush()


def open_file(path, mode='r', message=None):
    try:
        # Latin-1 preserves source bytes, including reference text and numbers.
        return open(path, mode, encoding='latin-1', newline=None if os.name == 'nt' else '')
    except OSError as error:
        text = message or 'could not open ' + path
        if not text.endswith('\n'):
            text += ' at %s line %d.\n' % (sys.argv[0], sys._getframe(1).f_lineno)
        raise ConversionError(text, error.errno)


class ConversionError(Exception):
    def __init__(self, message, status=255):
        super().__init__(message)
        self.status = status


def clean_master(source, dest):
    with open_file(source + '/MASTER.TBL', message='Unable to open source MASTER.TBL') as master:
        with open_file(dest + '/MASTER.TBL', 'w', 'Unable to open dest MASTER.TBL for write') as new:
            out('Reading from %s/MASTER.TBL\nCreating %s/MASTER.TBL.....' % (source, dest))
            for line in master:
                line = sub(r' NA$', '   ', line)
                line = line.replace(' NA"', '   "')
                line = line.replace(' NA ', '    ')
                new.write(sub(r'\s*$', '', line) + '\n')
    out('Done\n')


def create_revision(dest, template):
    out('Extracting Revision Information from MASTER.TBL...')
    with open_file(dest + '/MASTER.TBL', message='Unable to open MASTER.TBL') as master:
        with open_file(template + '/rev.txt', message='Unable to open ' + template + '/rev.txt') as heading:
            with open_file(dest + '/bsb.rev', 'w', 'Unable to open bsb.rev for write') as revision:
                revision.write(heading.read())
                found = False
                for line in master:
                    line = line[:-1]
                    if found:
                        item = match(r'. ([ \d]\d/[ \d]\d/\d\d)\s*(\w*)\s*(\w*)\s*(.*)', line)
                        continuation = match(r'!\s*(.*)', line)
                        if item:
                            date, author, kind, description = item.groups()
                            if author == 'DFF':
                                author = '3e102'
                            revision.write('\n\nDate: %s\nAuthor: %s\nType: %s\nDescription: %s' %
                                           (date, author, kind, description))
                        elif continuation:
                            revision.write('\\\n' + continuation.group(1))
                    if 'Revision History' in line and not found:
                        found = True
                        for unused in range(4):
                            master.readline()
                revision.write('\n')
    out('Done\n')


def namefile_hash(dest):
    out('Generating namefile hash...')
    names, all_files = {}, []
    name, count, filename = None, 0, ''
    with open_file(dest + '/MASTER.TBL', message='Unable to open dest MASTER.TBL for read') as master:
        for line in master:
            line = line[:-1]
            item = match(r'NAME="(.*)"', line)
            if item or 'Revision History' in line:
                if name is not None:
                    if count == 1:
                        mapped = filename
                    else:
                        mapped = sub(r'[,()/\\ ]', '', name)
                        mapped = mapped.replace('*', 'S').replace('+', 'P')
                        mapped = mapped.translate(str.maketrans('abcdefghijklmnopqrstuvwxyz',
                                                               'ABCDEFGHIJKLMNOPQRSTUVWXYZ')) + '-AGG.BAS'
                    names[name] = mapped
                    out('mapping %s to %s\n' % (mapped, name))
                name = item.group(1) if item else ''
                count = 0
            elif '!' not in line:
                principal = match(r'^\s*FILE="(.*)"', line)
                secondary = match(r'FIL[0-9]="(.*)"', line)
                auxiliary = match(r'(?:ECPFILE|COUFILE|EXCFILE)="(.*)"', line)
                if principal:
                    filename = principal.group(1)
                    all_files.append(filename)
                    count += 1
                elif secondary:
                    count += 1
                    all_files.append(secondary.group(1))
                elif auxiliary:
                    all_files.append(auxiliary.group(1))
    return names, all_files


def quoted_block(line, stream, always_advance=False):
    text, state = '', 0
    while True:
        quoted = match(r'(.*)"(.*)', line)
        if quoted:
            state = 1 if state == 0 else -1
            text += quoted.group(2) if state == 1 else quoted.group(1)
            text += '\n'
        elif state == 1:
            text += line
        if state != -1 or always_advance:
            line = stream.readline()
        if state == -1 or (not always_advance and match(r'^\s*Z=', line)):
            return text, line


def atom_list(line, stream):
    atoms = []
    while True:
        done = False
        if not match(r'^\s*!', line):
            end = match(r'^\s*(.*)\s*ENDATMNOS', line)
            if end:
                line = sub(r'^\s*(.*)\s*ENDATMNOS', r'\1', line)
                done = True
            else:
                line = sub(r'^\s*(.*)\s*$', r'\1', line)
            # Perl split discards trailing empty fields, but retains a leading one.
            fields = re.split(r'\s+', line, flags=re.ASCII)
            while fields and fields[-1] == '':
                fields.pop()
            atoms.extend(fields)
        line = stream.readline()
        if done:
            return atoms, line


def parse_data_file(filename, basis, atoms):
    out(' FILE : ' + filename + '\n')
    with open_file(filename) as data:
        line = data.readline()
        while line:
            if match(r'^\s*REFERENCE=', line):
                text, line = quoted_block(line, data)
                basis['references'] = basis.get('references', '') + text
            atomic = match(r'^\s*Z=\s*(\d+)', line)
            if atomic:
                atom = atomic.group(1)
                atoms.append(atom)
                functions = [] if 'category' in basis else [['', '']]
                got_data, angular, shell = False, '', ''
                line = data.readline()
                while line:
                    core = match(r'^\s*NCORE=\s*(\d+)', line)
                    maximum = match(r'^\s*LMAX=\s*(\d+)', line)
                    potential = match(r'^\s*L=\s*(\d+)\s*TYPE="(.*)"', line)
                    if core:
                        functions[0][0] = core.group(1)
                    if maximum:
                        functions[0][1] = maximum.group(1)
                    if potential:
                        angular, shell = potential.groups()
                    exponents = match(r'\s*NUMEXP=\s*(\d+)(.*)', line)
                    if exponents:
                        number, rest = exponents.groups()
                        header = sub(r'[\s+\d+]', '', rest) if 'category' in basis else [angular, shell]
                        contraction = [header]
                        for unused in range(int(number)):
                            line = data.readline()
                            row = sub(r'^\s*(.*)\s*$', r'\1', line)
                            fields = re.split(r'\s+', row, flags=re.ASCII)
                            while fields and fields[-1] == '':
                                fields.pop()
                            contraction.append(fields)
                        functions.append(contraction)
                        got_data = True
                    if match(r'^\s*(!|Z=)', line) and got_data:
                        break
                    line = data.readline()
                basis.setdefault('functions', {}).setdefault(atom, []).extend(functions)
                if match(r'^\s*Z=', line):
                    continue
            if 'File Revision History' in line:
                comments = []
                for line in data:
                    line = sub(r'(.*)\s+$', r'\1', line)
                    if line in ('!', ''):
                        break
                    if match(r'^\s*!        ', line):
                        # Continuations occupy a third field that is never printed.
                        pass
                    else:
                        comment = match(r'!\s*(\d+)/\s*(\d+)/(\d+)(.*)', line)
                        if comment:
                            month, day, year, text = comment.groups()
                            comments.append(('%s/%s/%s' % (month, day, year), text))
                        else:
                            out('Unrecognized File Revision History Line : ****%s****\n' % line)
                basis['comments'] = comments
            line = data.readline()


REPRESENTATIONS = [
    ('MB', 'Minimal'), ('VDZ', 'ValenceDoubleZeta'), ('VTZ', 'ValenceTripleZeta'),
    ('VQZ', 'ValenceQuadrupleZeta'), ('V5Z', 'ValenceQuintupleZeta'),
    ('V6Z', 'ValenceSextetZeta'), ('V7Z', 'SeptupleZeta'), ('V8Z', 'OctupleZeta'),
    ('DZ', 'DoubleZeta'), ('TZ', 'TripleZeta'), ('QZ', 'QuadrupleZeta'),
    ('5Z', 'SextetZeta'), ('GENERAL', 'General'), ('UNCONTR', 'Uncontract'), ('DFT', None)]
CATEGORIES = {'ORBITAL': ('ORBITAL', None), 'ECP': ('ORBITAL', 'ECPOrbital'),
              'DFTORB': ('ORBITAL', 'DFTOrbital'), 'DFTXFIT': ('ORBITAL', 'Exchange'),
              'DFTCFIT': ('ORBITAL', 'Charge'), 'PERIODIC': ('PeriodicHF', None),
              'AUXILIARY': ('TAIOrbital', None)}


def basis_type(types, basis):
    for token, representation in REPRESENTATIONS:
        if token in types:
            types = types.replace(token, '', 1)
            if representation is not None:
                basis['ao_representation'] = representation
            if token == 'UNCONTR':
                basis['contraction_type'] = 'Uncontracted'
            break
    else:
        if match(r'^\d', types):
            basis['ao_representation'] = 'General'
        else:
            out('Error Unrecognized TYPE\n')
    if basis.get('category') == 'TAIOrbital':
        types = types[::-1]
        while True:
            if match(r'\s+$', types):
                break
            if match(r'\d$', types):
                pass
            elif types.endswith(('P', 'T', 'D', 'R')):
                basis['type'] = {'P': 'polarization', 'T': 'polarization',
                                 'D': 'diffuse', 'R': 'rydberg'}[types[-1]]
                break
            else:
                out('Error : bad TYPE! ' + types + '\n')
            types = types[:-1]


def parse_master(source, dest, names):
    bases, ecps, basis_names = {}, {}, []
    basis = {}
    with open_file(dest + '/MASTER.TBL') as master:
        line = master.readline()
        while line:
            item = match(r'^\s*NAME="(.*)"', line)
            if item:
                name = item.group(1)
                out('NAME OF BASIS SET :: %s\nBASIS SET : %s\n' % (name, name))
                basis = {'cc': 'cc-p' in name}
                basis_names.append(name)
            category = match(r'^CATEGORY=(\w+)', line)
            if category:
                category = category.group(1)
                if category in CATEGORIES:
                    basis['category'], kind = CATEGORIES[category]
                    if kind is not None:
                        basis['type'] = kind
                else:
                    out('Unrecognized type ' + category + '\n')
            shared = match(r'^SHARED=(.)', line)
            if shared:
                basis['SHARED'] = 'true' if shared.group(1) == 'T' else 'false'
            general = match(r'^GENR=(.)', line)
            if general:
                basis['contraction_type'] = 'GC' if general.group(1) == 'T' else 'Segmented'
            types = match(r'^TYPE="(.*)"', line)
            if types:
                basis_type(types.group(1), basis)
            if line.startswith('SPHR='):
                basis['SPHR'] = 'Y' if 'Y' in line else 'N'
            if line.startswith('INFO='):
                text, line = quoted_block(line, master, always_advance=True)
                basis['INFO'] = basis.get('INFO', '') + text
            principal = match(r'^ATMN=(.*)\s*', line)
            if principal:
                line = sub(r'^ATMN=(.*)\s*', r'\1', line)
                atoms, line = atom_list(line, master)
                for atom in basis.get('functions', {}):
                    for supported in atoms:
                        if basis['functions'].get(supported) is None:
                            out('ERROR: No functions defined for %s\n' % element(supported))
                    # Perl compared these numerically ($fatom == $satom).
                    if not any(perl_number(atom) == perl_number(other) for other in atoms):
                        out('WARNING: Leaving %s out.\n' % element(atom))
                        basis['functions'][atom] = None
                basis.setdefault('ATMN', []).append(atoms)
            secondary = match(r'^ATM(\d)=(.*)', line)
            if secondary:
                line = sub(r'^ATM(\d)=(.*)', r'\2', line)
                atoms, line = atom_list(line, master)
                basis.setdefault('ATMN', []).append(atoms)
            principal_file = match(r'^\s*FILE="(.*)"', line)
            if principal_file:
                filename = principal_file.group(1)
                files = basis.setdefault('basis_names', [])
                files.append(names.get(name, ''))
                if names.get(name, '') != filename:
                    files.append(filename)
                else:
                    parse_data_file(source + '/' + filename, basis, [])
                bases[name] = basis
            auxiliary = match(r'^\s*(COUFILE|EXCFILE|ECPFILE|FIL(\d))="(.*)"', line)
            if auxiliary:
                kind, unused, filename = auxiliary.groups()
                aux_name = ''
                try:
                    with open(source + '/' + filename, encoding='latin-1', newline='') as auxiliary_file:
                        for aux_line in auxiliary_file:
                            item = match(r'^\s*NAME="(.*)"', aux_line)
                            if item:
                                aux_name = item.group(1)
                                break
                except OSError:
                    # Missing non-ECP auxiliary files are only listed as hidden.
                    pass
                if kind == 'ECPFILE' and aux_name not in ecps:
                    ecp, atoms = {}, []
                    ecps[aux_name] = (filename, ecp)
                    parse_data_file(source + '/' + filename, ecp, atoms)
                    ecp['ATMN'] = atoms
                basis.setdefault('basis_names', []).append(filename)
            line = master.readline()
    return bases, ecps, basis_names


def print_basis(name, basis, filename, ecp=False):
    out('Generating : ' + filename + '.meta\n')
    with open_file(filename + '.meta', 'w', 'Could not open ' + filename + '.meta\n') as meta:
        fields = [('name', name), ('type', 'ecp' if ecp else basis.get('type', '')),
                  ('category', 'AUXILIARY' if ecp else basis.get('category', ''))]
        if not ecp:
            fields.extend([('spherical', basis.get('SPHR', '')),
                           ('contraction_type', basis.get('contraction_type', ''))])
        fields.append(('references', basis.get('references', '')))
        if not ecp:
            fields.append(('info', basis.get('INFO', '')))
        for key, value in fields:
            meta.write('%s\n%s\n%s\n' % (key, value, key))
        meta.write('comments\n')
        for date, text in basis.get('comments', []):
            meta.write('%s %s\n' % (date, text))
        meta.write('comments\n')
    out('Generating : ' + filename + '\n')
    with open_file(filename, 'w', 'Could not open ' + filename + '\n') as data:
        # The strict upper bound also applies to ECPs, excluding element 118.
        for atom in range(1, len(PERIODIC_TABLE)):
            functions = basis.get('functions', {}).get(str(atom))
            if functions is None:
                continue
            data.write('atom=' + PERIODIC_TABLE[atom - 1])
            if ecp:
                core, maximum = functions[0]
                data.write(' ncore=%s lmax=%s\n' % (core, maximum))
                contractions = functions[1:]
            else:
                data.write('\n')
                contractions = functions
            for contraction in contractions:
                header = contraction.pop(0)
                if ecp:
                    angular, shell = header
                    data.write('ecp_potential%%l=%s%%shell=%s%%num_exponents=%d\n' %
                               (angular, shell, len(contraction)))
                    for row in contraction:
                        data.write(' '.join((row + ['', '', ''])[:3]) + '\n')
                else:
                    data.write('contraction shell=%s num_primitives=%d num_coefficients=%d\n' %
                               (header, len(contraction), len(contraction[0]) - 1 if contraction else -1))
                    for row in contraction:
                        data.write((row[0] if row else '') + ' ' + ' '.join(row[1:]) + '\n')


def parse_dav_data(source, dest, names):
    bases, ecps, basis_names = parse_master(source, dest, names)
    groups = {}
    for name in basis_names:
        basis = bases.setdefault(name, {})
        if basis.get('category') == 'ORBITAL' and 'type' not in basis:
            if basis.get('SHARED') == 'true':
                basis['type'] = 'pople'
            elif basis.get('contraction_type') in ('Segmented', 'Uncontracted'):
                basis['type'] = 'other_segmented'
            elif basis.get('contraction_type') == 'GC':
                basis['type'] = 'correlation_consistent' if basis.get('cc') else 'other_generally_contracted'
        print_basis(name, basis, dest + '/' + names.get(name, ''))
        groups.setdefault(basis.get('type', ''), []).append(name)
    for name, (filename, basis) in ecps.items():
        print_basis(name, basis, dest + '/' + filename, ecp=True)
    with open_file(dest + '/gbsNameConv', 'w', 'Could not open ' + dest + '/gbsNameConv') as mapping:
        for kind, entries in groups.items():
            mapping.write('type= ' + kind + '\n')
            for name in entries:
                basis = bases[name]
                mapping.write('name= %s\nfiles=%s\n' %
                              (name, ''.join(' ' + filename for filename in basis.get('basis_names', []))))
                for atoms in basis.get('ATMN', []):
                    mapping.write('atoms=' + ''.join(' ' + element(atom) for atom in atoms) + '\n')
                mapping.write('\n')
        mapping.write('type= ecp\n')
        for name, (filename, basis) in ecps.items():
            mapping.write('name= %s\nfiles= %s\natoms=%s\n' %
                          (name, filename, ''.join(' ' + element(atom) for atom in basis['ATMN'])))


def main(args):
    source, dest = '', ''
    for index, arg in enumerate(args):
        # Arguments are scanned independently, including option values.
        if '-h' in arg:
            out(USAGE)
            return 0
        if '-s' in arg:
            source = args[index + 1] if index + 1 < len(args) else ''
        if '-d' in arg:
            dest = args[index + 1] if index + 1 < len(args) else ''
    source = source or '/msrc/dist/gbasis-1.0'
    template = os.environ.get('ECCE_HOME', '') + '/data/admin/basissets'
    dest = dest or template + '/testNewData'
    # The Perl read the answer as bytes; a stray byte must not crash the prompt.
    sys.stdin.reconfigure(encoding='utf-8', errors='replace')
    while True:
        out('\nSource directory:\t%s\nDestination directory:\t%s\nOK? (y/n) ' % (source, dest))
        answer = sys.stdin.readline()
        if match(r'[Nn][Oo]', answer):
            return 0
        # The negated pattern is interpolated as "1", rather than negating a match.
        if '1' not in answer:
            break
    if os.path.exists(dest):
        out('Deleting old files from ' + dest + '...')
        deleted = 0
        for pattern in ('*.BAS', 'MASTER.TBL*', '*.POT', '*.*.meta', 'gbsNameConv'):
            paths = sorted(glob.glob(dest + '/' + pattern)) if '*' in pattern else [dest + '/' + pattern]
            for path in paths:
                try:
                    os.unlink(path)
                    deleted += 1
                except OSError:
                    pass
        out('%d files deleted.\n' % deleted)
    else:
        try:
            os.mkdir(dest, 0o777)
        except OSError:
            pass
    clean_master(source, dest)
    create_revision(dest, template)
    names, all_files = namefile_hash(dest)
    parse_dav_data(source, dest, names)
    out('Hidden Basis Sets:\n')
    for filename in all_files:
        if not os.path.exists(dest + '/' + filename):
            out(filename + '\n')
    out('End gbsDAVConverter\n')
    return 0


if __name__ == '__main__':
    # Text from the data files is latin-1 (one char per byte); write it back as
    # the same bytes, as Perl did.
    sys.stdout.reconfigure(encoding='latin-1', errors='replace')
    try:
        sys.exit(main(sys.argv[1:]))
    except ConversionError as error:
        sys.stderr.write(str(error).rstrip('\n') + '\n')
        sys.exit(error.status or 255)
