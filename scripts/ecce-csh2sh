#!/usr/bin/env python3
#
# ecce-csh2sh: check and convert csh job-script snippets in ECCE's configuration.
#
# gensub writes POSIX sh job scripts, so the shell text a site or user puts in
# submit.site or CONFIG.<machine> (setup, wrapup, <Code>Command, <Code>_loophole)
# must be sh.  This finds those snippets, rewrites what has an exact sh
# equivalent (rules: ecce_cshtosh.py) and reports the rest line by line.
# Everything else in the file is left exactly as it was.
#
# Files are read and written as latin-1 so every byte passes through unchanged.

import os
import re
import shutil
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import ecce_cshtosh  # noqa: E402

USAGE = """\
Usage: ecce-csh2sh --check   [targets]   report only; exit 1 if anything needs attention
       ecce-csh2sh --convert [targets]   rewrite, keeping <file>.csh-backup

Targets (any number):
  --user          ~/.ECCE/CONFIG.*
  --siteconfig    $ECCE_HOME/siteconfig/submit.site and CONFIG.*
  FILE...         these files

Options:
  --assume-sh-twins  convert `source x.csh` to `. x.sh` without finding x.sh here
                     (it must exist on the machine that runs the job)
  --force            replace an existing .csh-backup
  --quiet            print nothing on success
  --brief            one line per file, without the lines themselves
  --notice-file F    write a message for the user to F when something was
                     converted or needs attention
  --once --stamp S   the per-user first-start run: --convert --user --quiet, at
                     most once per stamp S (the version), notice for the Organizer

Exit status: 0 nothing to do or all converted, 1 attention needed (check) or
lines left that cannot be converted (convert), 2 error.
"""

LATIN = 'latin-1'


def B(s):
    return s.encode(LATIN)


def arg(a):
    return os.fsencode(a).decode(LATIN)


def env(name):
    v = os.environb.get(name.encode())
    return v.decode(LATIN) if v is not None else None


def out(s):
    sys.stdout.flush()
    sys.stdout.buffer.write(B(s))
    sys.stdout.buffer.flush()


def err(s):
    sys.stderr.flush()
    sys.stderr.buffer.write(B(s))
    sys.stderr.buffer.flush()


def plural(n):
    return "" if n == 1 else "s"


def is_backup(p):
    return re.search(r'(?:\.csh-backup|~|\.bak|\.orig|\.rpmnew|\.rpmsave|\.dpkg-\w+)$',
                     p, re.ASCII) is not None


def config_files(d):
    """Sorted d/CONFIG.* (shell-glob order and dotfile rules)."""
    try:
        names = os.listdir(B(d))
    except OSError:
        return []
    return sorted(d + "/" + n.decode(LATIN) for n in names if n.startswith(b"CONFIG."))


SNIPPET = re.compile(r'^(?:setup|wrapup|[\w-]+_(?:setup|wrapup|loophole)|[\w-]+command)$',
                     re.ASCII)


def read_lines(path):
    with open(B(path), 'rb') as h:
        data = h.read().decode(LATIN)
    parts = data.split("\n")
    lines = [p + "\n" for p in parts[:-1]]
    if parts[-1] != "":
        lines.append(parts[-1])
    return lines


def snippet_entries(lines):
    """Each entry: key, first (0-based index of its first line), n, and for the
    one-line forms single = (start, length) of the snippet within the line."""
    entries = []
    i = 0
    while i < len(lines):
        c = lines[i]
        if c.endswith("\n"):
            c = c[:-1]
        if re.match(r'^\s*//', c, re.ASCII) or re.match(r'^\s*#', c, re.ASCII) \
                or re.match(r'^\s*$', c, re.ASCII):
            i += 1
            continue
        m = re.match(r'^\s*(.*)\s*\{(.*)\}', c, re.ASCII)
        if m:
            key = ecce_cshtosh.strip(m.group(1))
            if SNIPPET.match(key.lower()):
                entries.append({'key': key, 'first': i, 'n': 1,
                                'single': (m.start(2), m.end(2) - m.start(2))})
            i += 1
            continue
        m = re.match(r'^\s*(.*)\s*\{', c, re.ASCII)
        if m:
            key = re.sub(r'\s*$', '', m.group(1), flags=re.ASCII)
            key = re.sub(r'^\s+', '', key, flags=re.ASCII)
            start = i + 1
            j = start
            while j < len(lines) and not lines[j].startswith("}"):
                j += 1
            if SNIPPET.match(key.lower()):
                entries.append({'key': key, 'first': start, 'n': j - start})
            i = j + 1
            continue
        m = re.match(r'^\s*(.*):\s*(.*)', c, re.ASCII)
        if m:
            key = re.sub(r'\s+$', '', m.group(1), flags=re.ASCII)
            key = re.sub(r'^\s+', '', key, flags=re.ASCII)
            if SNIPPET.match(key.lower()):
                entries.append({'key': key, 'first': i, 'n': 1,
                                'single': (m.start(2), m.end(2) - m.start(2))})
        i += 1
    return entries


def eol_of(line):
    return "\n" if line.endswith("\n") else ""


def analyse(path, assume):
    """-> dict with lines (new), changes, issues; or {'error': ...}."""
    try:
        lines = read_lines(path)
    except OSError as e:
        return {'error': "cannot read: %s" % e.strerror}
    new = list(lines)
    changes, issues = [], []
    for e in snippet_entries(lines):
        if 'single' in e:
            c = lines[e['first']]
            if c.endswith("\n"):
                c = c[:-1]
            text = c[e['single'][0]:e['single'][0] + e['single'][1]]
        else:
            b = [x[:-1] if x.endswith("\n") else x
                 for x in lines[e['first']:e['first'] + e['n']]]
            text = "\n".join(b)
        if re.match(r'^\s*$', text, re.ASCII):
            continue
        lead = re.match(r'^(\s*)', text, re.ASCII).group(1)
        trail = re.search(r'(\s*)$', text, re.ASCII).group(1)
        core = ecce_cshtosh.strip(text)
        src = core if 'single' in e else text
        res = ecce_cshtosh.snippet(src, structured=True, assume_twins=assume)
        for c in res['changes']:
            changes.append({'line': e['first'] + c['line'], 'key': e['key'],
                            'from': c['from'], 'to': c['to']})
        for iss in res['issues']:
            d = dict(iss)
            d['line'] = e['first'] + iss['line']
            d['key'] = e['key']
            issues.append(d)
        if res['text'] == src:
            continue
        if 'single' in e:
            c = lines[e['first']]
            if c.endswith("\n"):
                c = c[:-1]
            s, n = e['single']
            c = c[:s] + lead + res['text'] + trail + c[s + n:]
            new[e['first']] = c + eol_of(lines[e['first']])
        else:
            nl = res['text'].split("\n")
            for k in range(e['n']):
                new[e['first'] + k] = nl[k] + eol_of(lines[e['first'] + k])
    return {'lines': new, 'changes': changes, 'issues': issues}


def write_file(path, lines, st):
    tmp = "%s.csh2sh.%d" % (path, os.getpid())
    try:
        with open(B(tmp), 'wb') as h:
            h.write(B("".join(lines)))
    except OSError as e:
        return "cannot write %s: %s" % (tmp, e.strerror)
    try:
        os.chmod(B(tmp), st.st_mode & 0o7777)
        if os.geteuid() == 0:
            os.chown(B(tmp), st.st_uid, st.st_gid)
    except OSError:
        pass
    try:
        os.rename(B(tmp), B(path))
    except OSError as e:
        try:
            os.unlink(B(tmp))
        except OSError:
            pass
        return "cannot replace %s: %s" % (path, e.strerror)
    return None


def main(argv):
    o = {}
    files = []
    args = [arg(a) for a in argv]
    while args:
        a = args.pop(0)
        if a == '--check':
            o['mode'] = 'check'
        elif a == '--convert':
            o['mode'] = 'convert'
        elif a == '--user':
            o['user'] = True
        elif a == '--siteconfig':
            o['site'] = True
        elif a == '--assume-sh-twins':
            o['assume'] = True
        elif a == '--force':
            o['force'] = True
        elif a == '--quiet':
            o['quiet'] = True
        elif a == '--brief':
            o['brief'] = True
        elif a == '--once':
            o['once'] = True
        elif a == '--stamp':
            o['stamp'] = args.pop(0) if args else None
        elif a == '--notice-file':
            o['notice'] = args.pop(0) if args else None
        elif a in ('-h', '--help'):
            out(USAGE)
            return 0
        elif a.startswith('-'):
            err("ecce-csh2sh: unknown option %s\n%s" % (a, USAGE))
            return 2
        else:
            files.append(a)

    user_home = env('ECCE_REALUSERHOME') or env('HOME') or ''
    user_dir = user_home + "/.ECCE"

    if o.get('once'):
        if not o.get('stamp'):
            err("ecce-csh2sh: --once needs --stamp\n")
            return 2
        o['mode'] = 'convert'
        o['user'] = True
        o['quiet'] = True
        o['notice'] = user_dir + "/csh2sh-notice"
        try:
            with open(B(user_dir + "/csh2sh-done"), 'rb') as m:
                v = m.readline().decode(LATIN)
            if v.endswith("\n"):
                v = v[:-1]
            if v == o['stamp']:
                return 0
        except OSError:
            pass

    if not o.get('mode'):
        err(USAGE)
        return 2

    targets = []
    if o.get('user'):
        targets += [p for p in config_files(user_dir) if not is_backup(p)]
    if o.get('site'):
        home = env('ECCE_HOME')
        if not home:
            err("ecce-csh2sh: --siteconfig needs ECCE_HOME\n")
            return 2
        d = home + "/siteconfig"
        if os.path.isfile(B(d + "/submit.site")):
            targets.append(d + "/submit.site")
        targets += [p for p in config_files(d) if not is_backup(p) and os.path.isfile(B(p))]
    targets += files
    if not targets and not o.get('user') and not o.get('site') and not files:
        err("ecce-csh2sh: name FILEs, or use --user or --siteconfig\n")
        return 2

    any_attention = False
    errors = 0
    outl = []
    n_conv, n_issues, n_errors = [], [], []

    for given in targets:
        path = given
        if os.path.islink(B(given)):
            path = os.path.realpath(B(given)).decode(LATIN)
        r = analyse(path, o.get('assume', False))
        if 'error' in r:
            outl.append("%s: %s\n" % (given, r['error']))
            n_errors.append("%s: %s" % (given, r['error']))
            errors += 1
            continue
        nch, nis = len(r['changes']), len(r['issues'])
        if not nch and not nis:
            continue

        head = given + "\n"
        backup = path + ".csh-backup"
        if o['mode'] == 'convert' and nch:
            if os.path.exists(B(backup)) and not o.get('force'):
                head += "  NOT converted: %s exists (move it away, or use --force to replace it)\n" % backup
                n_errors.append("%s: not converted, %s already exists" % (given, backup))
                errors += 1
            else:
                st = os.stat(B(path))
                e = None
                try:
                    shutil.copyfile(B(path), B(backup))
                except OSError as ex:
                    e = "cannot write backup %s: %s" % (backup, ex.strerror)
                if e is None:
                    try:
                        os.chmod(B(backup), st.st_mode & 0o7777)
                        os.utime(B(backup), (int(st.st_atime), int(st.st_mtime)))
                    except OSError:
                        pass
                    e = write_file(path, r['lines'], st)
                if e:
                    head += "  NOT converted: %s\n" % e
                    n_errors.append("%s: not converted: %s" % (given, e))
                    errors += 1
                else:
                    head += "  converted %d line%s; original kept as %s\n" % (nch, plural(nch), backup)
                    n_conv.append("%s   (%d line%s, original kept as %s)" % (given, nch, plural(nch), backup))
        elif nch:
            head += "  %d line%s would be converted (ecce-csh2sh --convert)\n" % (nch, plural(nch))
            any_attention = True
        if not o.get('brief'):
            for c in r['changes']:
                head += "    line %d [%s]  %s\n        -> %s\n" % (c['line'], c['key'], c['from'], c['to'])
        if nis:
            head += ("  needs attention (%d line%s, gensub refuses a job until fixed):\n"
                     % (nis, plural(nis)))
            for i in r['issues']:
                if not o.get('brief'):
                    head += "    line %d [%s]  %s\n        write: %s\n" % (i['line'], i['key'], i['text'], i['want'])
                    if i['why']:
                        head += "        note: %s\n" % i['why']
                n_issues.append("%s line %d: %s\n      write: %s%s" % (
                    given, i['line'], i['text'], i['want'],
                    "\n      note: " + i['why'] if i['why'] else ""))
            any_attention = True
        outl.append(head)

    if outl and not o.get('quiet'):
        out("".join(outl))
        if not o.get('brief'):
            out('\nJob scripts are POSIX sh; see GETTING_STARTED.md, "Job scripts are POSIX sh".\n')
    elif not outl and not o.get('quiet'):
        out("ecce-csh2sh: nothing to convert, nothing needs attention.\n")

    if o.get('notice') and (n_conv or n_issues or n_errors):
        n = ("ECCE now runs job scripts with /bin/sh instead of csh.\n"
             "Your job-script settings (setup, wrapup, <Code>Command, <Code>_loophole in\n"
             "~/.ECCE/CONFIG.*) were checked.\n")
        if n_conv:
            n += "\nConverted to sh (the original of each is kept beside it):\n  " + "\n  ".join(n_conv) + "\n"
        if n_issues:
            n += ("\nStill csh. Jobs on these machines will not start until these lines are\n"
                  "written in sh:\n  " + "\n  ".join(n_issues) + "\n")
        if n_errors:
            n += "\nCould not be converted:\n  " + "\n  ".join(n_errors) + "\n"
        n += "\nRun 'ecce-csh2sh --check --user' to see this again.\n"
        try:
            with open(B(o['notice']), 'wb') as h:
                h.write(B(n))
        except OSError:
            pass

    if o.get('once') and not errors:
        try:
            with open(B(user_dir + "/csh2sh-done"), 'wb') as h:
                h.write(B(o['stamp'] + "\n"))
        except OSError:
            pass

    if errors:
        return 2
    if o['mode'] == 'check':
        return 1 if any_attention else 0
    return 1 if n_issues else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
