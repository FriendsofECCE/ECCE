#!/usr/bin/env perl
#
#  Look at a generated input deck and say whether anything is badly
#  wrong with it, before it is submitted (GitHub #148).
#
#      verifyinput -f <input file> -c <code name> [-a <atom count>]
#
#  Writes one finding per line:
#
#      LEVEL|LINE|CHECK|MESSAGE
#
#  LEVEL is BAD, UNSURE or GOOD.  LINE is the 1-based line a finding
#  points at, "FIRST-LAST" for a finding about a run of lines, or 0
#  where it points at the file as a whole.  A range on a GOOD finding
#  is what lets a reader see WHICH lines were actually examined and
#  passed, rather than having to take "checked" on trust.  GOOD lines
#  are emitted for checks that ran and passed, deliberately: a checker
#  that prints nothing when it is happy teaches nobody what it covers,
#  and "green" then gets read as "this calculation is correct" rather
#  than "these particular things are in order".
#
#  WHAT THIS MAY AND MAY NOT DECIDE.
#
#  Rules about the SHAPE of a deck -- which sections exist, which are
#  required, how one ends -- come from the codes' documentation and are
#  safe.  Rules about whether a KEYWORD is valid do not: this tree has
#  been wrong about that repeatedly from reading manuals (NWChem's
#  documented dispersion spellings are rejected; ORCA takes 6-31++G**
#  but not 6-31++G; Gaussian wants GD3BJ and ECCE wrote GD3-BJ).  A
#  checker that calls a correct deck wrong is worse than no checker,
#  because the user learns to ignore it.  So nothing here rejects a
#  keyword; anything it cannot judge is UNSURE.

use strict;
use warnings;
use Getopt::Std;

our ($opt_f, $opt_c, $opt_a, $opt_h);
getopts('f:c:a:h');

if ($opt_h || !defined($opt_f)) {
  print STDERR "usage: verifyinput -f <input file> -c <code> [-a <atoms>]\n";
  exit($opt_h ? 0 : 2);
}

my $code = defined($opt_c) ? $opt_c : "";
my @findings;

sub finding {
  my ($level, $line, $check, $message) = @_;
  push(@findings, join("|", $level, $line, $check, $message));
}

#  ---------------------------------------------------------------- read
unless (-e $opt_f) {
  finding("BAD", 0, "file", "There is no input file at $opt_f.");
  print "$_\n" foreach (@findings);
  exit 1;
}

open(my $in, '<', $opt_f) or do {
  finding("BAD", 0, "file", "The input file could not be read: $!");
  print "$_\n" foreach (@findings);
  exit 1;
};
binmode($in);
my @lines = <$in>;
close($in);

if (!@lines) {
  finding("BAD", 0, "file", "The input file is empty.");
  print "$_\n" foreach (@findings);
  exit 1;
}
finding("GOOD", 0, "file", scalar(@lines) . " lines.");

#  --------------------------------------------- bytes that cannot be read
#
#  This is the check that matters most and needs no knowledge of any
#  code.  Two decks in one afternoon were generated with six bytes of
#  binary where the basis set belongs -- invisible in a text view, and
#  refused by the code after the job had reached a queue.
my $binary = 0;
for my $i (0 .. $#lines) {
  my $line = $lines[$i];
  if ($line =~ /([^\x09\x0a\x0d\x20-\x7e])/) {
    my $byte = ord($1);
    finding("BAD", $i + 1, "readable",
            sprintf("This line contains a byte that is not text (0x%02x). " .
                    "That is not something a person typed, and the code " .
                    "will refuse the file.", $byte));
    $binary++;
    last if ($binary >= 5);
  }
}
finding("GOOD", 0, "readable", "Every byte is printable text.")
  if (!$binary);

#  --------------------------------------------------------- the geometry
#
#  An element symbol and three numbers, which is what every one of these
#  codes writes.  Counted rather than parsed: the point is to notice
#  that the geometry is missing or the wrong size, not to re-read it.
#  A number as any of these codes may write one, including the
#  exponent forms -- Gaussian decks from this tree carry coordinates
#  like -2.26132e-16, and a pattern demanding plain decimals reports
#  a perfectly good ozone deck as having no geometry at all.
my $NUM = qr/[-+]?(?:\d+\.?\d*|\.\d+)(?:[eEdD][-+]?\d+)?/;

my $whole_early = join("", @lines);
my $atoms = 0;
my $firstAtom = 0;
for my $i (0 .. $#lines) {
  #  Trailing tokens are allowed: MOPAC writes an optimisation flag
  #  after each coordinate, and NWChem permits a tag.
  if ($lines[$i] =~ /^\s*([A-Z][a-z]?)\d*\s+$NUM\s+$NUM\s+$NUM(\s|$)/) {
    $atoms++;
    $firstAtom = $i + 1 if (!$firstAtom);
  }
}

if (!$atoms && $whole_early =~ /geom\s*=\s*\(?[^)\n]*check/i) {
  #  A deck that says it takes its geometry from the checkpoint file
  #  is right to have none here.
  finding("UNSURE", 0, "geometry",
          "There is no geometry in this file, but the route card reads " .
          "it from the checkpoint file. Whether that checkpoint holds " .
          "what you expect cannot be judged from here.");
} elsif (!$atoms) {
  finding("BAD", 0, "geometry",
          "No geometry was found: no line holds an element symbol and " .
          "three coordinates. The calculation has nothing to run on.");
} elsif (defined($opt_a) && $opt_a =~ /^\d+$/ && $opt_a > 0 && $atoms != $opt_a) {
  finding("BAD", $firstAtom, "geometry",
          "The geometry has $atoms atoms; the calculation says it has " .
          "$opt_a. One of them is wrong.");
} else {
  finding("GOOD", $firstAtom, "geometry", "$atoms atoms.");
}

#  ------------------------------------------- what each code needs
#
#  Everything below is about the SHAPE of a deck -- which sections
#  exist, where each one ends, and whether what one section promises
#  another section delivers.  None of it judges a keyword.
#
#  A NOTE ON WHY NOT, because the temptation recurs.  Gaussian ships
#  `testrt`, its own route-card parser, which rejects exactly what the
#  real program rejects -- including the GD3BJ/GD3-BJ spelling that
#  cost a job in September 2026.  It is deliberately NOT called from
#  here: ECCE submits to remote machines, so the client doing the
#  checking is precisely where Gaussian is least likely to be
#  installed, and a check that degrades to "unsure" on most
#  installations is not a check.  It is used in tests/verify instead,
#  as the oracle the rules below are validated against -- so a rule
#  here is never merely somebody's reading of a manual.  Add rules
#  that way too.

my $whole = join("", @lines);
my @stripped = map { my $line = $_; chomp($line); $line } @lines;

#  Which elements the molecule actually contains, for the checks that
#  ask whether every one of them has been given a basis set.
my %seen;
my @elements;
my @atomSymbols;
for my $i (0 .. $#stripped) {
  if ($stripped[$i] =~ /^\s*([A-Z][a-z]?)\d*\s+$NUM\s+$NUM\s+$NUM(\s|$)/) {
    my $element = ucfirst(lc($1));
    push(@atomSymbols, $element);
    next if (exists($seen{$element}));
    $seen{$element} = 1;
    push(@elements, $element);
  }
}


#  Parentheses that do not balance.
#
#  Confirmed against Gaussian's own parser rather than assumed: an
#  unclosed '(' and an unopened ')' are both rejected outright, while
#  EMPTY parentheses are accepted -- which matters, because ECCE emits
#  "Freq=()" on nearly every deck and a rule written from intuition
#  would have condemned every one of them.  This is also the shape of
#  a real ECCE bug: a theory dialog once offered "MPW1PBE (hybrid"
#  with the closing parenthesis missing.
sub balanced
{
  my ($text) = @_;
  my $depth = 0;
  foreach my $character (split(//, $text)) {
    $depth++ if ($character eq "(");
    $depth-- if ($character eq ")");
    return 0 if ($depth < 0);
  }
  return ($depth == 0);
}



#  Lines inside a geometry that are not part of one.
#
#  THE CHECK A HAND EDIT NEEDS.  Everything else here asks whether a
#  section exists and where it ends; none of that notices a stray
#  character typed INSIDE one.  Reported live on 2026-09-25: an "s"
#  added to an NWChem deck, which stops it running and which the
#  checker passed without comment.
#
#  The rule is only applied to a geometry that is already known to be
#  Cartesian -- its first atom line carries three coordinates -- and
#  then every line in it must carry three too, or be a directive the
#  code takes there.  That is deliberately narrow: a Z-matrix has
#  lines of several shapes and a bare element symbol is a legal one,
#  so nothing is concluded about those at all.
sub geometryLines
{
  my ($from, $to, $directives, $what) = @_;
  my @L = @stripped;
  return if ($from > $to || $from < 0 || $to > $#L);

  #  Cartesian only: the first real line must be symbol + 3 numbers.
  my $first = -1;
  for my $i ($from .. $to) {
    next if ($L[$i] =~ /^\s*$/);
    $first = $i;
    last;
  }
  return if ($first < 0);
  return unless ($L[$first] =~ /^\s*[A-Za-z][A-Za-z]?\S*\s+$NUM\s+$NUM\s+$NUM(\s|$)/);

  my @odd;
  for my $i ($from .. $to) {
    next if ($L[$i] =~ /^\s*$/);
    next if ($L[$i] =~ /^\s*[A-Za-z][A-Za-z]?\S*\s+$NUM\s+$NUM\s+$NUM(\s|$)/);
    next if (defined($directives) && $L[$i] =~ /$directives/i);
    push(@odd, $i);
  }

  if (@odd) {
    my $line = $L[$odd[0]];
    $line =~ s/^\s+//;
    $line =~ s/\s+$//;
    $line = substr($line, 0, 40) . "..." if (length($line) > 43);
    finding("BAD", $odd[0] + 1, "geometry",
            "This line is inside the $what but is not an atom: every " .
            "other line there gives an element and three coordinates, " .
            "and this one reads \"$line\"." .
            (scalar(@odd) > 1
               ? " " . (scalar(@odd) - 1) . " more like it follow." : ""));
  } else {
    my $count = 0;
    for my $i ($from .. $to) { $count++ if ($L[$i] =~ /\S/); }
    finding("GOOD", ($from + 1) . "-" . ($to + 1), "geometry",
            "Every one of the $count lines in the $what is an atom.");
  }
}


#  ====================================================================
#  Charge, multiplicity and the electron count
#
#  A FORBIDDEN COMBINATION THAT NEEDS NO KNOWLEDGE OF ANY CODE.
#
#  The electron count follows from the elements and the charge, and
#  the multiplicity fixes how many of those electrons are unpaired.
#  The two have to agree in parity: an even number of electrons cannot
#  produce a doublet, and eleven electrons cannot produce a singlet.
#  Every one of these codes refuses such a job, in its own words and
#  usually well into the run.
#
#  This is arithmetic on the deck, not an opinion about chemistry, and
#  it is the same arithmetic for Gaussian, ORCA, NWChem and MOPAC --
#  which is why it lives here rather than in any one of them.
my %Z = (
  H=>1, He=>2, Li=>3, Be=>4, B=>5, C=>6, N=>7, O=>8, F=>9, Ne=>10,
  Na=>11, Mg=>12, Al=>13, Si=>14, P=>15, S=>16, Cl=>17, Ar=>18,
  K=>19, Ca=>20, Sc=>21, Ti=>22, V=>23, Cr=>24, Mn=>25, Fe=>26,
  Co=>27, Ni=>28, Cu=>29, Zn=>30, Ga=>31, Ge=>32, As=>33, Se=>34,
  Br=>35, Kr=>36, Rb=>37, Sr=>38, Y=>39, Zr=>40, Nb=>41, Mo=>42,
  Tc=>43, Ru=>44, Rh=>45, Pd=>46, Ag=>47, Cd=>48, In=>49, Sn=>50,
  Sb=>51, Te=>52, I=>53, Xe=>54, Cs=>55, Ba=>56, La=>57, Ce=>58,
  Pr=>59, Nd=>60, Pm=>61, Sm=>62, Eu=>63, Gd=>64, Tb=>65, Dy=>66,
  Ho=>67, Er=>68, Tm=>69, Yb=>70, Lu=>71, Hf=>72, Ta=>73, W=>74,
  Re=>75, Os=>76, Ir=>77, Pt=>78, Au=>79, Hg=>80, Tl=>81, Pb=>82,
  Bi=>83, Po=>84, At=>85, Rn=>86,
);

sub electronCount
{
  my ($charge, $multiplicity, $atomLines) = @_;

  my $protons = 0;
  foreach my $symbol (@$atomLines) {
    my $element = ucfirst(lc($symbol));
    #  One unknown element and the sum is wrong, so say nothing at all
    #  rather than accuse a perfectly good deck.
    return unless (exists($Z{$element}));
    $protons += $Z{$element};
  }
  return unless ($protons > 0);

  my $electrons = $protons - $charge;
  if ($electrons < 0) {
    finding("BAD", 0, "electrons",
            "The charge of $charge removes more electrons than this " .
            "molecule has.");
    return;
  }

  my $unpaired = $multiplicity - 1;
  if ($unpaired > $electrons) {
    finding("BAD", 0, "electrons",
            "A multiplicity of $multiplicity needs $unpaired unpaired " .
            "electrons, and this molecule has only $electrons " .
            "altogether.");
    return;
  }

  if ((($electrons - $unpaired) % 2) != 0) {
    my $ok = (($electrons % 2) == 0) ? "an odd multiplicity (1, 3, 5)"
                                     : "an even multiplicity (2, 4, 6)";
    finding("BAD", 0, "electrons",
            "Charge $charge gives this molecule $electrons electrons, " .
            "which cannot have a multiplicity of $multiplicity: " .
            "$electrons electrons require $ok. Either the charge or " .
            "the multiplicity is wrong.");
    return;
  }

  finding("GOOD", 0, "electrons",
          "$electrons electrons at charge $charge, consistent with a " .
          "multiplicity of $multiplicity.");
}


#  ====================================================================
#  Words ECCE itself can emit
#
#  Loaded from data/client/config/verify/<Code>.words, harvested from
#  the generators, templates and basis tables by
#  tools/verify/build_vocabulary.py.
#
#  THIS IS NOT A LIST OF WHAT THE CODE ACCEPTS, and must never be
#  treated as one.  ORCA 6 has well over a thousand keywords and
#  Gaussian's route options run to hundreds; no list of those could be
#  kept current, and an incomplete one would condemn valid keywords --
#  the false-alarm failure that makes a checker worthless.
#
#  What this knows is the much smaller, closed set of words ECCE can
#  write.  A token outside it is text a human typed, which is exactly
#  what Final Edit produces and exactly what is worth pointing at.
#  So an unknown word is UNSURE, NEVER BAD: "I do not recognise this"
#  is true of a hand-typed keyword whether or not the code accepts it,
#  and a harvest with gaps then produces more amber rather than false
#  red.
sub knownWords
{
  my ($codeName) = @_;
  my %words;

  my $home = $ENV{"ECCE_HOME"};
  my @places;
  push(@places, "$home/data/client/config/verify") if ($home);
  #  Beside this script, for a repository checkout.
  my $here = $0;
  $here =~ s{/[^/]+$}{};
  push(@places, "$here/../../data/client/config/verify");

  foreach my $place (@places) {
    my $path = "$place/$codeName.words";
    next unless (-r $path);
    open(my $in, '<', $path) or next;
    while (my $word = <$in>) {
      chomp($word);
      $words{lc($word)} = 1 if ($word =~ /\S/);
    }
    close($in);
    last;
  }
  return \%words;
}


#  Tokens on a keyword line that ECCE would not have written.
sub unknownWords
{
  my ($codeName, $text, $line, $what) = @_;

  my $words = knownWords($codeName);
  #  No vocabulary file: say nothing at all rather than call every
  #  word unknown.
  return unless (%$words);

  #  Gaussian separates method from basis with '/'; ORCA does not --
  #  "def2/J" is one keyword there, and splitting it reports two words
  #  that were never written.
  my $split = ($codeName =~ /^Gaussian/) ? qr{[\s=(),/]+} : qr{[\s=(),]+};

  my @unknown;
  my %reported;
  foreach my $token (split($split, $text)) {
    $token =~ s/^#\S?//;
    next unless ($token =~ /[A-Za-z]/);
    next if ($token =~ /^\d/);

    my $key = lc($token);
    next if (exists($words->{$key}));

    #  Gaussian writes the reference on the front of the method:
    #  rB3LYP, uPBE1PBE, roHF.  Strip it and try again before
    #  concluding anything.
    my $bare = $key;
    if ($bare =~ s/^(ro|r|u)//) {
      next if (exists($words->{$bare}));
    }

    next if (exists($reported{$key}));
    $reported{$key} = 1;
    push(@unknown, $token);
  }

  return unless (@unknown);

  my $list = join(", ", map { "\"$_\"" } @unknown);
  finding("UNSURE", $line, "keywords",
          "ECCE would not have written " .
          (scalar(@unknown) == 1 ? "this word" : "these words") .
          " on the $what: $list. That is not a fault -- it is what a " .
          "hand edit looks like -- but nothing here can tell you " .
          "whether the code accepts " .
          (scalar(@unknown) == 1 ? "it" : "them") . ".");
}

#  ====================================================================
#  Gaussian
#
#  A Gaussian deck is positional and blank-line delimited:
#
#      %-directives (Link 0)     optional, must precede the route
#      # route card              one or more lines
#      <blank>
#      title                     one or more lines
#      <blank>
#      charge multiplicity
#      molecule specification
#      <blank>
#      further sections          Gen basis, ECP, ModRedundant, ...
#      <blank>                   the file must end with one
#
#  Get a blank line wrong and Gaussian reads the title as part of the
#  route, or the charge line as part of the title, and then complains
#  about something that names neither.
#  ====================================================================
sub gaussian
{
  my @L = @stripped;

  my $fromCheck = ($whole =~ /geom\s*=\s*\(?[^)\n]*check/i);
  my $allCheck  = ($whole =~ /geom\s*=\s*\(?[^)\n]*allcheck/i);

  #  --------------------------------------------------- the route card
  my $routeAt = -1;
  for my $i (0 .. $#L) {
    if ($L[$i] =~ /^\s*#/) { $routeAt = $i; last; }
  }
  if ($routeAt < 0) {
    finding("BAD", 0, "route",
            "There is no route card: no line begins with '#'. Gaussian " .
            "will not know what to run.");
    return;
  }

  my $routeEnd = $#L + 1;
  for my $i ($routeAt .. $#L) {
    if ($L[$i] =~ /^\s*$/) { $routeEnd = $i; last; }
  }
  my $last = ($routeEnd <= $#L) ? $routeEnd - 1 : $#L;
  my $route = join(" ", @L[$routeAt .. $last]);
  finding("GOOD", ($routeAt + 1) . "-" . ($last + 1), "route",
          "The route card is present.");

  unknownWords($code, $route, ($routeAt + 1), "route card");

  if (!balanced($route)) {
    finding("BAD", $routeAt + 1, "keywords",
            "The parentheses on the route card do not balance. " .
            "Gaussian rejects the entire route card when they do not, " .
            "so nothing on it takes effect.");
  }

  #  ---------------------------------------------------------- Link 0
  my @late;
  for my $i ($routeAt + 1 .. $#L) {
    push(@late, $i + 1) if ($L[$i] =~ /^\s*%[A-Za-z]/);
  }
  if (@late) {
    finding("BAD", $late[0], "link0",
            "A %-directive appears after the route card. Link 0 " .
            "directives (%mem, %chk, %nprocshared) must come before " .
            "the '#' line, or Gaussian will not act on them.");
  }

  #  Reported, not judged: how much memory or how many processors a
  #  job should ask for is the user's business and the queue's.
  my @got;
  push(@got, "memory")            if ($whole =~ /^\s*%mem\s*=/mi);
  push(@got, "processors")        if ($whole =~ /^\s*%(nprocshared|cpu)\s*=/mi);
  push(@got, "a checkpoint file") if ($whole =~ /^\s*%chk\s*=/mi);
  if (@got) {
    finding("GOOD", 0, "link0", "Link 0 asks for " . join(", ", @got) . ".");
  } else {
    finding("UNSURE", 0, "link0",
            "There are no Link 0 directives at all -- no %mem, no " .
            "%nprocshared, no %chk. Gaussian will use its own " .
            "defaults, which on a shared machine is usually not what " .
            "you want.");
  }
  if ($fromCheck && $whole !~ /^\s*%chk\s*=/mi) {
    finding("BAD", 0, "link0",
            "The route card reads from a checkpoint file, but no %chk " .
            "says which one.");
  }

  #  ------------------------------------------------- section spacing
  if ($routeEnd > $#L) {
    finding("BAD", $routeAt + 1, "sections",
            "There is no blank line after the route card. Gaussian " .
            "reads the route until a blank line, so it will run the " .
            "title into it.");
    return;
  }
  finding("GOOD", 0, "sections",
          "The route card is closed by a blank line.");

  if ($allCheck) {
    finding("UNSURE", 0, "sections",
            "The route says Geom=AllCheck, so the title, charge and " .
            "geometry come from the checkpoint file rather than from " .
            "here. What that file holds cannot be judged from this deck.");
    return;
  }

  my $titleAt = $routeEnd + 1;
  if ($titleAt > $#L || $L[$titleAt] =~ /^\s*$/) {
    finding("BAD", $titleAt + 1, "title",
            "The title section is empty. Gaussian requires a title " .
            "between the route card and the charge line.");
    return;
  }
  my $titleEnd = $#L + 1;
  for my $i ($titleAt .. $#L) {
    if ($L[$i] =~ /^\s*$/) { $titleEnd = $i; last; }
  }
  if ($titleEnd > $#L) {
    finding("BAD", $titleAt + 1, "sections",
            "There is no blank line after the title, so Gaussian will " .
            "read the charge line as part of it.");
    return;
  }
  finding("GOOD", ($titleAt + 1) . "-" . $titleEnd, "title",
          "A title is present and closed.");

  my $chargeAt = $titleEnd + 1;
  if ($chargeAt > $#L || $L[$chargeAt] !~ /^\s*-?\d+\s+-?\d+\s*(!.*)?$/) {
    finding("BAD", ($chargeAt <= $#L ? $chargeAt + 1 : 0), "charge",
            "The line after the title is not a charge and multiplicity " .
            "pair. Gaussian expects two integers there.");
    return;
  }
  my ($charge, $mult) = ($L[$chargeAt] =~ /^\s*(-?\d+)\s+(-?\d+)/);
  finding("GOOD", $chargeAt + 1, "charge",
          "Charge $charge, multiplicity $mult.");
  electronCount($charge, $mult, \@atomSymbols);

  my $geomEnd = $#L + 1;
  for my $i ($chargeAt + 1 .. $#L) {
    if ($L[$i] =~ /^\s*$/) { $geomEnd = $i; last; }
  }
  if ($geomEnd > $#L) {
    finding("BAD", $chargeAt + 2, "sections",
            "The molecule specification is not followed by a blank " .
            "line. Gaussian needs one to know it has ended.");
  } else {
    finding("GOOD", 0, "sections",
            "The molecule specification is closed by a blank line.");
  }

  geometryLines($chargeAt + 1,
                (($geomEnd <= $#L) ? $geomEnd - 1 : $#L),
                undef, "molecule specification");

  if ($L[$#L] !~ /^\s*$/) {
    finding("BAD", $#L + 1, "sections",
            "The file does not end with a blank line, which Gaussian " .
            "requires.");
  }

  gaussianBasis();
}


#  ------------------------------------------------- the Gen basis set
#
#  "/GEN" on the route card means the basis follows in this file, so
#  everything about it can be checked from the file alone: that the
#  block exists, that it is built the way Gaussian's basis reader
#  expects, that each shell lists as many primitives as it declares,
#  and that every element in the molecule is covered by one.
#
#  This is the check #146 needed.  A basis block that came out as six
#  bytes of binary was read by Gaussian as an atomic symbol, and the
#  job died with a segmentation violation -- after reaching a queue.
sub gaussianBasis
{
  my @L = @stripped;
  return unless ($whole =~ m{/gen\b}i);

  #  The first element group header: names, then a terminating zero.
  my $start = -1;
  for my $i (0 .. $#L) {
    if ($L[$i] =~ /^\s*([A-Za-z]{1,2}\d*|-?\d+)(\s+([A-Za-z]{1,2}\d*|-?\d+))*\s+0\s*$/) {
      $start = $i;
      last;
    }
  }
  if ($start < 0) {
    finding("BAD", 0, "basis",
            "The route card says /GEN, which means the basis set is " .
            "given in this file, but no basis block was found.");
    return;
  }

  my %covered;
  my ($groups, $shells, $named, $byNumber) = (0, 0, 0, 0);
  my $i = $start;

  while ($i <= $#L) {
    if ($L[$i] =~ /^\s*$/) { last if ($groups); $i++; next; }

    #  An element group header.
    if ($L[$i] =~ /^\s*(.+?)\s+0\s*$/) {
      my $names = $1;
      foreach my $token (split(/\s+/, $names)) {
        #  A bare number is a centre index rather than an element.
        #  Legal, and it simply cannot be cross-checked against the
        #  geometry -- so note that and claim no coverage from it.
        if ($token =~ /^-?\d+$/) { $byNumber++; next; }
        $token =~ s/^-//;
        $covered{ucfirst(lc($token))} = 1;
      }
      $groups++;
      $i++;

      my $closed = 0;
      while ($i <= $#L) {
        if ($L[$i] =~ /^\s*\*{4,}\s*$/) { $closed = 1; $i++; last; }

        #  A shell: angular momentum, a primitive count, a scale
        #  factor -- then exactly that many lines of primitives.
        if ($L[$i] =~ /^\s*(SP|S|P|D|F|G|H|I)\s+(\d+)\s+$NUM\s*$/i) {
          my ($type, $count) = (uc($1), $2);
          $shells++;
          my $wanted = ($type eq "SP") ? 3 : 2;
          for my $k (1 .. $count) {
            $i++;
            if ($i > $#L) {
              finding("BAD", $i, "basis",
                      "The basis block stops in the middle of a shell: " .
                      "the $type shell declares $count primitives and " .
                      "the file runs out before they are all given.");
              return;
            }
            #  ANCHORED, and nothing but numbers.  Merely counting
            #  numbers found anywhere in the line accepts the NEXT
            #  SHELL's header as a primitive -- " S   1  1.00" holds
            #  two numbers -- so a shell that declares five primitives
            #  and lists three was read as complete, which is exactly
            #  the truncation this check exists to catch.
            my @numbers = ($L[$i] =~ /^\s*($NUM)(?:\s+($NUM))*\s*$/);
            @numbers = grep { defined($_) } @numbers;
            my @all = ($L[$i] =~ /($NUM)/g);
            if (!@numbers || scalar(@all) < $wanted) {
              finding("BAD", $i + 1, "basis",
                      "This should be primitive $k of $count for the " .
                      "$type shell above it, and it is not a row of " .
                      "$wanted numbers. The shell declares more " .
                      "primitives than it lists.");
              return;
            }
          }
          $i++;
          next;
        }

        #  Naming a basis the code ships is legal here and needs no
        #  primitives at all.
        if ($L[$i] =~ /^\s*\S+\s*$/) { $named++; $i++; next; }

        finding("BAD", $i + 1, "basis",
                "This line is inside the basis block but is neither a " .
                "shell (like 'S 3 1.00'), nor a basis name, nor the " .
                "'****' separator that ends an element group.");
        return;
      }

      if (!$closed) {
        finding("BAD", ($i <= $#L ? $i : $#L + 1), "basis",
                "A basis group is never closed by a '****' separator.");
        return;
      }
      next;
    }

    last;
  }

  #  Every element in the molecule needs a basis, or Gaussian stops
  #  with a message that names no element.
  my @missing;
  foreach my $element (@elements) {
    push(@missing, $element) unless (exists($covered{$element}));
  }

  if (@missing && !$byNumber) {
    finding("BAD", $start + 1, "basis",
            "The basis block covers " . join(", ", sort keys %covered) .
            ", but the molecule also contains " . join(", ", @missing) .
            ". Every element needs a basis set.");
    return;
  }

  my $what = "$groups element group" . ($groups == 1 ? "" : "s");
  $what .= ", $shells shell" . ($shells == 1 ? "" : "s") if ($shells);
  $what .= ", $named named" if ($named);
  #  The whole block, so a reader can see that all of it was walked
  #  rather than just found.
  my $stop = ($i > $#L) ? $#L : $i - 1;
  $stop = $start if ($stop < $start);
  finding("GOOD", ($start + 1) . "-" . ($stop + 1), "basis",
          "The Gen basis block is complete and readable: $what.");
  if ($byNumber) {
    finding("UNSURE", $start + 1, "basis",
            "Some basis groups name centres by number rather than by " .
            "element, so whether every atom is covered could not be " .
            "checked.");
  }
}


#  ====================================================================
#  ORCA
#
#      ! keyword line
#      %block ... end            or a one-line %keyword value
#      * xyz <charge> <mult>
#        geometry
#      *
#
#  The geometry block's closing '*' is the thing worth checking: ORCA
#  reads to the end of the file looking for it and reports the failure
#  in terms of whatever it last managed to parse.
#  ====================================================================
sub orca
{
  my @L = @stripped;

  my $bang = 0;
  for my $i (0 .. $#L) { $bang = $i + 1 if (!$bang && $L[$i] =~ /^\s*!/); }
  if ($bang) {
    finding("GOOD", $bang, "route", "The '!' keyword line is present.");
    my $keywords = $L[$bang - 1];
    $keywords =~ s/^\s*!//;
    unknownWords($code, $keywords, $bang, "'!' line");
  } else {
    finding("BAD", 0, "route",
            "There is no '!' keyword line. ORCA will not know what to " .
            "run.");
  }

  #  The geometry block.
  my $openAt = -1;
  my $isFile = 0;
  for my $i (0 .. $#L) {
    if ($L[$i] =~ /^\s*\*\s*(xyzfile|xyz|int|gzmt)\b/i) {
      $openAt = $i;
      $isFile = ($1 =~ /^xyzfile$/i);
      last;
    }
  }

  if ($openAt < 0) {
    finding("BAD", 0, "geomblock",
            "There is no '* xyz' line opening the geometry.");
    return;
  }

  #  Charge and multiplicity live on that same line.
  if ($L[$openAt] =~ /^\s*\*\s*\w+\s+(-?\d+)\s+(\d+)/) {
    finding("GOOD", $openAt + 1, "charge",
            "Charge $1, multiplicity $2.");
    electronCount($1, $2, \@atomSymbols);
  } else {
    finding("BAD", $openAt + 1, "charge",
            "The '* xyz' line does not carry a charge and a " .
            "multiplicity, which ORCA expects on it.");
  }

  if ($isFile) {
    finding("UNSURE", $openAt + 1, "geomblock",
            "The geometry is read from a separate .xyz file, so it " .
            "could not be checked from here.");
    return;
  }

  my $closed = 0;
  for my $i ($openAt + 1 .. $#L) {
    if ($L[$i] =~ /^\s*\*\s*$/) { $closed = $i + 1; last; }
  }
  if ($closed) {
    finding("GOOD", $closed, "geomblock",
            "The geometry block is closed by a '*'.");
    geometryLines($openAt + 1, $closed - 2, undef, "geometry block");
  } else {
    finding("BAD", $openAt + 1, "geomblock",
            "The geometry block opened here is never closed by a line " .
            "holding a single '*'.");
  }
}


#  ====================================================================
#  NWChem
#
#  Block structured: `geometry ... end`, `basis ... end`, `dft ... end`,
#  and a `task` directive that actually asks for something to be done.
#  A deck with no task is read in full and then does nothing at all,
#  which looks like a silent failure and is not one.
#  ====================================================================
sub nwchem
{
  my @L = @stripped;

  my %blocks;
  my @unclosed;
  my $depth = 0;
  my $openedAt = 0;
  my $openName = "";

  for my $i (0 .. $#L) {
    my $line = $L[$i];
    next if ($line =~ /^\s*#/);

    if (!$depth &&
        $line =~ /^\s*(geometry|basis|dft|scf|mp2|ccsd|tce|property|cosmo|driver|md|set|constraints|ecp|relativistic)\b/i) {
      #  A one-line `set` directive opens nothing.
      next if ($line =~ /^\s*set\b/i);
      $depth = 1;
      $openedAt = $i + 1;
      $openName = lc($1);
      $blocks{$openName} = 1;
      next;
    }
    if ($depth && $line =~ /^\s*end\s*$/i) { $depth = 0; next; }
  }
  push(@unclosed, "$openName (line $openedAt)") if ($depth);

  if (exists($blocks{"geometry"})) {
    finding("GOOD", 0, "geometry", "A geometry block is present.");

    #  Directives NWChem accepts inside a geometry block, so they are
    #  not mistaken for stray text.
    my $ok = qr/^\s*(end|units?|angstroms?|au|bohr|nm|pm|nocenter|center|
                      noautoz|autoz|noautosym|autosym|symmetry|zcoord|
                      zmatrix|variables|constants|load|print|adjust|
                      system|bqbq)\b/x;
    for my $i (0 .. $#L) {
      if ($L[$i] =~ /^\s*geometry\b/i) {
        my $close = $#L;
        for my $j ($i + 1 .. $#L) {
          if ($L[$j] =~ /^\s*end\s*$/i) { $close = $j - 1; last; }
        }
        geometryLines($i + 1, $close, $ok, "geometry block");
        last;
      }
    }
  } else {
    finding("BAD", 0, "geometry", "There is no geometry block.");
  }

  if (@unclosed) {
    finding("BAD", $openedAt, "sections",
            "The $openName block is never closed by an 'end'. NWChem " .
            "reads to the end of the file looking for it.");
  } else {
    finding("GOOD", 0, "sections", "Every block is closed by an 'end'.");
  }

  #  NWChem spells these as a top-level `charge` directive and a
  #  `mult` (or `nopen`) inside the method block, so they have to be
  #  gathered before the arithmetic can be done.  Both have defaults,
  #  and the defaults are what a deck means when it omits them.
  my $charge = ($whole =~ /^\s*charge\s+(-?\d+)/mi) ? $1 : 0;
  my $mult   = 1;
  if    ($whole =~ /^\s*mult(?:iplicity)?\s+(\d+)/mi) { $mult = $1; }
  elsif ($whole =~ /^\s*nopen\s+(\d+)/mi)             { $mult = $1 + 1; }
  finding("GOOD", 0, "charge", "Charge $charge, multiplicity $mult.");
  electronCount($charge, $mult, \@atomSymbols);

  if ($whole =~ /^\s*task\b/mi) {
    finding("GOOD", 0, "task", "A task directive is present.");
  } else {
    finding("BAD", 0, "task",
            "There is no task directive, so NWChem will read this file " .
            "and then do nothing.");
  }
}


#  ====================================================================
#  MOPAC
#
#  Strictly positional, and the positions are the whole format:
#
#      line 1    keywords
#      line 2    a description
#      line 3    a second comment line
#      line 4+   the geometry
#
#  There are no blank-line delimiters to get wrong, which makes the
#  one thing that can go wrong -- the geometry starting on the wrong
#  line -- worth stating plainly.  A keyword line continued with '+'
#  or '&' shifts everything down, so that case is not judged.
#  ====================================================================
sub mopac
{
  my @L = @stripped;

  if (!@L || $L[0] !~ /\S/) {
    finding("BAD", 1, "keywords",
            "The first line is empty. MOPAC reads its keywords from " .
            "it, so the job has no instructions.");
    return;
  }
  finding("GOOD", 1, "keywords", "A keyword line is present.");
  unknownWords($code, $L[0], 1, "keyword line");

  if ($L[0] =~ /[+&]\s*$/) {
    finding("UNSURE", 1, "sections",
            "The keyword line is continued onto the next line, which " .
            "moves the geometry down; the layout was not checked.");
    return;
  }

  #  MOPAC puts both on the keyword line, the multiplicity as a word.
  {
    my $charge = ($L[0] =~ /\bCHARGE\s*=\s*(-?\d+)/i) ? $1 : 0;
    my %words = (SINGLET => 1, DOUBLET => 2, TRIPLET => 3, QUARTET => 4,
                 QUINTET => 5, SEXTET => 6, SEPTET => 7, OCTET => 8);
    my $mult = 1;
    foreach my $word (keys %words) {
      if ($L[0] =~ /\b$word\b/i) { $mult = $words{$word}; last; }
    }
    finding("GOOD", 1, "charge", "Charge $charge, multiplicity $mult.");
    electronCount($charge, $mult, \@atomSymbols);
  }

  if (scalar(@L) < 4) {
    finding("BAD", scalar(@L), "sections",
            "A MOPAC deck needs a keyword line, two comment lines and " .
            "then the geometry; this file has only " . scalar(@L) .
            " lines.");
    return;
  }

  #  The geometry must begin on line 4, not before it: a comment line
  #  that looks like an atom is read as one.
  if ($L[3] =~ /^\s*([A-Z][a-z]?)\d*\s+$NUM/) {
    finding("GOOD", 4, "sections",
            "The keyword line, two comment lines and then the geometry.");
  } else {
    finding("BAD", 4, "sections",
            "Line 4 should be the first atom of the geometry -- MOPAC " .
            "expects keywords, two comment lines, then atoms -- and it " .
            "does not look like one.");
  }
}


#  ====================================================================
#  Quantum ESPRESSO
#
#  Fortran namelists, each opened with & and closed with a '/' on a
#  line of its own, then card blocks.  Checked more lightly than the
#  rest: QE support here is experimental, and these rules come from
#  documentation rather than from decks that have been run, which is
#  the weakest evidence this checker uses anywhere.
#  ====================================================================
sub espresso
{
  my @L = @stripped;

  foreach my $required (["control", "&CONTROL"],
                        ["system",  "&SYSTEM"],
                        ["electrons", "&ELECTRONS"]) {
    my ($name, $shown) = @$required;
    if ($whole =~ /^\s*&$name\b/mi) {
      finding("GOOD", 0, $name, "The $shown namelist is present.");
    } else {
      finding("BAD", 0, $name, "There is no $shown namelist.");
    }
  }

  #  Every namelist opened must be closed by a bare '/'.
  my $open = 0;
  my $openAt = 0;
  for my $i (0 .. $#L) {
    if ($L[$i] =~ /^\s*&\w+/)      { $open++; $openAt = $i + 1; next; }
    if ($L[$i] =~ /^\s*\/\s*$/)    { $open--; next; }
  }
  if ($open > 0) {
    finding("BAD", $openAt, "sections",
            "A namelist opened here is never closed by a '/' on a line " .
            "of its own.");
  } elsif ($open == 0) {
    finding("GOOD", 0, "sections", "Every namelist is closed by a '/'.");
  }

  if ($whole =~ /^\s*ATOMIC_POSITIONS/mi) {
    finding("GOOD", 0, "positions", "An ATOMIC_POSITIONS block is present.");
  } else {
    finding("BAD", 0, "positions", "There is no ATOMIC_POSITIONS block.");
  }

  if ($whole =~ /^\s*ATOMIC_SPECIES/mi) {
    finding("GOOD", 0, "species", "An ATOMIC_SPECIES block is present.");
  } else {
    finding("BAD", 0, "species",
            "There is no ATOMIC_SPECIES block, so no pseudopotential is " .
            "named for any element.");
  }
}


#  ------------------------------------------------------- which code
if    ($code =~ /^Gaussian/)          { gaussian();  }
elsif ($code eq "ORCA")               { orca();      }
elsif ($code eq "NWChem")             { nwchem();    }
elsif ($code eq "MOPAC")              { mopac();     }
elsif ($code eq "QuantumESPRESSO")    { espresso();  }
elsif ($code ne "") {
  finding("UNSURE", 0, "code",
          "There are no structural checks for $code yet, so only the " .
          "code-independent ones above were applied.");
} else {
  finding("UNSURE", 0, "code",
          "No code was named, so only the code-independent checks above " .
          "were applied.");
}

print "$_\n" foreach (@findings);

#  Exit status: 1 if anything is BAD, 0 otherwise.  The caller shows the
#  light; this only reports.
exit((grep { /^BAD\|/ } @findings) ? 1 : 0);
