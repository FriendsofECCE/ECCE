#!/usr/bin/env python3
"""Check the structure of a generated input deck before submission.

verifyinput -f <input file> -c <code name> [-a <atom count>]
Findings on stdout are LEVEL|LINE|CHECK|MESSAGE; exit 1 means a BAD finding.
Unknown keywords are UNSURE: the vocabulary describes what ECCE writes,
not everything a chemistry code accepts.
"""

import os
import re
import sys


NUM = r'[-+]?(?:\d+\.?\d*|\.\d+)(?:[eEdD][-+]?\d+)?'
Z = dict(zip(
    'H He Li Be B C N O F Ne Na Mg Al Si P S Cl Ar K Ca Sc Ti V Cr Mn Fe '
    'Co Ni Cu Zn Ga Ge As Se Br Kr Rb Sr Y Zr Nb Mo Tc Ru Rh Pd Ag Cd In Sn '
    'Sb Te I Xe Cs Ba La Ce Pr Nd Pm Sm Eu Gd Tb Dy Ho Er Tm Yb Lu Hf Ta W '
    'Re Os Ir Pt Au Hg Tl Pb Bi Po At Rn'.split(), range(1, 87)))
findings = []


def finding(level, line, check, message):
    findings.append('|'.join(str(x) for x in (level, line, check, message)))


def diagnostic(message):
    sys.stderr.buffer.write(message.replace('\n', os.linesep).encode('utf-8', 'surrogateescape'))


def balanced(text):
    depth = 0
    for character in text:
        if character == '(':
            depth += 1
        if character == ')':
            depth -= 1
        if depth < 0:
            return False
    return depth == 0


def geometryLines(start, stop, directives, what):
    L = stripped
    if start > stop or start < 0 or stop >= len(L):
        return
    first = next((i for i in range(start, stop + 1)
                  if re.search(r'\S', L[i], re.ASCII)), -1)
    cartesian = r'^\s*[A-Za-z][A-Za-z]?\S*\s+' + NUM + r'\s+' + NUM + r'\s+' + NUM + r'(\s|$)'
    if first < 0 or not re.search(cartesian, L[first], re.ASCII):
        return
    odd = []
    for i in range(start, stop + 1):
        if not re.search(r'\S', L[i], re.ASCII):
            continue
        if re.search(cartesian, L[i], re.ASCII):
            continue
        if directives is not None and re.search(directives, L[i], re.I | re.ASCII):
            continue
        odd.append(i)
    if odd:
        line = re.sub(r'^\s+|\s+$', '', L[odd[0]], flags=re.ASCII)
        if len(line) > 43:
            line = line[:40] + '...'
        finding('BAD', odd[0] + 1, 'geometry',
                'This line is inside the {} but is not an atom: every '
                'other line there gives an element and three coordinates, '
                'and this one reads "{}".{}'.format(
                    what, line, ' {} more like it follow.'.format(len(odd) - 1)
                    if len(odd) > 1 else ''))
    else:
        count = sum(bool(re.search(r'\S', L[i], re.ASCII)) for i in range(start, stop + 1))
        finding('GOOD', '{}-{}'.format(start + 1, stop + 1), 'geometry',
                'Every one of the {} lines in the {} is an atom.'.format(count, what))


def electronCount(charge, multiplicity, atomLines, assumed=False):
    level = 'UNSURE' if assumed else 'BAD'
    protons = 0
    for symbol in atomLines:
        element = symbol.lower().capitalize()
        if element not in Z:
            return
        protons += Z[element]
    if protons <= 0:
        return
    electrons = protons - int(charge)
    if electrons < 0:
        finding(level, 0, 'electrons',
                'The charge of {} removes more electrons than this molecule has.'.format(charge))
        return
    unpaired = int(multiplicity) - 1
    if unpaired > electrons:
        finding(level, 0, 'electrons',
                'A multiplicity of {} needs {} unpaired electrons, and this molecule has only {} '
                'altogether.'.format(multiplicity, unpaired, electrons))
        return
    if (electrons - unpaired) % 2:
        ok = 'an odd multiplicity (1, 3, 5)' if electrons % 2 == 0 else 'an even multiplicity (2, 4, 6)'
        finding(level, 0, 'electrons',
                'Charge {} gives this molecule {} electrons, which cannot have a multiplicity of {}: '
                '{} electrons require {}. {}'.format(
                    charge, electrons, multiplicity, electrons, ok,
                    'This deck does not state a multiplicity, so one was assumed -- the assumption may be what is wrong here.'
                    if assumed else 'Either the charge or the multiplicity is wrong.'))
        return
    finding('GOOD', 0, 'electrons',
            '{} electrons at charge {}, consistent with a multiplicity of {}.'.format(electrons, charge, multiplicity))


def knownWords(codeName):
    places = []
    home = os.environ.get('ECCE_HOME')
    if home and home != '0':
        places.append(home + '/data/client/config/verify')
    # Preserve the checkout lookup as well as the installed ECCE_HOME lookup.
    here = re.sub(r'/[^/]+$', '', sys.argv[0])
    places.append(here + '/../../data/client/config/verify')
    for place in places:
        path = place + '/' + codeName + '.words'
        try:
            with open(path, encoding='latin-1', newline=None if os.name == 'nt' else '') as handle:
                return {word.rstrip('\n').lower(): 1 for word in handle
                        if re.search(r'\S', word, re.ASCII)}
        except OSError:
            continue
    return {}


def unknownWords(codeName, text, line, what):
    words = knownWords(codeName)
    if not words:
        return
    split = r'[\s=(),/]+' if codeName.startswith('Gaussian') else r'[\s=(),]+'
    unknown, reported = [], set()
    for token in re.split(split, text, flags=re.ASCII):
        token = re.sub(r'^#\S?', '', token, flags=re.ASCII)
        if not re.search(r'[A-Za-z]', token) or re.search(r'^\d', token, re.ASCII):
            continue
        key = token.lower()
        if key in words:
            continue
        bare = re.sub(r'^(ro|r|u)', '', key)
        if bare != key and bare in words:
            continue
        if key in reported:
            continue
        reported.add(key)
        unknown.append(token)
    if not unknown:
        return
    finding('UNSURE', line, 'keywords',
            'ECCE would not have written {} on the {}: {}. That is not a fault -- it is what a '
            'hand edit looks like -- but nothing here can tell you whether the code accepts {}.'.format(
                'this word' if len(unknown) == 1 else 'these words', what,
                ', '.join('"{}"'.format(t) for t in unknown), 'it' if len(unknown) == 1 else 'them'))
def gaussian():
    L = stripped
    fromCheck = re.search(r'geom\s*=\s*\(?[^)\n]*check', whole, re.I | re.A)
    allCheck = re.search(r'geom\s*=\s*\(?[^)\n]*allcheck', whole, re.I | re.A)
    routeAt = next((i for i, line in enumerate(L) if re.search(r'^\s*#', line, re.A)), -1)
    if routeAt < 0:
        finding('BAD', 0, 'route',
                "There is no route card: no line begins with '#'. Gaussian "
                'will not know what to run.')
        return
    routeEnd = next((i for i in range(routeAt, len(L)) if re.search(r'^\s*$', L[i], re.A)), len(L))
    last = routeEnd - 1 if routeEnd < len(L) else len(L) - 1
    route = ' '.join(L[routeAt:last + 1])
    finding('GOOD', '{}-{}'.format(routeAt + 1, last + 1), 'route', 'The route card is present.')
    unknownWords(code, route, routeAt + 1, 'route card')
    if not balanced(route):
        finding('BAD', routeAt + 1, 'keywords',
                'The parentheses on the route card do not balance. '
                'Gaussian rejects the entire route card when they do not, '
                'so nothing on it takes effect.')
    td = re.search(r'(?:^|\s)(TDA?)\s*(?:=\s*\(?([^\s)]*)|\(([^)]*)\))?', route, re.I | re.A)
    if td:
        opts = td.group(3) if td.group(3) is not None else (td.group(2) or '')
        at = routeAt + 1
        states = re.search(r'NStates\s*=\s*(-?\d+)', opts, re.I | re.A)
        if states and int(states.group(1)) < 1:
            finding('UNSURE', at, 'excited', 'NStates is {}; TD needs at least one state.'.format(states.group(1)))
        else:
            finding('GOOD', at, 'excited', 'TD excited-state request is present.')
        if re.search(r'(?:^|[\s/])RO\w*', route, re.I | re.A) and not re.search(r'\bUHF\b', route, re.I | re.A):
            finding('UNSURE', at, 'excited',
                    'TD is not available for a restricted open-shell (RO) '
                    'reference in Gaussian.')
        if re.search(r'\b(MP[2-5]|CCSD|CCD|QCISD|CASSCF|CIS)\b', route, re.I | re.A):
            finding('UNSURE', at, 'excited',
                    'TD is requested together with a correlated or CI method; '
                    'TD applies to HF and DFT references.')
        if re.search(r'\bopt\b', route, re.I | re.A) and not re.search('root', opts, re.I | re.A):
            finding('UNSURE', at, 'excited',
                    'TD with an optimisation optimises the geometry of the first '
                    'excited state, not the ground state.')
    late = [i + 1 for i in range(routeAt + 1, len(L)) if re.search(r'^\s*%[A-Za-z]', L[i], re.A)]
    if late:
        finding('BAD', late[0], 'link0',
                'A %-directive appears after the route card. Link 0 '
                'directives (%mem, %chk, %nprocshared) must come before '
                "the '#' line, or Gaussian will not act on them.")
    got = []
    for pattern, label in [(r'^\s*%mem\s*=', 'memory'),
                           (r'^\s*%(nprocshared|cpu|nproc)\s*=', 'processors'),
                           (r'^\s*%chk\s*=', 'a checkpoint file')]:
        if re.search(pattern, whole, re.M | re.I | re.A):
            got.append(label)
    if got:
        finding('GOOD', 0, 'link0', 'Link 0 asks for ' + ', '.join(got) + '.')
    if fromCheck and not re.search(r'^\s*%chk\s*=', whole, re.M | re.I | re.A):
        finding('BAD', 0, 'link0',
                'The route card reads from a checkpoint file, but no %chk '
                'says which one.')
    if re.search(r'\breadfc\b', whole, re.I | re.A) and not re.search(r'^\s*%oldchk\s*=', whole, re.M | re.I | re.A):
        finding('UNSURE', routeAt + 1, 'link0',
                'The route card says Opt=ReadFC, but no %OldChk names the '
                'checkpoint file of an earlier calculation to read the force '
                "constants from. Pick that calculation's checkpoint as the "
                'orbital guess in the Calculation Editor, or Gaussian will '
                'stop for lack of force constants.')
    if re.search(r'\bNoSymm\b', whole, re.I | re.A) and not qstWanted:
        finding('UNSURE', routeAt + 1, 'symmetry',
                'This deck says NoSymm, so the calculation will report no '
                'orbital symmetry labels -- no MO correlation diagram can '
                'be drawn from it, and orbitals will be numbered rather '
                'than named. Tick "Use symmetry" in the Calculation '
                'Editor if that was not intended.')
    if routeEnd >= len(L):
        finding('BAD', routeAt + 1, 'sections',
                'There is no blank line after the route card. Gaussian '
                'reads the route until a blank line, so it will run the '
                'title into it.')
        return
    finding('GOOD', 0, 'sections', 'The route card is closed by a blank line.')
    if allCheck:
        finding('UNSURE', 0, 'sections',
                'The route says Geom=AllCheck, so the title, charge and '
                'geometry come from the checkpoint file rather than from '
                'here. What that file holds cannot be judged from this deck.')
        return
    titleAt = routeEnd + 1
    if titleAt >= len(L) or re.search(r'^\s*$', L[titleAt], re.A):
        finding('BAD', titleAt + 1, 'title',
                'The title section is empty. Gaussian requires a title '
                'between the route card and the charge line.')
        return
    titleEnd = next((i for i in range(titleAt, len(L)) if re.search(r'^\s*$', L[i], re.A)), len(L))
    if titleEnd >= len(L):
        finding('BAD', titleAt + 1, 'sections',
                'There is no blank line after the title, so Gaussian will '
                'read the charge line as part of it.')
        return
    swallowed = -1
    for i in range(titleAt, titleEnd):
        if (re.search(r'^\s*-?\d+\s+-?\d+\s*(!.*)?$', L[i], re.A) or
                re.search(r'^\s*[A-Za-z][A-Za-z]?\S*\s+$NUM\s+$NUM\s+$NUM(\s|$)'.replace('$NUM', NUM), L[i], re.A)):
            swallowed = i
            break
    if swallowed >= 0:
        finding('BAD', swallowed + 1, 'sections',
                'There is no blank line between the title and this line, so '
                'Gaussian will read it as part of the title. The title runs '
                'from line {} to line {}, which cannot be what was meant.'.format(titleAt + 1, titleEnd))
        return
    finding('GOOD', '{}-{}'.format(titleAt + 1, titleEnd), 'title', 'A title is present and closed.')
    chargeAt = titleEnd + 1
    if chargeAt >= len(L) or not re.search(r'^\s*-?\d+\s+-?\d+\s*(!.*)?$', L[chargeAt], re.A):
        finding('BAD', chargeAt + 1 if chargeAt < len(L) else 0, 'charge',
                'The line after the title is not a charge and multiplicity '
                'pair. Gaussian expects two integers there.')
        return
    charge, mult = re.search(r'^\s*(-?\d+)\s+(-?\d+)', L[chargeAt], re.A).groups()
    finding('GOOD', chargeAt + 1, 'charge', 'Charge {}, multiplicity {}.'.format(charge, mult))
    electronCount(charge, mult, atomSymbols)
    geomEnd = next((i for i in range(chargeAt + 1, len(L)) if re.search(r'^\s*$', L[i], re.A)), len(L))
    if geomEnd >= len(L):
        finding('BAD', chargeAt + 2, 'sections',
                'The molecule specification is not followed by a blank '
                'line. Gaussian needs one to know it has ended.')
    else:
        finding('GOOD', 0, 'sections', 'The molecule specification is closed by a blank line.')
    geometryLines(chargeAt + 1, geomEnd - 1 if geomEnd < len(L) else len(L) - 1,
                  None, 'molecule specification')
    if (geomEnd < len(L) and
            not re.search(r'gen|qst[23]|extrabasis|pseudo|modred|read|charge|massage|connect|oniom|gic|cards|extern|@', route, re.I | re.A) and
            not re.search('--link1--', whole, re.I | re.A)):
        for i in range(geomEnd + 1, len(L)):
            if re.search(r'^\s*$', L[i], re.A):
                continue
            finding('UNSURE', i + 1, 'sections',
                    'Nothing on the route card asks Gaussian to read input '
                    'after the molecule specification, so it will ignore '
                    'this line.')
            break
    if not re.search(r'^\s*$', L[-1], re.A):
        finding('BAD', len(L), 'sections',
                'The file does not end with a blank line, which Gaussian requires.')
    gaussianBasis()


def gaussianBasis():
    L = stripped
    if not re.search(r'/gen\b', whole, re.I | re.A):
        return
    start = next((i for i, line in enumerate(L) if re.search(r'^\s*([A-Za-z]{1,2}\d*|-?\d+)(\s+([A-Za-z]{1,2}\d*|-?\d+))*\s+0\s*$', line, re.A)), -1)
    if start < 0:
        finding('BAD', 0, 'basis',
                'The route card says /GEN, which means the basis set is '
                'given in this file, but no basis block was found.')
        return
    covered = set()
    groups = shells = named = byNumber = 0
    i = start
    while i < len(L):
        if re.search(r'^\s*$', L[i], re.A):
            if groups:
                break
            i += 1
            continue
        header = re.search(r'^\s*(.+?)\s+0\s*$', L[i], re.A)
        if header:
            names = header.group(1)
            for token in re.split(r'\s+', names, flags=re.A):
                if re.search(r'^-?\d+$', token, re.A):
                    byNumber += 1
                    continue
                token = re.sub('^-', '', token)
                covered.add(token.lower().capitalize())
            groups += 1
            i += 1
            closed = False
            while i < len(L):
                if re.search(r'^\s*\*{4,}\s*$', L[i], re.A):
                    closed = True
                    i += 1
                    break
                shell = re.search(r'^\s*(SP|S|P|D|F|G|H|I)\s+(\d+)\s+$NUM\s*$'.replace('$NUM', NUM), L[i], re.I | re.A)
                if shell:
                    kind, count = shell.group(1).upper(), shell.group(2)
                    shells += 1
                    wanted = 3 if kind == 'SP' else 2
                    for k in range(1, int(count) + 1):
                        i += 1
                        if i >= len(L):
                            finding('BAD', i, 'basis',
                                    'The basis block stops in the middle of a shell: '
                                    'the {} shell declares {} primitives and '
                                    'the file runs out before they are all given.'.format(kind, count))
                            return
                        # Require the complete primitive row; a shell header also contains numbers.
                        numbers = re.search(r'^\s*($NUM)(?:\s+($NUM))*\s*$'.replace('$NUM', NUM), L[i], re.A)
                        allNumbers = re.findall('(' + NUM + ')', L[i], re.A)
                        if not numbers or len(allNumbers) < wanted:
                            finding('BAD', i + 1, 'basis',
                                    'This should be primitive {} of {} for the '
                                    '{} shell above it, and it is not a row of '
                                    '{} numbers. The shell declares more '
                                    'primitives than it lists.'.format(k, count, kind, wanted))
                            return
                    i += 1
                    continue
                if re.search(r'^\s*\S+\s*$', L[i], re.A):
                    named += 1
                    i += 1
                    continue
                finding('BAD', i + 1, 'basis',
                        'This line is inside the basis block but is neither a '
                        "shell (like 'S 3 1.00'), nor a basis name, nor the "
                        "'****' separator that ends an element group.")
                return
            if not closed:
                finding('BAD', i if i < len(L) else len(L), 'basis',
                        "A basis group is never closed by a '****' separator.")
                return
            continue
        break
    missing = [element for element in elements if element not in covered]
    if missing and not byNumber:
        finding('BAD', start + 1, 'basis',
                'The basis block covers ' + ', '.join(sorted(covered)) +
                ', but the molecule also contains ' + ', '.join(missing) +
                '. Every element needs a basis set.')
        return
    what = '{} element group{}'.format(groups, '' if groups == 1 else 's')
    if shells:
        what += ', {} shell{}'.format(shells, '' if shells == 1 else 's')
    if named:
        what += ', {} named'.format(named)
    stop = len(L) - 1 if i >= len(L) else i - 1
    stop = max(stop, start)
    finding('GOOD', '{}-{}'.format(start + 1, stop + 1), 'basis',
            'The Gen basis block is complete and readable: {}.'.format(what))
    if byNumber:
        finding('UNSURE', start + 1, 'basis',
                'Some basis groups name centres by number rather than by '
                'element, so whether every atom is covered could not be '
                'checked.')


def orca():
    L = stripped
    bang = next((i + 1 for i, line in enumerate(L) if re.search(r'^\s*!', line, re.A)), 0)
    if bang:
        finding('GOOD', bang, 'route', "The '!' keyword line is present.")
        keywords = re.sub(r'^\s*!', '', L[bang - 1], flags=re.A)
        unknownWords(code, keywords, bang, "'!' line")
    else:
        finding('BAD', 0, 'route',
                "There is no '!' keyword line. ORCA will not know what to run.")
    openedAt = firstBlock = lastBlock = -1
    blocks = 0
    inSub = False
    for i, line in enumerate(L):
        # NewGTO/NewECP have their own end; it does not close %basis.
        if openedAt >= 0 and not inSub and re.search(r'^\s*New\w+\s+\w+\s*$', line, re.I | re.A):
            inSub = True
            continue
        if inSub:
            if re.search(r'^\s*end\s*$', line, re.I | re.A):
                inSub = False
            continue
        if openedAt < 0 and re.search(r'^\s*%(\w+)\s*$', line, re.A):
            openedAt = i
            if firstBlock < 0:
                firstBlock = i
            continue
        if openedAt >= 0 and re.search(r'^\s*end\s*$', line, re.I | re.A):
            blocks += 1
            lastBlock = i
            openedAt = -1
            continue
        if openedAt < 0 and re.search(r'^\s*%\w+\s+\S', line, re.A):
            if firstBlock < 0:
                firstBlock = i
            lastBlock = i
            blocks += 1
    if openedAt >= 0:
        finding('BAD', openedAt + 1, 'blocks',
                "This % block is never closed by an 'end'. ORCA reads to "
                'the end of the file looking for one.')
    elif blocks:
        finding('GOOD', '{}-{}'.format(firstBlock + 1, lastBlock + 1), 'blocks',
                '{} % block{} present and closed.'.format(blocks, ' is' if blocks == 1 else 's are'))
    orcaBasis(L)
    tdAt = 0
    inTd = False
    nroots = triplets = None
    for i, line in enumerate(L):
        if re.search(r'^\s*%tddft\s*$', line, re.I | re.A):
            inTd = True
            tdAt = i + 1
            continue
        if inTd and re.search(r'^\s*end\s*$', line, re.I | re.A):
            inTd = False
            continue
        if inTd:
            roots = re.search(r'^\s*nroots\s+(-?\d+)', line, re.I | re.A)
            if roots:
                nroots = roots.group(1)
            triplet = re.search(r'^\s*triplets\s+(\w+)', line, re.I | re.A)
            if triplet:
                triplets = triplet.group(1)
    if tdAt:
        if nroots is None:
            finding('UNSURE', tdAt, 'excited',
                    'The %tddft block gives no nroots; ORCA will compute '
                    'only its default number of states.')
        elif int(nroots) < 1:
            finding('BAD', tdAt, 'excited', 'nroots is {}; %tddft needs at least one state.'.format(nroots))
        else:
            finding('GOOD', tdAt, 'excited', 'TD-DFT asks for {} states.'.format(nroots))
        kw = L[bang - 1] if bang else ''
        if re.search(r'\b(\w*MP2\w*|CCSD\w*|CASSCF|NEVPT2|CASPT2|DLPNO\S*)', kw, re.I | re.A):
            finding('UNSURE', tdAt, 'excited',
                    '%tddft acts on the SCF/DFT reference; the correlated '
                    "method on the '!' line does not give excited states.")
        spin = re.search(r'^\s*\*\s*\w+\s+-?\d+\s+([2-9]\d*)\b', whole, re.M | re.A)
        if triplets is not None and re.search(r'^(true|1|yes)$', triplets, re.I | re.A) and spin:
            finding('UNSURE', tdAt, 'excited',
                    'Triplets are requested for an open-shell (multiplicity '
                    "{}) system; ORCA's unrestricted TD-DFT has no "
                    'singlet/triplet split.'.format(spin.group(1)))
    openAt = -1
    isFile = False
    for i, line in enumerate(L):
        opening = re.search(r'^\s*\*\s*(xyzfile|xyz|int|gzmt)\b', line, re.I | re.A)
        if opening:
            openAt = i
            isFile = opening.group(1).lower() == 'xyzfile'
            break
    if openAt < 0:
        finding('BAD', 0, 'geomblock', "There is no '* xyz' line opening the geometry.")
        return
    chargeLine = re.search(r'^\s*\*\s*\w+\s+(-?\d+)\s+(\d+)', L[openAt], re.A)
    if chargeLine:
        charge, mult = chargeLine.groups()
        finding('GOOD', openAt + 1, 'charge', 'Charge {}, multiplicity {}.'.format(charge, mult))
        electronCount(charge, mult, atomSymbols)
    else:
        finding('BAD', openAt + 1, 'charge',
                "The '* xyz' line does not carry a charge and a "
                'multiplicity, which ORCA expects on it.')
    if isFile:
        finding('UNSURE', openAt + 1, 'geomblock',
                'The geometry is read from a separate .xyz file, so it '
                'could not be checked from here.')
        return
    closed = next((i + 1 for i in range(openAt + 1, len(L)) if re.search(r'^\s*\*\s*$', L[i], re.A)), 0)
    if closed:
        finding('GOOD', closed, 'geomblock', "The geometry block is closed by a '*'.")
        geometryLines(openAt + 1, closed - 2, None, 'geometry block')
    else:
        finding('BAD', openAt + 1, 'geomblock',
                'The geometry block opened here is never closed by a line '
                "holding a single '*'.")


def orcaBasis(L=None):
    if L is None:
        L = stripped
    num = NUM
    bad = 0
    gtoRows = ecpRows = 0
    first = last = -1
    lval = dict((name, i) for i, name in enumerate('spdfghik'))
    i = 0
    while i < len(L):
        block = re.search(r'^\s*New(GTO|ECP)\s+(\w+)\s*$', L[i], re.I | re.A)
        if not block:
            i += 1
            continue
        kind, el = block.group(1).upper(), block.group(2)
        at = i + 1
        if first < 0:
            first = at
        lmax = ncore = closed = None
        seen = {}
        i += 1
        while i < len(L):
            line = L[i]
            if re.search(r'^\s*end\s*$', line, re.I | re.A):
                closed = i + 1
                i += 1
                break
            core = re.search(r'^\s*N_core\s+(\d+)\s*$', line, re.I | re.A)
            if kind == 'ECP' and core:
                ncore = core.group(1)
                i += 1
                continue
            maximum = re.search(r'^\s*lmax\s+([spdfghik])\s*$', line, re.I | re.A)
            if kind == 'ECP' and maximum:
                lmax = maximum.group(1).lower()
                i += 1
                continue
            hdr = r'^\s*([SPDFGHIKL])\s+(\d+)\s*$' if kind == 'GTO' else r'^\s*([spdfghik])\s+(\d+)\s*$'
            shell = re.search(hdr, line, re.I | re.A)
            if shell:
                sh, n = shell.group(1).lower(), shell.group(2)
                hline = i + 1
                seen[sh] = hline
                if kind == 'ECP' and lmax is not None and lval[sh] > lval[lmax]:
                    finding('BAD', hline, 'basis',
                            "ECP shell '{}' on {} is above its declared lmax "
                            "'{}'. ORCA stops on this.".format(sh, el, lmax))
                    bad += 1
                if kind == 'ECP':
                    row = r'^\s*\d+\s+$num\s+$num\s+\d+\s*$'
                elif sh == 'l':
                    row = r'^\s*\d+\s+$num\s+$num\s+$num\s*$'
                else:
                    row = r'^\s*\d+\s+$num\s+$num\s*$'
                row = row.replace('$num', num)
                got = 0
                i += 1
                while got < int(n) and i < len(L) and re.search(row, L[i], re.A):
                    got += 1
                    i += 1
                if got < int(n):
                    why = ''
                    if kind == 'ECP' and i < len(L) and re.search(r'^\s*$num\s+$num\s+$num\s*$'.replace('$num', num), L[i], re.A):
                        why = (' Its rows have three columns; ORCA needs four -- '
                               'index, exponent, coefficient, power -- and without '
                               'the index stops with "exponent expected in NewECP".')
                    finding('BAD', hline, 'basis',
                            'This {} shell on {} declares {} row{} but {}'
                            ' in the form ORCA reads.{}'.format(kind, el, n,
                                '' if int(n) == 1 else 's',
                                'only {} follow'.format(got) if got else 'none follow', why))
                    bad += 1
                    while i < len(L) and not re.search(hdr, L[i], re.I | re.A) and not re.search(r'^\s*end\s*$', L[i], re.I | re.A):
                        i += 1
                else:
                    if kind == 'ECP':
                        ecpRows += got
                    else:
                        gtoRows += got
                    if i < len(L) and re.search(row, L[i], re.A):
                        finding('BAD', i + 1, 'basis',
                                'This row follows a {} shell on {} that declared only {}.'.format(kind, el, n))
                        bad += 1
                        while i < len(L) and re.search(row, L[i], re.A):
                            i += 1
                continue
            finding('BAD', i + 1, 'basis',
                    'This line inside the New{} block for {} is neither a '
                    'shell header nor one of its rows.'.format(kind, el))
            bad += 1
            i += 1
        if not closed:
            finding('BAD', at, 'basis', "The New{} block for {} is never closed by an 'end'.".format(kind, el))
            bad += 1
            continue
        last = closed
        if kind == 'ECP':
            if ncore is None:
                finding('BAD', at, 'basis', 'The NewECP block for {} has no N_core line.'.format(el))
                bad += 1
            if lmax is None:
                finding('BAD', at, 'basis', 'The NewECP block for {} has no lmax line.'.format(el))
                bad += 1
            elif lmax not in seen:
                finding('BAD', at, 'basis',
                        'The NewECP block for {} declares lmax {} but lists '
                        "no '{}' shell. ORCA accepts this and silently runs "
                        'with a different potential from the one intended.'.format(el, lmax, lmax))
                bad += 1
    if first > 0 and not bad:
        finding('GOOD', '{}-{}'.format(first, last), 'basis',
                'Every NewGTO/NewECP shell lists the rows it declares '
                '({} basis, {} ECP), in the column layout ORCA reads.'.format(gtoRows, ecpRows))


def nwchem():
    L = stripped
    blocks = set()
    depth, openedAt, openName = 0, 0, ""
    for i, line in enumerate(L):
        if re.search(r'^\s*#', line, re.ASCII):
            continue
        m = re.search(r'^\s*(geometry|basis|dft|scf|mp2|ccsd|tce|property|cosmo|driver|md|set|constraints|ecp|relativistic)\b', line, re.I | re.ASCII)
        if not depth and m:
            if re.search(r'^\s*set\b', line, re.I | re.ASCII):
                continue
            depth, openedAt, openName = 1, i + 1, m.group(1).lower()
            blocks.add(openName)
            continue
        if depth and re.search(r'^\s*end\s*$', line, re.I | re.ASCII):
            depth = 0
            continue
    if 'geometry' in blocks:
        finding("GOOD", 0, "geometry", "A geometry block is present.")
        ok = r'^\s*(end|units?|angstroms?|au|bohr|nm|pm|nocenter|center|noautoz|autoz|noautosym|autosym|symmetry|zcoord|zmatrix|variables|constants|load|print|adjust|system|bqbq)\b'
        for i, line in enumerate(L):
            if re.search(r'^\s*geometry\b', line, re.I | re.ASCII):
                close = len(L) - 1
                for j in range(i + 1, len(L)):
                    if re.search(r'^\s*end\s*$', L[j], re.I | re.ASCII):
                        close = j - 1
                        break
                geometryLines(i + 1, close, ok, "geometry block")
                break
    else:
        finding("BAD", 0, "geometry", "There is no geometry block.")
    if depth:
        finding("BAD", openedAt, "sections",
                "The {} block is never closed by an 'end'. NWChem "
                "reads to the end of the file looking for it.".format(openName))
    else:
        finding("GOOD", 0, "sections", "Every block is closed by an 'end'.")
    m = re.search(r'^\s*charge\s+(-?\d+)', whole, re.M | re.I | re.ASCII)
    charge = m.group(1) if m else 0
    mult, assumed = 1, 1
    m = re.search(r'^\s*mult(?:iplicity)?\s+(\d+)', whole, re.M | re.I | re.ASCII)
    n = re.search(r'^\s*nopen\s+(\d+)', whole, re.M | re.I | re.ASCII)
    if m:
        mult, assumed = m.group(1), 0
    elif n:
        mult, assumed = int(n.group(1)) + 1, 0
    finding("GOOD", 0, "charge", "Charge {}, multiplicity {}{}.".format(
        charge, mult, " (assumed: the deck does not say)" if assumed else ""))
    electronCount(charge, mult, atomSymbols, assumed)
    if int(mult) > 1:
        if re.search(r'^\s*task\s+ccsd(?:\(t\)|\+t\(ccsd\))?\s', whole, re.M | re.I | re.ASCII):
            finding("BAD", 0, "openshell",
                    "The multiplicity is {}, but NWChem's ccsd module is "
                    "closed-shell only and stops with 'nopen is not zero'. "
                    "Use UCCSD or ROCCSD (tensor contraction engine) instead.".format(mult))
        if (re.search(r'^\s*task\s+mp2\s', whole, re.M | re.I | re.ASCII) and
                not re.search(r'^\s*uhf\b', whole, re.M | re.I | re.ASCII)):
            finding("BAD", 0, "openshell",
                    "The multiplicity is {}, but NWChem's mp2 module needs "
                    "a UHF reference for an open shell and stops with "
                    "'unknown SCFTYPE'. Use UMP2.".format(mult))
    if re.search(r'^\s*zcoord\b', whole, re.M | re.I | re.ASCII):
        if re.search(r'^\s*fix\s+atom\b', whole, re.M | re.I | re.ASCII):
            finding("BAD", 0, "constraints",
                    "Fixed atoms cannot be combined with bond, angle or torsion "
                    "constraints in NWChem: the optimizer stops with 'cartesian "
                    "constraints+internals'. Use either fixed atoms, or the "
                    "internal-coordinate constraints (a restraint may be combined "
                    "with the latter).")
        elif re.search(r'^\s*geometry\b[^\n]*\bnoautoz\b', whole, re.M | re.I | re.ASCII):
            finding("BAD", 0, "constraints",
                    "The geometry has noautoz, and NWChem then ignores the zcoord "
                    "bond, angle and torsion constraints without a message.")
    if re.search(r'^\s*task\b', whole, re.M | re.I | re.ASCII):
        finding("GOOD", 0, "task", "A task directive is present.")
    else:
        finding("BAD", 0, "task", "There is no task directive, so NWChem will read this file "
                "and then do nothing.")


def lineOf(pattern):
    for i, line in enumerate(stripped):
        if re.search(pattern, line):
            return i + 1
    return 0


def cp2k():
    L = stripped
    ranges, stack = {}, []
    bad = 0
    for i, line in enumerate(L):
        line = re.sub(r'[#!].*', '', line, flags=re.ASCII)
        m = re.search(r'^\s*&END\b\s*(\w*)', line, re.I | re.ASCII)
        if m:
            name = m.group(1).upper()
            top = stack.pop() if stack else None
            if top is not None:
                ranges.setdefault(top[0].upper(), '{}-{}'.format(top[1], i + 1))
            if top is None or (name and top[0].upper() != name):
                finding("BAD", i + 1, "sections",
                        "This &END does not close the section open at that point" +
                        (" (&{} from line {}).".format(top[0], top[1]) if top is not None else "."))
                bad += 1
                break
        else:
            m = re.search(r'^\s*&(\w+)', line, re.ASCII)
            if m:
                stack.append((m.group(1), i + 1))
    if not bad and stack:
        finding("BAD", stack[-1][1], "sections",
                "The &{} section opened here is never closed by &END.".format(stack[-1][0]))
    elif not bad:
        finding("GOOD", "1-{}".format(len(L)), "sections", "Every section is closed by &END.")
    for name, shown in [("global", "&GLOBAL"), ("force_eval", "&FORCE_EVAL"),
                        ("subsys", "&SUBSYS"), ("cell", "&CELL"), ("coord", "&COORD")]:
        pattern = re.compile(r'^\s*&' + name + r'\b', re.I | re.ASCII)
        if re.search(pattern.pattern, whole, re.M | re.I | re.ASCII):
            finding("GOOD", ranges.get(name.upper()) or lineOf(pattern), name,
                    "The {} section is present.".format(shown))
        else:
            finding("BAD", 0, name, "There is no {} section.".format(shown))
    m = re.search(r'^\s*RUN_TYPE\s+(\S+)', whole, re.M | re.I | re.ASCII)
    run = m.group(1) if m else None
    if run is None:
        finding("UNSURE", 0, "run", "RUN_TYPE is not set, so CP2K runs its default (ENERGY).")
    elif (re.search(r'^(GEO_OPT|CELL_OPT)$', run.upper(), re.ASCII) and
          not re.search(r'^\s*&MOTION\b', whole, re.M | re.I | re.ASCII)):
        finding("BAD", 0, "run", "RUN_TYPE {} needs a &MOTION section with "
                "its own subsection; CP2K stops without it.".format(run))
    else:
        finding("GOOD", lineOf(re.compile(r'^\s*RUN_TYPE\s', re.I | re.ASCII)), "run",
                "RUN_TYPE {}.".format(run.upper()))
    kind, atoms, cur, inCoord = {}, {}, None, False
    for line in L:
        line = re.sub(r'[#!].*', '', line, flags=re.ASCII)
        if re.search(r'^\s*&COORD\b', line, re.I | re.ASCII):
            inCoord = True
            continue
        if re.search(r'^\s*&END\s+COORD\b', line, re.I | re.ASCII):
            inCoord = False
            continue
        m = re.search(r'^\s*(([A-Z][a-z]?)\w*)\s+' + NUM + r'\s+' + NUM + r'\s+' + NUM, line, re.ASCII)
        if inCoord and m:
            atoms[m.group(1)] = m.group(2)
            continue
        m = re.search(r'^\s*&KIND\s+(\S+)', line, re.I | re.ASCII)
        if m:
            cur = m.group(1)
            kind[cur] = {}
            continue
        if re.search(r'^\s*&END\s+KIND\b', line, re.I | re.ASCII):
            cur = None
            continue
        m = re.search(r'^\s*(BASIS_SET|POTENTIAL|ELEMENT)\s+(\S+)', line, re.I | re.ASCII)
        if cur is not None and m:
            kind[cur][m.group(1).upper()] = m.group(2)
    def full(label):
        k = kind.get(label)
        return k and 'BASIS_SET' in k and 'POTENTIAL' in k
    missing = [label for label in sorted(atoms) if not full(label) and not full(atoms[label])]
    if missing:
        finding("BAD", 0, "kinds", "No &KIND with both a BASIS_SET and a POTENTIAL for: " +
                ', '.join(missing) + ". CP2K stops without them.")
    elif atoms:
        k1, k2 = lineOf(re.compile(r'^\s*&KIND\b', re.I | re.ASCII)), 0
        for i, line in enumerate(L):
            if re.search(r'^\s*&END\s+KIND\b', line, re.I | re.ASCII):
                k2 = i + 1
        finding("GOOD", '{}-{}'.format(k1, k2) if k1 and k2 >= k1 else k1, "kinds",
                "Every element (" + ', '.join(sorted(atoms)) + ") has a basis set and a potential.")
    m = re.search(r'^\s*MULTIPLICITY\s+(\d+)', whole, re.M | re.I | re.ASCII)
    mult = m.group(1) if m else None
    if (mult is not None and int(mult) > 1 and
            not re.search(r'^\s*(UKS|LSD|UNRESTRICTED_KOHN_SHAM)\b', whole, re.M | re.I | re.ASCII)):
        finding("BAD", 0, "spin", "MULTIPLICITY {} is set without UKS, so "
                "CP2K runs a restricted calculation and stops on the spin state.".format(mult))
    elif mult is not None:
        finding("GOOD", lineOf(re.compile(r'^\s*MULTIPLICITY\s', re.I | re.ASCII)), "spin",
                "Multiplicity {}.".format(mult))
    if re.search(r'^\s*&DFT_PLUS_U\b', whole, re.M | re.I | re.ASCII):
        if not kind:
            finding("BAD", 0, "plus_u", "&DFT_PLUS_U is outside any &KIND.")
        else:
            finding("GOOD", lineOf(re.compile(r'^\s*&DFT_PLUS_U\b', re.I | re.ASCII)), "plus_u",
                    "DFT+U is set on a kind.")


def cardRange(pattern):
    first = lineOf(pattern)
    if not first:
        return 0
    last = first
    for i in range(first, len(stripped)):
        if re.search(r'^\s*(&\w+|/\s*$|(ATOMIC_SPECIES|ATOMIC_POSITIONS|K_POINTS|CELL_PARAMETERS|OCCUPATIONS|CONSTRAINTS|ATOMIC_FORCES|ADDITIONAL_K_POINTS|HUBBARD)\b)', stripped[i], re.I | re.ASCII):
            break
        if re.search(r'\S', stripped[i], re.ASCII):
            last = i + 1
    return '{}-{}'.format(first, last) if last > first else first


def espresso():
    L = stripped
    nlRange, nlName, nlStart = {}, None, 0
    for i, line in enumerate(L):
        m = re.search(r'^\s*&(\w+)', line, re.ASCII)
        if m:
            nlName, nlStart = m.group(1).lower(), i + 1
            continue
        if re.search(r'^\s*/\s*$', line, re.ASCII) and nlName is not None:
            nlRange.setdefault(nlName, '{}-{}'.format(nlStart, i + 1))
