    for name, shown in [("control", "&CONTROL"), ("system", "&SYSTEM"), ("electrons", "&ELECTRONS")]:
        pattern = re.compile(r'^\s*&' + name + r'\b', re.I | re.ASCII)
        if re.search(pattern.pattern, whole, re.M | re.I | re.ASCII):
            finding("GOOD", nlRange.get(name) or lineOf(pattern), name,
                    "The {} namelist is present.".format(shown))
        else:
            finding("BAD", 0, name, "There is no {} namelist.".format(shown))
    opened, openAt = 0, 0
    for i, line in enumerate(L):
        if re.search(r'^\s*&\w+', line, re.ASCII):
            opened += 1
            openAt = i + 1
            continue
        if re.search(r'^\s*/\s*$', line, re.ASCII):
            opened -= 1
            continue
    if opened > 0:
        finding("BAD", openAt, "sections", "A namelist opened here is never closed by a '/' on a line of its own.")
    elif opened == 0:
        finding("GOOD", '1-{}'.format(len(L)), "sections", "Every namelist is closed by a '/'.")
    if re.search(r'^\s*ATOMIC_POSITIONS', whole, re.M | re.I | re.ASCII):
        finding("GOOD", cardRange(re.compile(r'^\s*ATOMIC_POSITIONS', re.I | re.ASCII)), "positions",
                "An ATOMIC_POSITIONS block is present.")
    else:
        finding("BAD", 0, "positions", "There is no ATOMIC_POSITIONS block.")
    if re.search(r'^\s*ATOMIC_SPECIES', whole, re.M | re.I | re.ASCII):
        finding("GOOD", cardRange(re.compile(r'^\s*ATOMIC_SPECIES', re.I | re.ASCII)), "species",
                "An ATOMIC_SPECIES block is present.")
    else:
        finding("BAD", 0, "species", "There is no ATOMIC_SPECIES block, so no pseudopotential is named for any element.")
    espressoOptions(L)


# Keep these names in step with QEFunctional.pm while ai.qe still uses Perl.
_QE_FOUR = {
    "SLA PW PBX PBC": "PBE", "SLA PW PSX PSC": "PBESOL",
    "SLA PW RPB PBC": "REVPBE", "SLA PZ NOGX NOGC": "PZ",
    "SLA PW NOGX NOGC": "PW", "SLA LYP B88 BLYP": "BLYP",
    "SLA PW GGX GGC": "PW91",
}
_QE_ALIAS = {"LDA": "PZ", "SLA PZ": "PZ"}


def qeCanonical(s):
    if s is None:
        return ""
    t = re.findall(r'\S+', s.upper(), re.ASCII)
    if not t:
        return ""
    if len(t) >= 4:
        if t[2] == 'PBE':
            t[2] = 'PBX'
        if t[3] == 'PBE':
            t[3] = 'PBC'
        four = ' '.join(t[:4])
        return _QE_FOUR.get(four, four)
    name = ' '.join(t)
    return _QE_ALIAS.get(name, name)


def qeFunctionalOfFile(path):
    found = ""
    try:
        with open(path, 'rb') as handle:
            for n, raw in enumerate(handle):
                if n >= 400:
                    break
                line = raw.decode('ascii', 'surrogateescape')
                m = re.search(r'\bfunctional\s*=\s*"([^"]*)"', line, re.I | re.ASCII)
                if not m:
                    m = re.search(r'^\s*(.*?)\s+Exchange-Correlation functional', line, re.I | re.ASCII)
                if m:
                    found = m.group(1)
                    break
    except OSError:
        return ""
    return qeCanonical(found)


def espressoFunctional(Lref, inputDft):
    m = re.search(r'''^\s*pseudo_dir\s*=\s*['"]([^'"]*)['"]''', whole, re.M | re.I | re.ASCII)
    if not m or m.group(1) == "":
        return
    directory = re.sub(r'/+$', '', m.group(1), flags=re.ASCII)
    if not directory.startswith('/'):
        deckDir = re.search(r'^(.*)/[^/]*$', opt_f, re.ASCII)
        directory = (deckDir.group(1) if deckDir else '.') + '/' + directory
    fun, order, inSpecies = {}, [], False
    for line in Lref:
        if re.search(r'^\s*ATOMIC_SPECIES', line, re.I | re.ASCII):
            inSpecies = True
            continue
        m = re.search(r'^\s*([A-Za-z]\w*)\s+\S+\s+(\S+)', line, re.ASCII)
        if inSpecies and m:
            f = qeFunctionalOfFile(directory + '/' + m.group(2))
            if f:
                fun[m.group(1)] = f
                order.append(m.group(1))
            continue
        if inSpecies and re.search(r'\S', line, re.ASCII):
            inSpecies = False
    if not order:
        return
    at = cardRange(re.compile(r'^\s*ATOMIC_SPECIES', re.I | re.ASCII))
    if len(set(fun[e] for e in order)) > 1:
        finding("BAD", at, "functional",
                "The pseudopotentials were generated with different functionals (" +
                ', '.join('{}: {}'.format(e, fun[e]) for e in order) +
                '); pw.x stops with "conflicting values for icorr".  Use pseudopotentials of one functional.')
        return
    pp = fun[order[0]]
    dft = qeCanonical(inputDft[0]) if inputDft is not None else ""
    if dft and dft != pp:
        finding("UNSURE", inputDft[1], "functional",
                "input_dft = '{}' differs from {}, the functional the pseudopotentials were generated with; pw.x "
                "runs, but the result mixes two functionals.".format(inputDft[0].upper(), pp))
    else:
        finding("GOOD", at, "functional", "The pseudopotentials were all generated with {}.".format(pp))


def espressoOptions(Lref):
    L = Lref
    nl, cur = {}, None
    for i, line in enumerate(L):
        line = re.sub(r'!.*', '', line, flags=re.ASCII)
        m = re.search(r'^\s*&(\w+)', line, re.ASCII)
        if m:
            cur = m.group(1).lower()
            continue
        if re.search(r'^\s*/\s*$', line, re.ASCII):
            cur = None
            continue
        if cur is None:
            continue
        for item in line.split(','):
            m = re.search(r'^\s*([\w()]+)\s*=\s*(.+?)\s*$', item, re.ASCII)
            if m:
                k, v = m.group(1).lower(), m.group(2)
                v = re.sub(r'''^['"]|['"]$''', '', v, flags=re.ASCII)
                nl.setdefault(cur, {})[k] = [v.lower(), i + 1]
    control = nl.setdefault('control', {})
    system = nl.setdefault('system', {})
    calc = control.get('calculation', ['scf'])[0]
    if 'ions' in nl and calc == 'scf':
        finding("BAD", 0, "ions", "An &IONS namelist is present in a calculation = 'scf' run; "
                'pw.x stops with "namelist &IONS not needed".')
    if calc == 'md':
        ions = nl.get('ions', {})
        dt = control.get('dt')
        # Fortran D exponents are accepted as numeric prefixes, with a
        # diagnostic, rather than evaluated as powers of ten.
        numeric = re.search(r'^\s*([-+]?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?)', dt[0], re.ASCII) if dt else None
        startsNumeric = dt is not None and re.search(r'^[-+]?\d', dt[0], re.ASCII)
        if startsNumeric and not re.search(r'^[-+]?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?\s*$', dt[0], re.ASCII):
            diagnostic('Argument "{}" isn\'t numeric in addition (+) at keywords line 396.\n'.format(dt[0]))
        if not startsNumeric or not numeric or float(numeric.group(1)) <= 0:
            finding("BAD", 0, "md", "A molecular dynamics run needs a positive time step (dt, in Rydberg atomic units) in &CONTROL.")
        else:
            finding("GOOD", dt[1], "md", "The time step dt is set (Rydberg atomic units; 20 is about 1 fs).")
        if 'nstep' not in control:
            finding("UNSURE", 0, "md", "nstep is not set, so pw.x runs its own default number of steps (50).")
        it = ions.get('ion_temperature', ['not_controlled'])[0]
        if it != 'not_controlled' and 'tempw' not in ions:
            finding("UNSURE", 0, "md", "ion_temperature = '{}' but tempw (the target temperature) is not set; pw.x then uses its default.".format(it))
        elif 'ion_temperature' in ions:
            finding("GOOD", ions['ion_temperature'][1], "md", "ion_temperature = '{}' in the &IONS namelist.".format(it))
    if 'vdw_corr' in system:
        finding("GOOD", system['vdw_corr'][1], "dispersion", "A dispersion correction (vdw_corr = '{}') is requested.".format(system['vdw_corr'][0]))
    species, speciesOrder, inSpecies = set(), [], False
    for line in L:
        if re.search(r'^\s*ATOMIC_SPECIES', line, re.I | re.ASCII):
            inSpecies = True
            continue
        m = re.search(r'^\s*([A-Za-z][A-Za-z0-9]*)\s+[-+0-9.]', line, re.ASCII)
        if inSpecies and m:
            species.add(m.group(1))
            speciesOrder.append(m.group(1))
            continue
        if inSpecies and re.search(r'\S', line, re.ASCII):
            inSpecies = False
    espressoFunctional(L, system.get('input_dft'))
    transition = set('Sc Ti V Cr Mn Fe Co Ni Cu Zn Y Zr Nb Mo Tc Ru Rh Pd Ag Cd La Ce Pr Nd Pm Sm Eu Gd Tb Dy Ho Er Tm Yb Lu Hf Ta W Re Os Ir Pt Au Hg Ac Th Pa U Np Pu'.split())
    uElements = []
    hubbardAt = 0
    for i, line in enumerate(L):
        if re.search(r'^\s*HUBBARD\b', line, re.I | re.ASCII):
            hubbardAt = i + 1
            break
    if hubbardAt:
        rows = 0
        for i in range(hubbardAt, len(L)):
            line = re.sub(r'!.*', '', L[i], flags=re.ASCII)
            if not re.search(r'\S', line, re.ASCII):
                continue
            if (re.search(r'^\s*[A-Z_]+\b', line, re.ASCII) and
                    not re.search(r'^\s*(U|J0|J|B|E2|E3|alpha)\s', line, re.I | re.ASCII)):
                break
            m = re.search(r'^\s*U\s+(\S+?)-(\d[spdf])\s+([-+]?\d*\.?\d+([EeDd][-+]?\d+)?)\s*$', line, re.ASCII)
            if m:
                el = m.group(1)
                rows += 1
                uElements.append(el)
                if el not in species:
                    finding("BAD", i + 1, "hubbard", "The HUBBARD card names '{}', which is not a species in ATOMIC_SPECIES.".format(el))
            elif re.search(r'^\s*\S+\s+\S+', line, re.ASCII):
                finding("BAD", i + 1, "hubbard", "This HUBBARD line is not 'U <species>-<orbital> <value>'.")
        if rows:
            finding("GOOD", hubbardAt, "hubbard", "A HUBBARD card with {} U value{} is present.".format(rows, '' if rows == 1 else 's'))
    if 'lda_plus_u' in system and re.search(r'^\.?t', system['lda_plus_u'][0], re.ASCII):
        n = 0
        for k in system:
            m = re.search(r'^hubbard_u\((\d+)\)$', k, re.ASCII)
            if not m:
                continue
            n += 1
            idx = int(m.group(1))
            if idx < 1 or idx > len(speciesOrder):
                finding("BAD", system[k][1], "hubbard", "{} refers to a species that does not exist (there are {}).".format(k, len(speciesOrder)))
            else:
                uElements.append(speciesOrder[idx - 1])
        if n:
            finding("GOOD", system['lda_plus_u'][1], "hubbard", "lda_plus_u is on with {} Hubbard_U value{}.".format(n, '' if n == 1 else 's'))
    if uElements:
        nspin = system.get('nspin', [1])[0]
        tm = [e for e in uElements if re.sub(r'\d+$', '', e, flags=re.ASCII).capitalize() in transition]
        if tm and not re.search(r'^[24]', str(nspin), re.ASCII):
            finding("UNSURE", 0, "hubbard", "U is set on " + ', '.join(tm) + " without spin polarisation (nspin = 2).  DFT+U on a transition metal usually needs it, with a starting magnetisation.")


def mopac():
    L = stripped
    if not L or not re.search(r'\S', L[0], re.ASCII):
        finding('BAD', 1, 'keywords', 'The first line is empty. MOPAC reads its keywords from '
                'it, so the job has no instructions.')
        return
    finding('GOOD', 1, 'keywords', 'A keyword line is present.')
    unknownWords(code, L[0], 1, 'keyword line')
    if re.search(r'[+&]\s*$', L[0], re.ASCII):
        finding('UNSURE', 1, 'sections', 'The keyword line is continued onto the next line, which '
                'moves the geometry down; the layout was not checked.')
        return
    m = re.search(r'\bCHARGE\s*=\s*(-?\d+)', L[0], re.I | re.ASCII)
    charge = m.group(1) if m else 0
    words = {'SINGLET': 1, 'DOUBLET': 2, 'TRIPLET': 3, 'QUARTET': 4,
             'QUINTET': 5, 'SEXTET': 6, 'SEPTET': 7, 'OCTET': 8}
    mult, assumed = 1, True
    for word in words:
        if re.search(r'\b' + word + r'\b', L[0], re.I | re.ASCII):
            mult, assumed = words[word], False
            break
    finding('GOOD', 1, 'charge', 'Charge {}, multiplicity {}{}.'.format(
        charge, mult, ' (assumed: no spin keyword)' if assumed else ''))
    electronCount(charge, mult, atomSymbols, assumed)
    if len(L) < 4:
        finding('BAD', len(L), 'sections', 'A MOPAC deck needs a keyword line, two comment lines and '
                'then the geometry; this file has only {} lines.'.format(len(L)))
        return
    if re.search(r'^\s*([A-Z][a-z]?)\d*\s+' + NUM, L[3], re.ASCII):
        finding('GOOD', '1-3', 'sections', 'The keyword line, two comment lines and then the geometry.')
        end = 3
        while end + 1 < len(L) and re.search(r'\S', L[end + 1], re.ASCII):
            end += 1
        finding('GOOD', '4-{}'.format(end + 1), 'geometry', '{} lines of geometry.'.format(end - 2))
        nxt = end + 1
        while nxt < len(L) and not re.search(r'\S', L[nxt], re.ASCII):
            nxt += 1
        if nxt < len(L):
            ln = nxt + 1
            unknownWords(code, L[nxt], ln, 'second keyword line')
            if re.search(r'\bOLDGEO\b', L[nxt], re.I | re.ASCII) and len(L) - 1 - nxt <= 2:
                finding('GOOD', '{}-{}'.format(end + 2, len(L)), 'sections',
                        'A second job on the geometry the first one ends with '
                        '(OLDGEO): a keyword line and two comment lines.')
            else:
                finding('UNSURE', '{}-{}'.format(ln, len(L)), 'sections',
                        'More input follows the geometry; a second job without '
                        'OLDGEO, or with its own geometry, is not checked.')
    else:
        finding('BAD', 4, 'sections', 'Line 4 should be the first atom of the geometry -- MOPAC '
                'expects keywords, two comment lines, then atoms -- and it '
                'does not look like one.')


ECCEQM_KEYWORDS = set(('title charge multiplicity method basis spherical grid grid_prune '
                   'charges localise localize units maxiter conv_energy conv_grad molden runtype maxsteps opt_conv '
                   'hessian_step temperature pressure symmetry_number '
                   'polarizability polarisability raman field_step parallel_points guess_mix '
                   'numeric_hessian ts_hessian_every ts_mode ts_follow irc_step irc_max_points irc_direction irc_hessian_every point_orbitals read_orbitals write_orbitals virtuals solvent epsilon cavity_scale dispersion').split())


def ecceqm():
    L = stripped
    keyword = ECCEQM_KEYWORDS
    functional = set('hf svwn lda pbe b3lyp pbe0'.split())
    INT = r'[-+]?\d+'
    charge, mult, method = 0, 1, 'hf'
    multGiven = False
    geomOpen = geomClose = basisOpen = basisClose = 0
    inGeom = inBasis = shells = primitives = curShell = 0
    inCons = consOpen = consClose = 0
    inScan = 0
    consAtoms, covered = [], set()
    bad, geomAtoms, basisName = 0, 0, ''
    badKeyword = 0
    wantsRaman, runtypeGiven = 0, 'energy'
    kwLines = []
    for i, original in enumerate(L):
        line = re.sub(r'#.*', '', original, flags=re.ASCII)
        if not re.search(r'\S', line, re.ASCII):
            continue
        key, rest = re.search(r'^\s*(\S+)\s*(.*?)\s*$', line, re.ASCII).groups()
        k, n = key.lower(), i + 1
        if inGeom:
            if k == 'end':
                inGeom, geomClose = 0, n
                continue
            m = re.search(r'^\s*([A-Za-z]+)\s+' + NUM + r'\s+' + NUM + r'\s+' + NUM + r'(\s|$)', line, re.ASCII)
            if m:
                symbol = m.group(1)
                if not re.search(r'^[Xx]$', symbol, re.ASCII) and symbol.capitalize() not in Z:
                    finding('BAD', n, 'geometry', '"{}" is not an element symbol ecce-qm knows.'.format(symbol))
                    bad += 1
                geomAtoms += 1
            else:
                shown = line.strip(' \t\n\r\f\v')
                if len(shown) > 43:
                    shown = shown[:40] + '...'
                finding('BAD', n, 'geometry', 'This line is inside the geometry block but is not an '
                        'atom (element and three coordinates): "{}". '
                        'ecce-qm stops on it.'.format(shown))
                bad += 1
            continue
        if inScan:
            if k == 'end':
                inScan = 0
                continue
            need = {'bond': 2, 'angle': 3, 'torsion': 4, 'dihedral': 4}
            w = rest.split()
            if k not in need:
                finding('BAD', n, 'scan', '"{}" is not a coordinate ecce-qm can scan (bond, '
                        'angle or torsion); ecce-qm stops on it.'.format(key))
                bad += 1
            # Perl's grep consumes the following ||: only the point count is
            # checked unless it is zero, when the two numeric values are checked.
            elif (len(w) != need[k] + 3 or
                  (not re.search(r'^\d+$', w[need[k] + 2], re.ASCII)
                   if w[need[k] + 2] not in ('', '0') else
                   any(not re.search('^' + NUM + '$', w[j], re.ASCII) for j in [need[k], need[k] + 1]))):
                finding('BAD', n, 'scan', "'{}' in a scan needs {} atom numbers, a start value, "
                        'an end value and the number of points; ecce-qm stops on '
                        'this line.'.format(k, need[k]))
                bad += 1
            continue
        if inCons:
            if k == 'end':
                inCons, consClose = 0, n
                continue
            need = {'bond': 2, 'angle': 3, 'torsion': 4, 'dihedral': 4, 'fix': 1}
            w = rest.split()
            if k not in need:
                finding('BAD', n, 'constraints', '"{}" is not a constraint ecce-qm knows (bond, '
                        'angle, torsion or fix); ecce-qm stops on it.'.format(key))
                bad += 1
            elif (len(w) < need[k] or len(w) > need[k] + (0 if k == 'fix' else 1) or
                  any(not re.search(r'^\d+$', word, re.ASCII) for word in w[:need[k]])):
                finding('BAD', n, 'constraints', "'{}' needs {} atom numbers{}; ecce-qm stops on this line.".format(
                    k, need[k], '' if k == 'fix' else ' and an optional value'))
                bad += 1
            elif len(w) > need[k] and not re.search('^' + NUM + '$', w[need[k]], re.ASCII):
                finding('BAD', n, 'constraints', "The value of a '{}' constraint must be a number, and "
                        'this reads "{}".'.format(k, w[need[k]]))
                bad += 1
            else:
                consAtoms.extend((n, word) for word in w[:need[k]])
            continue
        if inBasis and k == 'geometry':
            finding('BAD', basisOpen, 'basis', "The basis_data block is never closed by an 'end'; ecce-qm "
                    'reads the geometry keyword as part of it and stops.')
            bad += 1
            inBasis, basisClose = 0, -1
        if inBasis:
            if k == 'end':
                inBasis, basisClose, curShell = 0, n, 0
                continue
            if k == 'shell':
                m = re.search(r'^([A-Za-z]+)\s+([A-Za-z])(?:\s|$)', rest, re.ASCII)
                if m and re.search(r'^[spdfghi]$', m.group(2).lower(), re.ASCII) and m.group(1).capitalize() in Z:
                    covered.add(m.group(1).capitalize())
                    shells += 1
                    curShell = n
                else:
                    finding('BAD', n, 'basis', 'A shell line needs an element and one angular '
                            'momentum letter (S, P, D, F, G, H or I): '
                            '"shell {}".'.format(rest))
                    bad += 1
                continue
            if curShell and re.search(r'^\s*' + NUM + r'\s+' + NUM + r'(\s|$)', line, re.ASCII):
                primitives += 1
                continue
            finding('BAD', n, 'basis', "Inside basis_data only 'shell <element> <letter>' lines "
                    "and 'exponent coefficient' rows are allowed, and this is "
                    'neither. ecce-qm stops on it.')
            bad += 1
            continue
        if k == 'geometry':
            inGeom, geomOpen = 1, n
            continue
        if k == 'scan':
            inScan = 1
            continue
        if k == 'constraints':
            inCons, consOpen = 1, n
            continue
        if k == 'basis_data':
            inBasis, basisOpen = 1, n
            continue
        if k in keyword:
            kwLines.append(n)
        else:
            finding('BAD', n, 'keywords', '"{}" is not an ecce-qm keyword; ecce-qm stops with '
                    "'unknown keyword' on it.".format(key))
            bad += 1
            badKeyword += 1
            continue
        if k in ('runtype', 'opt_conv'):
            ok = r'(energy|gradient|optimize|opt|frequency|freq|optfreq|ts|irc)' if k == 'runtype' else r'(normal|tight)'
            if not re.search('^' + ok + '$', rest, re.I | re.ASCII):
                finding('BAD', n, 'keywords', "'{}' takes {}, and this reads "
                        '"{}"; ecce-qm stops on it.'.format(k, 'energy, gradient, optimize, frequency, optfreq, ts or irc'
                                                         if k == 'runtype' else 'normal or tight', rest))
                bad += 1
            elif k == 'runtype':
                runtypeGiven = rest.lower()
            continue
        if k in ('charge', 'multiplicity', 'maxiter', 'maxsteps', 'ts_hessian_every', 'ts_mode', 'irc_max_points', 'irc_hessian_every'):
            m = re.search('^' + INT + r'\b', rest, re.ASCII)
            if not m:
                finding('BAD', n, 'charge' if k in ('charge', 'multiplicity') else 'keywords',
                        "'{}' needs a whole number, and this reads \"{}\".".format(k, rest))
                bad += 1
                continue
            if k == 'charge':
                charge = int(re.search('^(' + INT + ')', rest, re.ASCII).group(1))
            if k == 'multiplicity':
                mult = int(re.search('^(' + INT + ')', rest, re.ASCII).group(1))
                multGiven = True
        elif k == 'method':
            method = rest.lower()
        elif k == 'basis':
            basisName = rest
        elif k == 'charges':
            for word in rest.lower().split():
                if re.search(r'^(loewdin|lowdin|chelpg|mk|merz-kollman|none)$', word, re.ASCII):
                    continue
                finding('BAD', n, 'keywords', "'charges' takes loewdin, chelpg, mk (or merz-kollman) "
                        'and none, and "{}" is none of them; ecce-qm stops on it.'.format(word))
                bad += 1
        elif k == 'grid':
            if not re.search(r'^\d+\s+\d+(\s|$)', rest, re.ASCII):
                finding('BAD', n, 'keywords', "'grid' needs two whole numbers (radial and angular "
                        'points), and this reads "{}".'.format(rest))
                bad += 1
        elif k in ('polarizability', 'polarisability', 'raman'):
            if not re.search(r'^(true|false|yes|no|on|off|1|0)$', rest, re.I | re.ASCII):
                finding('BAD', n, 'keywords', "'{}' takes true or false, and this reads \"{}\".".format(k, rest))
                bad += 1
            elif k == 'raman' and re.search(r'^(true|yes|on|1)$', rest, re.I | re.ASCII):
                wantsRaman = n
        elif k == 'irc_direction':
            if not re.search(r'^(both|forward|backward)$', rest, re.I | re.ASCII):
                finding('BAD', n, 'keywords', "'irc_direction' takes both, forward or backward, "
                        'and this reads "{}"; ecce-qm stops on it.'.format(rest))
                bad += 1
        elif k in ('field_step', 'conv_energy', 'conv_grad', 'irc_step'):
            if not re.search('^' + NUM + r'(\s|$)', rest, re.ASCII):
                finding('BAD', n, 'keywords', "'{}' needs a number, and this reads \"{}\".".format(k, rest))
                bad += 1
    if wantsRaman and not re.search(r'^(frequency|freq|optfreq|ts)$', runtypeGiven, re.ASCII):
        finding('BAD', wantsRaman, 'keywords', "'raman' needs runtype frequency, optfreq or ts; ecce-qm stops on it.")
        bad += 1
    if re.search(r'^(ts|irc)$', runtypeGiven, re.ASCII) and consOpen:
        finding('BAD', consOpen, 'constraints', 'A transition-state search or IRC (runtype ts, irc) takes no constraints; '
                'ecce-qm stops on it.')
        bad += 1
    if not badKeyword:
        finding('GOOD', 0, 'keywords', 'Every keyword is one ecce-qm reads.')
    m = re.sub(r'^(ro|r|u)(?=.)', '', method, flags=re.ASCII)
    if m in functional:
        ref = ('unrestricted' if re.search(r'^u.', method, re.ASCII) and method != m else
               'restricted open-shell' if re.search(r'^ro.', method, re.ASCII) and method != m else
               'restricted' if re.search(r'^r.', method, re.ASCII) and method != m else
               'restricted' if mult == 1 else 'restricted open-shell')
        finding('GOOD', 0, 'method', ('Hartree-Fock' if m == 'hf' else m.upper()) + ', ' + ref +
                (' (taken from the multiplicity)' if method == m else '') + '.')
        if re.search(r'^r.', method, re.ASCII) and method != m and not re.search(r'^ro', method, re.ASCII) and mult != 1:
            finding('UNSURE', 0, 'method', 'A closed-shell (restricted) reference was asked for with '
                    'multiplicity {}; use an open-shell reference (u or '
                    'ro) for that.'.format(mult))
    else:
        finding('BAD', 0, 'method', '"{}" is not a method ecce-qm has. It takes hf, '
                'svwn, pbe, b3lyp or pbe0, optionally with r, u or ro in '
                'front.'.format(method))
    if not geomOpen:
        finding('BAD', 0, 'geometry', "There is no geometry block, so ecce-qm stops with 'no "
                "geometry given'.")
    elif not geomClose:
        finding('BAD', geomOpen, 'geometry', "The geometry block is never closed by an 'end'; everything "
                'after it is read as atoms.')
    elif not geomAtoms:
        finding('BAD', geomOpen, 'geometry', 'The geometry block is empty.')
    elif not any(re.search(r'^BAD\|\d+\|geometry\|', f, re.ASCII) for f in findings):
        finding('GOOD', '{}-{}'.format(geomOpen, geomClose), 'geometry', '{} atoms in the geometry block.'.format(geomAtoms))
    flagged = {f.split('|')[1] for f in findings if re.search(r'^(BAD|UNSURE)\|\d+\|', f, re.ASCII)}
    ok = [n for n in kwLines if str(n) not in flagged]
    while ok:
        first = last = ok.pop(0)
        while ok and ok[0] == last + 1:
            last = ok.pop(0)
        finding('GOOD', first if first == last else '{}-{}'.format(first, last), 'keywords',
                ('An ecce-qm keyword' if first == last else 'ecce-qm keywords') + ', with a value ecce-qm accepts.')
    if consOpen and not consClose:
        finding('BAD', consOpen, 'constraints', "The constraints block is never closed by an 'end'.")
    elif consOpen:
        for ln, atom in consAtoms:
            if int(atom) < 1 or int(atom) > geomAtoms:
                finding('BAD', ln, 'constraints', 'Atom {} is not in the geometry, which has '
                        '{} atoms (dummy atoms count).'.format(atom, geomAtoms))
        if not any(re.search(r'^BAD\|\d+\|constraints\|', f, re.ASCII) for f in findings):
            finding('GOOD', '{}-{}'.format(consOpen, consClose), 'constraints', 'Every constrained atom is in the geometry.')
    if basisOpen and not basisClose:
        finding('BAD', basisOpen, 'basis', "The basis_data block is never closed by an 'end'.")
    elif basisClose < 0:
        pass
    elif basisOpen:
        missing = [element for element in elements if element not in covered]
        if not shells or not primitives:
            finding('BAD', basisOpen, 'basis', 'The basis_data block holds no shells.')
        elif missing:
            finding('UNSURE', '{}-{}'.format(basisOpen, basisClose), 'basis',
                    'basis_data gives no shell for ' + ', '.join(missing) + '. ecce-qm then looks for ' +
                    ('"{}"'.format(basisName) if basisName != '' else 'its default basis') +
                    ' in its basis library, which cannot be seen from here.')
        elif not any(re.search(r'^BAD\|\d+(-\d+)?\|basis\|', f, re.ASCII) for f in findings):
            finding('GOOD', '{}-{}'.format(basisOpen, basisClose), 'basis',
                    '{} shells cover every element in the geometry ({}).'.format(shells, ', '.join(elements)))
    else:
        finding('UNSURE', 0, 'basis', 'There is no basis_data block, so ecce-qm reads ' +
                ('"{}"'.format(basisName) if basisName != '' else 'its default (STO-3G)') +
                ' from its basis library; whether the library has it for every element cannot be judged here.')
    finding('GOOD', 0, 'charge', 'Charge {}, multiplicity {}{}.'.format(
        charge, mult, '' if multGiven else ' (assumed: the deck does not say)'))
    electronCount(charge, mult, atomSymbols, not multGiven)


def vina():
    have = {}
    for n, line in enumerate(stripped, 1):
        if re.search(r'^\s*(#|$)', line, re.ASCII):
            continue
        m = re.search(r'^\s*(\w+)\s*=\s*(\S+)', line, re.ASCII)
        if m:
            key, value = m.groups()
            have[key] = value
            # Perl numerically compares a leading numeric prefix, or zero.
            number = re.search(r'^\s*([-+]?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?)', value, re.ASCII)
            special = re.fullmatch(r'[-+]?(?:inf(?:inity)?|nan)', value, re.I | re.ASCII)
            numeric = float(value) if special else (float(number.group(1)) if number else 0)
            if (re.search(r'^size_[xyz]$', key, re.ASCII) and not special and
                    not re.fullmatch(r'[-+]?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?', value, re.ASCII)):
                diagnostic('Argument "{}" isn\'t numeric in numeric le (<=) at keywords line 880.\n'.format(value))
            if re.search(r'^size_[xyz]$', key, re.ASCII) and numeric <= 0:
                finding('BAD', n, 'box', '{} is {}; the search box needs '
                        'a positive size in every direction.'.format(key, value))
    missing = [k for k in 'receptor ligand center_x center_y center_z size_x size_y size_z'.split() if k not in have]
    if missing:
        finding('BAD', 1, 'options', 'The configuration lacks ' + ', '.join(missing) + ', which Vina needs.')
    else:
        finding('GOOD', 1, 'options', 'Receptor, ligand and the search box are given.')
    for part in ('LIGAND', 'RECEPTOR'):
        if not any(re.search(r'^#\| ' + part + r'_ATOMS=\d', line, re.ASCII) for line in stripped):
            finding('BAD', 1, 'structure', 'The deck names no ' + part.lower() +
                    ' atoms for the PDBQT preparation (no "#| ' + part + '_ATOMS=" line).')
    lists, bad = {}, False
    for part in ('LIGAND', 'RECEPTOR'):
        line = next((line for line in stripped if re.search(r'^#\| ' + part + r'_ATOMS=\d', line, re.ASCII)), None)
        if line is None:
            continue
        ranges = re.search(r'_ATOMS=(\S*)', line, re.ASCII).group(1).split(',')
        while ranges and ranges[-1] == '':
            ranges.pop()
        for r in ranges:
            m = re.search(r'^(\d+)(?:-(\d+))?$', r, re.ASCII)
            lo = int(m.group(1)) if m else None
            hi = int(m.group(2) or m.group(1)) if m else None
            if lo is None or lo > hi:
                finding('BAD', 1, 'structure', "{}_ATOMS has '{}', which is not an atom number or a range.".format(part, r))
                bad = True
                continue
            for atom in range(lo, hi + 1):
                lists.setdefault(atom, []).append(part)
    if bad or not lists:
        return
    total = int(opt_a) if opt_a and re.search(r'^\d+$', opt_a, re.ASCII) and int(opt_a) > 0 else 0
    dup, gap, out = [], [], []
    for i in sorted(lists):
        if len(lists[i]) > 1:
            dup.append(i)
        if total and i > total:
            out.append(i)
    if total:
        gap = [i for i in range(1, total + 1) if i not in lists]
    def show(a):
        text = ','.join(str(i) for i in a[:10])
        return text + (',... ({} in all)'.format(len(a)) if len(a) > 10 else '')
    if dup:
        finding('BAD', 1, 'structure', 'Atoms in both the ligand and the receptor lists: ' + show(dup) + '.')
    if gap:
        finding('BAD', 1, 'structure', 'Atoms in neither list: ' + show(gap) + '.')
    if out:
        finding('BAD', 1, 'structure', "Atom numbers beyond the calculation's {} atoms: {}.".format(total, show(out)))
    if not dup and not gap and not out:
        finding('GOOD', 1, 'structure', ('All {} atoms'.format(total) if total else 'The atoms') +
                ' are in exactly one of the ligand and receptor lists.')


def xtb(prog='xtb'):
    L = stripped
    if not L or not re.search(r'^\s*' + re.escape(prog) + r'\b', L[0], re.ASCII):
        finding('BAD', 1, 'options', 'Line 1 should start with "{0}" followed by the options; '
                'it is what the launch script runs {0} with.'.format(prog))
        return
    finding('GOOD', 1, 'options', 'An option line is present.')
    if prog != 'mlp':
        m = re.search(r'--chrg\s+(-?\d+)', L[0], re.ASCII)
        charge = m.group(1) if m else 0
        m = re.search(r'--uhf\s+(\d+)', L[0], re.ASCII)
        unpaired = int(m.group(1)) if m else 0
        assumed = not re.search(r'--uhf\s', L[0], re.ASCII)
        finding('GOOD', 1, 'charge', 'Charge {}, multiplicity {}{}.'.format(
            charge, unpaired + 1, ' (assumed: no --uhf)' if assumed else ''))
        electronCount(charge, unpaired + 1, atomSymbols, assumed)
    if re.search(r'^\s*xtb\s+dock\b', L[0], re.ASCII) and len(L) > 1 and re.search(r'^\s*[$]order', L[1], re.ASCII):
        return
    c = 1
    while c < len(L) and c in solventLine:
        c += 1
    if c > 1:
        finding('GOOD', '2-{}'.format(c), 'solvent', 'The solvent molecule ($solvent block) is present.')
    m = re.search(r'^\s*(\d+)\s*$', L[c], re.ASCII) if c < len(L) else None
    if len(L) < c + 2 or not m:
        finding('BAD', c + 1, 'sections', 'Line {} should be the number of atoms, the '
                'first line of the xyz part.'.format(c + 1))
        return
    count, atoms = m.group(1), 0
    for i in range(c + 2, len(L)):
        if not re.search(r'^\s*[A-Za-z]{1,2}\d*\s+' + NUM + r'\s+' + NUM + r'\s+' + NUM, L[i], re.ASCII):
            break
        atoms += 1
    if atoms == int(count):
        finding('GOOD', '{}-{}'.format(c + 1, c + 2 + atoms), 'geometry',
                '{} atoms, as the count on line {} says.'.format(count, c + 1))
    else:
        finding('BAD', c + 1, 'geometry', 'Line {} says {} atoms but {} atom lines '
                'follow the title line, which {} refuses.'.format(c + 1, count, atoms, prog))


def options(argv):
    # Getopt::Std stops at the first operand and permits attached values.
    opts = {}
    args = list(argv)
    while args and len(args[0]) > 1 and args[0].startswith('-'):
        arg = args.pop(0)
        if arg == '--':
            break
        option, rest = arg[1], arg[2:]
        if option in 'fca':
            opts[option] = rest if rest else (args.pop(0) if args else None)
        else:
            if option == 'h':
                opts[option] = True
            else:
                diagnostic('Unknown option: {}\n'.format(option))
            if rest:
                args.insert(0, '-' + rest)
    return opts


def report():
    # Nontext bytes quoted from the deck must survive without transcoding.
    output = ('\n'.join(findings) + '\n').replace('\n', os.linesep)
    sys.stdout.buffer.write(output.encode('utf-8', 'surrogateescape'))
    return int(any(row.startswith('BAD|') for row in findings))


def main(argv):
    global code, opt_a, opt_f, stripped, whole, atomSymbols, elements, solventLine, qstWanted
    findings[:] = []
    opts = options(argv)
    if opts.get('h') or opts.get('f') is None:
        diagnostic('usage: verifyinput -f <input file> -c <code> [-a <atoms>]\n')
        return 0 if opts.get('h') else 2
    opt_f, opt_a = opts['f'], opts.get('a')
    code = opts.get('c') if opts.get('c') is not None else ''
    if not os.path.exists(opt_f):
        finding('BAD', 0, 'file', 'There is no input file at {}.'.format(opt_f))
        return report()
    try:
        with open(opt_f, 'rb') as handle:
            lines = [line.decode('ascii', 'surrogateescape') for line in handle.readlines()]
    except IsADirectoryError:
        # The original reader treats an opened directory as an empty deck.
        lines = []
    except OSError as error:
        finding('BAD', 0, 'file', 'The input file could not be read: {}'.format(error.strerror))
        return report()
    if not lines:
        finding('BAD', 0, 'file', 'The input file is empty.')
        return report()
    finding('GOOD', 0, 'file', '{} lines.'.format(len(lines)))
    binary = 0
    for i, line in enumerate(lines):
        match = re.search(r'([^\x09\x0a\x0d\x20-\x7e])', line)
        if match:
            byte = ord(match.group(1)) & 255
            finding('BAD', i + 1, 'readable',
                    'This line contains a byte that is not text (0x{:02x}). '
                    'That is not something a person typed, and the code will refuse the file.'.format(byte))
            binary += 1
            if binary >= 5:
                break
    if not binary:
        finding('GOOD', 0, 'readable', 'Every byte is printable text.')
    whole = ''.join(lines)
    solventLine = {}
    if code == 'CREST':
        inside = False
        for i, line in enumerate(lines):
            if re.search(r'^\s*\$solvent\b', line, re.I | re.ASCII):
                inside = True
            if inside:
                solventLine[i] = 1
            if inside and re.search(r'^\s*\$end\b', line, re.I | re.ASCII):
                inside = False
    atoms = firstAtom = lastAtom = prevAtom = 0
    runs = []
    atomPattern = r'^\s*([A-Z][a-z]?|x)\d*(?:_\w+)?\s+' + NUM + r'\s+' + NUM + r'\s+' + NUM + r'(\s|$)'
    for i, line in enumerate(lines):
        if i in solventLine:
            continue
        if re.search(atomPattern, line, re.ASCII):
            if re.search(r'^\s*[BADLX]\s+\d+\s+\d+(\s+\d+){0,2}(\s+[A-Z]\b|\s+[-+]?\d*\.\d+|\s*$)', line, re.ASCII):
                continue
            atoms += 1
            if not firstAtom:
                firstAtom = i + 1
            lastAtom = i + 1
            if prevAtom == i:
                if not runs:
                    # Preserve the original failure when the very first line
                    # is an atom, including its diagnostic and exit status.
                    diagnostic('Modification of non-creatable array value attempted, subscript -1 at {} line 142.\n'.format(sys.argv[0]))
                    return 255
                runs[-1] += 1
            else:
                runs.append(1)
            prevAtom = i + 1
    rc = ' '.join(line for line in lines if re.search(r'^\s*#', line, re.ASCII))
    match = re.search(r'\bqst([23])\b', rc, re.I | re.ASCII)
    qstWanted = int(match.group(1)) if match else 0
    toldAtoms = opt_a is not None and re.search(r'^\d+$', opt_a, re.ASCII) and int(opt_a) > 0
    if code == 'Vina':
        pass
    elif not atoms and re.search(r'geom\s*=\s*\(?[^)\n]*check', whole, re.I | re.ASCII):
        finding('UNSURE', 0, 'geometry',
                'There is no geometry in this file, but the route card reads '
                'it from the checkpoint file. Whether that checkpoint holds '
                'what you expect cannot be judged from here.')
    elif not atoms:
        finding('BAD', 0, 'geometry',
                'No geometry was found: no line holds an element symbol and '
                'three coordinates. The calculation has nothing to run on.')
    elif qstWanted:
        ref = opt_a if toldAtoms else runs[0]
        if len(runs) != qstWanted:
            finding('BAD', firstAtom, 'geometry',
                    'Opt=QST{} needs {} structures, one after another, but the deck has {}.'.format(qstWanted, qstWanted, len(runs)))
        elif any(n != int(ref) for n in runs):
            finding('BAD', firstAtom, 'geometry',
                    'The structures have {} atoms; the calculation says it has {}. '
                    'Each one must have the same atoms.'.format(', '.join(str(n) for n in runs), ref))
        else:
            finding('GOOD', firstAtom, 'geometry', '{} structures of {} atoms each.'.format(qstWanted, ref))
    elif toldAtoms and atoms != int(opt_a):
        finding('BAD', firstAtom, 'geometry',
                'The geometry has {} atoms; the calculation says it has {}. One of them is wrong.'.format(atoms, opt_a))
    else:
        finding('GOOD', '{}-{}'.format(firstAtom, lastAtom) if lastAtom > firstAtom else firstAtom,
                'geometry', '{} atoms.'.format(atoms))
    stripped = [line[:-1] if line.endswith('\n') else line for line in lines]
    seen = set()
    elements, atomSymbols = [], []
    for i, line in enumerate(stripped):
        if qstWanted and runs and i + 1 >= firstAtom + runs[0]:
            break
        if i in solventLine:
            continue
        match = re.search(atomPattern, line, re.ASCII)
        if match:
            element = match.group(1).lower().capitalize()
            if element.lower() == 'x':
                continue
            atomSymbols.append(element)
            if element not in seen:
                seen.add(element)
                elements.append(element)
    if code.startswith('Gaussian'):
        gaussian()
    elif code == 'ORCA':
        orca()
    elif code == 'NWChem':
        nwchem()
    elif code == 'MOPAC':
        mopac()
    elif code == 'QuantumESPRESSO':
        espresso()
    elif code == 'CP2K':
        cp2k()
    elif code == 'xTB':
        xtb()
    elif code == 'CREST':
        xtb('crest')
    elif code == 'Vina':
        vina()
    elif code == 'MLP':
        xtb('mlp')
    elif code == 'ECCE-QM':
        ecceqm()
    elif code:
        finding('UNSURE', 0, 'code',
                'There are no structural checks for {} yet, so only the code-independent ones above were applied.'.format(code))
    else:
        finding('UNSURE', 0, 'code',
                'No code was named, so only the code-independent checks above were applied.')
    return report()


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
