#!/usr/bin/env perl
################################################################################
#
# Purpose:
# Extracts the zero point energy from ORCA's "Summary of contributions
# to the inner energy U:" block into ECCE's EZEROPT property (a
# PropValue, stored in Hartree). Unlike NWChem's own EZEROPT line
# (kcal/mol, needs converting), ORCA already prints the value directly
# in Hartree ("Eh") alongside the kcal/mol figure, so no conversion is
# needed here -- just pick out the Eh column.
#
# Sample input line, verified against a real captured ORCA output
# (THERMOCHEMISTRY AT 298.15K section, stable across ORCA versions --
# checked against both an old ORCA 3.0.3 capture and the labels quoted
# in ORCA 6.1's own tutorial docs, identical wording in both):
#   Zero point energy                ...      0.10060519 Eh      63.13 kcal/mol
#
################################################################################

$| = 1;

($key, $runtype, $ucCategory, $theory) = @ARGV;

my $line = <STDIN>;
my $value = 0.0;
if (defined($line) && $line =~ /\.\.\.\s*(-?\d+\.\d+)\s*Eh/) {
  $value = $1;
}

print "key: EZEROPT\n";
print "size:\n1\n";
print "values:\n$value\n";
print "units:\nHartree\n";
print "END\n";

exit(0);
