#!/usr/bin/env python3
"""Translate ECCE standard basis data on stdin to ACES II on stdout."""

from contextlib import redirect_stdout
from io import StringIO
import sys
from rdStandardGBS import translator_main
from wracesIIGBS import wracesII

# The short usage spells the code differently from its installed filename.
with redirect_stdout(StringIO()) as output:
    status = translator_main(wracesII, 'aceII', '1326')
sys.stdout.write(output.getvalue().replace('Usage: std2aceII\n', 'Usage: std2acesII\n', 1))
sys.exit(status)
