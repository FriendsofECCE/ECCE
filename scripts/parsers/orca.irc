#!/usr/bin/env perl
# IRC (#417): ORCA's "IRC PATH SUMMARY".  Energies are absolute (Eh); the
# row marked "<= TS" is the origin.  ORCA prints no reaction coordinate, so
# IRCCOORD is the signed point number counted from the TS.
$| = 1;
($key, $runtype) = @ARGV;
exit(0) unless ($runtype =~ /IRC/i);

my (@e, $ts);
while (<STDIN>) {
  next unless (/^\s*\d+\s+(-?\d+\.\d+)\s+-?\d+\.\d+\s+\d+\.\d+\s+\d+\.\d+(\s+<=\s*TS)?/);
  $ts = scalar(@e) if (defined $2);
  push(@e, $1);
}
exit(0) unless (defined $ts && @e > 1);

my @pts = map { [$_ - $ts, $e[$_]] } (0 .. $#e);
# Structures stored live (orca.irctrj) are in run order: the points the same,
# in the order orca.ircpoint received them, then any it missed.
if (-e "$key/orcaIrcFrames") {
  my %rank;
  if (open(my $fh, "<", "$key/orcaIrcPoints")) {
    my $i = 0;
    while (<$fh>) { my ($x) = split; $rank{$x} = $i++ if (defined $x && !exists $rank{$x}); }
    close($fh);
  }
  my $rk = sub { my $x = $_[0]; exists $rank{$x} ? $rank{$x}
                  : 1e6 + ($x >= 0 ? $x : 1e5 - $x) };
  @pts = sort { $rk->($a->[0]) <=> $rk->($b->[0]) } @pts;
}
my $n = scalar(@pts);
print "key: IRCCOORD\nsize: \n$n\nvalues: \n", join("\n", map { $_->[0] } @pts),
      "\nunits:\nPoint\nEND\n";
print "key: IRCENERGY\nsize: \n$n\nvalues: \n", join("\n", map { $_->[1] } @pts),
      "\nunits:\nHartree\nEND\n";
exit(0);
