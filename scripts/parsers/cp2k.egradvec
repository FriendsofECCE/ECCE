#!/usr/bin/env python3
import io
import re
import sys

# Python 3.6 lacks reconfigure(); job output may contain stray bytes.
for name in ("stdin", "stdout"):
    stream = getattr(sys, name)
    if hasattr(stream, "reconfigure"):
        stream.reconfigure(encoding="utf-8", errors="replace", newline="\n")
    else:
        setattr(sys, name, io.TextIOWrapper(stream.buffer, encoding="utf-8",
                                           errors="replace", newline="\n"))

_NUM = re.compile(r"[ \t\n\r\f\v]*([+-]?(?:\d+\.?\d*|\.\d+)(?:[eE][+-]?\d+)?)", re.ASCII)


def _num(value):
    # Perl arithmetic takes a numeric prefix, or zero for a non-number.
    match = _NUM.match(value)
    return float(match[1]) if match else 0.0


values, labels = [], []
for line in sys.stdin:
    if re.search(r"FORCES\|\s+Sum", line, re.ASCII):
        break
    match = re.search(r"FORCES\|\s+(\d+)\s+(-?\d\S*)\s+(-?\d\S*)\s+(-?\d\S*)\s+\d\S*\s*$",
                      line, re.ASCII)
    if not match:
        continue
    labels.append(match[1])
    for field in match.groups()[1:]:
        force = _num(field)
        # CP2K prints forces in Hartree/Bohr; ECCE stores the gradient.
        gradient = 0 if force == 0 else -force
        values.append(("%.10f" % gradient).replace("inf", "Inf"))
if labels:
    print("key: EGRADVEC\nsize:\n{} 3\nrowlabels:\n{}\ncolumnlabels:\nX Y Z\nvalues:".format(
        len(labels), " ".join(labels)))
    for index in range(0, len(values), 3):
        print(" ".join(values[index:index + 3]) + " ")
    print("units:\nHartree/Bohr\nEND", flush=True)
