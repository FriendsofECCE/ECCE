#!/usr/bin/env python3
# CP2K needs no launch-time edits, but Launch requires this preprocessor.
import sys

args = sys.argv[1:]
param, version = "", False
while args and len(args[0]) > 1 and args[0].startswith("-"):
    token = args.pop(0)
    option, rest = token[1], token[2:]
    if option == "-" and rest == "":
        break
    if option == "p":
        param = rest if rest else (args.pop(0) if args else "")
    else:
        if option == "v":
            version = True
        else:
            sys.stderr.write("Unknown option: {}\n".format(option))
        if rest:
            args.insert(0, "-" + rest)
if version:
    print("Revision: 1.0")
else:
    try:
        with open(param, encoding="utf-8", errors="replace"):
            pass
    except OSError:
        sys.stderr.write("parameter file does not exist!\n")
        sys.exit(2)
