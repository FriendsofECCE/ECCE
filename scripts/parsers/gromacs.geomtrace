#!/usr/bin/env python3
################################################################################
#
# Purpose:
#   The trajectory of a GROMACS run -> ECCE's GEOMTRACE table, one step per
#   frame.
#
#   gensub (on the compute side, where gmx is) converts traj.xtc with
#   "trjconv -pbc mol", keeps at most 100 frames, and writes them to
#   ecce-parse-traj.txt as
#
#     ECCE-TRAJ frame <n> atoms <N>
#     ECCE-TRAJ box <a> <b> <c> <alpha> <beta> <gamma>   (CRYST1; older runs have none)
#     <element> <x> <y> <z>        (Angstrom, one line per atom)
#     ECCE-TRAJ end
#
#   gromacs.desc ships that file whole (File=), one record per frame here:
#   GEOMTRACE, and LATTICEVEC when the frame has its box, so that the two
#   stay the same length and GTStepCmd draws each frame's cell.
#
################################################################################

import math
import re
import sys
from xtb_parse import configure_streams, number

configure_streams()
DEG = 3.14159265358979 / 180.0
coords, labels, box = [], [], []


def flush():
    if not coords:
        return
    print("key: GEOMTRACE\nsize:\n1 {} 3\nrowlabels:\n{}".format(len(coords), "".join(labels)))
    print("columnlabels:\nX Y Z\nvalues:")
    for coord in coords:
        print(" " + coord)
    print("units:\nAngstrom\nEND")
    if len(box) == 6:
        # a along x, b in the xy plane: the PDB convention, which is GROMACS's.
        a, b, c, alpha, beta, gamma = [number(value) for value in box]
        ca, cb, cg = [math.cos(value * DEG) for value in (alpha, beta, gamma)]
        sg = math.sin(gamma * DEG)
        if sg == 0:
            # Preserve the legacy diagnostic location and status for a degenerate
            # gamma angle so callers receive the same failure record.
            sys.stdout.flush()
            sys.stderr.write("Illegal division by zero at {} line 42, <STDIN> line {}.\n".format(sys.argv[0], line_number))
            sys.exit(255)
        cy = (ca - cb * cg) / sg
        cz = 1 - cb * cb - cy * cy
        vectors = (a, 0, 0, b * cg, b * sg, 0,
                   c * cb, c * cy, c * math.sqrt(cz if cz > 0 else 0))
        print("key: LATTICEVEC\nsize:\n1 3 3\nrowlabels:\n0 1 2\ncolumnlabels:\nX Y Z\nvalues:")
        for k in range(0, 9, 3):
            print(" %.6f %.6f %.6f" % tuple(0 if abs(value) < 5e-7 else value
                                             for value in vectors[k:k + 3]))
        print("units:\nAngstrom\nEND")
    coords.clear()
    labels.clear()
    box.clear()


line_number = 0
for raw in sys.stdin.buffer:
    line_number += 1
    line = raw.decode("utf-8", "replace")
    end = re.search(r"^ECCE-TRAJ end", line, re.ASCII)
    cell = re.search(r"^ECCE-TRAJ box\s+(.*?)\s*$", line, re.ASCII)
    atom = re.search(r"^\s*([A-Za-z]{1,2})\s+(-?\d+(?:\.\d+)?)\s+(-?\d+(?:\.\d+)?)\s+(-?\d+(?:\.\d+)?)\s*$", line, re.ASCII)
    if end:
        flush()
    elif cell:
        # split(/\s+/) retains a leading empty item, unlike split(' ').
        box[:] = re.split(r"\s+", cell.group(1), flags=re.ASCII)
        while box and box[-1] == "":
            box.pop()
        if len(box) != 6:
            box.clear()
    elif atom:
        coords.append(" ".join(atom.groups()[1:]))
        labels.append(" {}-{}".format(len(coords), atom.group(1)))
flush()
