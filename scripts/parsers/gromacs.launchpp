#!/usr/bin/env perl
###############################################################################
#
# Purpose:
#   Launch-time check of a GROMACS task's inputs, on the launching machine,
#   so that a mistake is reported at launch and not found in the job log.
#
#   Launch has staged gromacs.mdp (the input file), topol.top, conf.gro and
#   any .itp/.ndx includes in the current directory.  This checks the three
#   that grompp needs are there, and, if gmx is on this machine, runs grompp
#   on them into a scratch .tpr.  grompp's diagnostics are good -- a
#   topology that does not match the structure is the first thing a new user
#   hits -- and are printed as they are.  A non-zero exit stops the launch;
#   Launch shows what was printed.
#
#   The job script runs grompp again on the machine that runs the job (that
#   is where the .tpr that mdrun reads is built, and that machine may be a
#   different one with its own gmx), so nothing built here is shipped.  When
#   there is no gmx here the check is skipped and the job script reports a
#   failure in the output file instead.
#
#   Idempotent: it changes nothing in the directory.
#
##############################################################################
use strict;
use Getopt::Std;
use File::Temp qw(tempdir);
use Cwd ();
use FindBin qw($Bin);

our($opt_p, $opt_v);
getopts('p:v');

if ($opt_v) {
  print "gromacs.launchpp 2.0\n";
  exit 0;
}

open(my $pd, "<", $opt_p) || die "gromacs.launchpp: parameter file does not exist!\n";
my %params;
while (<$pd>) {
  s/\s*!.*$//;
  if (/^\s*([^:\s]+)\s*:\s*(.*?)\s*$/) { $params{$1} = $2; }
}
close($pd);

my $mdp = $params{"inputFile"} || "gromacs.mdp";

# gmx on this machine?  Not an error if it is not: the job's machine has it.
my $gmx = "";
foreach my $dir (split(/:/, $ENV{"PATH"} || "")) {
  if (-x "$dir/gmx") { $gmx = "$dir/gmx"; last; }
}

checkPrepare() if ($mdp =~ /\.gmxprep$/);

my @missing;
push(@missing, "the run-control file $mdp") if (! -s $mdp);
push(@missing, "the topology (topol.top)")  if (! -s "topol.top");
push(@missing, "the starting structure (conf.gro)") if (! -s "conf.gro");
if (@missing) {
  print STDERR "GROMACS needs " . join(", ", @missing) . " and it is not here.\n";
  print STDERR "Attach the topology and the structure on the Inputs tab of the task editor.\n";
  exit 1;
}

# The index file for -n: one the user attached wins and its group names are
# theirs; otherwise one is written from the groups the .mdp defines by residue
# name.  It is written here, before anything is checked, because Launch ships
# whatever is in this directory and the job script only passes -n.
my $ndx = indexFile();

if ($gmx eq "") {
  print "gmx is not on this machine, so the inputs are not checked here; grompp runs on the job's machine.\n";
  exit 0;
}

my $tmp = tempdir("gromacs.launchpp.XXXXXX", TMPDIR => 1, CLEANUP => 1);

# Include files in a folder are staged as <folder>__SLASH__<file> (the file
# transfer is flat).  grompp is run in a scratch directory where they are
# linked back under their folders, so that nothing staged is moved before
# Launch ships it.
my $work = "$tmp/run";
mkdir($work);
my $cwd = Cwd::getcwd();
opendir(my $dh, ".") || die "gromacs.launchpp: cannot read the staging directory\n";
foreach my $f (readdir($dh)) {
  next if ($f eq "." || $f eq ".." || ! -f $f);
  (my $rel = $f) =~ s#__SLASH__#/#g;
  if ($rel =~ m#^/# || $rel =~ m#(^|/)\.\.(/|$)#) { next; }
  if ($rel =~ m#/#) {
    (my $dir = $rel) =~ s#/[^/]*$##;
    system("mkdir", "-p", "$work/$dir");
  }
  symlink("$cwd/$f", "$work/$rel");
}
closedir($dh);
chdir($work);
$mdp = "$cwd/$mdp" if ($mdp !~ m#^/#);
# -r: a topology with [ position_restraints ] needs a reference structure,
# and grompp ignores it otherwise; the starting structure is the reference,
# as in the job script (gensub).
# A GROMOS force field draws one twin-range warning whatever the system.
my $maxwarn = 0;
if (open(my $tf, "<", "topol.top")) {
  while (<$tf>) { $maxwarn = 1 if (m#^\s*\#include\s*"gromos[^"]*\.ff/#); }
  close($tf);
}
# Berendsen coupling is a grompp warning whatever the system; the user chose it.
if (open(my $mf, "<", $mdp)) {
  while (<$mf>) { $maxwarn++ if (/^\s*pcoupl\s*=\s*berendsen\b/i); }
  close($mf);
}
my @cmd = ($gmx, "grompp", "-f", $mdp, "-c", "conf.gro", "-r", "conf.gro",
           "-p", "topol.top", ($ndx ne "" ? ("-n", $ndx) : ()),
           "-o", "$tmp/check.tpr", "-po", "$tmp/mdout.mdp", "-maxwarn", $maxwarn);
my $out = `@cmd 2>&1`;
# leave the scratch directory so that its removal at exit can succeed
chdir($cwd);
my $status = $? >> 8;
if ($status != 0) {
  print STDERR "grompp rejected the inputs, so the job was not submitted.\n";
  print STDERR "  command: @cmd\n\n";
  # the useful part of grompp's output starts at its first ERROR/WARNING
  my @lines = split(/\n/, $out);
  my $first = 0;
  for (my $i = 0; $i < scalar(@lines); $i++) {
    if ($lines[$i] =~ /^(ERROR|WARNING|Fatal error)/) { $first = $i; last; }
  }
  print STDERR join("\n", @lines[$first .. $#lines]) . "\n";
  exit($status);
}
print "grompp accepted the inputs.\n";
exit 0;

# The index file grompp is given, or "" for none.
sub indexFile
{
  my $own = "ecce_groups.ndx";
  my @user = sort grep { $_ ne $own && ! m#__SLASH__# && -f $_ } glob("*.ndx");
  if (@user) {
    unlink($own);
    return $user[0];
  }
  unlink($own);
  my $script = "$Bin/gromacs.mkndx";
  my $out = `'$^X' '$script' conf.gro '$mdp' $own topol.top 2>&1`;
  if ($? != 0) {
    print STDERR "The index file for the groups of the task could not be made.\n$out";
    exit 1;
  }
  return -s $own ? $own : "";
}

# A Prepare task has no topology or structure of its own to check; the
# mistakes worth stopping for are pdb2gmx's (a residue it has no entry for,
# a missing atom), so it is run on its own, here, on the staged structure.
sub checkPrepare
{
  my %r = (FF => "amber99sb-ildn", WATER => "tip3p", IGNH => 1, MERGE => 0);
  if (open(my $rf, "<", $mdp)) {
    while (<$rf>) { $r{$1} = $2 if (/^\s*([A-Z]+)=(\S*)\s*$/); }
    close($rf);
  }
  checkMinff() if (($r{SOURCE} || "") eq "minff");
  my @pdb = glob("*.gmxpdb");
  @pdb = glob("*.pdb") if (!@pdb);
  if (!@pdb) {
    print STDERR "Prepare needs the protein structure (a .pdb file) and it is not here.\n";
    exit 1;
  }
  if ($gmx eq "") {
    print "gmx is not on this machine, so pdb2gmx is not tried here; it runs on the job's machine.\n";
    exit 0;
  }
  my $tmp = tempdir("gromacs.launchpp.XXXXXX", TMPDIR => 1, CLEANUP => 1);
  # pdb2gmx goes by the extension, and a staged name may not end in .pdb
  my $pdb = "$tmp/in.pdb";
  symlink(Cwd::abs_path($pdb[0]), $pdb);
  my @cmd = ($gmx, "pdb2gmx", "-f", $pdb, "-ff", $r{FF}, "-water", $r{WATER},
             "-o", "$tmp/c.gro", "-p", "$tmp/t.top", "-i", "$tmp/p.itp");
  push(@cmd, "-ignh") if ($r{IGNH});
  push(@cmd, "-merge", "all") if ($r{MERGE});
  my $out = `cd $tmp && @cmd 2>&1 </dev/null`;
  my $status = $? >> 8;
  if ($status != 0) {
    print STDERR "pdb2gmx rejected the structure, so the job was not submitted.\n";
    print STDERR "  command: @cmd\n\n";
    my @lines = split(/\n/, $out);
    my $first = 0;
    for (my $i = 0; $i < scalar(@lines); $i++) {
      if ($lines[$i] =~ /(is missing in residue|not found in|^Fatal error|^Program:)/) { $first = $i; last; }
    }
    print STDERR join("\n", @lines[$first .. $#lines]) . "\n";
    exit($status);
  }
  print "pdb2gmx accepted the structure.\n";
  exit 0;
}

# A MINFF Prepare has no pdb2gmx step: its topology and structure were built
# by the editor and are staged as topol.gmxmin and conf.gmxmin.  What is
# worth stopping for is a topology grompp rejects, so grompp is run on them.
sub checkMinff
{
  if (! -s "topol.gmxmin" || ! -s "conf.gmxmin") {
    print STDERR "This Prepare has no mineral topology yet.\n";
    print STDERR "Open it in the GROMACS Prepare editor, choose the unit cell and press Build topology.\n";
    exit 1;
  }
  if ($gmx eq "") {
    print "gmx is not on this machine, so grompp is not tried here; it runs on the job's machine.\n";
    exit 0;
  }
  my $tmp = tempdir("gromacs.launchpp.XXXXXX", TMPDIR => 1, CLEANUP => 1);
  my $cwd = Cwd::getcwd();
  opendir(my $dh, ".") || die "gromacs.launchpp: cannot read the staging directory\n";
  foreach my $f (readdir($dh)) {
    next if ($f eq "." || $f eq ".." || ! -f $f);
    (my $rel = $f) =~ s#__SLASH__#/#g;
    next if ($rel =~ m#^/# || $rel =~ m#(^|/)\.\.(/|$)#);
    if ($rel =~ m#/#) {
      (my $dir = $rel) =~ s#/[^/]*$##;
      system("mkdir", "-p", "$tmp/$dir");
    }
    symlink("$cwd/$f", "$tmp/$rel");
  }
  closedir($dh);
  # gmx goes by the extension
  symlink("$cwd/topol.gmxmin", "$tmp/topol.top");
  symlink("$cwd/conf.gmxmin", "$tmp/conf.gro");
  open(my $mf, ">", "$tmp/check.mdp") || die "gromacs.launchpp: cannot write in $tmp\n";
  print $mf "integrator = steep\nnsteps = 0\ncutoff-scheme = Verlet\ncoulombtype = cutoff\n";
  print $mf "rcoulomb = 0.5\nrvdw = 0.5\npbc = xyz\nperiodic-molecules = yes\n";
  close($mf);
  my @cmd = ($gmx, "grompp", "-f", "check.mdp", "-c", "conf.gro", "-p", "topol.top",
             "-o", "check.tpr", "-po", "mdout.mdp");
  my $out = `cd $tmp && @cmd 2>&1 </dev/null`;
  my $status = $? >> 8;
  if ($status != 0) {
    print STDERR "grompp rejected the mineral topology, so the job was not submitted.\n";
    print STDERR "  command: @cmd\n\n";
    my @lines = split(/\n/, $out);
    my $first = 0;
    for (my $i = 0; $i < scalar(@lines); $i++) {
      if ($lines[$i] =~ /^(ERROR|WARNING|Fatal error)/) { $first = $i; last; }
    }
    print STDERR join("\n", @lines[$first .. $#lines]) . "\n";
    exit($status);
  }
  print "grompp accepted the mineral topology.\n";
  exit 0;
}
