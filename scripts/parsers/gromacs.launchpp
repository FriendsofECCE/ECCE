#!/usr/bin/env python3
"""Check staged GROMACS inputs; report advisory failures through the launch marker."""
import glob
import math
import os
import re
import shutil
import subprocess
import sys
import tempfile

import gmx_ions
import grompp_warn


NL = None if os.name == 'nt' else ''

def emit(text, stream=None):
    if os.name == 'nt':
        text = text.replace('\n', '\r\n')
    (stream or sys.stdout).buffer.write(text.encode('utf-8', 'surrogateescape'))


def read(path):
    # These bytes may be copied into a PDB or passed back in a diagnostic.
    with open(path, encoding='utf-8', errors='surrogateescape', newline=NL) as f:
        return f.read()


def write(path, text):
    with open(path, 'w', encoding='utf-8', errors='surrogateescape', newline=NL) as f:
        f.write(text)


def nonempty(path):
    try:
        return os.path.getsize(path) > 0
    except OSError:
        return False


def warn_and_exit(tool, detail, original=''):
    emit('ECCE-LAUNCH-WARNING\nThe job will stop at {} with this error:\n\n{}\n'.format(tool, detail))
    if original:
        emit('ECCE-ORIGINAL-MESSAGE\n' + original + '\n')
    raise SystemExit(0)


def run(cmd, cwd):
    result = subprocess.run(cmd, cwd=cwd, stdin=subprocess.DEVNULL,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    out = result.stdout.decode('utf-8', 'surrogateescape')
    if os.name == 'nt':
        out = out.replace('\r\n', '\n')
    return result.returncode, out


def diagnostic(out, pattern):
    lines = out.split('\n')
    while lines and not lines[-1]:
        lines.pop()
    first = next((i for i, line in enumerate(lines) if re.search(pattern, line)), 0)
    return '\n'.join(lines[first:])


def stage(work):
    for name in os.listdir('.'):
        if not os.path.isfile(name):
            continue
        rel = re.sub(r'\.gmxff$', '', name.replace('__SLASH__', '/'))
        if rel.startswith('/') or re.search(r'(^|/)\.\.(/|$)', rel):
            continue
        target = os.path.join(work, rel)
        os.makedirs(os.path.dirname(target), exist_ok=True)
        # Copies also work on Windows accounts without symlink privileges.
        if not os.path.lexists(target):
            shutil.copyfile(name, target)


def unlink(path):
    try:
        os.unlink(path)
    except OSError:
        pass


def index_file(mdp):
    own = 'ecce_groups.ndx'
    user = sorted(f for f in glob.glob('*.ndx')
                  if f != own and '__SLASH__' not in f and os.path.isfile(f))
    unlink(own)
    if user:
        return user[0]
    script = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'gromacs.mkndx')
    status, out = run([sys.executable, script, 'conf.gro', mdp, own, 'topol.top'], os.getcwd())
    if status:
        emit('The index file for the groups of the task could not be made.\n' + out, sys.stderr)
        raise SystemExit(1)
    return own if nonempty(own) else ''


def minff_check_cutoff(gro):
    try:
        lines = [l for l in read(gro).split('\n') if l.strip()]
        b = [float(s) for s in lines[-1].split()] if lines else []
    except (OSError, ValueError):
        b = []
    if len(b) not in (3, 9):
        return 0.5
    if len(b) == 3:
        b += [0] * 6
    vectors = [[b[0], b[3], b[4]], [b[5], b[1], b[6]], [b[7], b[8], b[2]]]
    maximum = 0.5
    for i, v in enumerate(vectors):
        maximum = min(maximum, 0.5 * math.sqrt(sum(x * x for x in v)), v[i])
    rc = int(maximum / 1.05 * 0.98 * 1000) / 1000
    return rc if rc > 0 else 0.5


def check_minff(gmx):
    if not nonempty('topol.gmxmin') or not nonempty('conf.gmxmin'):
        emit('This Prepare has no mineral topology yet.\n'
             'Open it in the GROMACS Prepare editor, choose the unit cell and press Build topology.\n', sys.stderr)
        return 1
    if not gmx:
        emit("gmx is not on this machine, so grompp is not tried here; it runs on the job's machine.\n")
        return 0
    with tempfile.TemporaryDirectory(prefix='gromacs.launchpp.') as tmp:
        stage(tmp)
        for source, dest in [('topol.gmxmin', 'topol.top'), ('conf.gmxmin', 'conf.gro')]:
            unlink(os.path.join(tmp, dest))
            shutil.copyfile(source, os.path.join(tmp, dest))
        rc = minff_check_cutoff('conf.gmxmin')
        write(os.path.join(tmp, 'check.mdp'),
              'integrator = steep\nnsteps = 0\ncutoff-scheme = Verlet\ncoulombtype = cutoff\n'
              'rcoulomb = {0:g}\nrvdw = {0:g}\npbc = xyz\nperiodic-molecules = yes\n'.format(rc))
        cmd = [gmx, 'grompp', '-f', 'check.mdp', '-c', 'conf.gro', '-p', 'topol.top',
               '-o', 'check.tpr', '-po', 'mdout.mdp']
        status, out = run(cmd, tmp)
        if status:
            warn_and_exit('grompp', 'command: ' + ' '.join(cmd) + '\n\n' +
                          diagnostic(out, r'^(ERROR|WARNING|Fatal error)'))
    emit('grompp accepted the mineral topology.\n')
    return 0


def check_prepare(mdp, gmx):
    recipe = dict(FF='amber99sb-ildn', WATER='tip3p', IGNH='1', MERGE='0')
    try:
        for line in read(mdp).split('\n'):
            m = re.match(r'^\s*([A-Z]+)=(\S*)\s*$', line, re.ASCII)
            if m:
                recipe[m[1]] = m[2]
    except OSError:
        pass
    if recipe.get('SOURCE') == 'minff':
        return check_minff(gmx)
    pdbs = sorted(glob.glob('*.gmxpdb')) or sorted(glob.glob('*.pdb'))
    if not pdbs:
        emit('Prepare needs the protein structure (a .pdb file) and it is not here.\n', sys.stderr)
        return 1
    if not gmx:
        emit("gmx is not on this machine, so pdb2gmx is not tried here; it runs on the job's machine.\n")
        return 0
    with tempfile.TemporaryDirectory(prefix='gromacs.launchpp.') as tmp:
        pdb = os.path.join(tmp, 'in.pdb')
        new, notes = gmx_ions.rewrite(read(pdbs[0]), recipe['FF'])
        write(pdb, new)
        cmd = [gmx, 'pdb2gmx', '-f', pdb, '-ff', recipe['FF'], '-water', recipe['WATER'],
               '-o', tmp + '/c.gro', '-p', tmp + '/t.top', '-i', tmp + '/p.itp']
        if recipe['IGNH'] not in ('', '0'):
            cmd.append('-ignh')
        if recipe['MERGE'] not in ('', '0'):
            cmd += ['-merge', 'all']
        status, out = run(cmd, tmp)
        if status:
            warn_and_exit('pdb2gmx', 'command: ' + ' '.join(cmd) + '\n\n' +
                          diagnostic(out, r'is missing in residue|not found in|^Fatal error|^Program:'))
    emit('pdb2gmx accepted the structure.\n')
    return 0


def main(args):
    params_path, version = None, False
    # Getopt::Std accepts clustered flags and stops at the first non-option.
    while args and args[0].startswith('-') and args[0] != '-':
        arg = args.pop(0)[1:]
        if arg == '-':
            break
        while arg:
            key, arg = arg[0], arg[1:]
            if key == 'v':
                version = True
            elif key == 'p':
                params_path = arg or (args.pop(0) if args else None)
                arg = ''
            else:
                emit('Unknown option: ' + key + '\n', sys.stderr)
    if version:
        emit('gromacs.launchpp 2.0\n')
        return 0
    try:
        contents = read(params_path) if params_path is not None else ''
        if params_path is None:
            raise FileNotFoundError(2, 'No such file or directory')
    except OSError as e:
        emit('gromacs.launchpp: parameter file does not exist!\n', sys.stderr)
        return e.errno or 255
    params = {}
    for line in contents.split('\n'):
        line = re.sub(r'\s*!.*$', '', line, flags=re.ASCII)
        m = re.match(r'^\s*([^:\s]+)\s*:\s*(.*?)\s*$', line, re.ASCII)
        if m:
            params[m[1]] = m[2]
    mdp = params.get('inputFile') or 'gromacs.mdp'
    gmx = shutil.which('gmx') or ''
    if mdp.endswith('.gmxprep'):
        return check_prepare(mdp, gmx)
    if nonempty('run.gmxtpr'):
        return 0
    missing = []
    for path, label in [(mdp, 'the run-control file ' + mdp), ('topol.top', 'the topology (topol.top)'),
                        ('conf.gro', 'the starting structure (conf.gro)')]:
        if not nonempty(path):
            missing.append(label)
    if missing:
        emit('GROMACS needs ' + ', '.join(missing) + ' and it is not here.\n'
             'Attach the topology and the structure on the Inputs tab of the task editor.\n', sys.stderr)
        return 1
    ndx = index_file(mdp)
    if not gmx:
        emit("gmx is not on this machine, so the inputs are not checked here; grompp runs on the job's machine.\n")
        return 0
    with tempfile.TemporaryDirectory(prefix='gromacs.launchpp.') as tmp:
        work = os.path.join(tmp, 'run')
        os.mkdir(work)
        stage(work)
        cmd = [gmx, 'grompp', '-f', os.path.abspath(mdp), '-c', 'conf.gro', '-r', 'conf.gro',
               '-p', 'topol.top']
        if ndx:
            cmd += ['-n', ndx]
        cmd += ['-o', tmp + '/check.tpr', '-po', tmp + '/mdout.mdp', '-maxwarn', '999']
        status, out = run(cmd, work)
        if status:
            msg = diagnostic(out, r'^(ERROR|WARNING|Fatal error)')
            named = grompp_warn.translate(msg)
            warn_and_exit('grompp', 'command: ' + ' '.join(cmd) + '\n\n' + named,
                          msg if named != msg else '')
        intended = 'ECCE-NETCHARGE-INTENDED' in read(os.path.join(work, 'topol.top'))
        stop = [w for w in grompp_warn.parse(out, intended) if not w['harmless']]
        if stop:
            body = '\n\n'.join(grompp_warn.explain(w) or grompp_warn.translate(w['text']) for w in stop)
            original = '\n\n'.join(w['head'] + '\n  ' + w['text'] for w in stop) if body != '\n\n'.join(
                w['text'] for w in stop) else ''
            warn_and_exit('grompp', body, original)
    emit('grompp accepted the inputs.\n')
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
