#!/usr/bin/env perl
################################################################################
# FILENAME:  ai.nwchem
#
#
# SYNTAX: ai.nwchem -p paramdictionary -f frag -q esp -b gbs -t template -c constraint
#
# PURPOSE:
#	Take an AbiChem generated dictionary and produce an input
#       file for a NWChem run. Note that the template file is
#       overwritten when generating the input file.
#
# DESCRIPTION:
#
# LIMITATIONS:
#
###########################################################################

{
# package for command-line options like -v
  use Getopt::Std;

  push(@INC,"$ENV{ECCE_HOME}/scripts/parsers");

# provides loadPT to setup periodic table hashes
  require "pertab.pl";

# Force output to be flushed
  $| = 1;

#
#  Handle the options
#
  &getopts(':n:t:pfbqchvse');
  &handle_options;

## Setup dates and such
  ($sec,$min,$hour,$mday,$mon,$year,$wday,$yday,$isdst) = localtime(time);
  $month = (January, February, March, April, May, June,
	    July, August, September, October, November, December)[$mon];

## Dictionary to be parsed from specified input file
  %AbiDict = ();

  if ($TplFILE eq "") {
    &usage;
  }

#  print "Executing: ai.nwchem $ARGV[0] $ARGV[1] $ARGV[2] $ARGV[3]\n";
# set some flags to determine what kind of basis is used.
  $usesXCBasis = 0;
  $usesCDBasis = 0;
  $usesECPBasis = 0;
  $usesBQAtoms = 0;
  %BQAtomsList = ();

## Main Routine
  &loadPT;
  &verifyAbiFile;
  &verifyFragFile;
  &verifyESPFile;
  &verifyCnstrntFile;
  &verifyGBSFile;
  &readDict;
  &aiDebugDict;
  &readChemSys;
  &readESPFile;
  &readCnstrntFile;
  &modifyInputFile;
  &removeUnusedSections;
# uncomment for debugging help
#  &dumpData;
  &cleanup;
}
## Modify the existing template or create a new copy of the
##   template and then begin modifying it.  We go line-by-line
##   throught the template, replacing all /##(.*)##/ tags with
##   translated dictionary values.  If no key is found in the
##   dictionary, we remove the line entirely
################################################################################
# Verbose troubleshooting output for the ##tag## substitution engine.
#
# Every silent-failure bug this project has chased through the input
# generators has one shape: a tag resolves to the empty string, its line is
# dropped, and the setting the user picked is simply not in the deck.  Nothing
# says so -- the script exits 0 and the job runs with different settings than
# the dialog showed.  (The NWChem BP86 case: the dialog offered "BP86 (GGA)",
# the resolver only matched "BP86 (hybrid)", and every such job silently ran
# on the default LDA instead.)
#
# Set ECCE_AI_DEBUG=1 for one line per tag on STDERR saying what it resolved
# to and, crucially, when it resolved to nothing.  An environment variable
# rather than a switch because these scripts are invoked with a fixed argument
# list from C++, so this needs no C++ change to turn on.
################################################################################
sub aiDebug {
  return unless $ENV{"ECCE_AI_DEBUG"};
  my ($message) = @_;
  print STDERR "[ecce-ai] $message\n";
}

# A resolver that returns "" is not automatically a bug.  The convention in
# these scripts is that a resolver which produces several lines either sets $_
# itself or prints straight to NEWFILE, and returns "" either way.  Four
# outcomes have to be told apart, and only the first two are trouble:
#
#   $_ still holds ##tag##   nothing replaced it; the literal tag text is
#                            about to be written into the input deck
#   nothing written at all   the line is dropped.  Intentional for an optional
#                            setting, and the silent-drop bug when it is not --
#                            the message names the tag, so a user report names
#                            the setting that vanished
#   bytes went to NEWFILE    the resolver wrote its own output (chemsys and
#                            friends do this); fine
#   $_ became something else likewise fine
#
# The NEWFILE byte count is what separates "dropped" from "written another
# way"; without it every multi-line resolver looks like a silent drop.
# Called from the `else { &aiUnmatched(@_); $result = ""; }` fallback that ends almost every
# translator in these scripts.  That fallback IS the silent-failure mechanism:
# the dialog offered a string, this sub has no case for it, the empty result
# propagates, and the job runs without the setting -- or, as with the Gaussian
# "None" case, the whole method string collapses to a bare "r".  @_ is the
# sub's own argument list, so the unmatched value reports itself without each
# call site having to name its parameter.
sub aiUnmatched {
  return unless $ENV{"ECCE_AI_DEBUG"};
  my $sub = (caller(1))[3] || "main";
  $sub =~ s/^main:://;
  my $value = defined($_[0]) ? $_[0] : "(no argument)";
  &aiDebug("  !! &$sub has no case for '$value' -- returning empty. If that "
           . "value came from a dialog, the dialog and this script disagree "
           . "and the setting will be missing from the input.");
}

# The full dictionary the dialogs and calced handed this script.  Logged once
# at startup because every "the job ran with the wrong settings" report needs
# both halves: what was asked for, and what reached the deck.
sub aiDebugDict {
  return unless $ENV{"ECCE_AI_DEBUG"};
  # readDict() stores every dotted SUFFIX of each key, so a single setting
  # appears four or five times.  Print only the longest form of each -- a key
  # that no other key ends with -- or the dump is mostly noise.
  my @keys = sort keys %AbiDict;
  my %isSuffix;
  foreach my $key (@keys) {
    foreach my $other (@keys) {
      $isSuffix{$key} = 1 if ($other ne $key && $other =~ /\.\Q$key\E$/);
    }
  }
  &aiDebug("dictionary as read from the .param file:");
  foreach my $key (@keys) {
    next if $isSuffix{$key};
    &aiDebug(sprintf("    %-46s = '%s'", $key, $AbiDict{$key}));
  }
}

sub aiDebugEmpty {
  return unless $ENV{"ECCE_AI_DEBUG"};
  my ($tag, $sub, $tellBefore) = @_;
  my $wrote = tell(NEWFILE) - $tellBefore;
  if ($_ =~ /\#\#\Q$tag\E\#\#/) {
    &aiDebug("  ##$tag##: &$sub returned EMPTY and nothing replaced the tag "
             . "-- the literal ##$tag## text will appear in the input file");
  } elsif ($wrote > 0) {
    &aiDebug("  ##$tag##: &$sub wrote $wrote bytes to the input directly");
  } elsif ($_ eq "") {
    &aiDebug("  ##$tag##: &$sub returned EMPTY and wrote nothing -- the line "
             . "was dropped; if that setting was chosen in the GUI, it is NOT "
             . "in the generated input");
  } else {
    &aiDebug("  ##$tag##: &$sub replaced the line itself");
  }
}

sub modifyInputFile {
  local($keysave, $key, $subname, $prefix, $postfix, $finished);
  $inputFile = $TplFILE;
  open(TEMPLATE, $inputFile);
  open(NEWFILE, ">tmpfile");
  # Do Specialized Key Replacement Before Trying Generic Subroutines
  while (<TEMPLATE>) {
    if (/([^#]*)##([^#]*)##(.*)/) {  ## Locate Tag
# cpp     if (/dummy/) {  ## Use this instead of above line for emacs indenting
      $prefix = $1;
      $postfix = $3;
      $keysave = $key = $2;
      &aiDebug("tag ##$key## (template line $.)");
      $finished = 0;
      while ($finished == 0) {
	$subname = $key;
	$subname =~ s/\./_/g;          ## Replace "." with "_" For Sub Name
	if (defined($AbiDict{$key})) { ## Value is in Dictionary
	  $finished = 1;                       ## Match Means We'll Be Done
	  $value = $AbiDict{$key};
	  $fct = "&$subname('$value')";
	  $eccePrevLine = $_;
	  $eccePrevTell = tell(NEWFILE);
	  $result = eval $fct;
          # #92: eval catches a die() inside the resolver, and the engine
          # reads undef as "no such sub / no substitution" -- so a
          # deliberate error used to vanish along with the tag's line and
          # the script exited 0 with a quietly incomplete deck. Re-raise
          # anything that is a real error; an "Undefined subroutine"
          # failure IS the no-substitution case the engine relies on, so
          # it stays silent.
          if ($@ && $@ !~ /Undefined subroutine/) { die $@; }
	  if (!(defined $result)) {            ## Simple Replacement if No Sub
	    s/##$keysave##/$value/;
	  } elsif ($result eq "") {
            &aiDebugEmpty($keysave, $subname, $eccePrevTell);
          } elsif ($result ne "") {            ## Replace With Subs Value
	    &aiDebug("  ##$keysave## -> \'$result\'");
	    $_ = $prefix . $result . $postfix . "\n";
	  } ## Else The Subroutine Did What it Needed
	} else {                      ## Value Wasn't in Dictionary
	  $finished = 1;
	  $fct = "&$subname";
	  $eccePrevLine = $_;
	  $eccePrevTell = tell(NEWFILE);
	  $result = eval $fct;
          # #92: eval catches a die() inside the resolver, and the engine
          # reads undef as "no such sub / no substitution" -- so a
          # deliberate error used to vanish along with the tag's line and
          # the script exited 0 with a quietly incomplete deck. Re-raise
          # anything that is a real error; an "Undefined subroutine"
          # failure IS the no-substitution case the engine relies on, so
          # it stays silent.
          if ($@ && $@ !~ /Undefined subroutine/) { die $@; }
	  if (!(defined $result)) {
	    # Instead of Failing Outright, Try Reducing Keyword
	    if (index($key, ".") >= $[) {
	      $key =~ s/\.[^\.]*$//;
              &aiDebug("  no &$subname; retrying as ##$key##");
	      $finished = 0;
	    } else {
	      ## print "Removing token $key\n";
	      &aiDebug("  ##$keysave##: no dictionary value and no resolver -- LINE REMOVED");
	      $_ = "";
	    }
	  } elsif ($result eq "") {
            &aiDebugEmpty($keysave, $subname, $eccePrevTell);
          } elsif ($result ne "") {            ## Replace With Subs Value
	    &aiDebug("  ##$keysave## -> \'$result\'");
	    $_ = $prefix . $result . $postfix . "\n";
	  } ## Else The Subroutine Did What it Needed
	}
      }
    }
    print(NEWFILE);
  }
  close TEMPLATE;
}

##############################################################################
#
#  Description:
#      Generate one or more task lines; goes with ##Tasks## key in template.
#       
#  Implementation:
#      Includes a hack to get around the fact that NWChem does not provide
#      energies when it evaluates numerical gradients and hessians.
#
############################################################################## 
sub Tasks {
  local($result);
  local($runtype,$local_runtype,$local_theory);
  $runtype = $AbiDict{"RunType"};
  $local_runtype = &RunType($runtype);
  $local_theory = &NWTheoryKey;
  $result = "";
#
# Include "task theory energy" line if task requires numerical gradient or
# hessian or is a property calculation
#
  if (($local_runtype =~/gradient/ && $local_theory =~ /ccsd/)
      || ($local_runtype =~ /gradient/ && $local_runtype =~ /numerical/)
      || ($local_runtype =~ /freq/ && !($local_theory =~ /ccsd/))
      || $local_runtype =~ /property/ || $local_runtype =~ /esp/) {
    $result .= "task ";
    $result .= &NWTheoryKey." ";
    $result .= "energy\n";
  }
  # Start Eric Bylaska's planewave module integration
  if ($AbiDict{"ES.Runtype.CPMD.Restart"}){
    $result .= "task ";
    $result .= &NWTheoryKey." ";
    $result .= "energy\n";
  }
  # End Eric Bylaska's planewave module integration
  if (!($local_runtype =~ /esp/)) {
    $result .= "task ";
    $result .= &NWTheoryKey." ";
    $result .= $local_runtype;
    if ( $runtype eq "GeoVib" ) {
      $result .= "\ntask ".&NWTheoryKey." freq";
      if ( $usesECPBasis == 1 || $usesCDBasis == 1 || $usesXCBasis == 1) {
        $result .= " numerical";
      } elsif ($AbiDict{"Theory"} eq "UDFT") {
        $result .= " numerical";
      }
    }
  } else {
    $result .= "task ";
    $result .= $local_runtype;
  }
  return $result;
}

##############################################################################
#
#  Description:
#      Add charge or qcharge directive to input.
#
############################################################################## 
sub Charge {
  local($result, $charge);
  $charge = $AbiDict{"Charge"};
  if ($useAtomBehavior == 1 && !$usesBQAtoms) {
    $result = "qcharge $charge";
  } else {
    $result = "charge $charge";
  }
  $_ = $result;
  return $result;
}

##############################################################################
#
#  Description:
#      Generate an NWChem theory key from an ecce Category
#
############################################################################## 
sub NWTheoryKey {
  my($result);
  if ($AbiDict{"Category"} eq "DFT" ) {
    $result =  "dft";
  # Start Eric Bylaska's planewave module integration
  } elsif ($AbiDict{"Category"} eq "NWPW" ) {
    if ( $AbiDict{"Theory"} eq "PSPW" ) {
      $result =  "pspw";
    } elsif ( $AbiDict{"Theory"} eq "BAND" ) {
      $result =  "band";
    } else {
      $result =  "pspw";
    }
    # End Eric Bylaska's planewave module integration
  } elsif ($AbiDict{"Category"} eq "SCF" ) {
    $result =  "scf";
  } elsif ($AbiDict{"Category"} eq "RISCF" ) {
    $result =  "riscf";
  } elsif ($AbiDict{"Category"} eq "MP" ) {
    if ($AbiDict{"ES.Theory.MP.Direct"} eq "direct") {
      $result =  "direct_mp2";
    } else {
      $result =  "mp2";
    }
  } elsif ($AbiDict{"Category"} eq "RIMP" ) {
    $result =  "rimp2";
  } elsif ($AbiDict{"Category"} eq "CC" ) {
    if ( $AbiDict{"Theory"} =~ /CCSD\(T\)/ ) {
      $result =  "ccsd(t)";
    } elsif ( $AbiDict{"Theory"} =~ /CCSDPT/ ) {
      $result =  "ccsd+t(ccsd)";
    } else {
      $result =  "ccsd";
    }
  }
  return $result;
}

