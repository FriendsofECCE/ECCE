#!/usr/bin/env perl
################################################################################
#
# Purpose:
# Parses MOPAC's "CALCULATED THERMODYNAMIC PROPERTIES" table into
# ENTHALPY, ETHERM, ENTROPY, HEATCAP and THERMOTEMP.
#
# Real MOPAC 23.1.2 shape -- one stanza per temperature, the components
# (VIB/ROT/INT/TRA) then a TOT. line carrying the totals:
#
#    TEMP. (K)   PARTITION FUNCTION   H.O.F.    ENTHALPY  HEAT CAPACITY ENTROPY
#                                    KCAL/MOL   CAL/MOLE    CAL/K/MOL  CAL/K/MOL
#
#  298.00  VIB.     0.1001D+01                     4.5175     0.1036     0.0174
#          ROT.     0.4286D+02                   888.2803     2.9808    10.4485
#          INT.     0.4291D+02                   892.7978     3.0844    10.4658
#          TRA.     0.7392D+26                  1480.4672     4.9680    34.6068
#          TOT.                      -57.790    2373.2650     8.0524    45.0726
#
# WHICH TEMPERATURE.  MOPAC prints 298 K first and then scans upward from
# 200 K, so Frequency=last on the .desc entry would still leave this
# script holding every stanza -- and taking the last one would silently
# report the top of the scan (400 K, say) as if it were room
# temperature.  The 298.15 K stanza is selected explicitly, falling back
# to the first one when a THERMO(nnn) range excludes it.  THERMOTEMP is
# emitted alongside so the panel always says which temperature the other
# four values belong to, rather than leaving the user to assume.
#
# MAPPING ONTO ECCE'S KEYS -- the part that is easy to get plausibly
# wrong, since every candidate is a small positive number:
#
#   ENTHALPY <- the H.O.F. column.  MOPAC's own footnote says this is
#               the Standard Enthalpy of Formation ("HEATS OF FORMATION
#               ARE RELATIVE TO THE ELEMENTS IN THEIR STANDARD STATE AT
#               298K (= Standard Enthalpy of Formation)").
#   ETHERM   <- H.O.F. minus RT.  See the long note below; this is NOT
#               the table's ENTHALPY column, and using that column here
#               would throw away the zero-point energy.
#   ENTROPY  <- S multiplied by the stanza's own temperature, because
#               ECCE stores this key as the energy T*S, not as S.
#   HEATCAP  <- Cp, stored in its printed units.  It is not an energy,
#               so its property declares units class NA and nothing
#               converts it.
#
# WHY ETHERM IS NOT THE "ENTHALPY" COLUMN, which is the obvious-looking
# choice and is wrong twice over.
#
# MOPAC's heat of formation is not a 0 K electronic energy.  Its manual
# (Manual/thermochemistry.html, which the output itself links to) gives
#
#     E_SCF = E_eq + E_zpe + E_vib + E_rot + E_tra + PV + ...
#
# and states the parameters "are optimized so as to reproduce the
# experimental heat of formation ... related to the values at 25 C, not
# to 0 K".  So the heat of formation ALREADY CONTAINS the zero-point
# energy and the thermal terms.
#
# The table's ENTHALPY column is only the correction H(T)-H(0), and its
# own footnote says "Hvib: Zero-point energy is not included".  Putting
# that in ETHERM would (a) discard the zero-point energy and (b) show a
# ~2 kcal/mol correction in the panel row where ORCA shows a total: for
# ORCA, "Total thermal energy" is E_el + ZPE + thermal, which that code
# prints having explicitly summed its "Total thermal correction" and its
# "Non-thermal (ZPE) correction".
#
# Rearranging MOPAC's own equation gives the matching total directly.
# E_SCF is an enthalpy (it carries the PV term), so the internal energy
# is E_SCF - PV = E_SCF - RT for an ideal gas -- zero-point energy
# included, because E_SCF includes it.  That is exactly ORCA's own
# relation seen from the other side: ORCA prints U and then "The
# enthalpy is H = U + kB*T".
#
# EZEROPT continues to carry the zero-point energy on its own, from
# MOPAC's "ZERO POINT ENERGY" line, so it is both inside ETHERM/ENTHALPY
# and visible separately -- same as for any other code.
#
# EGIBBS is deliberately NOT emitted.  MOPAC has no absolute energy --
# its H.O.F. is relative to the elements -- so H - T*S here is neither
# the absolute Gibbs energy that key holds for ORCA and Gaussian, nor a
# true Gibbs energy of formation, which would need the elements'
# entropies too.  Filling it would put a differently-defined number in
# the same panel row as other codes'.
#
################################################################################

$| = 1;

#  CODATA-consistent, matching the conversions used elsewhere in these
#  parsers.
use constant KCAL_PER_HARTREE => 627.5094740631;
#  Gas constant in cal/(K*mol), matching the units of this table.
use constant R_CAL_PER_K_MOL => 1.987204259;

my %stanza;           # temperature -> [hof, thermalH, cp, entropy]
my @order;
my $temp;

while (<STDIN>) {
  chomp;
  #  A stanza opens with its temperature on the same line as the VIB.
  #  component; the remaining components carry no temperature.
  if (/^\s*(\d+\.\d+)\s+VIB\./) {
    $temp = $1;
    push(@order, $temp) if (!exists($stanza{$temp}));
    next;
  }
  next if (!defined($temp));

  #  The TOT. line is the only one carrying the heat of formation, so it
  #  has four numbers where the component lines have three.
  if (/^\s*TOT\.\s+(-?\d+\.\d+)\s+(-?\d+\.\d+)\s+(-?\d+\.\d+)\s+(-?\d+\.\d+)\s*$/) {
    $stanza{$temp} = [$1, $2, $3, $4];
  }
}

exit(0) if (!@order);

#  Prefer room temperature; fall back to whatever was printed first.
my $pick;
foreach my $t (@order) {
  if (abs($t - 298.15) < 1.0) { $pick = $t; last; }
}
$pick = $order[0] if (!defined($pick));
exit(0) if (!exists($stanza{$pick}));

my ($hof, $thermalH, $cp, $entropy) = @{$stanza{$pick}};

#  size: IS NOT OPTIONAL, and omitting it does not degrade gracefully.
#
#  PropertyInterpreter::processSize() reads the size section by pulling
#  tokens until it has what it expects.  With no size: line it consumes
#  the rest of the stream -- END included -- and keeps pushing into a
#  vector until the allocation throws.  Nothing catches it, so
#  eccejobstore dies on an uncaught exception: SIGABRT, exit 134.
#  eccejobmaster restarts it, the restart finds the "EOF" bookmark the
#  first run left, and the user is shown "Cannot re-parse frequency
#  'last' type properties", which names neither the property nor the
#  cause.
#
#  This is why MOPAC jobs WITH thermochemistry died while the same job
#  without it was fine: the thermochemistry block was the only one whose
#  parser left the size out.  Every other scalar parser here emits
#  "size:\n1\n" -- orca.s2, mopac.ezeropt and the rest -- and this now
#  does too.
sub emit {
  my ($key, $value, $units) = @_;
  print "key: $key\n";
  print "size:\n1\n";
  print "values:\n$value\n";
  print "units:\n$units\n";
  print "END\n";
}

#  H.O.F. is kcal/mol; the entropy column is in CAL, a thousandth of
#  that.  $thermalH -- the table's ENTHALPY column -- is deliberately
#  NOT used for ETHERM; see the header.
my $rt = (R_CAL_PER_K_MOL * $pick) / 1000.0;   # kcal/mol
&emit("ENTHALPY", $hof / KCAL_PER_HARTREE, "Hartree");
&emit("ETHERM", ($hof - $rt) / KCAL_PER_HARTREE, "Hartree");
&emit("ENTROPY", ($entropy * $pick / 1000.0) / KCAL_PER_HARTREE, "Hartree");
&emit("HEATCAP", $cp, "cal/(K*mol)");
&emit("THERMOTEMP", $pick, "Kelvin");
exit(0);
