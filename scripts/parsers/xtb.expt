#!/usr/bin/env python3
# Import through a replacement copy: the original output and its companions
# belong to the user, including when the staging file is a symlink.
import os
import re
import sys
from xtb_parse import configure_streams, number, options

configure_streams()


def search(pattern, text, flags=0):
    return re.search(pattern, text, re.ASCII | flags)


def read(path):
    try:
        with open(path, encoding="utf-8", errors="replace", newline="") as stream:
            text = stream.read()
        with open(path, "rb") as stream:
            raw = stream.read()
        return text, raw
    except OSError:
        return "", b""


def nonempty(path):
    try:
        return os.path.getsize(path) > 0
    except OSError:
        return False


def usage():
    print("Usage: xtb.expt <outfile> [<sourcedir>]\nOptions:    -h        this help\n            -v        version")
    sys.exit(0)


opts, args = options(":hv", sys.argv[1:])
if "h" in opts:
    usage()
if "v" in opts:
    sys.exit(0)
if len(args) not in (1, 2):
    usage()
file = args[0]
text, combined = read(file)
if not os.path.isfile(file):
    # Match the importer's failure status; normal import failures use stdout.
    sys.stderr.write("Can't locate output file {} at {} line 32.\n".format(file, sys.argv[0]))
    sys.exit(2)
if not search(r"x T B", text):
    print(file + " is not an xtb output")
    sys.exit(1)
m = search(r"^\s*program call\s*:\s*(.*)$", text, re.M)
call = m.group(1) if m else ""
m = search(rb"xtb version (\S+)", combined)
version = m.group(1) if m else None
for bad in ("--md", "--omd", "--scan", "--path", "--metadyn", "--modef"):
    if search(r"(^|\s)" + re.escape(bad) + r"(\s|$)", call):
        print("xtb " + bad + " runs cannot be imported (energy, geometry optimization and frequency runs can)")
        sys.exit(1)
theory = "GFN2-xTB"
if search(r"--gfnff", call):
    theory = "GFN-FF"
if search(r"--gfn\s*1\b", call):
    theory = "GFN1-xTB"
if search(r"--gfn\s*0\b", call):
    print("GFN0-xTB runs cannot be imported (GFN2-xTB, GFN1-xTB and GFN-FF can)")
    sys.exit(1)
opt = bool(search(r"(^|\s)(--opt|--ohess|-o)(\s|$)", call))
hess = bool(search(r"(^|\s)(--hess|--ohess)(\s|$)", call))
runtype = "GeoVib" if opt and hess else "Geometry" if opt else "Vibration" if hess else "Energy"
m = search(r"(?:--opt|--ohess|-o)\s+(crude|sloppy|loose|normal|tight|vtight|verytight|extreme)\b", call)
level = m.group(1) if m else None
if level == "verytight":
    level = "vtight"
m = search(r"(?:--chrg|--charge|-c)\s+(-?\d+)", call)
charge = m.group(1) if m else "0"
m = search(r"(?:--uhf|-u)\s+(\d+)", call)
mult = number(m.group(1) if m else "0") + 1
model, solvent = None, None
raw_call = search(rb"^\s*program call\s*:\s*(.*)$", combined, re.M)
raw_call = raw_call.group(1) if raw_call else b""
m = search(rb"--alpb\s+(\S+)", raw_call)
g = search(rb"(?:--gbsa|-g)\s+(\S+)", raw_call)
# Perl's byte-oriented lc only changes ASCII letters.
if m:
    model, solvent = "ALPB", m.group(1).lower()
elif g:
    model, solvent = "GBSA", g.group(1).lower()
    solvent = {b"h2o": b"water", b"n-hexane": b"hexane"}.get(solvent, solvent)
dirname = "."
if os.path.islink(file):
    dirname = os.path.dirname(os.path.realpath(file))
elif len(args) > 1 and args[1]:
    dirname = args[1].rstrip("/")
if not search(r"^ECCE-XTB-FRAME\s", text, re.M):
    m = search(rb"^\s*coordinate file\s*:\s*(\S+)", combined, re.M)
    raw_coord = m.group(1) if m else b""
    coord = raw_coord.decode("utf-8", "replace")
    candidates = [dirname + "/xtbopt.log", dirname + "/xtbopt.xyz"] if opt else []
    if coord:
        candidates.append(dirname + "/" + coord)
    xyz = ""
    for candidate in candidates:
        if not nonempty(candidate):
            continue
        first = read(candidate)[0].split("\n")[0] + "\n"
        if search(r"^\s*(\d+)\s*$", first):
            xyz = candidate
            break
    if not xyz:
        # Keep the reported filename's original bytes in the diagnostic.
        message = ("No molecular geometry found for " + file + ": xtb prints none; put xtbopt.log (or the coordinate file ").encode("utf-8", "replace")
        sys.stdout.buffer.write(message + (raw_coord or b"of the run") + b") in the same directory\n")
        sys.exit(1)
    n, frame, left = 0, 0, 0
    frame_text = b""
    raw_lines = read(xyz)[1].split(b"\n")
    raw_lines = [line + b"\n" for line in raw_lines[:-1]] + ([raw_lines[-1]] if raw_lines[-1] else [])
    for raw_line in raw_lines:
        line = raw_line.decode("utf-8", "replace")
        if left == 0:
            if search(r"^\s*$", line):
                continue
            m = search(r"^\s*(\d+)", line)
            if not m:
                continue
            n = m.group(1)
            left = number(n) + 1
            frame += 1
            frame_text += "ECCE-XTB-FRAME {} {}\n".format(frame, n).encode("utf-8")
            continue
        frame_text += raw_line
        left -= 1
        if left == 0:
            frame_text += b"ECCE-XTB-ENDFRAME\n"
    if not combined.endswith(b"\n"):
        combined += b"\n"
    combined += frame_text
    molden = dirname + "/molden.input"
    if search(r"--molden", call) and theory != "GFN-FF" and nonempty(molden):
        s, raw = read(molden)
        m = search(r"\[Atoms\][^\n]*\n((?:\s*\S+\s+\d+\s+\d+\s+\S+\s+\S+\s+\S+\n)+)", s)
        count = m.group(1).count("\n") if m else 0
        if count == number(n):
            combined += b"ECCE-XTB-MOLDEN\n" + raw + (b"" if raw.endswith(b"\n") else b"\n") + b"ECCE-XTB-ENDMOLDEN\n"
    charges = dirname + "/charges"
    if nonempty(charges):
        s, raw = read(charges)
        if s.count("\n") == number(n):
            combined += b"ECCE-XTB-CHARGES\n" + raw + b"ECCE-XTB-ENDCHARGES\n"
    if hess:
        vs = dirname + "/vibspectrum"
        if nonempty(vs):
            s, raw = read(vs)
            modes = len(re.findall(r"^\s+\d+\s+\S*\s+-?\d+\.\d+\s+\d+\.\d+", s, re.ASCII | re.M))
            if modes == 3 * number(n):
                combined += b"ECCE-XTB-VIBSPECTRUM\n" + raw + b"ECCE-XTB-ENDVIBSPECTRUM\n"
        g98 = dirname + "/g98.out"
        if nonempty(g98):
            s, raw = read(g98)
            if search(r"Atom AN|Frequencies", s):
                combined += b"ECCE-XTB-G98\n" + raw + b"ECCE-XTB-ENDG98\n"
    os.unlink(file)
    with open(file, "wb") as stream:
        stream.write(combined)
text = combined.decode("utf-8", "replace")
atoms, current, inside, skip = [], [], False, False
for line in text.split("\n"):
    if search(r"^ECCE-XTB-FRAME\s", line):
        inside, current, skip = True, [], True
        continue
    if search(r"^ECCE-XTB-ENDFRAME", line):
        atoms, inside = current, False
        continue
    if not inside:
        continue
    if skip:
        skip = False
        continue
    m = search(r"^\s*([A-Za-z]{1,2})\s+(-?\d+\.\d+)\s+(-?\d+\.\d+)\s+(-?\d+\.\d+)\s*$", line)
    if m:
        current.append(m.groups())
if not atoms:
    print("No molecular geometry found in " + file)
    sys.exit(1)
root = re.sub(r"\.[^.]*$", "", file, flags=re.ASCII)
title = re.sub(r".*/", "", root, flags=re.ASCII)
params = [("title", title)]
if version is not None:
    params.append(("version", version))
params += [("Category", "SE"), ("Theory", theory), ("RunType", runtype),
           ("Charge", charge), ("ES.ChemSys.Multiplicity", "%.15g" % mult)]
if level is not None:
    params.append(("ES.Runtype.GeomOpt.Level", level))
if model is not None:
    params += [("ES.Theory.Solvent.Model", model), ("ES.Theory.Solvent.Name", solvent)]
with open(root + ".param", "wb") as stream:
    for key, value in params:
        raw_value = value if isinstance(value, bytes) else value.encode("utf-8", "replace")
        stream.write(key.encode("ascii") + b":\t" + raw_value + b"\n")
with open(root + ".frag", "w", encoding="utf-8", errors="replace", newline="") as stream:
    stream.write("title:\t{}\ntype:\tmolecule\ncharge:\t{}\nnum_atoms:\t{}\natom_info:\tsymbol cart\natom_list:\n".format(title, charge, len(atoms)))
    for atom in atoms:
        stream.write(" " + " ".join(atom) + "\n")
