#!/usr/bin/env python3
################################################################################
# Purpose:
# The maximum force a GROMACS minimisation ends with (#334), from the line
#     Maximum force     =  5.3351556e+02 on atom 74
# mdrun prints it once, at the end, so there is no per-step series.
################################################################################

import re
import sys
from xtb_parse import configure_streams

configure_streams()

for raw in sys.stdin.buffer:
    line = raw.decode("utf-8", "replace")
    if re.search(r"^Maximum force\s*=\s*(\S+)", line, re.ASCII):
        value = re.search(rb"^Maximum force\s*=\s*(\S+)", raw, re.ASCII).group(1)
        sys.stdout.buffer.write(b"key: FMAX\nsize:\n1\nvalues:\n " + value +
                                b"\nunits:\nkJ/mol/nm\nEND\n")
        break
