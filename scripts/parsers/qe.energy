#!/usr/bin/env perl
################################################################################
#
# Purpose:
# Extracts Quantum ESPRESSO's converged total energy into ECCE's TE
# property.  pw.x marks the converged value with a LEADING EXCLAMATION
# MARK, which is the whole reason this can be a separate parse entry from
# the per-iteration energies:
#
#   iteration:   "     total energy              =     -22.82070382 Ry"
#   converged:   "!    total energy              =     -22.82211442 Ry"
#
# So unlike ORCA and MOPAC -- where one marker phrase serves both purposes
# and CLAUDE.md's rule is to use a single combined entry emitting both
# keys -- QE really does have two textually distinct markers, and qe.desc
# uses two entries: [TE] here (anchored ^!) and [EWVEC] (anchored ^\s+)
# for the SCF trace.  The two Begin regexes cannot match the same physical
# line, which is what PDMatchBegin()'s first-match-wins behaviour requires.
#
# TEVEC (relax, vc-relax).  The ATOMIC_POSITIONS block pw.x prints after an
# SCF is the geometry of the NEXT SCF, so this script publishes the block
# (and cell) that qe.geomtrace / qe.latvec stashed, together with this
# energy: one TEVEC per GEOMTRACE frame, each its own.  The starting
# geometry has no block and is not a frame; the final block repeats the last
# frame and is never published.  md has its own vectors (qe.mdstep).
#
# UNITS: pw.x prints Rydberg.  EnergyConverter (src/util/units/
# EnergyConverter.C) knows kcal/Mole, kJoule/Mole, Hartree and eV -- there
# is NO Rydberg entry -- so the value is converted here, once, to Hartree
# (1 Ry = 0.5 Hartree exactly) which is what every other code's energy
# scripts emit.
#
################################################################################

$| = 1;

($key, $runtype, $ucCategory, $theory) = @ARGV;

$_ = <STDIN>;
my $ry;
if (/^!\s*total energy\s*=\s*(-?\d+\.?\d*([EeDd][-+]?\d+)?)/) {
  $ry = $1;
  $ry =~ s/[Dd]/E/;
}
exit(0) if (!defined($ry));

my $hartree = $ry * 0.5;
my $paired = "";
if ($runtype !~ /dynamics/i && -e "$key/qeStash.GEOMTRACE") {
  foreach my $name ("GEOMTRACE", "LATTICEVEC") {
    my $f = "$key/qeStash.$name";
    if (open(my $fh, "<", $f)) {
      local $/;
      $paired .= <$fh>;
      close($fh);
    }
    unlink($f);
  }
  $paired .= "key: TEVEC\nsize:\n1\nvalues:\n$hartree\nunits:\nHartree\nEND\n";
}
print $paired;

print "key: TE\n";
print "size:\n1\n";
print "values:\n$hartree\n";
print "units:\nHartree\n";
print "END\n";
exit(0);
