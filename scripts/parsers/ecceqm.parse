#!/usr/bin/env perl
################################################################################
#
# Purpose:
#   Turns one piece of ecce-qm's output into ECCE properties.  Every piece
#   identifies itself on its first line (ecceqm.desc feeds it from the Begin
#   line on), so this one script serves all the parse types.  The output
#   format is described in docs/qm/README.md.
#
#   MO columns arrive in ECCE's canonical order (atoms in input order, shells
#   of one atom stably sorted by angular momentum), which is what MOAOORDER
#   "angular-momentum" tells ECCE; the m-order within a shell is ECCE-QM.edml's
#   MOOrdering.
#
################################################################################

$| = 1;

my @lines = <STDIN>;
chomp(@lines);
my $first = shift(@lines);
exit(0) if (!defined($first));

sub scalarProp {
  my ($key, $value, $units) = @_;
  print "key: $key\nsize:\n1\nvalues:\n$value\n";
  print "units:\n$units\n" if (defined($units));
  print "END\n";
}

sub vectorProp {
  my ($key, $vals, $units) = @_;
  print "key: $key\nsize:\n", scalar(@$vals), "\nvalues:\n", join(" ", @$vals), "\n";
  print "units:\n$units\n" if (defined($units));
  print "END\n";
}

my %energyKey = (
  energy_total          => 'TE',
  energy_nuclear        => 'NNREPUL',
  energy_one_electron   => 'ONEELEC',
  energy_coulomb        => 'COULOMB',
  energy_exchange_hf    => 'EXCHANGE',
  energy_xc             => 'EXCORR',
);

if ($first =~ /^(energy_\w+)\s+(\S+)/ && exists($energyKey{$1})) {
  &scalarProp($energyKey{$1}, $2, "Hartree");
} elsif ($first =~ /^energy_step\s+(\S+)/) {
  &scalarProp("TEVEC", $1, "Hartree");
} elsif ($first =~ /^begin geometry\b/) {
  # index symbol x y z (angstrom): one geometry of the trace
  my (@rows, $labels);
  foreach my $l (@lines) {
    last if ($l =~ /^end\b/);
    my @f = split(' ', $l);
    next if (@f < 5);
    push(@rows, " $f[2] $f[3] $f[4]");
    $labels .= " $f[0]-$f[1]";
  }
  if (@rows) {
    print "key: GEOMTRACE\nsize:\n1 ", scalar(@rows), " 3\nrowlabels:\n$labels\n";
    print "columnlabels:\nX Y Z\nvalues:\n", join("\n", @rows), "\nunits:\nAngstrom\nEND\n";
  }
} elsif ($first =~ /^begin scan_table\b/) {
  # point value energy converged; the unit is in the header comment
  my (@c, @e);
  my $unit = ($first =~ /unit\s+bond|unit\s+angstrom/i) ? "Angstrom" : "Degree";
  foreach my $l (@lines) {
    last if ($l =~ /^end\b/);
    my @f = split(' ', $l);
    next if (@f < 3);
    push(@c, sprintf("%.5f", $f[1]));
    push(@e, $f[2]);
  }
  if (@c) {
    &vectorProp("SCANCOORD", \@c, $unit);
    &vectorProp("SCANENERGY", \@e, "Hartree");
  }
} elsif ($first =~ /^begin scan_geometry\b/) {
  my (@rows, $labels);
  foreach my $l (@lines) {
    last if ($l =~ /^end\b/);
    my @f = split(' ', $l);
    next if (@f < 5);
    push(@rows, " $f[2] $f[3] $f[4]");
    $labels .= " $f[0]-$f[1]";
  }
  if (@rows) {
    print "key: SCANGEOM\nsize:\n1 ", scalar(@rows), " 3\nrowlabels:\n$labels\n";
    print "columnlabels:\nX Y Z\nvalues:\n", join("\n", @rows), "\nunits:\nAngstrom\nEND\n";
  }
} elsif ($first =~ /^begin irc_table\b/) {
  # point s energy; the TS is the row with s = 0
  my (@c, @e);
  foreach my $l (@lines) {
    last if ($l =~ /^end\b/);
    my @f = split(' ', $l);
    next if (@f < 3);
    push(@c, $f[1]);
    push(@e, $f[2]);
  }
  if (@c > 1) {
    &vectorProp("IRCCOORD", \@c, "sqrt(amu)*bohr");
    &vectorProp("IRCENERGY", \@e, "Hartree");
  }
} elsif ($first =~ /^begin irc_geometry\b/) {
  my (@rows, $labels);
  foreach my $l (@lines) {
    last if ($l =~ /^end\b/);
    my @f = split(' ', $l);
    next if (@f < 5);
    push(@rows, " $f[2] $f[3] $f[4]");
    $labels .= " $f[0]-$f[1]";
  }
  if (@rows) {
    print "key: IRCGEOM\nsize:\n1 ", scalar(@rows), " 3\nrowlabels:\n$labels\n";
    print "columnlabels:\nX Y Z\nvalues:\n", join("\n", @rows), "\nunits:\nAngstrom\nEND\n";
  }
} elsif ($first =~ /^begin gradient\b/) {
  # index symbol dE/dx dE/dy dE/dz (hartree/bohr)
  my (@rows, @v);
  foreach my $l (@lines) {
    last if ($l =~ /^end\b/);
    my @f = split(' ', $l);
    next if (@f < 5);
    push(@rows, "$f[2] $f[3] $f[4]");
    push(@v, @f[2, 3, 4]);
  }
  if (@rows) {
    my $norm = 0;
    $norm += $_ * $_ foreach (@v);
    &scalarProp("EGRAD", sprintf("%.10f", sqrt($norm)), "Hartree/Bohr");
    print "key: EGRADVEC\nsize:\n", scalar(@rows), " 3\nrowlabels:\n";
    print join(" ", 1 .. scalar(@rows)), "\ncolumnlabels:\nX Y Z\nvalues:\n", join("\n", @rows), "\n";
    print "units:\nHartree/Bohr\nEND\n";
  }
} elsif ($first =~ /^(zero_point_energy|thermal_energy|enthalpy|entropy_ts|gibbs_energy)\s+(\S+)/) {
  my %k = (zero_point_energy => 'EZEROPT', thermal_energy => 'ETHERM', enthalpy => 'ENTHALPY',
           entropy_ts => 'ENTROPY', gibbs_energy => 'EGIBBS');
  &scalarProp($k{$1}, $2, "Hartree");
} elsif ($first =~ /^thermo_temperature\s+(\S+)/) {
  &scalarProp('THERMOTEMP', sprintf("%.2f", $1), "Kelvin");
} elsif ($first =~ /^thermo_pressure_atm\s+(\S+)/) {
  &scalarProp('THERMOPRES', sprintf("%.5g", $1), "atm");
} elsif ($first =~ /^begin vibrations\b/) {
  # index frequency(cm-1) ir(km/mol), every mode of the 3N, translations and
  # rotations first with 0 (the rows of VIBFREQ, VIBIR and VIB line up)
  my (@f, @ir);
  foreach my $l (@lines) {
    last if ($l =~ /^end\b/);
    my @c = split(' ', $l);
    next if (@c < 3);
    push(@f, $c[1]);
    push(@ir, $c[2]);
  }
  if (@f) {
    my $n = scalar(@f);
    my $labels = join(" ", 1 .. $n);
    print "key: VIBFREQ\nsize:\n$n\nrowlabels:\n$labels\nvalues:\n", join(" ", @f), "\nunits:\ncm-1\nEND\n";
    print "key: VIBIR\nsize:\n$n\nrowlabels:\n$labels\nvalues:\n", join(" ", @ir), "\nunits:\nKM/Mole\nEND\n";
  }
} elsif ($first =~ /^begin raman\b/) {
  # index activity depolarization_ratio, rows as in the vibrations block
  my (@act, @dep);
  foreach my $l (@lines) {
    last if ($l =~ /^end\b/);
    my @c = split(' ', $l);
    next if (@c < 3);
    push(@act, $c[1]);
    push(@dep, $c[2]);
  }
  if (@act) {
    my $n = scalar(@act);
    my $labels = join(" ", 1 .. $n);
    print "key: VIBRAM\nsize:\n$n\nrowlabels:\n$labels\nvalues:\n", join(" ", @act), "\nunits:\nA**4/AMU\nEND\n";
    print "key: VIBRAMDEPOL\nsize:\n$n\nrowlabels:\n$labels\nvalues:\n", join(" ", @dep), "\nunits:\nNA\nEND\n";
  }
} elsif ($first =~ /^begin polarizability\b/) {
  # three rows of the symmetric tensor; POLARIZ holds XX XY XZ YY YZ ZZ
  my @t;
  foreach my $l (@lines) {
    last if ($l =~ /^end\b/);
    my @c = split(' ', $l);
    push(@t, [@c]) if (@c == 3);
  }
  if (@t == 3) {
    my @v = ($t[0][0], $t[0][1], $t[0][2], $t[1][1], $t[1][2], $t[2][2]);
    print "key: POLARIZ\nsize:\n6\nrowlabels:\nXX XY XZ YY YZ ZZ\nvalues:\n", join(" ", @v), "\nEND\n";
  }
} elsif ($first =~ /^begin normal_modes\b/) {
  # index then x y z per atom: one Cartesian displacement vector per mode
  my @modes;
  foreach my $l (@lines) {
    last if ($l =~ /^end\b/);
    my @c = split(' ', $l);
    shift(@c);
    push(@modes, [@c]) if (@c);
  }
  if (@modes) {
    my $nm = scalar(@modes);
    my $na = scalar(@{$modes[0]}) / 3;
    print "key: VIB\nsize:\n$nm $na 3\nvectorlabels:\n", join(" ", ("NA") x $nm), "\nrowlabels:\n";
    print join(" ", 1 .. $na), "\ncolumnlabels:\nX Y Z\nvalues:\n";
    foreach my $m (@modes) {
      for my $a (0 .. $na - 1) {
        print join(" ", @{$m}[3 * $a .. 3 * $a + 2]), "\n";
      }
    }
    print "units:\nAngstrom\nEND\n";
  }
} elsif ($first =~ /^s_squared\s+(\S+)/) {
  &scalarProp("S2", $1);
} elsif ($first =~ /^wall_seconds\s+(\S+)/) {
  &scalarProp("ETIME", $1);
} elsif ($first =~ /^dipole_debye\s+(\S+)\s+(\S+)\s+(\S+)/) {
  print "key: DIPOLE\nsize:\n3\nrowlabels:\nX Y Z\nvalues:\n$1 $2 $3\nunits:\nDebye\nEND\n";
} elsif ($first =~ /^begin atoms\b/) {
  # index symbol Z x y z mulliken_net_charge
  my @q;
  foreach my $l (@lines) {
    last if ($l =~ /^end\b/);
    my @f = split(' ', $l);
    push(@q, $f[6]) if (@f >= 7);
  }
  &vectorProp("MULLIKEN", \@q, "e") if (@q);
} elsif ($first =~ /^begin charges\s+(\w+)/) {
  # index symbol net_charge; one block per scheme asked for with "charges"
  my %key = ("loewdin" => "LOEWDIN", "chelpg" => "ESPFIT", "mk" => "MKFIT");
  my @q;
  foreach my $l (@lines) {
    last if ($l =~ /^end\b/);
    my @f = split(' ', $l);
    push(@q, $f[2]) if (@f >= 3);
  }
  &vectorProp($key{$1}, \@q, "e") if (@q && $key{$1});
} elsif ($first =~ /^begin localised_orbitals\s+(\w+)/) {
  my $lspin = ($1 eq 'beta') ? 'BETA' : '';
  # index energy occupation label...; the label's spaces become "_" because a
  # string vector is stored whitespace separated (the MO panel turns them back)
  my (@en, @occ, @lab);
  foreach my $l (@lines) {
    last if ($l =~ /^end\b/);
    my @f = split(' ', $l);
    next if (@f < 4);
    push(@en, $f[1]);
    push(@occ, $f[2]);
    push(@lab, join("_", @f[3 .. $#f]));
  }
  if (@en) {
    &vectorProp("LOCMOENG$lspin", \@en, "Hartree");
    &vectorProp("LOCMOOCC$lspin", \@occ, "electrons");
    print "key: LOCMOLABEL$lspin\nsize:\n", scalar(@lab), "\nrowlabels:\n";
    print join(" ", 1 .. scalar(@lab)), "\nvalues:\n", join(" ", @lab), "\nEND\n";
  }
} elsif ($first =~ /^virtual_orbitals(?:_note)?\s+(.*\S)/) {
  # "ivo", or why improved virtuals were asked for but not made
  my $v = join("_", split(' ', $1));
  print "key: MOVIRTNOTE\nsize:\n1\nrowlabels:\n1\nvalues:\n$v\nEND\n";
} elsif ($first =~ /^localisation_skipped\s+(.*\S)/) {
  # why no localised set was written; spaces become "_" as in the labels
  my $why = join("_", split(' ', $1));
  print "key: LOCMONOTE\nsize:\n1\nrowlabels:\n1\nvalues:\n$why\nEND\n";
} elsif ($first =~ /^begin localised_mo_coefficients\s+(\w+)/) {
  my $lkey = ($1 eq 'beta') ? 'LOCMOBETA' : 'LOCMO';
  my @rows;
  foreach my $l (@lines) {
    last if ($l =~ /^end\b/);
    my @f = split(' ', $l);
    shift(@f);
    push(@rows, [@f]) if (@f);
  }
  exit(0) if (!@rows);
  my $nmo = scalar(@rows);
  my $nbas = scalar(@{$rows[0]});
  print "key: $lkey\nsize:\n$nmo $nbas\nrowlabels:\n";
  for my $m (1 .. $nmo) {
    print "LMO-$m ";
    print "\n" if (($m % 8) == 0);
  }
  print "\ncolumnlabels:\n";
  for my $b (1 .. $nbas) {
    print "BasFun-$b ";
    print "\n" if (($b % 6) == 0);
  }
  print "\nvalues:\n";
  foreach my $r (@rows) {
    print join(" ", @$r), "\n";
  }
  print "END\n";
} elsif ($first =~ /^begin orbitals\s+(\w+)/) {
  my $spin = $1;
  my (@en, @occ);
  foreach my $l (@lines) {
    last if ($l =~ /^end\b/);
    my @f = split(' ', $l);
    next if (@f < 3);
    push(@en, $f[1]);
    push(@occ, $f[2]);
  }
  my ($e, $o) = ($spin eq 'beta') ? ('ORBENGBETA', 'ORBOCCBETA') : ('ORBENG', 'ORBOCC');
  if (@en) {
    &vectorProp($e, \@en, "Hartree");
    &vectorProp($o, \@occ, "electrons");
  }
} elsif ($first =~ /^begin mo_coefficients\s+(\w+)/) {
  my $spin = $1;
  my @rows;
  foreach my $l (@lines) {
    last if ($l =~ /^end\b/);
    my @f = split(' ', $l);
    shift(@f);
    push(@rows, [@f]) if (@f);
  }
  exit(0) if (!@rows);
  my $nmo = scalar(@rows);
  my $nbas = scalar(@{$rows[0]});
  my $key = ($spin eq 'beta') ? 'MOBETA' : 'MO';
  print "key: $key\nsize:\n$nmo $nbas\nrowlabels:\n";
  for my $m (1 .. $nmo) {
    print "MO-$m ";
    print "\n" if (($m % 8) == 0);
  }
  print "\ncolumnlabels:\n";
  for my $b (1 .. $nbas) {
    print "BasFun-$b ";
    print "\n" if (($b % 6) == 0);
  }
  print "\nvalues:\n";
  foreach my $r (@rows) {
    print join(" ", @$r), "\n";
  }
  print "END\n";
  if ($spin ne 'beta') {
    print "key: MOAOORDER\nsize:\n1\nvalues:\nangular-momentum\nEND\n";
  }
}
exit(0);
