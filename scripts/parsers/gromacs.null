#!/usr/bin/env perl
###############################################################################
#
# Name:   $Source$
#
#
# Purpose:
# This script ignores all input. It is used to skip over redundant output
# in the end-of-run AVERAGES summary, whose energy block is
# byte-identical to a real step's and must not be parsed as one.
# See gromacs.desc.
#
##############################################################################

# Force output to be flushed
$| = 1;

######
# The command line arguments
######
($key, $runtype, $ucCategory, $theory) = @ARGV;

exit(0);
