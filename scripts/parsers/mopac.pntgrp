#!/usr/bin/env python3
################################################################################
#
# Purpose:
# Extracts the point group from MOPAC's "MOLECULAR POINT GROUP : <PG>"
# line into ECCE's PNTGRP property (a PropTSVecString).  Modeled on
# orca.pntgrp / gaussian-16.symmetry for the output shape.
#
# Sample input line, verified against real MOPAC 23.1.2 output (note the
# trailing whitespace MOPAC pads the label with):
#       MOLECULAR POINT GROUP   :   C2v
#
################################################################################

import re
import sys
from xtb_parse import configure_streams

configure_streams()

# Labels are opaque bytes in Perl, including malformed UTF-8. Match the raw
# record so publishing a label cannot replace bytes in the user's output.
match = re.search(rb"MOLECULAR POINT GROUP\s*:\s*(\S+)", sys.stdin.buffer.readline(), re.ASCII)
label = match.group(1) if match else b"C1"
sys.stdout.buffer.write(b"key: PNTGRP\nsize: \n1\nvalues: \n" + label + b"\nEND\n")
