#!/usr/bin/env python3
import re
import sys
from xtb_parse import configure_streams, scalar

configure_streams()
for line in sys.stdin:
    m = re.search(r"^\s*full:\s+(-?\d+\.\d+)\s+(-?\d+\.\d+)\s+(-?\d+\.\d+)\s+\d",
                  line, re.ASCII)
    if m:
        print("key: DIPOLE\nsize:\n3\nrowlabels:\nX Y Z\nvalues:\n{}\nunits:\nDebye\nEND".format(
            " ".join(m.groups())))
        break
