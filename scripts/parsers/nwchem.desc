[CORRELTN]
Script=nwchem.scalar
# mp2/dft tag this "correlation energy"; the ccsd module tags its own as
# "ccsd correlation energy", so a plain "task ccsd(t)" job used to yield
# no Correlation Energy at all.  With the alternation a combined
# mp2-then-ccsd job matches twice and, Frequency=all being an overwriting
# scalar, ends up holding the CCSD value -- the later task's.
Begin=begin%(?:ccsd )?correlation energy
Frequency=all
Lines=2
[END]

