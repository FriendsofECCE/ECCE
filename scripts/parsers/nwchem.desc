# Thermochemistry, COSMO solvation and the correlated energies of a TCE job
# (open-shell coupled cluster) exist only in NWChem's stdout (the primary
# output file), not in the ecce_print trace, hence a File= entry.  eccejobmonitor
# allows one parse type per File=, so one script reads all of it.
[EZEROPT][ETHERM][ENTHALPY][ENTROPY][EGIBBS][THERMOTEMP][ESOLV][SOLVMODEL][ECCSD][EMP2][ECCSDTPERT][ECCSDTPERT2][CORRELTN]
Script=nwchem.thermo
File=nwch.nwout
Begin=nwch.nwout
[END]

[MULLIKEN]
Script=nwchem.mulliken
Begin=begin%total mulliken atomic
Frequency=last
End=task
[END]

[MLKNSHELL]
Script=nwchem.mlknshell
Begin=begin%total mulliken shell
Frequency=last
End=task
[END]

[TEPROP]
Script=nwchem.te
Begin=^task_energy%begin%total energy
Frequency=last
End=task
[END]

[TEVEC]
Script=nwchem.te
Begin=task_gradient%begin%total energy
Frequency=all
End=task
[END]

[EMP2]
Script=nwchem.emp2
Begin=ccsd%begin%mp2 energy
Frequency=all
End=task
[END]

[ECCSD]
Script=nwchem.emp2
Begin=ccsd%begin%total ccsd energy
Frequency=all
End=task
[END]

[ECCSDTPERT]
Script=nwchem.emp2
Begin=ccsd%begin%total ccsd\(t\)
Frequency=all
End=task
[END]

[ECCSDTPERT2]
Script=nwchem.emp2
Begin=ccsd%begin%total ccsd\+t\(ccsd\)
Frequency=all
End=task
[END]

[DELTAE]
Script=nwchem.scalar
Begin=begin%iterative total energy difference
Frequency=all
Lines=2
[END]

[RESIDNORM]
Script=nwchem.scalar
# NWChem 7.2.3 tags this "ccsd rms error"; "rms error" on its own is not
# emitted by any module (verified against the tag strings in the 7.2.3
# binary), so the bare Begin could never match and the Residual Norm
# property was silently never extracted.  Alternation rather than
# replacement, in case an older/other module does use the short form.
Begin=begin%(?:ccsd )?rms error
Frequency=all
Lines=2
[END]

