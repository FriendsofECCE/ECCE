# parse Descriptor for NWCHEM output file
#
# Due to the way nwchem outputs U* theory mos, and the fact that we
# want to only parse the last one, the mo-related parsing is a little
# messy.  A separate entry is required for alpha and beta properties.
# This applies to MO MOBETA ORBOCC ORBOCCBETA...
# Symmetry has been included.
#

[EGRADVEC]
Script=nwchem.egradvec
Begin=task_gradient%begin%total gradient
Frequency=all
End=task
[END]

[EGRAD]
Script=nwchem.scalar
Begin=task_gradient%begin%gradient norm
Frequency=all
Lines=2
[END]

# DEWVEC is "Orbital Gradient Norm", a PropTSVector<Wave Step> -- the SCF
# convergence trace.
#
# The Begin used to be "task_gradient%begin%orbital gradient norm", which
# matches nothing NWChem emits and so this property was never extracted,
# for any job, ever.  The orbital gradient norm comes from the SCF module
# rather than from the task, so the real tag always carries the module
# between the task and %begin%:
#
#   task_gradient scf%begin%orbital gradient norm%1%double
#   task_energy scf%begin%orbital gradient norm%1%double
#   task_optimize driver task_energy scf%begin%orbital gradient norm%1%double
#
# whereas its siblings above (total gradient, gradient norm) are genuinely
# task-level and really do read "task_gradient%begin%...".  Anchoring on
# "scf%begin%" instead picks up every conventional-SCF task -- energy,
# gradient, optimize, frequencies, mp2 -- and cannot collide with
# [OGRADNORMCPVEC] below, whose Car-Parrinello tag
# ("task_car-parrinello%begin%orbital gradient norm") has no module at all.
# That matters for more than tidiness: PDMatchBegin() returns the first
# parse type whose Begin matches a line and never checks the rest, so two
# entries able to match one line would permanently starve one of them.
#
# DFT jobs emit no orbital gradient norm at all (confirmed against
# oh_udft), so there is no dft-module variant to cover.
[DEWVEC]
Script=nwchem.scalar
Begin=scf%begin%orbital gradient norm
Frequency=all
Lines=2
[END]

# A frequency-only run has no gradient task, so this is its only geometry:
# NWChem prints the modes in the frame autosym moved the molecule into, and
# the viewer must draw them on those coordinates. nwchem.geomtrace drops it
# for Geometry/GeoVib, where the gradient blocks already hold the trace.
[GEOMHESS]
Script=nwchem.geomtrace
Begin=task_hessian task_energy%begin%cartesian coordinates
Frequency=last
End=task
[END]

[GEOMPROP]
Script=nwchem.geomtrace
Begin=^task_energy%begin%cartesian coordinates
Frequency=last
End=task
[END]

[GEOMCAR]
Script=nwchem.geomtrace
Begin=task_car-parrinello%begin%cartesian coordinates
Frequency=all
End=task
[END]

[GEOMTRACE]
Script=nwchem.geomtrace
Begin=task_gradient%begin%cartesian coordinates
Frequency=all
End=task
[END]

[LATVECNULL]
Script=nwchem.null
Begin=task_hessian task_energy%begin%lattice vectors
Frequency=last
End=task
[END]

[LATVECPROP]
Script=nwchem.latvec
Begin=^task_energy%begin%lattice vectors
Frequency=last
End=task
[END]

[LATVECTRACE]
Script=nwchem.latvec
Begin=task_gradient%begin%lattice vectors
Frequency=all
End=task
[END]

# Car-Parrinello emits its own per-step lattice vectors, and until this
# entry existed nothing matched them: a real CP run's ecce_print trace
# carries one "lattice vectors" block per step (5 in the checked-in
# fixture) and LATTICEVEC never appeared, making nwchem.latvec's CP
# branch dead code and discarding the per-step cell for every CP run.
# Found while analysing the plane-wave path for docs/QE_ROADMAP.md.
#
# Worth having rather than tidiness: GTStepCmd.C already assigns a
# per-step 3x3 cell from LATTICEVEC and GeomTracePropertyPanel already
# plots alongside a geometry trace, so ECCE can already animate a
# variable-cell trajectory and simply had no producer for one.
#
# The Begin cannot collide with the three entries above: they are
# prefixed task_hessian/task_energy/task_gradient, this one
# task_car-parrinello. Same script and same emitted key (LATTICEVEC) as
# LATVECTRACE -- only the task tag differs.
[LATVECCPTRACE]
Script=nwchem.latvec
Begin=task_car-parrinello%begin%lattice vectors
Frequency=all
End=task
[END]

