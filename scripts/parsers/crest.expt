#!/usr/bin/env python3
###############################################################################
# FILENAME:  crest.expt
#
# SYNTAX: crest.expt <outfile> [<sourcedir>]
#
# PURPOSE:
#       Reads the output of a CREST run and writes the ECCE .frag/.param pair,
#       so it can be imported as a completed calculation.
#
#       The settings come from CREST's "Command line input" line.  The
#       ensemble is in the output only as the ECCE-CREST-FRAME blocks the
#       job script appends, so an output without them is refused.  The
#       calculation's structure is its input molecule (a protonation or QCG
#       ensemble has other atoms), read from the deck or crest.xyz next to
#       the output; a conformer search without one uses its lowest conformer.
###############################################################################
import os
import re
import sys
from xtb_parse import configure_streams, number, options

configure_streams()


def search(pattern, text, flags=0):
    return re.search(pattern, text, re.ASCII | flags)


def read(path):
    with open(path, encoding="utf-8", errors="replace", newline="") as stream:
        text = stream.read()
    with open(path, "rb") as stream:
        raw = stream.read()
    return text, raw


def usage():
    print("Usage: crest.expt <outfile> [<sourcedir>]\nOptions:    -h        this help\n            -v        version")
    sys.exit(0)


opts, args = options(":hv", sys.argv[1:])
if "h" in opts:
    usage()
if "v" in opts:
    sys.exit(0)
if len(args) not in (1, 2):
    usage()
file = args[0]
try:
    text, raw = read(file)
except OSError as exc:
    sys.stderr.write("Can't locate output file {} at {} line 29.\n".format(file, sys.argv[0]))
    sys.exit(exc.errno or 255)
if not search(r"Conformer-Rotamer Ensemble Sampling Tool", text):
    print(file + " is not a CREST output")
    sys.exit(1)
if not search(r"^ECCE-CREST-FRAME\s", text, re.M):
    print(file + " has no ensemble: CREST writes it to a separate file, which ECCE appends to the outputs of the runs it launches")
    sys.exit(1)
m = search(r"^\s*Command line input:\s*\n\s*\$\s*(.*)$", text, re.M)
call = m.group(1) if m else ""
m = search(r"Version\s+(\d[\w.]*)", text)
version = m.group(1) if m else None
theory = "GFN2-xTB"
if search(r"--gfnff(\s|$)", call):
    theory = "GFN-FF"
if search(r"--gfn2//gfnff", call):
    theory = "GFN2//GFN-FF"
runtype = "Conformer Search"
if search(r"--protonate(\s|$)", call):
    runtype = "Protonation Sites"
if search(r"--tautomeri[sz]e(\s|$)", call):
    runtype = "Tautomers"
if search(r"--qcg(\s|$)", call):
    runtype = "Solvation Shell"
m = search(r"--chrg\s+(-?\d+)", call)
charge = m.group(1) if m else "0"
m = search(r"--uhf\s+(\d+)", call)
mult = number(m.group(1) if m else "0") + 1
model, solvent = None, None
# Solvent names are free text: Perl's byte-oriented lc changes ASCII only.
m = search(rb"^\s*Command line input:\s*\n\s*\$\s*(.*)$", raw, re.M)
raw_call = m.group(1) if m else b""
m = search(rb"--alpb\s+(\S+)", raw_call)
g = search(rb"--gbsa\s+(\S+)", raw_call)
if m:
    model, solvent = "ALPB", m.group(1).lower()
elif g:
    model, solvent = "GBSA", g.group(1).lower()
    solvent = {b"h2o": b"water", b"n-hexane": b"hexane"}.get(solvent, solvent)
m = search(r"--ewin\s+(\d*\.?\d+)", call)
ewin = m.group(1) if m else None
m = search(r"--nsolv\s+(\d+)", call)
nsolv = m.group(1) if m else None
noreftopo = search(r"--noreftopo(\s|$)", call)
notopo = search(r"--notopo(\s|$)", call)

# --- the input molecule ------------------------------------------------------
dirname = "."
if os.path.islink(file):
    dirname = os.path.dirname(os.path.realpath(file))
elif len(args) > 1 and args[1]:
    dirname = args[1].rstrip("/")
stem = re.sub(r".*/", "", file, flags=re.ASCII)
stem = re.sub(r"\.[^.]*$", "", stem, flags=re.ASCII)
atoms = []
for candidate in (dirname + "/" + stem + ".crestin", dirname + "/crest.crestin", dirname + "/crest.xyz"):
    try:
        if os.path.getsize(candidate) == 0:
            continue
        x = read(candidate)[0]
    except OSError:
        continue
    lines = x.split("\n")
    lines = [line + "\n" for line in lines[:-1]] + ([lines[-1]] if lines[-1] else [])
    # a deck: line 1 is the option line, then any $solvent block
    if search(r"\.crestin$", candidate):
        lines = lines[1:]
        if lines and search(r"^\s*\$solvent", lines[0]):
            while lines and not search(r"^\s*\$end", lines[0]):
                lines.pop(0)
            lines = lines[1:]
    m = search(r"^\s*(\d+)\s*$", lines[0]) if len(lines) >= 2 else None
    if not m:
        continue
    n = number(m.group(1), integer=True)
    for line in lines[2:2+n]:
        m = search(r"^\s*([A-Za-z]{1,2})\s+(-?\d+\.?\d*)\s+(-?\d+\.?\d*)\s+(-?\d+\.?\d*)", line)
        if m:
            atoms.append(m.groups())
    if len(atoms) == n:
        break
    atoms = []
if not atoms and runtype == "Conformer Search":
    m = search(r"^ECCE-CREST-FRAME 1 (\d+)\n[^\n]*\n((?:[^\n]*\n)*?)ECCE-CREST-ENDFRAME", text, re.M)
    if m:
        for line in m.group(2).split("\n"):
            m = search(r"^\s*([A-Za-z]{1,2})\s+(-?\d+\.\d+)\s+(-?\d+\.\d+)\s+(-?\d+\.\d+)", line)
            if m:
                atoms.append(m.groups())
if not atoms:
    print("No input molecule found for {}: put the deck ({}.crestin) or crest.xyz in the same directory".format(file, stem))
    sys.exit(1)
root = re.sub(r"\.[^.]*$", "", file, flags=re.ASCII)
title = re.sub(r".*/", "", root, flags=re.ASCII)
params = [("title", title)]
if version is not None:
    params.append(("version", version))
params += [("Category", "SE"), ("Theory", theory), ("RunType", runtype),
           ("Charge", charge), ("ES.ChemSys.Multiplicity", "%.15g" % mult)]
if model is not None:
    params += [("ES.Theory.Solvent.Model", model), ("ES.Theory.Solvent.Name", solvent)]
if ewin is not None:
    key = "ES.Runtype.Sites.EnergyWindow" if runtype in ("Protonation Sites", "Tautomers") else "ES.Runtype.Conformers.EnergyWindow"
    params.append((key, ewin))
if runtype == "Conformer Search":
    if noreftopo:
        params.append(("ES.Runtype.Conformers.NoRefTopo", "1"))
    if notopo:
        params.append(("ES.Runtype.Conformers.NoTopo", "1"))
if runtype == "Solvation Shell":
    if nsolv is not None:
        params.append(("ES.Runtype.QCG.Number", nsolv))
    params.append(("ES.Runtype.QCG.Solvent", solvent if solvent is not None else b"water"))
with open(root + ".param", "wb") as stream:
    for key, value in params:
        value = value if isinstance(value, bytes) else value.encode("utf-8", "replace")
        stream.write(key.encode("ascii") + b":\t" + value + b"\n")
with open(root + ".frag", "w", encoding="utf-8", errors="replace", newline="") as stream:
    stream.write("title:\t{}\ntype:\tmolecule\ncharge:\t{}\nnum_atoms:\t{}\natom_info:\tsymbol cart\natom_list:\n".format(title, charge, len(atoms)))
    for atom in atoms:
        stream.write(" {} {}\n".format(atom[0].capitalize(), " ".join(atom[1:])))
