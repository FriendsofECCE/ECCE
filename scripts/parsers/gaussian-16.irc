#!/usr/bin/env perl
# IRC (#417): energy and reaction coordinate of every path point, from
# "Summary of reaction path following".  The block lists energies relative to
# the TS; the TS energy itself is in the line before it, so the stored
# energies are absolute and the panel can show either.
#
# The live points (gaussian-16.ircgeom, #948) are in run order with one
# IRCGEOM frame each, and frames cannot be replaced; so the summary's values
# go out in that same order, each row matched to the live point of the same
# coordinate.  If the two do not match one to one, the live series stays.
$| = 1;
($key, $runtype) = @ARGV;
exit(0) unless ($runtype =~ /IRC/i);

my ($ts, $inTable, @e, @x);
while (<STDIN>) {
  if (/relative to the TS energy of\s+(-?\d+\.\d+)/) { $ts = $1; next; }
  if (/RxCoord/) { $inTable = 1; next; }
  next unless $inTable;
  if (/^\s+\d+\s+(-?\d+\.\d+)\s+(-?\d+\.\d+)\s*$/) { push(@e, $1); push(@x, $2); }
}
exit(0) unless (defined $ts && @e > 1);

my @live = map { (split)[0] } readLines("$key/g16IrcPoints");
my @order;
if (@live) {
  exit(0) unless (@live == @x);
  my %used;
  foreach my $c (@live) {
    my ($best) = sort { abs($x[$a] - $c) <=> abs($x[$b] - $c) }
                 grep { !$used{$_} } 0 .. $#x;
    exit(0) if (abs($x[$best] - $c) > 1e-4);
    $used{$best} = 1;
    push(@order, $best);
  }
} else {
  @order = 0 .. $#x;
}

my $n = scalar(@order);
print "key: IRCCOORD\nsize: \n$n\nvalues: \n", join("\n", map { $x[$_] } @order),
      "\nunits:\nsqrt(amu)*bohr\nEND\n";
print "key: IRCENERGY\nsize: \n$n\nvalues: \n",
      join("\n", map { sprintf("%.6f", $ts + $e[$_]) } @order), "\nunits:\nHartree\nEND\n";
exit(0);

sub readLines {
  my @l;
  if (open(my $fh, "<", $_[0])) { @l = <$fh>; close($fh); chomp @l; }
  return grep { length } @l;
}
