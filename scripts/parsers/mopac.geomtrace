#!/usr/bin/env python3
################################################################################
#
# Purpose:
# Extracts one "CARTESIAN COORDINATES" block from MOPAC output into
# ECCE's standard GEOMTRACE table format.
#
# MOPAC prints this table in TWO different layouts and mopac.desc feeds
# both to this script (Skip cannot land on the first data row of both):
#
#   the 4-decimal input echo, with an extra sub-header line --
#        NO.       ATOM           X           Y           Z
#         1         O          0.0000      0.0000      0.1173
#
#   and the 9-decimal final geometry, with none --
#      1    O        0.000000000     0.000000000     0.117300000
#
# Both data rows have the same token shape (index, symbol, x, y, z), so
# one regex covers them; non-matching lines (blanks, the sub-header) are
# SKIPPED rather than treated as end-of-block.  Stopping at the first
# non-matching line -- the natural pattern, and what orca.geomtrace does
# -- would silently produce zero output for the echo layout.
#
################################################################################

import re
import sys
import os
from xtb_parse import configure_streams

configure_streams()

coords, symbols = [], []
for line in sys.stdin:
    match = re.search(r"^\s*\d+\s+([A-Za-z]{1,2})\s+(-?\d+\.\d+)\s+(-?\d+\.\d+)\s+(-?\d+\.\d+)\s*$", line, re.ASCII)
    if match:
        symbols.append(match.group(1))
        coords.append(" ".join(match.groups()[1:]))
if coords:
    labels = "".join(" {}-{}".format(i + 1, symbol) for i, symbol in enumerate(symbols))
    print("key: GEOMTRACE\nsize:\n1 {} 3\nrowlabels:\n{}\ncolumnlabels:\nX Y Z\nvalues:".format(
        len(coords), labels))
    for row in coords:
        print(" " + row)
    print("units:\nAngstrom\nEND")

    # mopac.vib rotates a FORCE run's modes back into this frame; the latest
    # block before the force orientation is the one it needs.
    try:
        with open(os.path.join(sys.argv[1], "mopacInputGeom"), "w",
                  encoding="utf-8", errors="replace", newline="\n") as stream:
            for symbol, row in zip(symbols, coords):
                stream.write(symbol + " " + row + "\n")
    except OSError:
        pass
