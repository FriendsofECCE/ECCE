#!/usr/bin/env python3
# Attractor-to-nucleus rows in section I select atoms; section III has charges.
# Non-nuclear maxima are left out, and attractor order is atom order.
import re
import sys

from atomcharges import emit_charges

charges = {}
order = []
# The Perl read job output as bytes; a stray byte must not crash the parse.
sys.stdin.reconfigure(encoding="utf-8", errors="replace")
for line in sys.stdin:
    nucleus = re.match(r"^\s*(\d+)\s+-?\d+\.\d+\s+-?\d+\.\d+\s+-?\d+\.\d+\s+[A-Za-z]{1,2}\s+\(", line)
    if nucleus:
        order.append(nucleus[1])
    else:
        charge = re.match(r"^\s*(\d+)\s+\d+\.\d+\s+-?\d+\.\d+\s+(-?\d+\.\d+)\s*$", line)
        if charge:
            charges[charge[1]] = charge[2]

values = [charges[index] for index in order if index in charges]
if len(values) == len(order):
    emit_charges("AIM", values)
