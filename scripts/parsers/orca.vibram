#!/usr/bin/env perl
################################################################################
#
# Purpose:
# Extracts Raman activities (and depolarization ratios) from ORCA's
# "RAMAN SPECTRUM" block into ECCE's VIBRAM/VIBRAMDEPOL properties
# (PropVectors). Modeled directly on orca.vibir: like IR SPECTRUM, RAMAN
# SPECTRUM only lists the real vibrational modes (typically starting at
# mode 6 for a nonlinear molecule), so the leading translation/rotation
# modes are padded with 0.0 to keep VIBRAM/VIBRAMDEPOL the same length
# and row-aligned with VIBFREQ (NModePanel indexes PropVectors by row,
# not by a shared mode-number column).
#
# Sample input lines (real ORCA 6.1.1 output, issue #173):
#  Mode    freq (cm**-1)   Activity   Depolarization
# -------------------------------------------------------------------
#    6:      1789.30      5.573684      0.530134
#    7:      3978.84     73.133864      0.169961
#
################################################################################

$| = 1;

($key, $runtype, $ucCategory, $theory) = @ARGV;

my %activity;
my %depol;
my $maxmode = -1;
while (<STDIN>) {
  if (/^\s*(\d+):\s+(-?\d+\.\d+)\s+(-?\d+\.\d+)\s+(-?\d+\.\d+)/) {
    my ($mode, $act, $dep) = ($1, $3, $4);
    $activity{$mode} = $act;
    $depol{$mode} = $dep;
    $maxmode = $mode if ($mode > $maxmode);
  } else {
    last;
  }
}

my $nfrequencies = $maxmode + 1;
exit(0) if ($nfrequencies < 1);

print "key: VIBRAM\n";
print "size:\n$nfrequencies\n";
print "rowlabels:\n";
foreach my $i (1 .. $nfrequencies) {
  print " $i ";
  print "\n" if (($i % 10) == 0);
}
print "\n" if (($nfrequencies % 10) != 0);
print "values:\n";
foreach my $i (0 .. $nfrequencies - 1) {
  my $val = exists($activity{$i}) ? $activity{$i} : 0.0;
  print " $val";
  print "\n" if ((($i+1) % 10) == 0);
}
print "\n" if (($nfrequencies % 10) != 0);
print "units:\nA**4/AMU\n";
print "END\n";

print "key: VIBRAMDEPOL\n";
print "size:\n$nfrequencies\n";
print "rowlabels:\n";
foreach my $i (1 .. $nfrequencies) {
  print " $i ";
  print "\n" if (($i % 10) == 0);
}
print "\n" if (($nfrequencies % 10) != 0);
print "values:\n";
foreach my $i (0 .. $nfrequencies - 1) {
  my $val = exists($depol{$i}) ? $depol{$i} : 0.0;
  print " $val";
  print "\n" if ((($i+1) % 10) == 0);
}
print "\n" if (($nfrequencies % 10) != 0);
print "units:\nNA\n";
print "END\n";
exit(0);
