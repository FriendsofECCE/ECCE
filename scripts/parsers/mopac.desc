# Parse descriptor for MOPAC output files (MOPAC 23.1.2).
#
# Every Begin/Skip/Lines/End below was checked by SIMULATING
# scripts/eccejobmonitor's real Begin/Skip/Lines/End line-feeding
# algorithm against captured output from real MOPAC 23.1.2 runs
# (2026-09-21 session) -- not by hand-picking line ranges, which is
# exactly what let ORCA's GEOMTRACE/VIBFREQ bugs hide (see CLAUDE.md).
# Remember Skip=N skips N lines TOTAL STARTING FROM AND INCLUDING the
# Begin-matching line, so Skip=1 means "start feeding at the line right
# after Begin".
#
# Two eccejobmonitor behaviors shaped the entries below:
#   * PDMatchBegin() returns the FIRST parse type whose Begin matches a
#     line and never checks the rest, so no two Begins here may match
#     the same physical line.
#   * While a block is open, lines are consumed until End matches, and
#     the End-matching line is consumed too -- so a Begin sitting on (or
#     before) another entry's End line can never fire.  That is why
#     MULLIKEN and DIPOLE are a single combined entry: MOPAC prints the
#     dipole table immediately after the atomic charge table with no
#     separator, so a separate [DIPOLE] entry anchored on the
#     "DIPOLE  X  Y  Z  TOTAL" header would have been permanently
#     starved by [MULLIKEN]'s End.

# MOPAC's heat of formation is its total energy for all practical
# purposes (a semiempirical Hamiltonian has no meaningful absolute
# electronic energy), so it is published under three keys at once: TE
# and TEVEC so everything in ECCE that keys on "the energy" works, and
# HFENERGY ("Heat of Formation", already in data/client/config/
# properties and previously unused by any code) under its real name.
#
# Units are kcal/mol, which is the Energy converter's OWN BASE UNIT
# (see src/util/units/EnergyConverter.C -- base is "kcal/Mole", with
# Hartree as a derived 0.001593601451 factor), so no conversion is done
# here; the value is passed through exactly as MOPAC printed it.
#
# MOPAC PRINTS THIS LINE WITH TWO DIFFERENT WORDINGS, which simulating
# the monitor against a FORCE-only run is what exposed:
#           FINAL HEAT OF FORMATION =        -57.79986 KCAL/MOL =    -241.83461 KJ/MOL
#           HEAT OF FORMATION =     -57.791897 KCALS/MOLE
# The second (no "FINAL", "KCALS/MOLE" not "KCAL/MOL") is what a FORCE
# job prints -- a Vibration runtype would otherwise have extracted NO
# energy at all, silently, exactly the shape of the gaussian-16.desc
# MULLIKEN bug in CLAUDE.md.  One entry with an optional "FINAL " covers
# both; splitting them into two entries is NOT an option, since
# "FINAL HEAT OF FORMATION" matches the shorter Begin too and
# PDMatchBegin()'s first-match-wins would permanently starve one of them.
#
# Frequency=all so a GeoVib job (two MOPAC data sets in one file)
# contributes every heat; TE and HFENERGY are plain overwriting
# PropValues and end up holding the last one.  mopac.energy emits TEVEC
# ONLY for the "FINAL" wording, deliberately: a FORCE job repeats the
# non-final line twice while printing only one geometry, and TEVEC is
# indexed by Geometry Step, so counting those would make the Geometry
# Trace plot longer than GEOMTRACE has frames (see the GEOMTRACE note
# below for why that matters).
[TE][TEVEC][HFENERGY]
Script=mopac.energy
Begin=HEAT OF FORMATION\s*=
Frequency=all
Skip=0
Lines=1
[END]

# MOPAC prints two DIFFERENT "CARTESIAN COORDINATES" table layouts --
# the 4-decimal input echo (with a "NO.  ATOM  X  Y  Z" sub-header) and
# the 9-decimal final geometry (no sub-header) -- so Skip cannot land
# exactly on the first data row for both.  Skip=1 lands inside both
# blocks and mopac.geomtrace skips non-matching lines rather than
# stopping at the first one (the same fix orca.vibfreq needed).
#
# The Begin regex is ANCHORED (^\s*...\s*$) on purpose: a FORCE run also
# prints "FORCE CONSTANT IN CARTESIAN COORDINATES (Millidynes/A)", which
# an unanchored /CARTESIAN COORDINATES/ would match, producing a bogus
# extra geometry frame.  Confirmed present in a real CH4 FORCE run.
#
# KNOWN LIMITATION: MOPAC does not print the geometry at each
# optimization cycle at any ordinary verbosity (LARGE, PRTXYZ and
# GRADIENTS were all tried against the real binary and none of them do;
# only the EF debugging keyword PRNT=3 does, buried in per-cycle Hessian
# dumps).  So GEOMTRACE is not a per-step animation for MOPAC -- it is
# the input geometry plus the final geometry (plus the second data set's
# echo, for GeoVib).  That is enough for what GEOMTRACE is mostly used
# for (CalcMgr's "reuse the optimized geometry" path reads the LAST
# frame).  It is also why MOPAC's per-cycle "CYCLE: n ... HEAT: x" lines
# are deliberately NOT mapped to a PropTSVector<Geometry Step>: that
# would give a Geometry Trace plot with more points than GEOMTRACE has
# frames, and clicking a point past the end drives GTStepCmd into
# PropTSVecTable::value()'s out-of-bounds path (warning + all-zero
# coordinates).  Keeping len(TEVEC) <= len(GEOMTRACE) avoids that.
#
# SECOND KNOWN WART, worth knowing before trusting the last frame to
# four decimal places: in a GeoVib run the LAST block in the file is the
# second (FORCE) data set's own input echo, which MOPAC prints to 4
# decimals, not the 9-decimal final geometry of the optimization that
# precedes it.  Both are the same optimized structure; the last frame is
# just rounded to 1e-4 Angstrom.  CalcMgr's "reuse the optimized
# geometry" path reads that last frame, so a re-run starts from the
# rounded coordinates.  Harmless at MOPAC's own accuracy, but it is why
# the frames in one trace do not all carry the same precision.
[GEOMTRACE]
Script=mopac.geomtrace
Begin=^\s*CARTESIAN COORDINATES\s*$
Skip=1
Frequency=all
End=Empirical Formula|General Reference for
[END]

# One combined entry (see the header note on End-line starvation).  The
# block MOPAC prints is:
#               NET ATOMIC CHARGES AND DIPOLE CONTRIBUTIONS
#   (blank)
#     ATOM NO.   TYPE          CHARGE      No. of ELECS.   s-Pop       p-Pop
#       1          O          -0.645360        6.6454     1.81709     4.82827
#       ...
#    DIPOLE           X         Y         Z       TOTAL
#    POINT-CHG.     0.000    -0.000    -1.818     1.818
#    HYBRID        -0.000     0.000    -0.323     0.323
#    SUM           -0.000    -0.000    -2.141     2.141
# Skip=3 (Begin + blank + column header) puts the first atom row first.
#
# These are MOPAC's default Coulson-style net atomic charges, published
# as MULLIKEN because that is the only per-atom partial-charge property
# key ECCE's charge panel understands and it is what every other code
# feeds it.  MOPAC can also print a true Mulliken population analysis
# (keyword MULLIK), but that needs an extra keyword and a second block,
# so the always-present one is used.
#  Molecular orbitals.  Needs "VECTORS ALLVEC" on the keyword line,
#  which ai.mopac emits when the theory dialog's "Print molecular
#  orbitals" box is ticked -- without VECTORS the block is absent, and
#  without ALLVEC only the occupied orbitals appear.
#
#  Begin is ANCHORED to a line that is nothing but the word: MOPAC echoes
#  its keywords near the top of every output as
#  "*  VECTORS    - FINAL EIGENVECTORS TO BE PRINTED", and an unanchored
#  Begin matches THAT, opening the block hundreds of lines early and
#  swallowing [GEOMTRACE], [PNTGRP] and [IP] on the way down.
#
#  Skip=0 so the Begin-matching line is itself fed to the script: for UHF
#  it reads "ALPHA EIGENVECTORS" / "BETA EIGENVECTORS", and that header
#  is the only thing distinguishing the two spins.  Both spins arrive in
#  ONE block, because End lies past both.
#
#  End is the next section's heading rather than a blank line: column
#  groups within the block are separated by blank lines that are
#  indistinguishable from the ones that close it.  That is why
#  [MULLIKEN][DIPOLE] above had to be re-anchored past this heading.
[MO][MOBETA][ORBENG][ORBENGBETA][ORBSYM][ORBSYMBETA]
Script=mopac.mo
Begin=^\s*(ALPHA|BETA)?\s*EIGENVECTORS\s*$
Skip=0
Frequency=last
End=NET ATOMIC CHARGES
[END]

#  Orbital occupancies, derived from the electron populations -- see
#  mopac.orbocc's header for why they come from there and not from
#  MOPAC's own "NO. OF FILLED LEVELS" line (which cannot be reached
#  without starving [PNTGRP] and [IP]).
#
#  Skip=2 counts the Begin line itself, so it consumes the heading and
#  the blank line under it, landing on the "Atom  s  px  py  pz" header.
#  End covers both shapes seen live: a blank line (unrestricted runs,
#  where the spin populations follow) and the MOPAC banner (restricted
#  runs, where the output ends).
#
#  Printed by default, so this fires even for a job that did not ask for
#  VECTORS -- but a pure FORCE run prints neither, and then both entries
#  correctly produce nothing.
#  Thermochemistry, from a FORCE/THERMO run.  Begin/End bracket the
#  whole table -- every temperature stanza reaches the script, which
#  selects the 298 K one itself, because MOPAC prints 298 K FIRST and
#  then scans upward from 200 K.  Neither Frequency=first nor
#  Frequency=last can express "the room-temperature stanza" when the
#  table is one block.
#
#  End is the table's own footnote.  Note it reads "HEATS OF FORMATION"
#  (plural, no "="), while [TE][TEVEC][HFENERGY] begins on
#  "HEAT OF FORMATION\s*=" -- no collision, and every line matching that
#  entry's Begin lies above this table anyway (verified in both the
#  ch4_force and ch4_geovib fixtures).
[ENTHALPY][ETHERM][ENTROPY][HEATCAP][THERMOTEMP]
Script=mopac.thermo
Begin=CALCULATED THERMODYNAMIC PROPERTIES
Skip=0
Frequency=last
End=HEATS OF FORMATION ARE RELATIVE
[END]

#  MO data from MOPAC's GRAPHF file rather than its printed output.
#
#  A File= parse type, the same mechanism Gaussian uses for fort.7 and
#  GAMESS-UK for ftn058: eccejobmonitor ships the named file whole and
#  the script parses it, instead of matching Begin/End in the job's
#  stdout.
#
#  This entry and the printed-eigenvector one above emit the SAME keys,
#  deliberately.  The .mgf is the better source -- full-precision
#  coefficients, occupancies and symmetry labels all in one place -- but
#  it only exists when the deck asked for GRAPHF, which decks generated
#  before that did not.  Both are kept so an older calculation still
#  gets its orbitals from the printed block, and a new one gets the
#  better data.  Whichever is delivered later wins, which is what the
#  test fixture pins.
[MOFILE]
Script=mopac.mgf
File=mopac.mgf
Begin=mopac.mgf
[END]

[ORBOCC][ORBOCCBETA]
Script=mopac.orbocc
Begin=ATOMIC ORBITAL ELECTRON POPULATIONS
Skip=2
Frequency=last
End=^\s*$|\*\*\*\*
[END]

[MULLIKEN][DIPOLE]
Script=mopac.charges
#  Anchored on the table's own column header, NOT on the "NET ATOMIC
#  CHARGES AND DIPOLE CONTRIBUTIONS" heading above it.  That heading is
#  where [MO]... ends, and eccejobmonitor consumes the End-matching line
#  as part of the block it closes -- so a Begin on it could never fire
#  once the eigenvector entry existed.  Skip=1 lands on the same first
#  data row the old Skip=3 did.
Begin=^\s*ATOM NO\.\s+TYPE\s+CHARGE
Skip=1
Frequency=last
End=^\s*SUM\s
[END]

# Single line, e.g. "      MOLECULAR POINT GROUP   :   C2v".  Printed
# once per geometry MOPAC reports on; Frequency=last takes the final
# (post-optimization) one.  Deliberately NOT anchored on the other
# place MOPAC prints a point group ("MOLECULAR WEIGHT = ... POINT
# GROUP:  C2v"), which would collide.
[PNTGRP]
Script=mopac.pntgrp
Begin=MOLECULAR POINT GROUP
Frequency=last
Skip=0
Lines=1
[END]

# Frequencies, mode symmetry labels AND the per-mode Cartesian
# displacement vectors, all from the one NORMAL COORDINATE ANALYSIS
# block.  VIB is what makes the "Vibrational Frequencies" entry appear
# in the Properties menu at all (PropertyPanelDescriptor.xml gates that
# panel on VIB, not VIBFREQ), and NModePanel indexes VIB, VIBFREQ and
# VIBSYM against each other row by row.
#
# VIBFREQ IS DELIBERATELY *NOT* TAKEN FROM MOPAC's FRIENDLIER
# "DESCRIPTION OF VIBRATIONS" SECTION, which prints a tidy
# "FREQUENCY   1286.05" line per stanza: that section COLLAPSES
# DEGENERATE MODES, printing one stanza per distinct frequency rather
# than one per mode.  A real PM7 CH4 FORCE run has 9 modes here and only
# 7 stanzas there, so the first version of this integration produced a
# 7-row VIBFREQ against a 9-mode VIB -- silently misaligned, exactly the
# trap CLAUDE.md records for ORCA's VIBFREQ/VIBIR pair.  Caught by
# running a real CH4 job through a simulation of eccejobmonitor's own
# line-feeding algorithm; a water test molecule has no degeneracies and
# would never have shown it.  Taking all three keys from one block makes
# the alignment structural.  See mopac.vib's header for the layout.
#
# MOPAC lists only the genuine 3N-6 (3N-5) modes in this block -- no
# near-zero translation/rotation rows to filter out, unlike ORCA/NWChem.
[VIBFREQ][VIBSYM][VIB]
Script=mopac.vib
Begin=NORMAL COORDINATE ANALYSIS
Skip=1
Frequency=last
End=MASS-WEIGHTED COORDINATE ANALYSIS
[END]

# IR intensities, from the DESCRIPTION OF VIBRATIONS block.  Without
# VIBIR (or VIBRAM) NModePanel::fillGraph() returns false and
# initialize() falls back to showTable(), which is why MOPAC alone showed
# a table where every other code shows the spectrum plot.
#
# THE End IS THE WHOLE STORY HERE.  This shipped on 2026-09-22 anchored
# on "SYMMETRY NUMBER FOR POINT-GROUP" and was withdrawn the same
# evening, because it made eccejobmonitor die on every MOPAC job:
#
#   FATAL ERROR: JobOutputGet: end of file encountered while reading
#   parse type VIBIR
#
# The monitor tails a file that is still being written.  Matching a
# Begin and then reaching EOF without the End is fatal, not "try again
# next poll", so an End has to be a string that reliably appears --
# and MOPAC does not print that one for every molecule or runtype.
#
# The obvious replacement is a trap: "FORCE CONSTANT" appears INSIDE
# every VIBRATION stanza, so ending on it would close the block after
# the first mode and report one mode's intensity as though it were all
# of them -- worse than nothing, and exactly what the withdrawal note
# warned a blank line would do.
#
# "SYMBOL  FORCE CONSTANT" is the header of the force-constant table
# that follows the block, and cannot match a stanza line (those read
# " FORCE CONSTANT      0.2475", with no SYMBOL).  Checked across every
# MOPAC fixture: present exactly once in each output that has a
# DESCRIPTION OF VIBRATIONS block, always after it, and absent from
# every output that has no such block.
#
# It is NOT sufficient on its own, and the alternation is not
# decoration.  With THERMO the force-constant table comes a long way
# after the stanzas -- 438 to 647 in the ch4_geovib fixture -- and the
# thermochemistry table sits between them at 492.  Ending only on the
# table header therefore swallowed [ENTHALPY]...'s Begin and starved it
# completely: MOPAC thermochemistry stopped being extracted the moment
# this entry was re-enabled.  "SYSTEM IS A GROUND STATE" is printed
# immediately after the stanzas whenever THERMO is on, so the
# alternation closes the block before the thermochemistry in that case
# and on the table header otherwise.
#
# Boundary check per this file's header: Begin lies after [VIBFREQ]'s
# End (MASS-WEIGHTED COORDINATE ANALYSIS), so nothing is eaten from
# under it, and the End line is no other entry's Begin.
#
# Skip=1 starts feeding at the line after Begin, which is blank;
# mopac.vibir scans for its own markers and ignores everything else, so
# the usual off-by-one that silently produces zero output does not
# apply.
#
# The block collapses degenerate modes (4 stanzas for CH4's 9 modes);
# mopac.vibir expands them back out, so VIBIR comes out the same length
# as VIBFREQ.  The value is the square of the transition dipole on a
# relative scale: MOPAC prints a transition dipole in Debye and gives no
# conversion to km/mol, so the units say "arb. units" rather than
# claiming an absolute intensity.  Peak positions and relative heights
# are right; the y-axis is not comparable with another code's.
[VIBIR]
Script=mopac.vibir
Begin=DESCRIPTION OF VIBRATIONS
Skip=1
Frequency=last
End=SYSTEM IS A GROUND STATE|SYMBOL\s+FORCE CONSTANT
[END]

# "          ZERO POINT ENERGY      10.115 KCAL/MOL" -- already in
# kcal/mol, the Energy converter's base unit, so no conversion.
[EZEROPT]
Script=mopac.ezeropt
Begin=ZERO POINT ENERGY
Frequency=last
Skip=0
Lines=1
[END]

# "          IONIZATION POTENTIAL    =         12.115488 EV" -- MOPAC
# prints this for every job (Koopmans' theorem from the HOMO energy).
[IP]
Script=mopac.ip
Begin=IONIZATION POTENTIAL
Frequency=last
Skip=0
Lines=1
[END]

# Only present when the input carries the GRADIENTS keyword, which
# ai.mopac emits for the Gradient runtype:
#    PARAMETER     ATOM    TYPE            VALUE        GRADIENT
#       1          1  O    CARTESIAN X     0.000000      0.000000  KCAL/ANGSTROM
# End is the blank line that closes the table.
[EGRADVEC]
Script=mopac.egradvec
Begin=PARAMETER\s+ATOM\s+TYPE
Skip=1
Frequency=last
End=^\s*$
[END]

# "\n TOTAL JOB TIME:             0.14 SECONDS" -- wall time for the
# whole file (both data sets, for a GeoVib job).  Mapped to ETIME
# (elapsed), not CPUSEC; MOPAC's separate "COMPUTATION TIME" line is
# per-data-set summed thread time, not a whole-job CPU total.
[ETIME]
Script=mopac.etime
Begin=TOTAL JOB TIME:
Frequency=last
Skip=0
Lines=1
[END]
