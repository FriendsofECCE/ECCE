#!/usr/bin/env perl
# TD-DFT / CIS excited states from the "Excitation energies and oscillator
# strengths" block:
#  Excited State   2:      Singlet-B2     6.9037 eV  179.59 nm  f=0.0301  <S**2>=0.000
#        8 -> 10         0.70285
# Frequency=all: every step of an Opt TD run has its own block, and the
# scalar keys end up holding the last one.  The TD total energy of the state
# being optimised is the trace energy of such a run (#521).
$| = 1;
($key, $runtype) = @ARGV;
use FindBin;
require "$FindBin::Bin/excited.pl";
my (@st, $td);
while (<STDIN>) {
  if (/Total Energy, E\(TD-HF\/TD-DFT\)\s*=\s*(-?\d+\.\d+)/) { $td = $1; next; }
  if (/^\s*Excited State\s+\d+:\s+(.*?)\s+(-?\d+\.\d+) eV\s+\d+\.\d+ nm\s+f=(\d+\.\d+)/) {
    push(@st, { label => $1, ev => $2, f => $3, trans => [] });
  } elsif (@st && /^\s+(\d+)\s*(->|<-)\s*(\d+)\s+(-?\d+\.\d+)\s*$/) {
    #  "<-" is the de-excitation amplitude of a full (non-TDA) TD run.
    my ($from, $to) = $2 eq "->" ? ($1, $3) : ($3, $1);
    push(@{$st[-1]{trans}}, "$from>$to:$4");
  }
}
&emitExcited(@st);
if (defined $td && $runtype =~ /Geo/i && -e "$key/g16TdOpt") {
  print "key: $_\nsize:\n1\nvalues:\n$td\nunits:\nHartree\nEND\n" for ("TE", "TEVEC");
}
exit(0);
