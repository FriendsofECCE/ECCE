#!/usr/bin/env python3
# xtb's `charges` file (appended by gensub between ECCE-XTB-CHARGES markers):
# one atomic charge per line, in atom order.  GFN1/GFN2 write Mulliken-type
# charges; GFN-FF writes its EEQ charges.  Both go to MULLIKEN, the key the
# existing charges panel reads.
import re
import sys
from xtb_parse import configure_streams, scalar

configure_streams()
values = []
for line in sys.stdin:
    m = re.search(r"^\s*(-?\d+\.\d+)\s*$", line, re.ASCII)
    if m:
        values.append(m.group(1))
if values:
    print("key: MULLIKEN\nsize:\n{}\nvalues:\n{}\nunits:\ne\nEND".format(
        len(values), " ".join(values)))
