#!/usr/bin/env python3
import re
import sys
import math
from xtb_parse import configure_streams, scalar, number

configure_streams()

# The echoed keyword line identifies the dielectric without guessing a
# solvent name; several solvents can have the same dielectric constant.
eps = None
for line in sys.stdin:
    match = re.search(r"^\s*(?=[A-Za-z0-9])[^\r\n]*\bEPS\s*=\s*((?:\d+(?:\.\d*)?|\.\d+)(?:[eEdD][+-]?\d+)?)(?=\s|$)", line, re.ASCII | re.IGNORECASE)
    if match:
        value = number(match.group(1).replace("d", "e").replace("D", "E"))
        if math.isfinite(value) and value >= 1:
            eps = value
if eps is not None:
    scalar("SOLVMODEL", "COSMO, ε = {:.15g}".format(eps), "NA")
