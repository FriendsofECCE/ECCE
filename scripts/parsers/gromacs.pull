#!/usr/bin/env python3
################################################################################
# Purpose:
# The pull code's output of a GROMACS run: gensub joins pullx.xvg (the pull
# coordinate, nm) and pullf.xvg (its force, kJ/mol/nm) into ecce-parse-pull.txt,
#     ECCE-PULL <time ps> <coordinate> <force>
# one line per output frame, which become the vectors PULLTIME, PULLDIST and
# PULLFORCE of the Pull Force panel.
################################################################################

import re
import sys
from xtb_parse import configure_streams

configure_streams()

times, coords, forces = [], [], []
pattern = r"^ECCE-PULL\s+(\S+)\s+(\S+)\s+(\S+)\s*$"
for raw in sys.stdin.buffer:
    line = raw.decode("utf-8", "replace")
    if re.search(pattern, line, re.ASCII):
        match = re.search(pattern.encode("ascii"), raw, re.ASCII)
        for values, value in zip((times, coords, forces), match.groups()):
            values.append(value)
if len(times) >= 2:
    for key, units, values in (("PULLTIME", "ps", times), ("PULLDIST", "nm", coords),
                               ("PULLFORCE", "kJ/mol/nm", forces)):
        header = "key: {}\nsize:\n{}\nvalues:\n".format(key, len(times))
        sys.stdout.buffer.write(header.encode("ascii") +
                                b"\n".join(b" " + value for value in values) +
                                ("\nunits:\n{}\nEND\n".format(units)).encode("ascii"))
