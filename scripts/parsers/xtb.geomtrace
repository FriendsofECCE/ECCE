#!/usr/bin/env python3
import re
import sys
from xtb_parse import configure_streams, scalar

configure_streams()
rows, labels, values = [], [], {}
for line in sys.stdin:
    if re.search(r"(?:^|\s)(?:energy|time|score):", line, re.ASCII):
        for name, pattern in (("score", r"-?\d+\.?\d*"),
                              ("energy", r"-?\d+\.\d+"),
                              ("time", r"\d+\.\d+"),
                              ("relative", r"-?\d+\.\d+")):
            m = re.search(r"(?:^|\s)" + name + r":\s*(" + pattern + ")", line, re.ASCII)
            if m:
                values[name] = m.group(1)
    else:
        m = re.search(r"^\s*([A-Za-z]{1,2})\s+(-?\d+\.\d+)\s+(-?\d+\.\d+)\s+(-?\d+\.\d+)\s*$",
                      line, re.ASCII)
        if m:
            rows.append(" ".join(m.groups()[1:]))
            labels.append("{}-{}".format(len(rows), m.group(1)))
if rows:
    print("key: GEOMTRACE\nsize:\n1 {} 3\nrowlabels:\n {}".format(len(rows), " ".join(labels)))
    print("columnlabels:\nX Y Z\nvalues:")
    for row in rows:
        print(" " + row)
    print("units:\nAngstrom\nEND")
    if "energy" in values and "relative" not in values:
        scalar("TEVEC", values["energy"])
    for name, key, unit in (("score", "POSESCORE", "kcal/mol"),
                            ("time", "TIMEVEC", "ps"),
                            ("relative", "CONFREL", "kcal/mol")):
        if name in values:
            scalar(key, values[name], unit)
