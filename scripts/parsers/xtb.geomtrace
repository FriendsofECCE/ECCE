#!/usr/bin/env perl
# One frame between the ECCE-XTB-FRAME markers that gensub appends to the
# output (xtb prints no coordinates itself): an xyz comment line, then the
# atoms.  The comment of an xtbopt.log frame carries that step's energy, so
# GEOMTRACE and TEVEC come from the same frame and stay the same length
# (TEVEC may never be longer than GEOMTRACE).
$| = 1;
($key, $runtype, $ucCategory, $theory) = @ARGV;

# A conformer-search frame (ecce-confsearch) has "relative: <kcal/mol>" in its
# comment and gives CONFREL instead of TEVEC, as for a CREST ensemble.
my (@coordlines, $rowLabels, $energy, $time, $rel);
$rowLabels = "";
while (<STDIN>) {
  if (/(?:^|\s)(?:energy|time|score):/) {
    $score = $1 if (/(?:^|\s)score:\s*(-?\d+\.?\d*)/);
    $energy = $1 if (/(?:^|\s)energy:\s*(-?\d+\.\d+)/);
    $time = $1 if (/(?:^|\s)time:\s*(\d+\.\d+)/);
    $rel = $1 if (/(?:^|\s)relative:\s*(-?\d+\.\d+)/);
  } elsif (/^\s*([A-Za-z]{1,2})\s+(-?\d+\.\d+)\s+(-?\d+\.\d+)\s+(-?\d+\.\d+)\s*$/) {
    push(@coordlines, "$2 $3 $4");
    $rowLabels .= " " . scalar(@coordlines) . "-$1";
  }
}

my $size = scalar(@coordlines);
exit(0) if ($size < 1);

print "key: GEOMTRACE\nsize:\n1 $size 3\nrowlabels:\n$rowLabels\n";
print "columnlabels:\nX Y Z\nvalues:\n";
print " $_\n" foreach (@coordlines);
print "units:\nAngstrom\nEND\n";

if (defined($energy) && !defined($rel)) {
  print "key: TEVEC\nsize:\n1\nvalues:\n$energy\nunits:\nHartree\nEND\n";
}
# A docking pose: its interaction energy, kcal/mol (see scripts/parsers/dock.poses).
if (defined($score)) {
  print "key: POSESCORE\nsize:\n1\nvalues:\n$score\nunits:\nkcal/mol\nEND\n";
}
# An MD frame carries its time in ps (gensub puts it in the comment line);
# it is the plot's x axis.
if (defined($time)) {
  print "key: TIMEVEC\nsize:\n1\nvalues:\n$time\nunits:\nps\nEND\n";
}
if (defined($rel)) {
  print "key: CONFREL\nsize:\n1\nvalues:\n$rel\nunits:\nkcal/mol\nEND\n";
}
exit(0);
