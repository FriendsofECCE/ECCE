# Parse descriptor for ORCA output file (issue #38, reduced scope:
# geometry trace, total energy, vibrational frequencies, NMR shielding).
#
# Grounded in real ORCA 6.1.1 runs (2026-09-06 session) -- see
# orca.geomtrace/orca.energy/orca.vibfreq/orca.isoshield/
# orca.shieldtensor for the exact line shapes each Begin/Skip/End pair
# was checked against. Not yet checked against larger systems where
# column widths or line wrapping could differ.

[GEOMTRACE]
Script=orca.geomtrace
Begin=CARTESIAN COORDINATES \(ANGSTROEM\)
Skip=1
Frequency=all
End=CARTESIAN COORDINATES \(A\.U\.\)
[END]

[TE]
Script=orca.energy
Begin=FINAL SINGLE POINT ENERGY
Frequency=last
Skip=0
Lines=1
[END]

# Textually distinct from [TE]'s Begin above even though it matches the
# identical real text -- eccejobmonitor keys its whole parse-type table
# by the literal Begin string (PDFileRead's "$parseHandle =
# $pdBuf{$PD_KEY_BEGIN}"), and silently drops any later entry whose
# Begin collides with an earlier one already in the table ("silently
# ignore duplicate parse handles"). TE and TEVEC both have to match
# "FINAL SINGLE POINT ENERGY" but need different Frequency values, so
# the two Begin strings are wrapped differently (non-capturing group,
# functionally a no-op) purely to avoid colliding on this hash key.
[TEVEC]
Script=orca.energy
Begin=(?:FINAL SINGLE POINT ENERGY)
Frequency=all
Skip=0
Lines=1
[END]

[VIBFREQ]
Script=orca.vibfreq
Begin=VIBRATIONAL FREQUENCIES
Skip=4
Frequency=last
End=NORMAL MODES
[END]

[ISOSHIELD][ANISOSHIELD]
Script=orca.isoshield
Begin=CHEMICAL SHIELDING SUMMARY \(ppm\)
Skip=5
Frequency=last
End=NMR shielding tensor
[END]

[SHIELDTENSOR][SHIELDEIGVAL]
Script=orca.shieldtensor
Begin=CHEMICAL SHIELDINGS \(ppm\)
Frequency=first
End=CHEMICAL SHIELDING SUMMARY
[END]
