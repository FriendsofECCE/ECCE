# Parse descriptor for ORCA output file (issue #38, extended per #74/#76:
# geometry trace, total/decomposed energy, gradient, dipole/quadrupole,
# Mulliken charges, molecular orbitals, vibrational frequencies, NMR
# shielding).
#
# Grounded in real ORCA 6.1.1 runs (2026-09-06/07 sessions) -- see the
# individual orca.* scripts for the exact line shapes each Begin/Skip/End
# pair was checked against, INCLUDING actually simulating eccejobmonitor's
# real Begin/Skip/End line-feeding algorithm against captured output
# (not just testing each script by hand-picking the right lines) --
# Skip=N skips N lines total starting from and including the Begin line
# itself, not N lines after it, which is easy to get off by one for any
# script that stops at the first non-matching line (hit both GEOMTRACE
# and VIBFREQ, see their entries below). Not yet checked against larger
# systems where column widths or line wrapping could differ.

# Skip=2, not 1: eccejobmonitor's Skip count includes the Begin-matching
# line itself (verified against the real line-feeding algorithm in
# scripts/eccejobmonitor -- Skip=N skips N lines total starting from and
# including Begin, not N lines after it), so skipping just the header
# line (Skip=1) left the "---" dashed separator as the first line fed to
# orca.geomtrace, which breaks immediately on any non-atom first line and
# silently produced zero output on every single invocation via the real
# monitor pipeline (confirmed by simulating the exact algorithm against a
# real captured ORCA 6.1.1 run this session). This was the root cause of
# GitHub issue #74's "GEOMTRACE never gets extracted despite a correct
# [Begin] match" mystery -- the Begin regex genuinely does match, but the
# script byte after it never saw usable data.
[GEOMTRACE]
Script=orca.geomtrace
Begin=CARTESIAN COORDINATES \(ANGSTROEM\)
Skip=2
Frequency=all
End=CARTESIAN COORDINATES \(A\.U\.\)
[END]

# TE and TEVEC as two separate parse types (one Frequency=last, one
# Frequency=all) does NOT work for ORCA, unlike NWChem's own [TEPROP]/
# [TEVEC] split it was modeled on: NWChem has two genuinely different
# marker phrases for these ("task_energy" vs "task_gradient"), but
# ORCA prints the identical "FINAL SINGLE POINT ENERGY" text for both
# purposes. eccejobmonitor's PDMatchBegin() returns the first parse
# type whose Begin matches a given line and never checks the rest for
# that same line -- with two entries matching identical text, whichever
# happens to be checked first permanently starves the other for the
# whole run (confirmed live: TEVEC matched 10/10 times, TE never
# matched once). Single combined entry instead, Frequency=all: every
# match re-emits both TE and TEVEC (see orca.energy), so TE just keeps
# getting overwritten and naturally ends up holding the last value once
# matching stops, while TEVEC accumulates the full per-step trace.
[TE][TEVEC]
Script=orca.energy
Begin=FINAL SINGLE POINT ENERGY
Frequency=all
Skip=0
Lines=1
[END]

# ORCA's "TOTAL SCF ENERGY" block repeats once per SCF evaluation (once
# per geometry step during an optimization), same shape every time --
# confirmed against a real ORCA 6.1.1 RHF/STO-3G Opt+Freq run (this
# session). Split into two entries since the two line groups aren't
# contiguous in ORCA's output (a blank line and a "Virial components:"
# header separate them); no ECCE property key exists for "Electronic
# Energy" itself, only its two components (ONEELEC/TWOELEC), matching
# NWChem/Gaussian's own key set.
[NNREPUL][ONEELEC][TWOELEC]
Script=orca.energydecomp
Begin=Nuclear Repulsion\s*:
Frequency=all
Skip=0
Lines=4
[END]

[PE][KE]
Script=orca.energydecomp
Begin=Potential Energy\s*:
Frequency=all
Skip=0
Lines=2
[END]

# Requires ai.orca's unconditional "%output Print[P_MOs] 1 end" block
# (added alongside this) -- without it ORCA doesn't print MO coefficients
# to text output at all. Deriving ORBENG/ORBOCC from this block instead of
# the separate "ORBITAL ENERGIES" section since that section truncates to
# the first 10 virtuals by default while this one prints every orbital.
[MO][MOBETA][ORBENG][ORBENGBETA][ORBOCC][ORBOCCBETA]
Script=orca.mo
Begin=MOLECULAR ORBITALS
Skip=2
Frequency=last
End=MULLIKEN POPULATION ANALYSIS
[END]

[EGRAD][EGRADVEC]
Script=orca.egradvec
Begin=CARTESIAN GRADIENT
Skip=3
Frequency=all
End=TIMINGS
[END]

[DIPOLE]
Script=orca.dipole
Begin=Total Dipole Moment
Frequency=last
End=Rotational spectrum
[END]

# Requires ai.orca's unconditional "%elprop Quadrupole true end" block
# (added alongside this) -- ORCA does not compute the quadrupole moment
# by default.
[QUADPOLE]
Script=orca.quadpole
Begin=QUADRUPOLE MOMENT
Frequency=last
End=diagonalized tensor:
[END]

[MULLIKEN]
Script=orca.mulliken
Begin=MULLIKEN ATOMIC CHARGES
Skip=2
Frequency=last
End=Sum of atomic charges
[END]

# Skip=4 (Begin/dashes/blank/"Scaling factor..."): only needs to land
# past the boilerplate common to every run -- with symmetry in use
# (UseSym, or ORCA auto-detecting one), a "Point group:"+"Irrep" header
# pair is inserted right after this point, absent otherwise, so a
# fixed Skip can't reliably land exactly on the first data line either
# way. orca.vibfreq now skips non-matching lines itself instead of
# stopping at the first one (this used to be Skip=5 relying on the
# script's old stop-at-first-non-match behavior, which silently
# produced zero frequencies whenever the symmetry lines were present --
# confirmed live against a real ORCA 6.1.1 run, both with and without
# UseSym, this session).
[VIBFREQ]
Script=orca.vibfreq
Begin=VIBRATIONAL FREQUENCIES
Skip=4
Frequency=last
End=NORMAL MODES
[END]

# Without this, the Vibration entry doesn't appear in the Properties
# menu at all -- PropertyPanelDescriptor.xml's "Vibrational Frequencies"
# panel is gated on VIB (mode displacement vectors), not VIBFREQ.
[VIB]
Script=orca.vib
Begin=NORMAL MODES
Skip=7
Frequency=last
End=IR SPECTRUM
[END]

# IR SPECTRUM's own block only lists the real vibrational modes (starts
# at Mode 6 for a nonlinear molecule, 5 if linear) -- unlike
# VIBRATIONAL FREQUENCIES above, it omits the near-zero translation/
# rotation modes entirely. orca.vibir pads those back in with 0.0
# intensity so VIBIR stays the same length and row-aligned with VIBFREQ
# (NModePanel indexes both PropVectors by the same row, not a shared
# mode-number column). Skip=6, same off-by-one convention as GEOMTRACE/
# VIBFREQ above (counts the Begin line itself): block is Begin/dashes/
# blank/header/units-header/dashes, so data starts on line 7.
# Grounded in the real ORCA 6.1.1 sample block from ORCA's own docs
# (faccts.de IR tutorial, 2026-09 session) -- not yet independently
# verified against a live run in this environment.
[VIBIR]
Script=orca.vibir
Begin=IR SPECTRUM
Skip=6
Frequency=last
End=The first frequency considered to be a vibration
[END]

# Single line, e.g. "Point Group:  C2v, Symmetry Number:   2" -- real
# ORCA 6.1.1 sample from a captured H2O/RHF/STO-3G run (see issue #74's
# original report). Frequency=last: takes the final (post-optimization,
# if any) point group if ORCA ever prints this more than once in a run.
[PNTGRP]
Script=orca.pntgrp
Begin=Point Group:
Frequency=last
Skip=0
Lines=1
[END]

# Real line verified against a captured ORCA output (THERMOCHEMISTRY AT
# 298.15K section -- checked against an old ORCA 3.0.3 capture, wording
# identical to ORCA 6.1's own tutorial docs). ORCA already prints Eh
# directly, unlike NWChem's kcal/mol-only line, so no unit conversion
# needed in the script.
[EZEROPT]
Script=orca.ezeropt
Begin=Zero point energy
Frequency=last
Skip=0
Lines=1
[END]

# Headline thermochemistry (Total Thermal Energy, Total Enthalpy, the
# T*S entropy term, Gibbs Free Energy) -- new property infrastructure,
# no code extracted any of these before (see data/client/config/
# properties). Real lines verified against a captured ORCA output
# (THERMOCHEMISTRY AT 298.15K section); see orca.thermo's own header
# for the exact text and the EGIBBS wording caveat.
[ETHERM]
Script=orca.thermo
Begin=Total thermal energy
Frequency=last
Skip=0
Lines=1
[END]

[ENTHALPY]
Script=orca.thermo
Begin=Total Enthalpy
Frequency=last
Skip=0
Lines=1
[END]

[ENTROPY]
Script=orca.thermo
Begin=Final entropy term
Frequency=last
Skip=0
Lines=1
[END]

[EGIBBS]
Script=orca.thermo
Begin=Final Gibbs free
Frequency=last
Skip=0
Lines=1
[END]

# Matches the SCF iteration data line's own shape directly rather than
# anchoring on a section header -- see orca.deltae's header comment for
# why (no single stable header text works; verified live against a
# real ORCA 6.1.1 run, zero false-positive matches elsewhere in a full
# real output file).
[DELTAE]
Script=orca.deltae
Begin=^\s*\d+\s+-?\d+\.\d+\s+-?\d+\.\d+[eE][+-]\d+
Frequency=all
Skip=0
Lines=1
[END]

# Real line verified against a captured ORCA output:
#   TOTAL RUN TIME: 0 days 0 hours 0 minutes 2 seconds 571 msec
# Deliberately not CPUSEC -- see orca.etime's header comment for why.
[ETIME]
Script=orca.etime
Begin=TOTAL RUN TIME:
Frequency=last
Skip=0
Lines=1
[END]

# Only printed for open-shell (UHF/UKS) jobs; verified against a real
# ORCA 6.1.1 UHF run. Never matches for closed-shell jobs, which is
# correct (S2 stays unset rather than shown as a meaningless 0).
[S2]
Script=orca.s2
Begin=Expectation value of <S\*\*2>
Frequency=last
Skip=0
Lines=1
[END]

[ISOSHIELD][ANISOSHIELD]
Script=orca.isoshield
Begin=CHEMICAL SHIELDING SUMMARY \(ppm\)
Skip=5
Frequency=last
End=NMR shielding tensor
[END]

[SHIELDTENSOR][SHIELDEIGVAL]
Script=orca.shieldtensor
Begin=CHEMICAL SHIELDINGS \(ppm\)
Frequency=first
End=CHEMICAL SHIELDING SUMMARY
[END]
