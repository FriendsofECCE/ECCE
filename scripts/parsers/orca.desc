# Parse descriptor for ORCA output file (issue #38, extended per #74/#76:
# geometry trace, total/decomposed energy, gradient, dipole/quadrupole,
# Mulliken charges, molecular orbitals, vibrational frequencies, NMR
# shielding).
#
# Grounded in real ORCA 6.1.1 runs (2026-09-06/07 sessions) -- see the
# individual orca.* scripts for the exact line shapes each Begin/Skip/End
# pair was checked against, INCLUDING actually simulating eccejobmonitor's
# real Begin/Skip/End line-feeding algorithm against captured output
# (not just testing each script by hand-picking the right lines) --
# Skip=N skips N lines total starting from and including the Begin line
# itself, not N lines after it, which is easy to get off by one for any
# script that stops at the first non-matching line (hit both GEOMTRACE
# and VIBFREQ, see their entries below). Not yet checked against larger
# systems where column widths or line wrapping could differ.

# Skip=2, not 1: eccejobmonitor's Skip count includes the Begin-matching
# line itself (verified against the real line-feeding algorithm in
# scripts/eccejobmonitor -- Skip=N skips N lines total starting from and
# including Begin, not N lines after it), so skipping just the header
# line (Skip=1) left the "---" dashed separator as the first line fed to
# orca.geomtrace, which breaks immediately on any non-atom first line and
# silently produced zero output on every single invocation via the real
# monitor pipeline (confirmed by simulating the exact algorithm against a
# real captured ORCA 6.1.1 run this session). This was the root cause of
# GitHub issue #74's "GEOMTRACE never gets extracted despite a correct
# [Begin] match" mystery -- the Begin regex genuinely does match, but the
# script byte after it never saw usable data.
# IRC (#417): the summary table of an IRC job.  Ends on the citations header
# (the table is followed by a dashes line, so a dashes End would stop early).
[IRCCOORD][IRCENERGY]
Script=orca.irc
Begin=IRC PATH SUMMARY
Frequency=last
End=SUGGESTED CITATIONS FOR THIS RUN
[END]

# Relaxed scan (#393): the optimised energy of each scan point.  Ends on the
# second table's heading, which no other entry begins on.
[SCANCOORD][SCANENERGY]
Script=orca.scan
Begin=RELAXED SURFACE SCAN RESULTS
Frequency=last
End=Calculated Surface using the SCF energy
[END]

# Relaxed scan structures (#410): one frame per scan point.
[SCANGEOM]
Script=orca.scangeom
File=orca.orcain.allxyz
Begin=orca.orcain.allxyz
[END]

# ORCA names the file after the input, which ECCE always calls orca.orcain.
[IRCGEOM]
Script=orca.ircgeom
File=orca.orcain_IRC_Full_trj.xyz
Begin=orca.orcain_IRC_Full_trj.xyz
[END]

[GEOMTRACE]
Script=orca.geomtrace
Begin=CARTESIAN COORDINATES \(ANGSTROEM\)
Skip=2
Frequency=all
End=CARTESIAN COORDINATES \(A\.U\.\)
[END]

# TE and TEVEC as two separate parse types (one Frequency=last, one
# Frequency=all) does NOT work for ORCA, unlike NWChem's own [TEPROP]/
# [TEVEC] split it was modeled on: NWChem has two genuinely different
# marker phrases for these ("task_energy" vs "task_gradient"), but
# ORCA prints the identical "FINAL SINGLE POINT ENERGY" text for both
# purposes. eccejobmonitor's PDMatchBegin() returns the first parse
# type whose Begin matches a given line and never checks the rest for
# that same line -- with two entries matching identical text, whichever
# happens to be checked first permanently starves the other for the
# whole run (confirmed live: TEVEC matched 10/10 times, TE never
# matched once). Single combined entry instead, Frequency=all: every
# match re-emits both TE and TEVEC (see orca.energy), so TE just keeps
# getting overwritten and naturally ends up holding the last value once
# matching stops, while TEVEC accumulates the full per-step trace.
[TE][TEVEC]
Script=orca.energy
Begin=FINAL SINGLE POINT ENERGY
Frequency=all
Skip=0
Lines=1
[END]

# ORCA's "TOTAL SCF ENERGY" block repeats once per SCF evaluation (once
# per geometry step during an optimization), same shape every time --
# confirmed against a real ORCA 6.1.1 RHF/STO-3G Opt+Freq run (this
# session). Split into two entries since the two line groups aren't
# contiguous in ORCA's output (a blank line and a "Virial components:"
# header separate them); no ECCE property key exists for "Electronic
# Energy" itself, only its two components (ONEELEC/TWOELEC), matching
# NWChem/Gaussian's own key set.
[NNREPUL][ONEELEC][TWOELEC]
Script=orca.energydecomp
Begin=Nuclear Repulsion\s*:
Frequency=all
Skip=0
Lines=4
[END]

[PE][KE]
Script=orca.energydecomp
Begin=Potential Energy\s*:
Frequency=all
Skip=0
Lines=2
[END]

# Requires ai.orca's unconditional "%output Print[P_MOs] 1 end" block
# (added alongside this) -- without it ORCA doesn't print MO coefficients
# to text output at all. Deriving ORBENG/ORBOCC from this block instead of
# the separate "ORBITAL ENERGIES" section since that section truncates to
# the first 10 virtuals by default while this one prints every orbital.
[MO][MOBETA][ORBENG][ORBENGBETA][ORBOCC][ORBOCCBETA][MOAOORDER]
Script=orca.mo
Begin=MOLECULAR ORBITALS
Skip=2
Frequency=last
End=MULLIKEN POPULATION ANALYSIS
[END]

#  Orbital symmetry labels, which live in the Irrep column of "ORBITAL
#  ENERGIES" -- the MO coefficient block above carries no symmetry, so
#  this is a separate read of a separate section.  ORCA only prints that
#  column with "! UseSym", which the "Use symmetry" checkbox in
#  orcatheory.py drives; without it the script emits nothing and the MO
#  table simply has no Sym column, which is the correct outcome.
#
#  Skip=2 counts the Begin line itself (see CLAUDE.md), so it consumes
#  "ORBITAL ENERGIES" and the "----" underline directly below it.  That
#  underline matters: End is an unindented dashes run, and without the
#  skip the block would close on its own header underline and feed the
#  script nothing.
#
#  End deliberately stops on those dashes rather than on "MOLECULAR
#  ORBITALS".  ORCA prints the dashes ABOVE that heading, so ending here
#  leaves the heading itself unconsumed and the [MO] entry above can
#  still match it -- ending on the heading would eat it and starve [MO]
#  of ever firing, the failure this file has already been bitten by
#  twice (VIBFREQ/VIB and SHIELDTENSOR/ISOSHIELD).
[ORBSYM][ORBSYMBETA]
Script=orca.orbsym
Begin=ORBITAL ENERGIES
Skip=2
Frequency=last
End=^-{4,}\s*$
[END]

[EGRAD][EGRADVEC]
Script=orca.egradvec
Begin=CARTESIAN GRADIENT
Skip=3
Frequency=all
End=TIMINGS
[END]

[DIPOLE]
Script=orca.dipole
Begin=Total Dipole Moment
Frequency=last
End=Rotational spectrum
[END]

# Requires ai.orca's unconditional "%elprop Quadrupole true end" block
# (added alongside this) -- ORCA does not compute the quadrupole moment
# by default.
[QUADPOLE]
Script=orca.quadpole
Begin=QUADRUPOLE MOMENT
Frequency=last
End=diagonalized tensor:
[END]

[MULLIKEN]
Script=orca.mulliken
Begin=MULLIKEN ATOMIC CHARGES
Skip=2
Frequency=last
End=Sum of atomic charges
[END]

# The other population schemes.  LOEWDIN is printed with every run; the
# rest only when the input asks (! Hirshfeld, ! MBIS, ! NBO).  Loewdin has
# no "Sum" line, so it ends on the block that follows it.  The Hirshfeld and
# MBIS tables start at the "ATOM  CHARGE" header after some summary lines,
# so they are not Skip=-counted; atomcharges.pl picks out the atom rows and
# the "  TOTAL" row ends them.  NPA comes from NBO's own text in the ORCA
# output (the licensed program has to be installed and run via ! NBO).
[LOEWDIN]
Script=orca.loewdin
Begin=LOEWDIN ATOMIC CHARGES
Skip=2
Frequency=last
End=LOEWDIN REDUCED ORBITAL CHARGES
[END]

[HIRSHFELD]
Script=orca.hirshfeld
Begin=HIRSHFELD ANALYSIS
Frequency=last
End=^  TOTAL
[END]

[MBIS]
Script=orca.mbis
Begin=MBIS ANALYSIS
Frequency=last
End=^  TOTAL
[END]

[NPA]
Script=orca.npa
Begin=Summary of Natural Population Analysis
Skip=1
Frequency=last
End=\* Total \*
[END]

# Skip=4 (Begin/dashes/blank/"Scaling factor..."): only needs to land
# past the boilerplate common to every run -- with symmetry in use
# (UseSym, or ORCA auto-detecting one), a "Point group:"+"Irrep" header
# pair is inserted right after this point, absent otherwise, so a
# fixed Skip can't reliably land exactly on the first data line either
# way. orca.vibfreq now skips non-matching lines itself instead of
# stopping at the first one (this used to be Skip=5 relying on the
# script's old stop-at-first-non-match behavior, which silently
# produced zero frequencies whenever the symmetry lines were present --
# confirmed live against a real ORCA 6.1.1 run, both with and without
# UseSym, this session).
#
# End is the unanchored-dashes line that ORCA prints immediately BEFORE
# the "NORMAL MODES" header, NOT "NORMAL MODES" itself.  That matters,
# and it is not cosmetic: eccejobmonitor consumes the End-matching line
# as part of this block, so an End of "NORMAL MODES" ate the very line
# [VIB]'s Begin needs and [VIB] could therefore NEVER fire -- the exact
# End-line starvation hazard mopac.desc's header warns about.  Effect:
# every ORCA frequency job extracted VIBFREQ but no VIB at all, which
# (see [VIB] below) means the "Vibrational Frequencies" panel never
# appeared in the Properties menu for any ORCA job, with no error
# anywhere.  Found 2026-09-21 by tests/parsers on a real ORCA 6.1.1
# RHF/STO-3G Opt Freq run.
# The pattern is anchored and requires an unindented run of dashes, so
# it cannot match the indented separator lines inside other blocks.
[VIBFREQ]
Script=orca.vibfreq
Begin=VIBRATIONAL FREQUENCIES
Skip=4
Frequency=last
End=^-{4,}\s*$
[END]

# Without this, the Vibration entry doesn't appear in the Properties
# menu at all -- PropertyPanelDescriptor.xml's "Vibrational Frequencies"
# panel is gated on VIB (mode displacement vectors), not VIBFREQ.
#
# End is the dashes line before the "IR SPECTRUM" header, not
# "IR SPECTRUM" itself, for the same reason [VIBFREQ] above stops before
# "NORMAL MODES": consuming the header line would starve [VIBIR] the
# moment [VIB] started firing (it only looked healthy before because
# [VIB] never fired at all).
[VIB]
Script=orca.vib
Begin=NORMAL MODES
Skip=7
Frequency=last
End=^-{4,}\s*$
[END]

# IR SPECTRUM's own block only lists the real vibrational modes (starts
# at Mode 6 for a nonlinear molecule, 5 if linear) -- unlike
# VIBRATIONAL FREQUENCIES above, it omits the near-zero translation/
# rotation modes entirely. orca.vibir pads those back in with 0.0
# intensity so VIBIR stays the same length and row-aligned with VIBFREQ
# (NModePanel indexes both PropVectors by the same row, not a shared
# mode-number column). Skip=6, same off-by-one convention as GEOMTRACE/
# VIBFREQ above (counts the Begin line itself): block is Begin/dashes/
# blank/header/units-header/dashes, so data starts on line 7.
# Grounded in the real ORCA 6.1.1 sample block from ORCA's own docs
# (faccts.de IR tutorial, 2026-09 session), and now also confirmed
# against a live run (issue #173 session, water and CH4).
#
# End used to be "The first frequency considered to be a vibration",
# the true end of the IR table -- but only when Raman (%elprop Polar 1)
# is off. With Raman on, ORCA prints a whole RAMAN SPECTRUM block
# between the IR table's footnotes and that line, so the old End
# swallowed RAMAN SPECTRUM's own header too and starved [VIBRAM]'s
# Begin -- the same End-line-starvation shape [VIBFREQ] above already
# warns about. Ending on the second footnote line closes the IR table
# identically whether Raman ran or not; verified against real ORCA
# 6.1.1 output both ways.
[VIBIR]
Script=orca.vibir
Begin=IR SPECTRUM
Skip=6
Frequency=last
End=The dipole moment derivative
[END]

# Raman activities/depolarization ratios (issue #173), requested by
# ai.orca's Raman Activities checkbox ("%elprop Polar 1"). RAMAN
# SPECTRUM, like IR SPECTRUM, lists only the real vibrational modes --
# orca.vibram pads the leading translation/rotation modes with 0.0 for
# the same row-alignment-with-VIBFREQ reason orca.vibir does.
#
# Skip=5: Begin/dashes/blank/header/dashes (one header line, not IR
# SPECTRUM's two), so data starts on line 6.
#
# End is the text [VIBIR] used to use before Raman existed -- safe here
# because this is the last entry reading this part of the file, so
# nothing else needs that line as its own Begin.
#
# Depolarization ratio has no existing property key (checked
# data/client/config/properties); VIBRAMDEPOL was added there as a
# plain PropVector<Normal Mode>, with no display panel yet.
#
# Verified against real ORCA 6.1.1: water (HF and B3LYP) and CH4 (to
# confirm degenerate modes are listed individually here, unlike
# MOPAC's DESCRIPTION OF VIBRATIONS -- see CLAUDE.md), with and without
# a preceding geometry optimization.
[VIBRAM][VIBRAMDEPOL]
Script=orca.vibram
Begin=RAMAN SPECTRUM
Skip=5
Frequency=last
End=The first frequency considered to be a vibration
[END]

# Single line, e.g. "Point Group:  C2v, Symmetry Number:   2" -- real
# ORCA 6.1.1 sample from a captured H2O/RHF/STO-3G run (see issue #74's
# original report). Frequency=last: takes the final (post-optimization,
# if any) point group if ORCA ever prints this more than once in a run.
[PNTGRP]
Script=orca.pntgrp
Begin=Point Group:
Frequency=last
Skip=0
Lines=1
[END]

# Real line verified against a captured ORCA output (THERMOCHEMISTRY AT
# 298.15K section -- checked against an old ORCA 3.0.3 capture, wording
# identical to ORCA 6.1's own tutorial docs). ORCA already prints Eh
# directly, unlike NWChem's kcal/mol-only line, so no unit conversion
# needed in the script.
[EZEROPT]
Script=orca.ezeropt
Begin=Zero point energy
Frequency=last
Skip=0
Lines=1
[END]

# Headline thermochemistry (Total Thermal Energy, Total Enthalpy, the
# T*S entropy term, Gibbs Free Energy) -- new property infrastructure,
# no code extracted any of these before (see data/client/config/
# properties). Real lines verified against a captured ORCA output
# (THERMOCHEMISTRY AT 298.15K section); see orca.thermo's own header
# for the exact text and the EGIBBS wording caveat.
[ETHERM]
Script=orca.thermo
Begin=Total thermal energy
Frequency=last
Skip=0
Lines=1
[END]

[ENTHALPY]
Script=orca.thermo
Begin=Total Enthalpy
Frequency=last
Skip=0
Lines=1
[END]

[ENTROPY]
Script=orca.thermo
Begin=Final entropy term
Frequency=last
Skip=0
Lines=1
[END]

[EGIBBS]
Script=orca.thermo
Begin=Final Gibbs free
Frequency=last
Skip=0
Lines=1
[END]

# Temperature and pressure of the thermochemistry block (two lines).
[THERMOTEMP][THERMOPRES]
Script=orca.thermoconds
Begin=^Temperature\s+\.\.\.
Frequency=last
Skip=0
Lines=2
[END]

# CPCM block: the epsilon, the function type (CPCM/COSMO), the solvent name
# when one was given, and the SMD descriptors that mark SMD.
[SOLVMODEL]
Script=orca.solvmodel
Begin=CPCM SOLVATION MODEL
Frequency=last
Skip=0
Lines=16
[END]

# SMD cavity-dispersion term, in the TOTAL SCF ENERGY component list.
# CPCM without SMD prints no such line.
[ESOLVCDS]
Script=orca.solv
Begin=SMD CDS \(Gcds\)
Frequency=last
Skip=0
Lines=1
[END]

# Matches the SCF iteration data line's own shape directly rather than
# anchoring on a section header -- see orca.deltae's header comment for
# why (no single stable header text works; verified live against a
# real ORCA 6.1.1 run, zero false-positive matches elsewhere in a full
# real output file).
[DELTAE]
Script=orca.deltae
Begin=^\s*\d+\s+-?\d+\.\d+\s+-?\d+\.\d+[eE][+-]\d+
Frequency=all
Skip=0
Lines=1
[END]

# Real line verified against a captured ORCA output:
#   TOTAL RUN TIME: 0 days 0 hours 0 minutes 2 seconds 571 msec
# Deliberately not CPUSEC -- see orca.etime's header comment for why.
[ETIME]
Script=orca.etime
Begin=TOTAL RUN TIME:
Frequency=last
Skip=0
Lines=1
[END]

# Only printed for open-shell (UHF/UKS) jobs; verified against a real
# ORCA 6.1.1 UHF run. Never matches for closed-shell jobs, which is
# correct (S2 stays unset rather than shown as a meaningless 0).
[S2]
Script=orca.s2
Begin=Expectation value of <S\*\*2>
Frequency=last
Skip=0
Lines=1
[END]

# Only present when the input requests CHELPG (ORCA doesn't compute
# ESP charges by default) -- real block verified against a captured
# ORCA 6.1.1 run. Skip=2 (Begin+dashes), End bounds it before the
# "Total charge:" summary line.
[ESPFIT]
Script=orca.espcharge
Begin=CHELPG Charges
Skip=2
Frequency=last
End=Total charge:
[END]

# Begin is the summary table's own COLUMN HEADER, not the
# "CHEMICAL SHIELDING SUMMARY (ppm)" section header one would reach for
# first.  [SHIELDTENSOR] below ends on "CHEMICAL SHIELDING SUMMARY", and
# eccejobmonitor consumes an End-matching line as part of that block, so
# a Begin of "CHEMICAL SHIELDING SUMMARY \(ppm\)" could NEVER match --
# ISOSHIELD/ANISOSHIELD were silently never extracted from any ORCA NMR
# job (found 2026-09-21 by tests/parsers against a real ORCA 6.1.1
# RHF/STO-3G NMR run; same End-line starvation family as [VIBFREQ]/[VIB]
# above).  Anchoring past the other entry's End line fixes it without
# touching [SHIELDTENSOR], whose own Begin line IS its first fed line
# (no Skip), so its End cannot simply be moved onto a dashes line.
# Skip=1 (the Begin line only): orca.isoshield ignores every line that
# is not a "<n> <El> <iso> <aniso>" row, so the dashes line under the
# header is harmless and need not be counted.
[ISOSHIELD][ANISOSHIELD]
Script=orca.isoshield
Begin=^\s*Nucleus\s+Element\s+Isotropic
Skip=1
Frequency=last
End=NMR shielding tensor
[END]

[SHIELDTENSOR][SHIELDEIGVAL]
Script=orca.shieldtensor
Begin=CHEMICAL SHIELDINGS \(ppm\)
Frequency=first
End=CHEMICAL SHIELDING SUMMARY
[END]

# Job progress for the Organizer's Progress box (#284).  No Script: these
# only feed the monitor's live snapshot, not the property table.
# SCF: the energy tolerance is printed once per SCF in its settings (the
# geometry block's own "Energy Change TolE" has no leading space).
# TD-DFT/CIS excited states (#383).  One block from the first "EXCITED
# STATES" header through the electric-dipole absorption table, so both the
# state listing and the spectrum rows reach orca.excited.  End is the velocity
# table's header, which no other entry begins on.
[EXCIENERGY][EXCIOSC][EXCISYM][EXCITRANS]
Script=orca.excited
Begin=^TD-DFT(/TDA)? EXCITED STATES
Skip=0
Frequency=last
End=ABSORPTION SPECTRUM VIA TRANSITION VELOCITY DIPOLE MOMENTS
[END]

[PROGRESS]
Begin=^ Energy Change\s+TolE\s+\.{4}\s+(\S+) Eh
Remember=scftol
[END]

[PROGRESS]
Begin=^\s+(\d+)\s+(-\d+\.\d+)\s+(-?\d\.\d+e[-+]\d+)\s+\d\.\d+e[-+]\d+
Progress=scf cycle=$1 energy=$2 dE=$3/{scftol}
History=dE
[END]

# A relaxed scan: the number of points is in the scan header (one scanned
# parameter; for several the last one is kept and the box drops a total
# smaller than the point number).
[PROGRESS]
Begin=range=\s*-?\d+\.\d+ \.\. -?\d+\.\d+\s+steps =\s+(\d+)
Remember=scanpts
[END]

[PROGRESS]
Begin=RELAXED SURFACE SCAN STEP\s+(\d+)
Progress=scan point=$1/{scanpts}
[END]

# One entry per line of ORCA's convergence table; the cycle line comes
# first so that it starts the record.
[PROGRESS]
Begin=^\s+\*\s+GEOMETRY OPTIMIZATION CYCLE\s+(\d+)\s+\*
Progress=opt step=$1
[END]

[PROGRESS]
Begin=^Current Energy\s+\.{4}\s+(-?\d+\.\d+) Eh
Progress=opt energy=$1
History=energy
[END]

[PROGRESS]
Begin=^\s+Energy change\s+(-?\d+\.\d+)\s+(\d+\.\d+)\s+(?:YES|NO)
Progress=opt dE=$1/$2
[END]

[PROGRESS]
Begin=^\s+MAX gradient\s+(-?\d+\.\d+)\s+(\d+\.\d+)\s+(?:YES|NO)
Progress=opt maxgrad=$1/$2
History=maxgrad
[END]

[PROGRESS]
Begin=^\s+RMS gradient\s+(-?\d+\.\d+)\s+(\d+\.\d+)\s+(?:YES|NO)
Progress=opt rmsgrad=$1/$2
History=rmsgrad
[END]

[PROGRESS]
Begin=^\s+MAX step\s+(-?\d+\.\d+)\s+(\d+\.\d+)\s+(?:YES|NO)
Progress=opt maxstep=$1/$2
[END]

[PROGRESS]
Begin=^\s+RMS step\s+(-?\d+\.\d+)\s+(\d+\.\d+)\s+(?:YES|NO)
Progress=opt rmsstep=$1/$2
[END]

[PROGRESS]
Begin=THE OPTIMIZATION HAS CONVERGED
Progress=opt converged=yes
[END]

[PROGRESS]
Begin=The optimization did not converge but reached the maximum number of
Progress=opt converged=no
[END]

# NEB, NEB-CI and NEB-TS (#466): one record per L-BFGS iteration.  The
# energy is relative to the reactant (ORCA prints no absolute one), so it
# is "erel", not "energy".  The thresholds are printed once in the NEB
# settings; the climbing-image columns exist only after the switch-on.
[PROGRESS]
Begin=Max\(\|Fp\|\)\s+\.{4}\s+(\d\.\d+e[-+]\d+) Eh/Bohr
Remember=nebmaxf
[END]

[PROGRESS]
Begin=RMS\(Fp\)\s+\.{4}\s+(\d\.\d+e[-+]\d+) Eh/Bohr
Remember=nebrmsf
[END]

[PROGRESS]
Begin=Max\(\|F\|\)\s+\.{4}\s+(\d\.\d+e[-+]\d+) Eh/Bohr
Remember=nebmaxc
[END]

[PROGRESS]
Begin=RMS\(F\)\s+\.{4}\s+(\d\.\d+e[-+]\d+) Eh/Bohr
Remember=nebrmsc
[END]

[PROGRESS]
Begin=^\s+LBFGS\s+(\d+)\s+\d+\s+(-?\d+\.\d+)\s+(\d+\.\d+)\s+(\d+\.\d+)\s+\d+\.\d+
Progress=neb iter=$1 erel=$2 maxforce=$3/{nebmaxf} rmsforce=$4/{nebrmsf}
History=erel
[END]

[PROGRESS]
Begin=^\s+LBFGS\s+\d+\s+\d+\s+-?\d+\.\d+\s+\d+\.\d+\s+\d+\.\d+\s+\d+\.\d+\s+(\d+\.\d+)\s+(\d+\.\d+)
Progress=neb maxcforce=$1/{nebmaxc} rmscforce=$2/{nebrmsc}
[END]

# Numerical frequencies count displaced geometries.  An analytic Hessian
# counts the CP-SCF perturbations solved.  The CP-SCF solver also runs for
# NMR and polarizabilities, so only a Hessian ("Nuclear geometric
# perturbations ... YES") switches the iteration lines on.
[PROGRESS]
Begin=<< Calculating gradient on displaced geometry\s+(\d+) \(of\s+(\d+)\) >>
Progress=freq kind=numerical point=$1/$2
[END]

[PROGRESS]
Begin=^Nuclear geometric perturbations\s+\.\.\.\s+YES
Remember=hessian
Value=freq
[END]

[PROGRESS]
Begin=^Nuclear geometric perturbations\s+\.\.\.\s+YES\s+\(\s*(\d+) perturbations
Progress=freq kind=analytic point=0/$1
[END]

[PROGRESS]
Begin=\|\|err\|\|_max\s+=\s+\S+\s+\(\s*\S+ sec\s+(\d+)/\s*(\d+) done\)
Progress={hessian} kind=analytic point=$1/$2
[END]

[PROGRESS]
Begin=^SCF HESSIAN\s*$
Remember=hessian
Value=-
[END]

[PROGRESS]
Begin=^SCF HESSIAN\s*$
Progress=freq phase=assemble
[END]

[PROGRESS]
Begin=^Zero point energy\s+\.\.\.\s+(-?\d+\.\d+) Eh
Progress=freq done=yes zpe=$1
[END]
