#!/usr/bin/env python3
"""Write residue and topology-molecule groups for the staged GROMACS task."""
import errno
import os
import re
import sys


# Perl's buffered regular-file reads leave ENOTTY in $!, which die returns.
def fail(message, code=errno.ENOTTY):
    ending = '\r\n' if os.name == 'nt' else '\n'
    sys.stderr.buffer.write((message + ending).encode('utf-8', 'surrogateescape'))
    raise SystemExit(code)


NL = None if os.name == 'nt' else ''

def read(path):
    try:
        # Group definitions can be appended to this file: preserve unrecognised bytes.
        with open(path, encoding='utf-8', errors='surrogateescape', newline=NL) as f:
            return f.read()
    except OSError as e:
        fail('gromacs.mkndx: cannot read {}: {}'.format(path, e.strerror), e.errno)


def write(path, text, mode='w'):
    try:
        with open(path, mode, encoding='utf-8', errors='surrogateescape', newline=NL) as f:
            f.write(text)
    except OSError as e:
        fail('gromacs.mkndx: cannot write {}: {}'.format(path, e.strerror), e.errno)


def number(s):
    m = re.match(r'\s*[+-]?(?:\d+\.?\d*|\.\d+)(?:[eE][+-]?\d+)?', s, re.ASCII)
    return float(m[0]) if m else 0


class Topology:
    def __init__(self, defined):
        self.defined = defined
        self.visited = set()
        self.atoms = {}
        self.order = []

    def include(self, name, parent):
        flat = name.replace('/', '__SLASH__')
        candidates = [os.path.join(d, n) for d in (parent, '.') for n in (name, flat)]
        dirs = [os.environ.get('GMXLIB'),
                os.path.join(os.environ['GMXDATA'], 'top') if os.environ.get('GMXDATA') else None,
                '/usr/share/gromacs/top']
        candidates += [os.path.join(d, name) for d in dirs if d is not None]
        return next((p for p in candidates if os.path.isfile(p)), None)

    def read(self, path):
        if path in self.visited:
            return
        self.visited.add(path)
        try:
            with open(path, encoding='utf-8', errors='surrogateescape', newline=NL) as f:
                lines = f.readlines()
        except OSError:
            return
        sect, cur, named, on = '', '', False, [True]
        for line in lines:
            line = line.split(';')[0]
            if not line.strip():
                continue
            m = re.match(r'^\s*#\s*if(n?)def\s+(\w+)', line, re.ASCII)
            if m:
                on.append(on[-1] and (bool(m[1]) != (m[2] in self.defined)))
                continue
            if re.match(r'^\s*#\s*else', line):
                if len(on) > 1:
                    on[-1] = on[-2] and not on[-1]
                continue
            if re.match(r'^\s*#\s*endif', line):
                if len(on) > 1:
                    on.pop()
                continue
            if not on[-1]:
                continue
            define = re.match(r'^\s*#\s*define\s+(\w+)', line, re.ASCII)
            inc = re.match(r'^\s*#\s*include\s+"([^"]+)"', line)
            section = re.match(r'^\s*\[\s*(\w+)\s*\]', line, re.ASCII)
            if define:
                self.defined.add(define[1])
            elif inc:
                if re.search(r'(forcefield|ffbonded|ffnonbonded)\.itp$', inc[1]):
                    continue
                found = self.include(inc[1], os.path.dirname(path) or '.')
                if found:
                    self.read(found)
            elif re.match(r'^\s*#', line):
                continue
            elif section:
                sect = section[1].lower()
                if sect == 'moleculetype':
                    named = False
            elif sect == 'moleculetype' and not named:
                cur = line.split()[0]
                named = True
                self.atoms[cur] = 0
            elif sect == 'atoms' and cur:
                self.atoms[cur] += 1
            elif sect == 'molecules':
                fields = line.split()
                self.order.append((fields[0], number(fields[1]) if len(fields) > 1 else 0))


def block(name, indices):
    return '[ {} ]\n'.format(name) + ''.join(
        ''.join('{:4d} '.format(i) for i in indices[j:j + 15]) + '\n'
        for j in range(0, len(indices), 15))


def main(args):
    if not 3 <= len(args) <= 4:
        fail('usage: gromacs.mkndx conf.gro run.mdp out.ndx [topol.top]', 255)
    gro, mdp, out = args[:3]
    top = args[3] if len(args) == 4 else None
    mdp_text = read(mdp)
    defs, defined = [], set()
    for line in mdp_text.splitlines(True):
        m = re.match(r'^;\s*ecce-group\s+(\S+)\s*=\s*(.+?)\s*$', line, re.ASCII)
        if m:
            defs.append((m[1], re.split(r'\s+', m[2], flags=re.ASCII)))
        m = re.match(r'^\s*define\s*=\s*([^;]*)', line, re.ASCII)
        if m:
            defined.update(re.findall(r'-D(\w+)', m[1], re.ASCII))
    if not defs:
        return 0
    lines = read(gro).splitlines(True)
    n = int(number(lines[1])) if len(lines) > 1 else 0
    residues, xyz = [], []
    for line in lines[2:2 + n]:
        residues.append(line[5:10].strip())
        xyz.append([number(line[20 + 8 * i:28 + 8 * i]) for i in range(3)])
    if len(residues) != n or n == 0:
        fail('gromacs.mkndx: {} lists {} atoms, not the {} it declares.'.format(gro, len(residues), n), 255 if len(residues) != n else errno.ENOTTY)
    seen = set(residues)
    mol_atoms = None

    def molecule_atoms(name):
        nonlocal mol_atoms
        if mol_atoms is None:
            if top is None or not os.path.isfile(top):
                fail('gromacs.mkndx: a group asks for a molecule (mol:{}) and no topology was given.'.format(name),
                     errno.ENOENT if top is not None else errno.ENOTTY)
            topology = Topology(defined)
            topology.read(top)
            mol_atoms, at = {}, 0
            for mol, count in topology.order:
                size = topology.atoms.get(mol, 0)
                if not size:
                    fail('gromacs.mkndx: molecule {} of the topology has no [ atoms ] that could be found, '
                         'so the atoms of {} cannot be placed.'.format(mol, name), 255)
                for i in range(int(count + (count % 1 > 0))):
                    mol_atoms.setdefault(mol, []).extend(range(at + 1, at + size + 1))
                    at += size
            if at != n:
                fail("gromacs.mkndx: the topology's molecules hold {} atoms, the structure {}.".format(at, n), 255)
        if not mol_atoms.get(name):
            fail('gromacs.mkndx: the topology has no molecule named {}; it has: {}.'.format(
                name, ' '.join(sorted(mol_atoms))), 255)
        return mol_atoms[name]

    text, members = block('System', list(range(1, n + 1))), {}
    for name, names in defs:
        extra = set()
        for res in names:
            if res.startswith('mol:') and len(res) > 4:
                extra.update(molecule_atoms(res[4:]))
            elif res not in seen:
                fail('gromacs.mkndx: group {} asks for residue name {}, which is not in the structure; '
                     'it has: {}.'.format(name, res, ' '.join(sorted(seen))))
        idx = [i for i in range(1, n + 1) if residues[i - 1] in names or i in extra]
        text += block(name, idx)
        members[name] = idx
    pull, has_atom = {}, set()
    for line in mdp_text.splitlines(True):
        line = line.split(';')[0]
        m = re.match(r'^\s*pull[-_]group(\d+)[-_]name\s*=\s*(\S+)', line, re.I | re.ASCII)
        if m:
            pull[m[1]] = m[2]
        m = re.match(r'^\s*pull[-_]group(\d+)[-_]pbcatom\s*=', line, re.I | re.ASCII)
        if m:
            has_atom.add(m[1])
    add = ''
    for group in sorted(pull):
        idx = members.get(pull[group], [])
        if group in has_atom or len(idx) < 2:
            continue
        centre = [sum(xyz[i - 1][k] / len(idx) for i in idx) for k in range(3)]
        best = min(idx, key=lambda i: sum((xyz[i - 1][k] - centre[k]) ** 2 for k in range(3)))
        add += 'pull-group%d-pbcatom      = %d\n' % (int(group), best)
    if add:
        write(mdp, add, 'a')
    write(out, text)
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
