#!/usr/bin/env perl
# GEOMTRACE for the Input and Z-Matrix orientation blocks of Gaussian 16:
# holds the block back until it is known whether a Standard block follows (see gaussian-16-trace.pl).
push(@INC,"$ENV{ECCE_HOME}/scripts/parsers");
require "pertab.pl";
require "gaussian-16-trace.pl";
&loadPT;
$| = 1;
($key, $runtype, $ucCategory, $theory) = @ARGV;
my ($rows, $labels) = readBlock();
# An earlier Input block that no Standard block followed is its own step.
my ($oldRows, $oldLabels) = takeStash($key);
emitFrame($key, $oldRows, $oldLabels);
saveStash($key, $rows, $labels);
exit(0);
