#!/usr/bin/env python3
import importlib
import os
import sys

sys.path.insert(0, os.path.join(os.environ["ECCE_HOME"], "scripts", "parsers"))
trace = importlib.import_module("gaussian-16-trace")
trace.configure_streams()
key, runtype = (sys.argv[1:] + ["", ""])[:2]
rows, labels = trace.read_block()
# A held Input block with no following Standard block is its own step.
old_rows, old_labels = trace.take_stash(key)
trace.emit_frame(key, old_rows, old_labels)
trace.save_stash(key, rows, labels)
if "irc" in runtype.lower():
    trace.save_irc_input(key, rows)
