# Parse descriptor for GAUSSIAN-03 output file.

[ORBOCC1][ORBOCCBETA]
Script=gaussian-16.orbocc
Begin=Orbital symmetries
Frequency=last
End=Condensed to atoms
[END]

[ORBOCC2][ORBOCCBETA]
Script=gaussian-16.orbocc
Begin=Molecular Orbital Coefficients
Frequency=last
End=Condensed to atoms
[END]

[NULL3]
Script=gaussian-16.null
Begin=Making orbital integer symmetry
Frequency=all
End=CISAX will form
[END]

[SCANCOORD][SCANENERGY]
Script=gaussian-16.scan
Begin=Summary of Optimized Potential Surface Scan
Frequency=last
End=Largest change from initial coordinates
[END]

# Relaxed scan structures (#410): needs the whole log, since a point's
# converged geometry is only known from the "Optimization completed" after it.
[SCANGEOM]
Script=gaussian-16.scangeom
File=g16.g16out
Begin=g16.g16out
[END]

[IRCCOORD][IRCENERGY]
Script=gaussian-16.irc
Begin=Energies reported relative to the TS energy
Frequency=last
End=Total number of points
[END]

[IRCGEOM]
Script=gaussian-16.ircgeom
Begin=CURRENT STRUCTURE
Frequency=all
End=CHANGE IN THE REACTION COORDINATE
[END]

# One frame per step: Input/Z-Matrix blocks are held by geomtrace-input and
# replaced by the Standard block, or published on "Symmetry turned off" (#498).
[GEOMTRACE]
Script=gaussian-16.geomtrace-input
Begin=Input orientation\:
Skip=5
Frequency=all
End=--------------------------------------
[END]

[GEOMTRACE]
Script=gaussian-16.geomtrace-input
Begin=Z-Matrix orientation\:
Skip=5
Frequency=all
End=--------------------------------------
[END]

[GEOMTRACE1]
Script=gaussian-16.geomtrace
Begin=Standard orientation\:
Skip=5
Frequency=all
End=--------------------------------------
[END]

# Not a property: only releases the held Input block.
[GEOMTRACE2]
Script=gaussian-16.geomtrace-flush
Begin=Symmetry turned off
Skip=1
Frequency=all
Lines=1
[END]

[EGRAD]
Script=gaussian-16.egrad
Begin=Cartesian Forces\:
Frequency=all
Skip=0
Lines=1
[END]

[EGRADVEC]
Script=gaussian-16.egradvec
Begin=             Forces
Frequency=last
Skip=3
End=--------------------------------------
[END]

#The key used for a property that is derived from an auxiliary file cannot
#match any entries in the properties file
[MOFILE]
Script=gaussian-16.mo
File=fort.7
Begin=fort.7
[END]

[ESP]
Script=gaussian-16.esp
File=grid.dat
Begin=grid.dat
[END]

[DELTAE]
Script=gaussian-16.deltae
Begin=Delta\-E
Frequency=all
Skip=0
Lines=1
[END]

[RMSDP]
Script=gaussian-16.rmsdp
Begin=RMSDP
Frequency=all
Skip=0
Lines=1
[END]

[CPUSEC]
Script=gaussian-16.cpusec
Begin=Job cpu time\:
Frequency=all
Skip=0
Lines=1
[END]

[KE][NNREPUL]
Script=gaussian-16.ke
Begin=N\-N\=
Frequency=all
Skip=0
Lines=1
[END]

[VIB][VIBFREQ][VIBIR][VIBRAM][VIBSYM]
Script=gaussian-16.vib
Begin=reduced masses \(AMU\), force constants \(mDyne\/A\)
Frequency=first
End=-------------------
[END]

# Freq=Anharmonic, requestable from the Runtype Details dialog since #110.
# The harmonic block above is still printed by an anharmonic job and still
# feeds VIB/VIBFREQ/...; this is the second-order perturbative analysis
# printed after it.  End= lands on the units banner of the NEXT table in
# the same section (dipole strengths rather than integrated intensities),
# which is a line no other entry Begins on -- an End that lands on another
# entry's Begin silently starves that entry forever.
[ANHARMFREQ][ANHARMIR]
Script=gaussian-16.anharm
Begin=Anharmonic Infrared Spectroscopy
Frequency=first
End=Dipole strengths \(DS\)
[END]

[NULL1]
Script=gaussian-16.null
Begin=Proceeding to internal job step
Frequency=first
End=Harmonic frequencies
[END]

# The block also swallows the rest of the output up to the next
# "Cartesian Forces" line, as the NULL2 entry it replaces did, so the
# entries below cannot match inside it.
[EZEROPT][ETHERM][ENTHALPY][EGIBBS][ENTROPY][THERMOTEMP][THERMOPRES]
Script=gaussian-16.thermo
Begin= Thermochemistry
Frequency=last
End=Cartesian Forces
[END]

# Model and solvent from the last PCM block (the final geometry).  End on
# the rule after "Solvent :": G16 prints "Spheres list" only for a small
# cavity (none at 26 spheres), and a block that never ends swallows every
# later property of the run.
[SOLVMODEL]
Script=gaussian-16.solvmodel
Begin=Polarizable Continuum Model \(PCM\)
Frequency=last
End=^ -{20,}\s*$
[END]

# SMD only; PCM prints no solvation term of its own.
[ESOLVCDS]
Script=gaussian-16.solv
Begin=SMD-CDS \(non-electrostatic\) energy
Frequency=last
Skip=0
Lines=1
[END]

[DIPOLE1]
Script=gaussian-16.dipole
Begin=Dipole moment\=
Frequency=last
Lines=1
[END]

[DIPOLE2]
Script=gaussian-16.dipole
Begin=Dipole moment \(field\-independent basis\, Debye\)\:
Frequency=last
Lines=1
Skip=1
[END]

[QUADPOLE1]
Script=gaussian-16.quadpole
Begin=Quadrupole moment \(field\-independent basis\, Debye\-Ang\)\:
Frequency=last
End=Traceless
Skip=1
[END]

[OCTAPOLE2]
Script=gaussian-16.octapole
Begin=Octapole moment \(field\-independent basis\, Debye\-Ang\*\*2\)\:
Frequency=last
Lines=3
Skip=1
[END]

[HEXPOLE]
Script=gaussian-16.hexpole
Begin=Hexadecapole moment \(field\-independent basis\, Debye\-Ang\*\*3\)\:
Frequency=last
Lines=4
Skip=1
[END]

[POLARIZ1][HYPERPOL1]
Script=gaussian-16.db
Begin=l9999\.exe
Frequency=last
End=Job cpu
[END]

[POLARIZ2][HYPERPOL1]
Script=gaussian-16.db
Begin= 1\\1\\GINC
Frequency=last
End=Job cpu
[END]

[SHIELDTENSOR][ISOSHIELD][ANISOSHIELD][SHIELDEIGVAL]
Script=gaussian-16.shieldtensor
Begin=Magnetic shielding
Frequency=first
End= Leave Link 1002
[END]

[MULLIKEN]
Script=gaussian-16.mulliken
Begin= Mulliken (atomic )?charges( and spin densities)?\:
Skip=2
Frequency=all
End= Sum of Mulliken
[END]

# Only printed on request: APT with Freq, ESP charges with Pop=MK/CHELPG/HLY
# (the label is "ESP charges" for all three), Hirshfeld and CM5 with
# Pop=Hirshfeld or Pop=CM5 (one table, two columns; naming both prints
# neither), NPA with Pop=NPA.  Begin for
# the Hirshfeld table must not match "Hirshfeld charges with hydrogens
# summed", which comes right after it.
[APT]
Script=gaussian-16.apt
Begin= APT charges\:
Skip=2
Frequency=last
End= Sum of APT
[END]

[ESPFIT]
Script=gaussian-16.espfit
Begin= ESP charges\:
Skip=2
Frequency=last
End= Sum of ESP
[END]

[HIRSHFELD][CM5]
Script=gaussian-16.hirshfeld
Begin= Hirshfeld charges, spin densities
Skip=2
Frequency=last
End=^\s+Tot\s
[END]

# AIM=(CP): the attractor-to-nucleus table (section I) and the charges
# (section III) are far apart, so the block spans both.
[AIM]
Script=gaussian-16.aim
Begin= I\. ATTRACTORS
Skip=0
Frequency=last
End=^ Total\s+\d+\.\d+\s+\d+\.\d+
[END]

# TD-DFT/CIS excited states.  One block per geometry, so an Opt+TD job
# prints several; the last is the converged geometry.  End is the line that
# follows the last root's transitions in every TD run.
[EXCIENERGY][EXCIOSC][EXCISYM][EXCITRANS]
Script=gaussian-16.excited
Begin=Excitation energies and oscillator strengths
Skip=0
Frequency=all
End=SavETr:
[END]

[NPA]
Script=gaussian-16.npa
Begin= Summary of Natural Population Analysis
Skip=1
Frequency=last
End=\* Total \*
[END]

[FERMICON]
Script=gaussian-16.fermicon
Begin=Fermi
Skip=2
Frequency=first
End=-------------------
[END]

# Excited-state optimisation (#521): flag it from the route, which precedes
# every energy; gaussian-16.excited then gives TE/TEVEC the TD total energy.
[ROUTEFLAG]
Script=gaussian-16.routeflag
Begin=^ #
Frequency=first
Skip=0
Lines=4
[END]

