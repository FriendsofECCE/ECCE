# Parse descriptor for ecce-qm output (the built-in engine, code ECCE-QM).
# Every piece of the output starts with a line that names it, so one script,
# ecceqm.parse, serves all entries; each entry's Begin matches exactly one
# kind of line (no two Begins may match the same line, see mopac.desc).
# Skip=0 feeds the Begin line itself, which is how the script tells the
# pieces apart.  Block pieces end on their own "end <name>" line.  Format:
# docs/qm/README.md.

[TE]
Script=ecceqm.parse
Begin=^energy_total\s
Frequency=last
Skip=0
Lines=1
[END]

# One block per geometry of a gradient or optimisation run (none for Energy),
# written as soon as the step is done: the geometry trace, the energy trace
# (TE above stays the final energy) and the gradient.
[TEVEC]
Script=ecceqm.parse
Begin=^energy_step\s
Frequency=all
Skip=0
Lines=1
[END]

[GEOMTRACE]
Script=ecceqm.parse
Begin=^begin geometry\b
Frequency=all
Skip=0
End=^end geometry
[END]

[EGRAD][EGRADVEC]
Script=ecceqm.parse
Begin=^begin gradient\b
Frequency=all
Skip=0
End=^end gradient
[END]

# Relaxed scan: the engine rewrites the table after every point, so the last
# one is the whole scan; each point's structure is a block of its own.
[SCANCOORD][SCANENERGY]
Script=ecceqm.parse
Begin=^begin scan_table\b
Frequency=last
Skip=0
End=^end scan_table
[END]

[SCANGEOM]
Script=ecceqm.parse
Begin=^begin scan_geometry\b
Frequency=all
Skip=0
End=^end scan_geometry
[END]

# IRC: the table is rewritten after every point; the structures come once at
# the end, in path order with the TS in the middle (as in orca.desc).
[IRCCOORD][IRCENERGY]
Script=ecceqm.parse
Begin=^begin irc_table\b
Frequency=last
Skip=0
End=^end irc_table
[END]

[IRCGEOM]
Script=ecceqm.parse
Begin=^begin irc_geometry\b
Frequency=all
Skip=0
End=^end irc_geometry
[END]

[NNREPUL]
Script=ecceqm.parse
Begin=^energy_nuclear\s
Frequency=last
Skip=0
Lines=1
[END]

[ONEELEC]
Script=ecceqm.parse
Begin=^energy_one_electron\s
Frequency=last
Skip=0
Lines=1
[END]

[COULOMB]
Script=ecceqm.parse
Begin=^energy_coulomb\s
Frequency=last
Skip=0
Lines=1
[END]

[EXCHANGE]
Script=ecceqm.parse
Begin=^energy_exchange_hf\s
Frequency=last
Skip=0
Lines=1
[END]

[EXCORR]
Script=ecceqm.parse
Begin=^energy_xc\s
Frequency=last
Skip=0
Lines=1
[END]

[S2]
Script=ecceqm.parse
Begin=^s_squared\s
Frequency=last
Skip=0
Lines=1
[END]

[ETIME]
Script=ecceqm.parse
Begin=^wall_seconds\s
Frequency=last
Skip=0
Lines=1
[END]

[DIPOLE]
Script=ecceqm.parse
Begin=^dipole_debye\s
Frequency=last
Skip=0
Lines=1
[END]

[MULLIKEN]
Script=ecceqm.parse
Begin=^begin atoms\b
Frequency=last
Skip=0
End=^end atoms
[END]

# Extra charge sets ("charges" keyword): LOEWDIN, ESPFIT (CHELPG) and MKFIT
# (Merz-Kollman) are one block each.
[LOEWDIN]
Script=ecceqm.parse
Begin=^begin charges loewdin\b
Frequency=last
Skip=0
End=^end charges
[END]

[ESPFIT]
Script=ecceqm.parse
Begin=^begin charges chelpg\b
Frequency=last
Skip=0
End=^end charges
[END]

[MKFIT]
Script=ecceqm.parse
Begin=^begin charges mk\b
Frequency=last
Skip=0
End=^end charges
[END]

[ORBENG][ORBOCC]
Script=ecceqm.parse
Begin=^begin orbitals (restricted|alpha)
Frequency=last
Skip=0
End=^end orbitals
[END]

[ORBENGBETA][ORBOCCBETA]
Script=ecceqm.parse
Begin=^begin orbitals beta
Frequency=last
Skip=0
End=^end orbitals
[END]

[MO][MOAOORDER]
Script=ecceqm.parse
Begin=^begin mo_coefficients (restricted|alpha)
Frequency=last
Skip=0
End=^end mo_coefficients
[END]

[MOBETA]
Script=ecceqm.parse
Begin=^begin mo_coefficients beta
Frequency=last
Skip=0
End=^end mo_coefficients
[END]


# Frequency runs (Vibration, GeoVib).  Like ORCA's, VIBFREQ, VIBIR and VIB
# list all 3N modes with the translations and rotations first, at zero.
[VIBFREQ][VIBIR]
Script=ecceqm.parse
Begin=^begin vibrations\b
Frequency=last
Skip=0
End=^end vibrations
[END]

# Raman runs: activity (A^4/amu) and depolarization ratio, all 3N rows like
# VIBFREQ, the translations and rotations at 0.
[VIBRAM][VIBRAMDEPOL]
Script=ecceqm.parse
Begin=^begin raman\b
Frequency=last
Skip=0
End=^end raman
[END]

# Static polarisability ("polarizability" keyword, and Raman runs).
[POLARIZ]
Script=ecceqm.parse
Begin=^begin polarizability\b
Frequency=last
Skip=0
End=^end polarizability
[END]

[VIB]
Script=ecceqm.parse
Begin=^begin normal_modes\b
Frequency=last
Skip=0
End=^end normal_modes
[END]

[EZEROPT]
Script=ecceqm.parse
Begin=^zero_point_energy\s
Frequency=last
Skip=0
Lines=1
[END]

[THERMOTEMP]
Script=ecceqm.parse
Begin=^thermo_temperature\s
Frequency=last
Skip=0
Lines=1
[END]

[THERMOPRES]
Script=ecceqm.parse
Begin=^thermo_pressure_atm\s
Frequency=last
Skip=0
Lines=1
[END]

[ETHERM]
Script=ecceqm.parse
Begin=^thermal_energy\s
Frequency=last
Skip=0
Lines=1
[END]

[ENTHALPY]
Script=ecceqm.parse
Begin=^enthalpy\s
Frequency=last
Skip=0
Lines=1
[END]

[ENTROPY]
Script=ecceqm.parse
Begin=^entropy_ts\s
Frequency=last
Skip=0
Lines=1
[END]

[EGIBBS]
Script=ecceqm.parse
Begin=^gibbs_energy\s
Frequency=last
Skip=0
Lines=1
[END]


# Job progress for the Organizer (#284), not properties: eccejobmonitor tests
# every line against these, inside other entries' blocks too, and keeps a
# snapshot it sends at most once a second.  Progress is "<stage> key=value
# ...", $1.. from Begin; a record (cycle, step, point) that changes clears
# the stage's other keys.  History keeps one value per record for a plot.
[PROGRESS]
Begin=^progress scf (.*)$
Progress=scf $1
History=dE
[END]

[PROGRESS]
Begin=^progress opt (.*)$
Progress=opt $1
History=energy
[END]

[PROGRESS]
Begin=^progress freq (.*)$
Progress=freq $1
[END]

[PROGRESS]
Begin=^progress irc (.*)$
Progress=irc $1
[END]

[PROGRESS]
Begin=^progress scan (.*)$
Progress=scan $1
[END]
