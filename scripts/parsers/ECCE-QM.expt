#!/usr/bin/env perl
###############################################################################
# FILENAME:  ECCE-QM.expt
#
# SYNTAX: ECCE-QM.expt <outfile>
#
# PURPOSE:
#       Reads an ecce-qm output file and generates the ECCE .frag/.param/.gbs
#       triple, so it can be imported as a completed calculation.  The output
#       carries everything but the shells of the basis, so the basis is
#       recorded by its library name (the "basis" line), and a run with a
#       basis of its own ("custom") imports without one.  Format of the
#       output: docs/qm/README.md.
###############################################################################

use Getopt::Std;

$| = 1;
&getopts(':hv');
&usage && exit if ($opt_h || $opt_help);
exit if ($opt_v);
&usage if ($#ARGV != 0);

open(INPUT, $ARGV[0]) || die "Can't locate output file $ARGV[0]";
my (%kv, @atoms);
my $inAtoms = 0;
while (<INPUT>) {
  chomp;
  if (/^begin atoms/) { $inAtoms = 1; next; }
  if (/^end atoms/) { $inAtoms = 0; next; }
  if ($inAtoms) {
    my @f = split(' ', $_);
    push(@atoms, [@f[1, 3, 4, 5]]) if (@f >= 6);
    next;
  }
  $kv{$1} = $2 if (/^(\w+)\s+(.*?)\s*$/);
}
close(INPUT);

if (!@atoms) {
  print "No molecular geometry found in $ARGV[0]\n";
  exit(1);
}

my $method = $kv{method};
my ($category, $theory) = ($method eq 'hf') ? ('SCF', 'HF') : ('DFT', 'DFT');
my %functional = (svwn => 'SVWN', pbe => 'PBE', b3lyp => 'B3LYP', pbe0 => 'PBE0');
my $reference = $kv{reference};
my $unrestricted = ($reference =~ /^u/) ? 1 : 0;

($title = $ARGV[0]) =~ s/\.[^.]*$//;
(my $root = $ARGV[0]) =~ s/\.[^.]*$//;

open(PARAMS, ">$root.param");
print(PARAMS "title:\t$title\n");
print(PARAMS "Category:\t$category\n");
print(PARAMS "Theory:\t$theory\n");
print(PARAMS "RunType:\tEnergy\n");
print(PARAMS "Charge:\t" . (defined($kv{charge}) ? $kv{charge} : 0) . "\n");
print(PARAMS "ES.ChemSys.Multiplicity:\t$kv{multiplicity}\n") if (defined($kv{multiplicity}));
print(PARAMS "ES.Theory.DFT.XCFunctionals:\t$functional{$method}\n") if ($category eq 'DFT' && $functional{$method});
print(PARAMS "ES.Theory.ECCEQM.Unrestricted:\t1\n") if ($unrestricted);
print(PARAMS "SphericalBasis:\tTRUE\n");
close(PARAMS);

open(MOL, ">$root.frag");
print(MOL "title:\t$title\ntype:\tmolecule\n");
print(MOL "charge:\t" . (defined($kv{charge}) ? $kv{charge} : 0) . "\n");
print(MOL "num_atoms:\t" . scalar(@atoms) . "\n");
print(MOL "atom_info:\tsymbol cart\natom_list:\n");
my %seen;
foreach my $a (@atoms) {
  print(MOL " $a->[0] $a->[1] $a->[2] $a->[3]\n");
  $seen{$a->[0]} = 1;
}
close(MOL);

my $basis = $kv{basis};
if (defined($basis) && $basis ne 'custom') {
  open(GBS, ">$root.gbs");
  print(GBS "NameBasis\nbasis \"ao basis\" spherical print\n");
  foreach my $sym (sort keys(%seen)) {
    print(GBS "$sym library \"$basis\"\n");
  }
  print(GBS "END\nEndNameBasis\n");
  close(GBS);
}
exit(0);

sub usage {
  print "Usage: ECCE-QM.expt <outfile>\n";
  print "Options:    -h        this help\n";
  print "            -v        version\n";
  exit;
}
