#!/usr/bin/env perl
# GEOMTRACE for the Standard orientation block of Gaussian 16: publishes it
# and drops the Input block held for the same step (see gaussian-16-trace.pl).
push(@INC,"$ENV{ECCE_HOME}/scripts/parsers");
require "pertab.pl";
require "gaussian-16-trace.pl";
&loadPT;
$| = 1;
($key, $runtype, $ucCategory, $theory) = @ARGV;
my ($rows, $labels) = readBlock();
takeStash($key);
emitFrame($key, $rows, $labels);
exit(0);
