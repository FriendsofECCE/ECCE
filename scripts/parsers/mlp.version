#!/usr/bin/env python3
# The model, its software version and licence, from the three header lines
# ecce-mlp prints ("Model:", "Version:", "Licence:"), as one VERSION string.
import re
import sys
from xtb_parse import configure_streams

configure_streams()
values = {}
# Free-text metadata must retain the original bytes, as in xtb.expt.
for raw in sys.stdin.buffer:
    line = raw.decode("utf-8", "replace")
    for key in ("Model", "Version", "Licence"):
        pattern = r"^" + key + r":\s+(.+?)\s*$"
        if re.search(pattern, line, re.ASCII):
            values[key] = re.search(pattern.encode("ascii"), raw, re.ASCII).group(1)
if "Model" not in values:
    sys.exit(0)
value = values["Model"]
more = []
if "Version" in values:
    more.append(values["Version"])
if "Licence" in values:
    more.append(b"licence " + values["Licence"])
if more:
    value += b" (" + b", ".join(more) + b")"
sys.stdout.buffer.write(b"key: VERSION\nsize:\n1\nvalues:\n" + value + b"\nEND\n")
