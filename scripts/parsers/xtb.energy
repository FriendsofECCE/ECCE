#!/usr/bin/env python3
# The final total energy, from the closing summary box:
#   "          | TOTAL ENERGY               -5.070370761845 Eh   |"
# xtb prints Hartree already.
import re
import sys
from xtb_parse import configure_streams, scalar

configure_streams()
line = sys.stdin.readline()
m = re.search(r"TOTAL ENERGY\s+(-?\d+\.\d+)\s+Eh", line, re.ASCII)
if m:
    scalar("TE", m.group(1), "Hartree")
