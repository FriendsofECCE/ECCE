#!/usr/bin/env python3
################################################################################
#
# Purpose:
#   The simulation time (ps) of one log step, from the "Step  Time" value row,
#   into TIMEVEC.  It accumulates beside TEVEC/PRESSVEC, one point per step, so
#   the Viewer's step plots can put time on the x axis.  gromacs.energy cannot
#   read it: its block starts at "Energies", after the time line.
#
################################################################################

import re
import sys
from xtb_parse import configure_streams

configure_streams()

for raw in sys.stdin.buffer:
    line = raw.decode("utf-8", "replace")
    match = re.search(r"^\s*\d+\s+(-?\d+\.\d+)\s*$", line, re.ASCII)
    if match:
        print("key: TIMEVEC\nsize:\n1\nvalues:\n {}\nunits:\nps\nEND".format(match.group(1)))
        break
