#!/usr/bin/env python3
################################################################################
#
# Purpose:
# Extracts energies from a GROMACS mdrun .log block into ECCE's TE and
# TEVEC properties.
#
# Input is one block of a real mdrun log (verified against GROMACS
# 2025.2):
#
#            Step           Time
#               2        2.00000
#
#    Energies (kJ/mol)
#         LJ (SR)   Coulomb (SR)   Coul. recip.      Potential Pressure (bar)
#     2.32600e+03   -9.67730e+03    1.85069e+02   -7.16623e+03    5.66364e+03
#
# THE COLUMNS ARE NOT FIXED. Which terms appear depends on the run: a
# minimisation has no kinetic energy or temperature, an NVT run adds
# "Kinetic En.", "Total Energy", "Temperature" and a thermostat term, PME
# adds "Coul. recip.", and so on. So the header line has to be read and
# the wanted column located by NAME rather than by position -- hardcoding
# an index would silently read the wrong quantity the first time someone
# changed the integrator, which is the same class of bug as this
# project's .desc column assumptions.
#
# The header is fixed-width, not whitespace-delimited: "LJ (SR)" and
# "Coul. recip." both contain spaces. GROMACS writes each field in 15
# columns, so the header is split on that rather than on whitespace.
#
# Units are kJ/mol, which ECCE's EnergyConverter already knows as
# "kJoule/Mole" -- so unlike Quantum ESPRESSO (whose Rydberg has no entry
# at all and has to be converted to Hartree by every parser) these can be
# published as they are.
#
################################################################################
import re
import sys
from xtb_parse import WS, configure_streams, fields

configure_streams()

terms = {}
saw_energies = False
closed = False
# A real step has a Step Time header; the run summary instead starts:
#     <====  A V E R A G E S  ====>
#     Statistics over 501 steps using 6 frames
#        Energies (kJ/mol)
# The summary repeats the energies marker but has no Step header. The
# six-step 500-step fixture has seven energy blocks, including that average.
# gromacs.desc lets gromacs.mdavg consume the summary through Total Virial,
# so its repeated marker cannot fire this parser. Real-step sections start
# at Energies and end at the closing blank line.
rows = iter(sys.stdin.buffer)
for raw in rows:
    raw = raw[:-1] if raw.endswith(b"\n") else raw
    line = raw.decode("utf-8", "replace")
    if re.search(r"^\s*Step\s+Time\s*$", line, re.ASCII):
        continue
    if re.search(r"^\s*Energies\s*\(", line, re.ASCII):
        saw_energies = True
        continue
    if not saw_energies:
        continue
    if re.search(r"^\s*$", line, re.ASCII):
        closed = True
        break
    if not re.search(r"[A-Za-z]", line, re.ASCII):
        continue
    # A block is a sequence of header/value pairs: GROMACS wraps at five
    # terms, so a minimisation prints one pair and dynamics prints two:
    #        LJ (SR)   Coulomb (SR)   Coul. recip.      Potential    Kinetic En.
    #    1.37191e+03   -1.02702e+04    1.01441e+02   -8.79686e+03    1.45954e+03
    #   Total Energy  Conserved En.    Temperature Pressure (bar)
    #   -7.33732e+03   -8.13312e+03    3.01028e+02   -8.59611e+02
    # Stopping after the first pair would report Potential for dynamics while
    # missing the preferred Total Energy on the second pair. Header widths
    # count bytes; decoding first would move non-ASCII columns.
    names = [raw[i:i + 15].strip(WS.encode("ascii")) for i in range(0, len(raw), 15)]
    names = [name for name in names if name]
    if not names:
        continue
    values = next(rows, None)
    if values is None:
        break
    # Match the permissive text view, but retain each original value's bytes.
    decoded = fields(values.decode("utf-8", "replace"))
    raw_values = re.findall(rb"[^ \t\n\r\f\v]+", values, re.ASCII)
    if len(decoded) == len(names):
        terms.update(zip(names, raw_values))


def emit(key, value, units, leading=True):
    header = "key: {}\nsize:\n1\nvalues:\n".format(key).encode("ascii")
    sys.stdout.buffer.write(header + (b" " if leading else b"") + value +
                            "\nunits:\n{}\nEND\n".format(units).encode("ascii"))

# Only the energies section is required; excluding the summary is the
# .desc averages entry's job. Require the section to close with a blank line:
# a block truncated after the first pair still has Potential but may lack
# Total Energy, so emitting it would publish a plausible wrong quantity.
# GROMACS can interleave messages after the time row, for example:
#      Step           Time
#        500        1.00000
#      Writing checkpoint, step 500 at Tue Sep 22 18:15:48 2026
#      Energies (kJ/mol)
# These extra lines make a fixed line-count boundary unsafe.
if not saw_energies or not closed:
    sys.exit(0)
#  "Total Energy" is present for a dynamics run; a minimisation prints
#  only "Potential". Prefer the total when it exists, because that is what
#  the user means by the energy of an MD frame.
energy = terms.get(b"Total Energy", terms.get(b"Potential"))
if energy is None:
    sys.exit(0)
#  Both keys on every invocation: the plain overwriting TE holds the last value,
#  while the step-vector TEVEC accumulates the whole trace from the same
#  calls. That avoids two .desc entries fighting over one Begin line.
for key in ("TE", "TEVEC"):
    emit(key, energy, "kJoule/Mole")
#  Pressure comes out of the SAME block, already parsed into terms,
#  and is emitted from this one entry rather than a second .desc entry --
#  the marker line is identical, and two entries sharing a Begin would
#  leave one of them permanently starved (PDMatchBegin returns only the
#  first match).
#
#  GROMACS labels the column "Pressure (bar)", and bar is a unit
#  PressureConverter knows.  That matters: convertTo() THROWS on a unit
#  it does not have, so an invented label would be an exception rather
#  than a cosmetic wart.
#
#  Scalar only, deliberately.  A per-step pressure would be a
#  PropTSVector<Geometry Step>, and GeomTracePropertyPanel plots any of
#  those against GEOMTRACE.  MD tasks have one (gromacs.geomtrace, thinned
#  to at most 100 frames), so the plot point of a step with no frame goes to
#  the nearest frame (GTStepCmd); a minimisation has none.  A minimisation
#  run prints no pressure at all, hence the membership guard.
if b"Pressure (bar)" in terms:
    #  And the per-step trace, so a run's pressure can be plotted against
    #  step.  It is shown by "Geometry Step Plots", which plots any step
    #  vector on its own.
    for key in ("PRESSURE", "PRESSVEC"):
        emit(key, terms[b"Pressure (bar)"], "Bar", False)
#  Temperature, likewise a trace.  Only dynamics prints it.
if b"Temperature" in terms:
    emit("TEMPVEC", terms[b"Temperature"], "Kelvin", False)
#  The MD Summary panel's per-step series (#334).  Potential and kinetic
#  energy have their own keys because TEVEC holds the total, and PEVEC/KEVEC
#  are other codes'.  Volume and density only exist in a pressure-coupled run.
series = {b"Potential": ("MDPEVEC", "kJoule/Mole"),
          b"Kinetic En.": ("MDKEVEC", "kJoule/Mole"),
          b"Volume": ("MDVOLVEC", "nm^3"), b"Density": ("MDDENSVEC", "kg/m^3")}
for term in sorted(series):
    if term in terms:
        key, units = series[term]
        emit(key, terms[term], units)
