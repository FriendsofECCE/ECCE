#!/usr/bin/env perl
################################################################################
#
# Purpose:
# Extracts energies from a GROMACS mdrun .log block into ECCE's TE and
# TEVEC properties.
#
# SPIKE / PROOF OF CONCEPT. This exists to establish that GROMACS output
# can be monitored through ECCE's existing eccejobmonitor mechanism at
# all, as groundwork for docs/GROMACS_ROADMAP.md. It is NOT reachable
# from the GUI: there is no GROMACS.edml, so no calculation can be
# created for it. See the roadmap for what a real integration needs.
#
# Input is one block of a real mdrun log (verified against GROMACS
# 2025.2):
#
#            Step           Time
#               2        2.00000
#
#    Energies (kJ/mol)
#         LJ (SR)   Coulomb (SR)   Coul. recip.      Potential Pressure (bar)
#     2.32600e+03   -9.67730e+03    1.85069e+02   -7.16623e+03    5.66364e+03
#
# THE COLUMNS ARE NOT FIXED. Which terms appear depends on the run: a
# minimisation has no kinetic energy or temperature, an NVT run adds
# "Kinetic En.", "Total Energy", "Temperature" and a thermostat term, PME
# adds "Coul. recip.", and so on. So the header line has to be read and
# the wanted column located by NAME rather than by position -- hardcoding
# an index would silently read the wrong quantity the first time someone
# changed the integrator, which is the same class of bug as this
# project's .desc column assumptions.
#
# The header is fixed-width, not whitespace-delimited: "LJ (SR)" and
# "Coul. recip." both contain spaces. GROMACS writes each field in 15
# columns, so the header is split on that rather than on whitespace.
#
# Units are kJ/mol, which ECCE's EnergyConverter already knows as
# "kJoule/Mole" -- so unlike Quantum ESPRESSO (whose Rydberg has no entry
# at all and has to be converted to Hartree by every parser) these can be
# published as they are.
#
################################################################################

$| = 1;

($key, $runtype, $ucCategory, $theory) = @ARGV;

use constant FIELD_WIDTH => 15;

my %term;
my $sawEnergies = 0;
my $done = 0;

#  Fed a block that starts at the "Step  Time" header, because that is
#  what distinguishes a REAL STEP from the run-summary block GROMACS
#  prints at the end:
#
#     <====  A V E R A G E S  ====>
#     Statistics over 501 steps using 6 frames
#        Energies (kJ/mol)
#        ...
#
#  That trailing block has the identical "Energies (kJ/mol)" marker and
#  no Step header. Anchoring on the energies alone would parse it as one
#  more step, putting a final point on every energy-vs-step plot whose
#  value is an AVERAGE OVER THE RUN -- plausible-looking and wrong. The
#  500-step fixture has 6 step markers and 7 energy blocks, which is how
#  this was noticed.
#
#  The block is fed with a generous fixed line count (see gromacs.desc),
#  so this may over-read into whatever follows. Stopping as soon as one
#  complete energies section has been closed by a blank line is what
#  makes that safe: without it, an over-read would pick up the NEXT
#  step's numbers and silently report them for this one.
while (<STDIN>) {
  chomp;
  last if ($done);

  next if (/^\s*Step\s+Time\s*$/);   # not normally fed; see gromacs.desc
  if (/^\s*Energies\s*\(/) { $sawEnergies = 1; next; }

  if (!$sawEnergies) {
    next;                                   # step number, blanks
  }

  if (/^\s*$/) {
    $done = 1;                              # blank closes the section
    last;
  }

  #  A block is a SEQUENCE of header/value row pairs, not one pair.
  #  GROMACS wraps at five terms, so a minimisation prints one pair and
  #  a dynamics run prints two:
  #
  #        LJ (SR)   Coulomb (SR)   Coul. recip.      Potential    Kinetic En.
  #    1.37191e+03   -1.02702e+04    1.01441e+02   -8.79686e+03    1.45954e+03
  #   Total Energy  Conserved En.    Temperature Pressure (bar)
  #   -7.33732e+03   -8.13312e+03    3.01028e+02   -8.59611e+02
  #
  #  An earlier version stopped after the first value row. It still found
  #  "Potential", so it still produced a plausible energy for a dynamics
  #  run, while never seeing "Total Energy" -- the value it says it
  #  prefers. Silently returning the wrong quantity, which is this
  #  codebase's most repeated failure shape. Found by running an actual
  #  NVT job rather than reasoning about the format.
  if (/[A-Za-z]/) {
    #  Fixed-width, not whitespace-delimited: "LJ (SR)" and
    #  "Coul. recip." both contain spaces.
    my $line = $_;
    my @names = ();
    while (length($line) > 0) {
      my $field = substr($line, 0, FIELD_WIDTH);
      $line = (length($line) > FIELD_WIDTH)
            ? substr($line, FIELD_WIDTH) : "";
      $field =~ s/^\s+//;
      $field =~ s/\s+$//;
      push(@names, $field) if ($field ne "");
    }
    next if (scalar(@names) == 0);

    my $values = <STDIN>;
    last if (!defined($values));
    chomp($values);
    my @values = split(' ', $values);
    next if (scalar(@values) != scalar(@names));

    for (my $i = 0; $i < scalar(@names); $i++) {
      $term{$names[$i]} = $values[$i];
    }
  }
}

#  Only the energies section is required. gromacs.desc anchors on the
#  "Step Time" header and then skips past it, so this script is handed
#  the energies and nothing else -- it cannot distinguish a real step
#  from the end-of-run AVERAGES block by their text, and excluding the
#  latter is the Begin anchor's job. Said explicitly because it is the
#  kind of division of responsibility that is easy to break later by
#  "simplifying" the anchor onto the energies marker.
#  REQUIRE the energies section to have been CLOSED by a blank line
#  within the text we were given. A truncated block is the dangerous
#  case, not the empty one: GROMACS wraps its terms at five per row, so
#  a dynamics block cut short after the first header/value pair still
#  contains "Potential" and would happily report it -- while "Total
#  Energy", on the second pair, never arrives. That is a silently WRONG
#  quantity rather than a missing one.
#
#  It is reachable in practice. gromacs.desc frames blocks with a line
#  count (see there for why an End pattern cannot work), and GROMACS
#  interleaves messages into the block:
#
#      Step           Time
#        500        1.00000
#
#      Writing checkpoint, step 500 at Tue Sep 22 18:15:48 2026
#
#
#      Energies (kJ/mol)
#
#  which pushes the second pair past the end of the fed range. Refusing
#  the block loses that step; reporting it would have published the
#  potential energy as if it were the total. Losing a data point is
#  recoverable, publishing a wrong one is not.
exit(0) if (!$sawEnergies || !$done);

#  "Total Energy" is present for a dynamics run; a minimisation prints
#  only "Potential". Prefer the total when it exists, because that is what
#  the user means by the energy of an MD frame.
my $energy;
foreach my $wanted ("Total Energy", "Potential") {
  if (defined($term{$wanted})) {
    $energy = $term{$wanted};
    last;
  }
}
exit(0) if (!defined($energy));

#  Both keys on every invocation, which is the pattern CLAUDE.md
#  recommends: the plain overwriting TE ends up holding the last value,
#  while the step-vector TEVEC accumulates the whole trace from the same
#  calls. That avoids two .desc entries fighting over one Begin line.
foreach my $k ("TE", "TEVEC") {
  print "key: $k\n";
  print "size:\n1\n";
  print "values:\n $energy\n";
  print "units:\nkJoule/Mole\n";
  print "END\n";
}

#  Pressure comes out of the SAME block, already parsed into %term above,
#  and is emitted from this one entry rather than a second .desc entry --
#  the marker line is identical, and two entries sharing a Begin would
#  leave one of them permanently starved (PDMatchBegin returns only the
#  first match).
#
#  GROMACS labels the column "Pressure (bar)", and bar is a unit
#  PressureConverter knows.  That matters: convertTo() THROWS on a unit
#  it does not have, so an invented label would be an exception rather
#  than a cosmetic wart.
#
#  Scalar only, deliberately.  A per-step pressure would have to be a
#  PropTSVector<Geometry Step>, and GeomTracePropertyPanel plots any of
#  those against GEOMTRACE -- which GROMACS has no producer for, so the
#  trace would be unplottable at best and out of bounds at worst (the
#  len(TEVEC) <= len(GEOMTRACE) rule in CLAUDE.md).  A minimisation run
#  prints no pressure at all, hence the defined() guard.
if (defined($term{"Pressure (bar)"})) {
  print "key: PRESSURE\n";
  print "size:\n1\n";
  print "values:\n" . $term{"Pressure (bar)"} . "\n";
  print "units:\nBar\n";
  print "END\n";
}
exit(0);
