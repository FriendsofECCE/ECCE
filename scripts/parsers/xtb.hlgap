#!/usr/bin/env python3
# The HOMO-LUMO gap, from the closing summary box:
#   "          | HOMO-LUMO GAP              14.629673576893 eV   |"
# Units class NA (data/client/config/properties): the stored string is what
# the Energies panel shows.
import re
import sys
from xtb_parse import configure_streams, scalar

configure_streams()
line = sys.stdin.readline()
m = re.search(r"HOMO-LUMO GAP\s+(-?\d+\.\d+)\s+eV", line, re.ASCII)
if m:
    scalar("HLGAP", m.group(1), "eV")
