#!/usr/bin/env python3
# The source vectors are mass-weighted. Divide by sqrt(mass), renormalise,
# and pad the rigid modes so VIB stays aligned with the full spectrum.
import math
import re
import sys
from xtb_parse import configure_streams, fields, number

configure_streams()
mass = [0, 1.008, 4.0026, 6.94, 9.0122, 10.81, 12.011, 14.007, 15.999,
  18.998, 20.180, 22.990, 24.305, 26.982, 28.085, 30.974, 32.06, 35.45,
  39.948, 39.098, 40.078, 44.956, 47.867, 50.942, 51.996, 54.938, 55.845,
  58.933, 58.693, 63.546, 65.38, 69.723, 72.630, 74.922, 78.971, 79.904,
  83.798, 85.468, 87.62, 88.906, 91.224, 92.906, 95.95, 98, 101.07, 102.91,
  106.42, 107.87, 112.41, 114.82, 118.71, 121.76, 127.60, 126.90, 131.29,
  132.91, 137.33, 138.91, 140.12, 140.91, 144.24, 145, 150.36, 151.96,
  157.25, 158.93, 162.50, 164.93, 167.26, 168.93, 173.05, 174.97, 178.49,
  180.95, 183.84, 186.21, 190.23, 192.22, 195.08, 196.97, 200.59, 204.38,
  207.2, 208.98, 209, 210, 222]
z, modes, cols = [], [], []
for line in sys.stdin:
    m = re.search(r"^\s+\d+\s+(\d+)\s+0\s+-?\d+\.\d+\s+-?\d+\.\d+\s+-?\d+\.\d+\s*$", line, re.ASCII)
    if m:
        z.append(number(m.group(1), integer=True))
        continue
    m = re.search(r"^\s+Frequencies\s+--(.*)$", line, re.ASCII)
    if m:
        cols = [[] for _ in fields(m.group(1))]
        continue
    m = re.search(r"^\s+\d+\s+\d+\s+(-?\d+\.\d+\s+-?\d+\.\d+\s+-?\d+\.\d+.*)$", line, re.ASCII)
    if m and cols:
        v = fields(m.group(1))
        for c, col in enumerate(cols):
            col.extend((v + [""] * (3 * len(cols)))[3*c:3*c+3])
        if len(cols[0]) == 3 * len(z):
            modes.extend(cols)
            cols = []
natoms = len(z)
nmodes = 3 * natoms
npad = nmodes - len(modes)
if natoms < 1 or not modes or npad < 0:
    sys.exit(0)
print("key: VIB\nsize:\n{} {} 3\nvectorlabels:".format(nmodes, natoms))
for n, heading in ((nmodes, "rowlabels:"), (natoms, "columnlabels:\nX Y Z\nvalues:")):
    for i in range(1, n + 1):
        print(" NA " if n == nmodes else " {} ".format(i), end="")
        if i % 10 == 0:
            print()
    print("\n" + heading)
print("0.0 0.0 0.0\n" * (npad * natoms), end="")
for v in modes:
    d = []
    norm = 0.0
    for i in range(3 * natoms):
        x = number(v[i]) / math.sqrt(mass[z[i // 3]])
        d.append(x)
        norm += x * x
    norm = math.sqrt(norm) or 1
    for a in range(natoms):
        print("%.15e %.15e %.15e" % tuple(d[3*a+k] / norm for k in range(3)))
print("units:\nAngstrom\nEND")
