#!/usr/bin/env perl
################################################################################
#
# Purpose:
# Generates a GROMACS .mdp run-control file from an ECCE calculation.
#
# Called by md.gmxtask for GROMACS.edml's MD tasks; docs/GROMACS.md has the
# whole picture.  The .mdp half of an integration is ordinary work of the
# same shape as ai.orca or ai.qe, and it produces files the real grompp
# accepts.
#
# WHAT THIS DELIBERATELY DOES NOT DO: build a topology. GROMACS takes
# three inputs -- .mdp (run control), .top (topology and force field)
# and .gro/.pdb (coordinates) -- and grompp combines them into a binary
# .tpr that mdrun executes. Only the .mdp is generated here. The
# topology is the user's, brought in from pdb2gmx or elsewhere, which is
# the "import-only" scope in the roadmap's section 3.1. ECCE has no
# concept of a force field, and inventing one is a much larger piece of
# work than this.
#
# Units are GROMACS's own: ps for time, nm for distances, K for
# temperature, kJ/mol for energy. No conversion is done or needed --
# unlike Quantum ESPRESSO, whose Rydberg has no entry in ECCE's
# EnergyConverter at all.
#
################################################################################

use Getopt::Std;

$| = 1;

getopts(':n:t:pfbcqeshv');

$baseName = $opt_n;
$TplFILE  = $opt_t;

die "ai.gromacs error: -n <basename> is required\n" if (!defined($baseName));
die "ai.gromacs error: -t <template> is required\n" if (!defined($TplFILE));

$ParamFILE = $baseName . ".param";
%AbiDict = ();
&readDict;
&verifyRunType;
&modifyInputFile;
&mergeExtraLines;
&cleanup;
exit(0);

################################################################################

# Which mdrun integrator this calculation asks for.
#
# Validated in the MAIN FLOW, before any generation starts. ai.<code>
# template engines resolve every ##tag## through eval, and a die inside
# a resolver used to be swallowed silently, emitting a deck with the
# line missing (issue #92). That is fixed, but the rule stands.
sub verifyRunType {
  my $runtype = $AbiDict{"RunType"};
  if ($runtype ne "Energy" && $runtype ne "Geometry" &&
      $runtype ne "Dynamics") {
    die "ai.gromacs error: runtype '$runtype' is not supported.\n" .
        "  Supported: Energy (single point), Geometry (minimisation),\n" .
        "  Dynamics (molecular dynamics).\n";
  }
}

sub Integrator {
  my $runtype = $AbiDict{"RunType"};
  #  A single point is "md with no steps": GROMACS has no dedicated
  #  single-point integrator, and nsteps=0 evaluates the energy of the
  #  input configuration exactly once. Verified against real grompp and
  #  mdrun rather than assumed.
  return &stringOr("ES.Runtype.MD.Minimizer", "steep") if ($runtype eq "Geometry");
  return "md";
}

sub GMXRunControl {
  my @l = ();
  my $runtype = $AbiDict{"RunType"};
  my $integrator = &Integrator;

  push(@l, "; Generated by ECCE ai.gromacs");
  my $gn = $AbiDict{"ES.Runtype.MD.GroupsNote"};
  push(@l, "; Note: $gn use the defined groups, but none is defined; System is used")
    if (defined($gn) && $gn ne "");
  push(@l, "integrator               = $integrator");

  if ($runtype eq "Energy") {
    push(@l, "nsteps                   = 0");
  } elsif ($runtype eq "Geometry") {
    push(@l, "emtol                    = " .
             &numOr("ES.Runtype.MD.EnergyTolerance", "1000.0"));
    push(@l, "emstep                   = " .
             &numOr("ES.Runtype.MD.MinimizerStep", "0.01"));
    push(@l, "nsteps                   = " .
             &numOr("ES.Runtype.MD.MaxSteps", "5000"));
  } else {
    push(@l, "dt                       = " .
             &numOr("ES.Runtype.MD.TimeStep", "0.002"));
    push(@l, "nsteps                   = " .
             &numOr("ES.Runtype.MD.NumberOfSteps", "5000"));
    push(@l, "tinit                    = " .
             &numOr("ES.Runtype.MD.InitialTime", "0"));
  }

  #  How often mdrun writes an energy block to the .log. This is what
  #  gromacs.desc parses, so a value of 0 would leave ECCE with no
  #  progress and no TEVEC trace at all -- not a silent failure exactly,
  #  but an empty result that looks like one.
  push(@l, "nstlog                   = " .
           &numOr("ES.Runtype.MD.LogInterval", "100"));
  push(@l, "nstenergy                = " .
           &numOr("ES.Runtype.MD.EnergyInterval", "100"));
  my $r = join("\n", @l);
  $_ = $r;
  return $r;
}

sub GMXNeighbourSearching {
  my @l = ();
  #  Verlet is the only supported scheme in modern GROMACS; the old
  #  group scheme was removed in 2019.
  push(@l, "cutoff-scheme            = Verlet");
  push(@l, "nstlist                  = " .
           &numOr("ES.Runtype.MD.NeighbourListInterval", "10"));
  push(@l, "pbc                      = xyz");
  my $r = join("\n", @l);
  $_ = $r;
  return $r;
}

sub GMXElectrostatics {
  my @l = ();
  push(@l, "coulombtype              = " .
           &stringOr("ES.Theory.MD.Coulombtype", "PME"));
  push(@l, "rcoulomb                 = " .
           &numOr("ES.Theory.MD.CoulombCutoff", "0.9"));
  push(@l, "rvdw                     = " .
           &numOr("ES.Theory.MD.VdwCutoff", "0.9"));
  my $ct = &stringOr("ES.Theory.MD.Coulombtype", "PME");
  if (lc($ct) eq "pme") {
    push(@l, "pme-order                = " .
             &numOr("ES.Theory.MD.PMEOrder", "4"));
    my $g = $AbiDict{"ES.Theory.MD.FourierGrid"};
    if (defined($g) && $g ne "") {
      push(@l, "fourier-nx               = $g");
      push(@l, "fourier-ny               = $g");
      push(@l, "fourier-nz               = $g");
    }
  } elsif (lc($ct) eq "reaction-field") {
    #  epsilon-rf 0 is an infinite dielectric outside the cutoff, the
    #  usual choice and the one a plain cutoff means.
    push(@l, "epsilon-rf               = 0");
  }
  my $r = join("\n", @l);
  $_ = $r;
  return $r;
}

#  Molecules that bond across the cell boundary; grompp's default is no,
#  so nothing is written when it is not asked for.
sub GMXPeriodicMolecules {
  my $r = "";
  $r = "periodic-molecules       = yes"
    if (&numOr("ES.Theory.MD.PeriodicMolecules", "0") == 1);
  $_ = $r;
  return $r;
}

sub GMXTemperatureCoupling {
  my @l = ();
  #  Only for dynamics. A minimisation or a single point with a
  #  thermostat is not an error in grompp, but it is meaningless, and
  #  emitting settings that do nothing makes a generated file harder to
  #  read than one that omits them.
  return "" if ($AbiDict{"RunType"} ne "Dynamics");

  my $tcoupl = &stringOr("ES.Runtype.MD.Thermostat", "v-rescale");
  return "" if ($tcoupl eq "no" || $tcoupl eq "none");

  #  One tau-t and ref-t per group: the panel has one value, repeated.
  my @tc = &groupList("ES.Runtype.MD.TcGroups");
  my $n = scalar(@tc) || 1;
  my $tau = &numOr("ES.Runtype.MD.CouplingTime", "0.1");
  my $ref = &numOr("ES.Runtype.MD.Temperature", "300");
  push(@l, "tcoupl                   = $tcoupl");
  push(@l, "tc-grps                  = " . (@tc ? join(" ", @tc) : "System"));
  push(@l, "tau-t                    = " . join(" ", ($tau) x $n));
  push(@l, "ref-t                    = " . join(" ", ($ref) x $n));
  #  Simulated annealing: the reference temperature moves linearly from
  #  ref-t to the final one between the two times (ps from the start).
  if (defined($AbiDict{"ES.Runtype.MD.AnnealTemperature"})) {
    push(@l, "annealing                = " . join(" ", ("single") x $n));
    push(@l, "annealing-npoints        = " . join(" ", (2) x $n));
    push(@l, "annealing-time           = " . join(" ", (
             &numOr("ES.Runtype.MD.AnnealStart", "0") . " " .
             &numOr("ES.Runtype.MD.AnnealEnd", "100")) x $n));
    push(@l, "annealing-temp           = " . join(" ", (
             $ref . " " . $AbiDict{"ES.Runtype.MD.AnnealTemperature"}) x $n));
  }
  my $r = join("\n", @l);
  $_ = $r;
  return $r;
}

#  Pressure coupling, only when the task asks for it (an NPT run).
#  C-rescale, because Berendsen is what GROMACS itself calls wrong for
#  anything but equilibration and C-rescale is its drop-in replacement.
sub GMXPressureCoupling {
  my @l = ();
  return "" if ($AbiDict{"RunType"} ne "Dynamics");
  return "" if (!defined($AbiDict{"ES.Runtype.MD.Pressure"}));
  #  ref-p and compressibility take as many values as the coupling type
  #  has directions: P / P P / P P P 0 0 0 (the last three are the
  #  off-diagonal terms).
  my $type = lc(&stringOr("ES.Runtype.MD.PressureType", "isotropic"));
  my $p = $AbiDict{"ES.Runtype.MD.Pressure"};
  my $c = &numOr("ES.Runtype.MD.Compressibility", "4.5e-5");
  my ($refp, $comp) = ($p, $c);
  if ($type eq "semiisotropic") {
    $refp = "$p $p"; $comp = "$c $c";
  } elsif ($type eq "anisotropic") {
    $refp = "$p $p $p 0 0 0"; $comp = "$c $c $c 0 0 0";
  }
  push(@l, "pcoupl                   = " .
           &stringOr("ES.Runtype.MD.Barostat", "C-rescale"));
  push(@l, "pcoupltype               = $type");
  push(@l, "nstpcouple               = " . $AbiDict{"ES.Runtype.MD.PressureInterval"})
    if (defined($AbiDict{"ES.Runtype.MD.PressureInterval"}));
  push(@l, "tau-p                    = " .
           &numOr("ES.Runtype.MD.PressureTime", "0.5"));
  push(@l, "ref-p                    = $refp");
  push(@l, "compressibility          = $comp");
  my $r = join("\n", @l);
  $_ = $r;
  return $r;
}

#  Where the velocities come from.  A run that resumes finds them in the
#  structure file it starts from and carries on (continuation); any other
#  dynamics run makes new ones at the target temperature.
sub GMXVelocities {
  my @l = ();
  return "" if ($AbiDict{"RunType"} ne "Dynamics");
  if (&numOr("ES.Runtype.MD.Resume", "0") == 1) {
    push(@l, "gen-vel                  = no");
    push(@l, "continuation             = yes");
  } else {
    push(@l, "gen-vel                  = yes");
    push(@l, "gen-temp                 = " .
             &numOr("ES.Runtype.MD.GenTemp", "300"));
    push(@l, "gen-seed                 = -1");
  }
  my $r = join("\n", @l);
  $_ = $r;
  return $r;
}

sub GMXCenterOfMass {
  my @l = ();
  return "" if ($AbiDict{"RunType"} ne "Dynamics");
  my $f = $AbiDict{"ES.Runtype.MD.RemoveCM"};
  return "" if (!defined($f));
  if ($f > 0) {
    push(@l, "comm-mode                = Linear");
    my @com = &groupList("ES.Runtype.MD.ComGroups");
    push(@l, "comm-grps                = " . join(" ", @com)) if (@com);
    push(@l, "nstcomm                  = $f");
  } else {
    push(@l, "comm-mode                = None");
  }
  my $r = join("\n", @l);
  $_ = $r;
  return $r;
}

#  A compressed (.xtc) trajectory, when the task asks for one.
sub GMXOutput {
  my @l = ();
  my $f = $AbiDict{"ES.Runtype.MD.TrajectoryInterval"};
  return "" if (!defined($f) || $f eq "" || $f <= 0);
  push(@l, "nstxout-compressed       = $f");
  my $r = join("\n", @l);
  $_ = $r;
  return $r;
}

#  The user's -D flags, then the position-restraint one.
sub GMXDefines {
  my $d = $AbiDict{"ES.Runtype.MD.Defines"};
  $_ = (defined($d) && $d ne "") ? "define                    = $d" : "";
  return $_;
}

sub GMXRefcoord {
  my $v = $AbiDict{"ES.Runtype.MD.RefcoordScaling"};
  $_ = (defined($v) && $v ne "") ? "refcoord-scaling         = $v" : "";
  return $_;
}

#  What each group is made of, as comments: gromacs.launchpp reads them to
#  write the index file (gromacs.mkndx), so the .mdp stays the one place that
#  says which groups exist.
sub GMXGroupDefs {
  my $g = $AbiDict{"ES.Runtype.MD.GroupDefs"};
  $_ = "";
  return $_ if (!defined($g) || $g eq "");
  $_ = join("\n", map { (my $d = $_) =~ s/=/ = /; "; ecce-group $d" } split(/\|/, $g));
  return $_;
}

#  The pull code: one umbrella coordinate between the centres of mass of two
#  groups, starting from their present distance.  Positions and forces are
#  written every 50 steps to pullx.xvg and pullf.xvg.
sub GMXPull {
  my @l = ();
  $_ = "";
  my @g = &groupList("ES.Runtype.MD.PullGroups");
  return "" if (@g != 2);
  my $geom = &stringOr("ES.Runtype.MD.PullGeometry", "distance");
  push(@l, "pull                      = yes");
  #  A chain is often longer than half the box, and grompp then insists on a
  #  hand-picked pbc atom; the previous step's COM as reference needs none.
  push(@l, "pull-pbc-ref-prev-step-com = yes");
  push(@l, "pull-ngroups              = 2");
  push(@l, "pull-ncoords              = 1");
  push(@l, "pull-group1-name          = $g[0]");
  push(@l, "pull-group2-name          = $g[1]");
  push(@l, "pull-coord1-type          = umbrella");
  push(@l, "pull-coord1-geometry      = $geom");
  push(@l, "pull-coord1-vec           = " . $AbiDict{"ES.Runtype.MD.PullVec"})
    if ($geom eq "direction");
  push(@l, "pull-coord1-dim           = " . &stringOr("ES.Runtype.MD.PullDim", "Y Y Y"));
  push(@l, "pull-coord1-groups        = 1 2");
  push(@l, "pull-coord1-start         = yes");
  push(@l, "pull-coord1-rate          = " . &numOr("ES.Runtype.MD.PullRate", 0.01));
  push(@l, "pull-coord1-k             = " . &numOr("ES.Runtype.MD.PullK", 1000));
  push(@l, "pull-nstxout              = 50");
  push(@l, "pull-nstfout              = 50");
  $_ = join("\n", @l);
  return $_;
}

sub GMXConstraints {
  my @l = ();
  my $constraints = &stringOr("ES.Runtype.MD.Constraints", "h-bonds");
  return "" if ($constraints eq "none");
  push(@l, "constraints              = $constraints");
  my $r = join("\n", @l);
  $_ = $r;
  return $r;
}

################################################################################

sub groupList {
  my $v = $AbiDict{$_[0]};
  return (defined($v) && $v ne "") ? split(/\s+/, $v) : ();
}

#  Lines the user wrote in the task editor replace ours of the same key and
#  are appended after the rest, so there are never two lines for one key.
#  Keys are compared with - and _ alike and without regard to case, as grompp
#  does.
sub mdpKey {
  my $k = shift;
  $k =~ s/^\s+//; $k =~ s/\s+$//;
  $k =~ s/_/-/g;
  return lc($k);
}

sub mergeExtraLines {
  my $x = $AbiDict{"ES.Runtype.MD.ExtraLines"};
  return if (!defined($x) || $x eq "");
  my (@order, %line);
  foreach my $l (split(/\|/, $x)) {
    $l =~ s/\s+$//;
    my $k = ($l =~ /^\s*([^=;\s][^=;]*?)\s*=/) ? &mdpKey($1) : "\0$l";
    push(@order, $k) if (!exists($line{$k}));
    $line{$k} = $l;
  }
  open(IN, "tmpfile") || die "ai.gromacs error: Couldn't read tmpfile\n";
  my @keep;
  while (<IN>) {
    chomp;
    next if (/^\s*([^=;\s][^=;]*?)\s*=/ && exists($line{&mdpKey($1)}));
    push(@keep, $_);
  }
  close(IN);
  open(OUT, ">tmpfile") || die "ai.gromacs error: Couldn't write tmpfile\n";
  print OUT join("\n", @keep, "; Lines written in the task editor",
                 map { $line{$_} } @order), "\n";
  close(OUT);
}

sub numOr {
  my ($key, $default) = @_;
  my $v = $AbiDict{$key};
  return (defined($v) && $v ne "") ? $v : $default;
}

sub stringOr {
  my ($key, $default) = @_;
  my $v = $AbiDict{$key};
  return (defined($v) && $v ne "") ? $v : $default;
}

# Same ##tag## engine as the other ai.* generators: replace ##key## with
# &key() if such a sub exists, else the raw dictionary value, else drop
# the line. A sub that wants to emit nothing sets $_ = "" itself.
sub modifyInputFile {
  open(TPL, $TplFILE) || die "ai.gromacs error: Couldn't open $TplFILE\n";
  open(OUT, ">tmpfile") || die "ai.gromacs error: Couldn't write tmpfile\n";
  while (<TPL>) {
    if (/\#\#(\S+)\#\#/) {
      my $tag = $1;
      my $subname = $tag;
      $subname =~ s/\./_/g;
      my $value = "";
      $_ = "";
      #  Re-raise a real error while leaving "Undefined subroutine"
      #  silent, so a resolver's die reaches the user (a6d0512).
      eval "\$value = &$subname";
      if ($@ && $@ !~ /Undefined subroutine/) {
        die $@;
      }
      if (!$@ && $_ ne "") {
        $value = $_;
      }
      next if ($value eq "");
      print OUT $value . "\n";
    } else {
      print OUT $_;
    }
  }
  close(TPL);
  close(OUT);
}

sub readDict {
  open(PARAM, $ParamFILE) || die "ai.gromacs error: Couldn't open $ParamFILE\n";
  while (<PARAM>) {
    chomp;
    next if (/^\s*$/ || /^\s*#/);
    if (/^([^:]+):\s*(.*)$/) {
      my ($key, $value) = ($1, $2);
      $key =~ s/^\s+//; $key =~ s/\s+$//;
      $value =~ s/^\s+//; $value =~ s/\s+$//;
      $AbiDict{$key} = $value;
      #  Store every dotted SUFFIX too, so a resolver can ask for a short
      #  name, matching the other generators' readDict.
      my @parts = split(/\./, $key);
      while (scalar(@parts) > 1) {
        shift(@parts);
        my $suffix = join(".", @parts);
        $AbiDict{$suffix} = $value if (!defined($AbiDict{$suffix}));
      }
    }
  }
  close(PARAM);
}

sub cleanup {
  rename("tmpfile", $TplFILE);   # perl itself: Windows perl has no /bin/mv
}
