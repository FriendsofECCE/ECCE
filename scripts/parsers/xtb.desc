# Parse descriptor for xtb 6.7.1 output (GFN2-xTB, GFN1-xTB, GFN-FF).
#
# Energy, HOMO-LUMO gap, dipole, geometry trace, progress, and (stage 2) the
# orbitals from the Molden file gensub appends.  Charges and vibrations are
# later stages and add entries here.
#
# No two Begins may match one physical line, and an End line is consumed with
# its block; the entries below use Lines= or markers gensub writes, so
# neither trap applies.  Skip=N counts the Begin line itself.

# The closing summary box, printed once.
[TE]
Script=xtb.energy
Begin=^\s+\| TOTAL ENERGY\s
Frequency=last
Skip=0
Lines=1
[END]

[HLGAP]
Script=xtb.hlgap
Begin=^\s+\| HOMO-LUMO GAP\s
Frequency=last
Skip=0
Lines=1
[END]

# "molecular dipole:", a column header, the "q only" row and the "full" row.
[DIPOLE]
Script=xtb.dipole
Begin=^molecular dipole:
Frequency=last
Skip=0
Lines=4
[END]

# gensub appends the frames after the run (xtb prints no coordinates):
#   ECCE-XTB-FRAME <n> <atoms> / xyz comment line / atoms / ECCE-XTB-ENDFRAME
[GEOMTRACE][TEVEC]
Script=xtb.geomtrace
Begin=^ECCE-XTB-FRAME\s
Skip=1
Frequency=all
End=^ECCE-XTB-ENDFRAME
[END]

# gensub appends xtb's molden.input (not for GFN-FF, which has no orbitals).
# Begin/End lines are consumed with the block.
[MO][MOBETA][ORBENG][ORBENGBETA][ORBOCC][ORBOCCBETA][MOAOORDER][GTOBASIS]
Script=xtb.mo
Begin=^ECCE-XTB-MOLDEN\s*$
Skip=0
Frequency=last
End=^ECCE-XTB-ENDMOLDEN
[END]

# SCF iterations: "  3     -4.1470395 -0.177636E-14  0.199E-07   10.79  100000.0  T"
[PROGRESS]
Begin=^\s+(\d+)\s+(-?\d+\.\d+)\s+-?\d\.\d+E[-+]\d+\s+\d\.\d+E[-+]\d+\s+\S+\s+\S+\s+[TF]\s*$
Progress=scf cycle=$1 energy=$2
[END]

[PROGRESS]
Begin=^\s+\*\*\* convergence criteria satisfied after
Progress=scf converged=yes
[END]

# The optimizer's gradient criterion is printed once in its setup table.
[PROGRESS]
Begin=^\s+:\s+grad\. convergence\s+(\S+)
Remember=gconv
[END]

[PROGRESS]
Begin=^\.+ CYCLE\s+(\d+)\s
Progress=opt step=$1
[END]

[PROGRESS]
Begin=^\s+\* total energy\s+:\s+(-?\d\S*)\s+Eh
Progress=opt energy=$1
History=energy
[END]

[PROGRESS]
Begin=^\s+gradient norm\s+:\s+(\d\S*)\s+Eh/\S+\s+predicted
Progress=opt grad=$1/{gconv}
[END]

[PROGRESS]
Begin=^\s+\*\*\* GEOMETRY OPTIMIZATION CONVERGED AFTER
Progress=opt converged=yes
[END]

[PROGRESS]
Begin=^\s+\*\*\* FAILED TO CONVERGE GEOMETRY OPTIMIZATION
Progress=opt converged=no
[END]
