#!/usr/bin/env python3
################################################################################
#
# Purpose:
# Extracts MOPAC's "ELECTROSTATIC POTENTIAL CHARGES" table (printed with the
# ESP keyword) into ECCE's ESPFIT property.  Rows, after Skip=3:
#                     1          O    -0.5889
#                     2          H     0.2944
# MOPAC prints four decimals.
#
################################################################################

import re
import sys
from xtb_parse import configure_streams

configure_streams()

charges = []
for line in sys.stdin:
    match = re.search(r"^\s*\d+\s+[A-Za-z]{1,2}\s+(-?\d+\.\d+)\s*$", line, re.ASCII)
    if match:
        charges.append(match.group(1))
if charges:
    print("key: ESPFIT\nsize:\n{}\nvalues:\n{}\nunits:\ne\nEND".format(
        len(charges), " ".join(charges)))
