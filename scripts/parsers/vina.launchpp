#!/usr/bin/env perl
###############################################################################
# Launch-time check of a Vina deck (Launch::postProcessInput() runs this on
# every Vina launch, in the directory where it staged the deck, named by
# inputFile in the -p file, and the auxiliary input vina.vinafrag).
#
# The automatic search box follows the LIGAND's coordinates, which is right
# for a ligand redocked from the receptor's own structure and wrong for one
# drawn in the Builder or added from another file.  Vina then searches empty
# space and returns ordinary-looking poses.  Provenance is not stored, so the
# test is geometric: how many receptor atoms the box holds.  It only warns
# (ECCE-LAUNCH-WARNING, exit 0); a check that cannot run exits 0 silently.
###############################################################################
use strict;
use Getopt::Std;

our ($opt_p, $opt_v);
getopts('p:v');

if ($opt_v) {
  print "Revision: 2.0\n";
  exit 0;
}

my $MINATOMS = 10;

my $deckName = "";
if (defined($opt_p) && open(my $pf, "<", $opt_p)) {
  while (<$pf>) { $deckName = $1 if (/^inputFile:\s*(\S+)/); }
  close($pf);
}
exit 0 if ($deckName eq "" || !-r $deckName);

my %c;
my @rec;
open(my $dk, "<", $deckName) or exit 0;
while (<$dk>) {
  if (/^\s*(center|size)_([xyz])\s*=\s*(\S+)/) { $c{"$1$2"} = $3; }
  elsif (/^#\|\s*RECEPTOR_ATOMS=(\S*)/) {
    foreach my $r (split(/,/, $1)) {
      if ($r =~ /^(\d+)-(\d+)$/) { push(@rec, $1 .. $2); }
      elsif ($r =~ /^(\d+)$/) { push(@rec, $1); }
      else { exit 0; }
    }
  }
}
close($dk);
foreach my $k (qw(centerx centery centerz sizex sizey sizez)) {
  exit 0 unless (defined($c{$k}) && $c{$k} =~ /^[-+]?\d*\.?\d+(?:[eE][-+]?\d+)?$/);
}
exit 0 unless @rec;

open(my $fr, "<", "vina.vinafrag") or exit 0;
my @xyz;
my $inList = 0;
while (<$fr>) {
  if (!$inList) { $inList = 1 if (/^atom_list:/); next; }
  my @w = split(' ', $_);
  last unless (@w >= 4 && $w[1] =~ /^[-+.\d]/);
  push(@xyz, [@w[1 .. 3]]);
}
close($fr);

my $inside = 0;
foreach my $i (@rec) {
  my $a = $xyz[$i - 1];
  exit 0 unless defined($a);
  my $in = 1;
  foreach my $k (0 .. 2) {
    my $ax = ("x", "y", "z")[$k];
    $in = 0 if (abs($a->[$k] - $c{"center$ax"}) > $c{"size$ax"} / 2);
  }
  $inside++ if $in;
}
exit 0 if ($inside >= $MINATOMS);

print "ECCE-LAUNCH-WARNING\n";
print "The search box holds $inside receptor atoms, so it is not on a binding site.\n\n";
print "Unless it was set by hand, the box is placed automatically around the ligand. "
    . "That is correct when the ligand came from the receptor's own structure file "
    . "and wrong for a ligand that was drawn or added from another file: the box then "
    . "sits where the ligand's own coordinates put it. Vina will search this volume "
    . "and report poses and scores for it.\n\n";
print "Select the binding-site residues in the Builder and use "
    . "Tools > Docking Box Around Selection.\n";
exit 0;
