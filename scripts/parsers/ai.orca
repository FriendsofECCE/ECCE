#!/usr/bin/env perl
################################################################################
# FILENAME:  ai.orca
#
# SYNTAX: ai.orca -p -f -b -c -n <basename> -t <template> [-h] [-v]
#
# PURPOSE:
#       Take an AbiChem generated dictionary and produce an ORCA input file.
#       Modeled on ai.gauss16 (see that file for the sibling Gaussian-16
#       version) -- the generic dictionary/geometry/constraint file readers
#       and the ##tag## template substitution engine (modifyInputFile) are
#       copied verbatim since they are code-agnostic.
#
# STATUS (issue #38): REDUCED SCOPE first cut, matching the method/runtype
# set in data/client/cap/ORCA.edml -- RHF/UHF/RDFT/UDFT crossed with
# Energy/Gradient/Geometry/Vibration/GeoVib. No MP2/CC/CI, no basis-set
# route-card shortcut (always writes the explicit %basis block from
# wrORCAGBS.pm), no geometry constraints, no symmetry handling.
#
# The "! <keywords>" line and %basis block below have been verified against
# a real ORCA 6.1.1 install (RHF/UHF/RKS/UKS + EnGrad/Opt/Freq keywords, and
# an explicit NewGTO basis block, all round-tripped successfully -- see
# 2026-09-06 session). The %scf/%geom convergence blocks have NOT been
# round-tripped and use approximate/default settings -- check before relying
# on tight convergence behavior.
#
################################################################################

use Getopt::Std;
use vars qw($opt_h $opt_help $opt_v $opt_n $opt_p $opt_f $opt_b $opt_c $opt_t);

push(@INC,"$ENV{ECCE_HOME}/scripts/parsers");
require "pertab.pl";
&loadPT;

$| = 1;

&getopts(':n:t:pfbchv');
&handle_options;

%AbiDict = ();

if ($TplFILE eq "") {
  &usage;
}

&verifyAbiFile;
&verifyFragFile;
&verifyCnstrntFile;
&readDict;
&aiDebugDict;
&verifyGBSFile;
&readChemSys;
&readCnstrntFile;
&modifyInputFile;
&cleanup;
exit(0);

################################################################################
# Generic ##tag## substitution engine -- identical to ai.gauss16's
# modifyInputFile. Walks the template line by line, replaces ##key## with
# either &key(value) if such a sub exists, else the raw dictionary value,
# else (no match at any level of the dot-separated key) drops the line.
################################################################################
################################################################################
# Verbose troubleshooting output for the ##tag## substitution engine.
#
# Every silent-failure bug this project has chased through the input
# generators has one shape: a tag resolves to the empty string, its line is
# dropped, and the setting the user picked is simply not in the deck.  Nothing
# says so -- the script exits 0 and the job runs with different settings than
# the dialog showed.  (The NWChem BP86 case: the dialog offered "BP86 (GGA)",
# the resolver only matched "BP86 (hybrid)", and every such job silently ran
# on the default LDA instead.)
#
# Set ECCE_AI_DEBUG=1 for one line per tag on STDERR saying what it resolved
# to and, crucially, when it resolved to nothing.  An environment variable
# rather than a switch because these scripts are invoked with a fixed argument
# list from C++, so this needs no C++ change to turn on.
################################################################################
sub aiDebug {
  return unless $ENV{"ECCE_AI_DEBUG"};
  my ($message) = @_;
  print STDERR "[ecce-ai] $message\n";
}

# A resolver that returns "" is not automatically a bug.  The convention in
# these scripts is that a resolver which produces several lines either sets $_
# itself or prints straight to NEWFILE, and returns "" either way.  Four
# outcomes have to be told apart, and only the first two are trouble:
#
#   $_ still holds ##tag##   nothing replaced it; the literal tag text is
#                            about to be written into the input deck
#   nothing written at all   the line is dropped.  Intentional for an optional
#                            setting, and the silent-drop bug when it is not --
#                            the message names the tag, so a user report names
#                            the setting that vanished
#   bytes went to NEWFILE    the resolver wrote its own output (chemsys and
#                            friends do this); fine
#   $_ became something else likewise fine
#
# The NEWFILE byte count is what separates "dropped" from "written another
# way"; without it every multi-line resolver looks like a silent drop.
# Called from the `else { &aiUnmatched(@_); $result = ""; }` fallback that ends almost every
# translator in these scripts.  That fallback IS the silent-failure mechanism:
# the dialog offered a string, this sub has no case for it, the empty result
# propagates, and the job runs without the setting -- or, as with the Gaussian
# "None" case, the whole method string collapses to a bare "r".  @_ is the
# sub's own argument list, so the unmatched value reports itself without each
# call site having to name its parameter.
sub aiUnmatched {
  return unless $ENV{"ECCE_AI_DEBUG"};
  my $sub = (caller(1))[3] || "main";
  $sub =~ s/^main:://;
  my $value = defined($_[0]) ? $_[0] : "(no argument)";
  &aiDebug("  !! &$sub has no case for '$value' -- returning empty. If that "
           . "value came from a dialog, the dialog and this script disagree "
           . "and the setting will be missing from the input.");
}

# The full dictionary the dialogs and calced handed this script.  Logged once
# at startup because every "the job ran with the wrong settings" report needs
# both halves: what was asked for, and what reached the deck.
sub aiDebugDict {
  return unless $ENV{"ECCE_AI_DEBUG"};
  # readDict() stores every dotted SUFFIX of each key, so a single setting
  # appears four or five times.  Print only the longest form of each -- a key
  # that no other key ends with -- or the dump is mostly noise.
  my @keys = sort keys %AbiDict;
  my %isSuffix;
  foreach my $key (@keys) {
    foreach my $other (@keys) {
      $isSuffix{$key} = 1 if ($other ne $key && $other =~ /\.\Q$key\E$/);
    }
  }
  &aiDebug("dictionary as read from the .param file:");
  foreach my $key (@keys) {
    next if $isSuffix{$key};
    &aiDebug(sprintf("    %-46s = '%s'", $key, $AbiDict{$key}));
  }
}

sub aiDebugEmpty {
  return unless $ENV{"ECCE_AI_DEBUG"};
  my ($tag, $sub, $tellBefore) = @_;
  my $wrote = tell(NEWFILE) - $tellBefore;
  if ($_ =~ /\#\#\Q$tag\E\#\#/) {
    &aiDebug("  ##$tag##: &$sub returned EMPTY and nothing replaced the tag "
             . "-- the literal ##$tag## text will appear in the input file");
  } elsif ($wrote > 0) {
    &aiDebug("  ##$tag##: &$sub wrote $wrote bytes to the input directly");
  } elsif ($_ eq "") {
    &aiDebug("  ##$tag##: &$sub returned EMPTY and wrote nothing -- the line "
             . "was dropped; if that setting was chosen in the GUI, it is NOT "
             . "in the generated input");
  } else {
    &aiDebug("  ##$tag##: &$sub replaced the line itself");
  }
}

sub modifyInputFile {
  local($keysave, $key, $subname, $prefix, $postfix, $finished);
  $inputFile = $TplFILE;
  open(TEMPLATE, $inputFile);
  open(NEWFILE, ">tmpfile");
  while (<TEMPLATE>) {
    if (/([^#]*)##([^#]*)##(.*)/) {
      $prefix = $1;
      $postfix = $3;
      $keysave = $key = $2;
      &aiDebug("tag ##$key## (template line $.)");
      $finished = 0;
      while ($finished == 0) {
        $subname = $key;
        $subname =~ s/\./_/g;
        if (defined($AbiDict{$key})) {
          $finished = 1;
          $value = $AbiDict{$key};
          $fct = "&$subname('$value')";
          $eccePrevLine = $_;
          $eccePrevTell = tell(NEWFILE);
          $result = eval $fct;
          # #92: eval catches a die() inside the resolver, and the engine
          # reads undef as "no such sub / no substitution" -- so a
          # deliberate error used to vanish along with the tag's line and
          # the script exited 0 with a quietly incomplete deck. Re-raise
          # anything that is a real error; an "Undefined subroutine"
          # failure IS the no-substitution case the engine relies on, so
          # it stays silent.
          if ($@ && $@ !~ /Undefined subroutine/) { die $@; }
          if (!(defined $result)) {
            s/##$keysave##/$value/;
          } elsif ($result eq "") {
            &aiDebugEmpty($keysave, $subname, $eccePrevTell);
          } elsif ($result ne "") {
            &aiDebug("  ##$keysave## -> \'$result\'");
            $_ = $prefix . $result . $postfix . "\n";
          }
        } else {
          $finished = 1;
          $fct = "&$subname";
          $eccePrevLine = $_;
          $eccePrevTell = tell(NEWFILE);
          $result = eval $fct;
          # #92: eval catches a die() inside the resolver, and the engine
          # reads undef as "no such sub / no substitution" -- so a
          # deliberate error used to vanish along with the tag's line and
          # the script exited 0 with a quietly incomplete deck. Re-raise
          # anything that is a real error; an "Undefined subroutine"
          # failure IS the no-substitution case the engine relies on, so
          # it stays silent.
          if ($@ && $@ !~ /Undefined subroutine/) { die $@; }
          if (!(defined $result)) {
            if (index($key, ".") >= $[) {
              $key =~ s/\.[^\.]*$//;
              &aiDebug("  no &$subname; retrying as ##$key##");
              $finished = 0;
            } else {
              &aiDebug("  ##$keysave##: no dictionary value and no resolver -- LINE REMOVED");
              $_ = "";
            }
          } elsif ($result eq "") {
            &aiDebugEmpty($keysave, $subname, $eccePrevTell);
          } elsif ($result ne "") {
            &aiDebug("  ##$keysave## -> \'$result\'");
            $_ = $prefix . $result . $postfix . "\n";
          }
        }
      }
    }
    print(NEWFILE);
  }
  close(TEMPLATE);
  close(NEWFILE);
}

################################################################################
# Code-specific tag resolvers
################################################################################

# The "! keyword keyword ..." line
sub ORCARoute {
  my $route = "! ";
  $route .= &Theory($AbiDict{"Category"}, $AbiDict{"Theory"}) . " ";
  if ($useExplicitBasis == 0) {
    $route .= "$NameBasis ";
  }
  $route .= &RunType($AbiDict{"RunType"}) . " ";
  $route .= &RIJCOSXToken . " ";
  $route .= &SCFConvergenceToken . " ";
  $route .= &GeomConvergenceToken . " ";
  $route .= &FreqMethodToken . " ";
  $route .= &SolvationToken . " ";
  $route .= &ChelpgToken . " ";
  $route .= &SymmetryToken . " ";
  $route .= &AuxCBasisToken;
  $route =~ s/\s+/ /g;
  $route =~ s/\s+$//;
  return $route;
}

#  "! UseSym" -- turn on ORCA's symmetry detection.  Verified against
#  real ORCA 6.1.1: without it the "ORBITAL ENERGIES" block has no Irrep
#  column at all, with it every orbital carries one, which is what the
#  MO table's symmetry column is built from.
#
#  Deliberately NOT unconditional, unlike the print flags above: UseSym
#  changes what ORCA computes, not just what it reports, so it is the
#  user's call via the "Use symmetry" checkbox in orcatheory.py.
sub SymmetryToken {
  my $result = "";
  #  The choice now lives on the Calculation Editor's own page, beside
  #  the point group, and is stored under the code-neutral key that
  #  Gaussian and NWChem already read.  The old ORCA-only key is still
  #  honoured so calculations that stored one keep working.
  my $shared = $AbiDict{"ES.Theory.UseSymmetry"};
  my $mine   = $AbiDict{"ES.Theory.SCF.UseSymmetry"};
  my $wanted = defined($shared) ? $shared : $mine;
  if (defined($wanted) && $wanted eq "1") {
    $result = "UseSym";
  }
  return $result;
}

# "! RIJCOSX <auxbasis>" -- RI-J + chain-of-spheres approximate
# exchange. Verified against real ORCA 6.1.1 for both DFT (RKS) and HF:
# COSX grid generation and "Your calculation utilizes the auxiliary
# basis: <name>" both confirmed in the output.
sub RIJCOSXToken {
  my $result = "";
  if ($AbiDict{"ES.Theory.SCF.UseRIJCOSX"} eq "1") {
    my $auxBasis = $AbiDict{"ES.Theory.SCF.RIJCOSXAuxBasis"};
    $auxBasis = "def2/J" if ($auxBasis eq "");
    $result = "RIJCOSX $auxBasis";
  }
  return $result;
}

# "! LooseSCF|TightSCF|VeryTightSCF" -- "Normal" (ORCA's own default)
# emits nothing. Verified against real ORCA 6.1.1: each keyword
# visibly changes the printed SCF "Convergence Tolerance" TolE/TolErr
# values.
# Implicit solvation. ORCA had NONE -- no CPCM, no SMD, nothing -- so
# every deck ECCE generated was gas phase with no way to say otherwise.
#
# CPCM goes on the route card as "! CPCM(<solvent>)". SMD is NOT a route
# keyword: it is requested through CPCM's own block, which ORCABlocks
# emits, so this returns nothing for SMD. Verified against the real ORCA
# 6.1.1 binary -- the block-only form is accepted and genuinely engages
# the model ("CPCM SOLVATION MODEL", Epsilon 78.3550, "SMD-CDS solvent
# descriptors" all present in the output for water).
#
# Solvent names are kept in lockstep with orcatheory.py's list, every
# entry of which was checked by submitting "! HF STO-3G CPCM(<name>)" and
# looking for ORCA's "INPUT ERROR". A name the dialog offers that this
# sub does not know would silently produce a gas-phase job.
# "! CHELPG" -- ESP-fitted partial charges (issue #88).
#
# orca.desc has parsed the resulting "CHELPG Charges" block into
# ESPCHARGE since ORCA was integrated, but nothing could ever request
# one, so that parse type was dead code and the property never appeared
# for any ORCA job. Verified against ORCA 6.1.1: the keyword is accepted
# and the block it emits is exactly what orca.desc's Skip=2 expects.
# Correlation-fitting auxiliary basis ("<basis>/C").
#
# REQUIRED, not an optimisation, for anything whose correlation part goes
# through RI-MP2 -- which in ORCA means every DOUBLE HYBRID functional.
# Found by running them rather than by reading about them: "! B2PLYP
# def2-SVP" passes input parsing cleanly and then dies at runtime with
#
#   ERROR: RI-MP2 needs an AuxC basis but none was defined!
#
# (ORCA exit 55). Adding "def2-SVP/C" makes it run. So a dialog that
# offered double hybrids without this would produce decks that always
# fail, and fail late -- after the job reached a queue.
#
# The "<orbital basis>/C" spelling is the convention for both families
# ECCE offers here, def2-* and cc-pV*Z. Emitted only when needed, because
# an unnecessary AuxC is harmless but noisy, and only when the orbital
# basis is a name rather than an explicit set (an explicit basis has no
# name to append "/C" to).
sub AuxCBasisToken {
  my $result = "";
  return "" if ($useExplicitBasis != 0 || $NameBasis eq "");

  my $category = $AbiDict{"Category"};
  my $theory = $AbiDict{"Theory"};
  my $needsAuxC = 0;

  #  Anything whose correlation goes through RI needs a
  #  correlation-fitting basis. Two families do:
  #
  #    * double hybrids, whose MP2 component is RI-MP2; and
  #    * every DLPNO method, which is RI-based by construction.
  #
  #  CANONICAL MP2 and coupled cluster do NOT: conventional integrals
  #  are ORCA's default for them, and an unnecessary AuxC is harmless
  #  but noisy. That distinction is why this is a method property
  #  rather than a category one -- "CC" contains both CCSD(T), which
  #  does not need it, and DLPNO-CCSD(T), which does.
  #
  #  Verified against ORCA 6.1.1 by running each without an AuxC basis:
  #  DLPNO-MP2 and DLPNO-CCSD(T) both die with exit 55, exactly as the
  #  double hybrids do, while plain MP2 and CCSD(T) run fine.
  if ($category eq "DFT") {
    $needsAuxC = &IsDoubleHybrid($AbiDict{"ES.Theory.DFT.XCFunctionals"});
  } elsif ($theory =~ /^DLPNO-/) {
    $needsAuxC = 1;
  }

  $result = $NameBasis . "/C" if ($needsAuxC);
  $_ = $result;
  return $result;
}

# Which functionals in orcatheory.py's list are double hybrids, i.e. have
# an MP2 correlation component. Kept as an explicit set rather than a
# name-pattern guess: "B2PLYP" and "B3LYP" differ by one character and
# only one of them needs an AuxC basis.
sub IsDoubleHybrid {
  my ($label) = @_;
  my %doubleHybrids = (
    "B2PLYP"     => 1,
    "B2GP-PLYP"  => 1,
    "mPW2PLYP"   => 1,
    "wB2PLYP"    => 1,
    "DSD-BLYP"   => 1,
    "DSD-PBEP86" => 1,
    "PWPB95"     => 1,
  );
  return (defined($doubleHybrids{$label}) ? 1 : 0);
}

sub ChelpgToken {
  my $result = "";
  if ($AbiDict{"ES.Runtype.ORCA.UseCHELPG"} eq "1") {
    $result = "CHELPG";
  }
  $_ = $result;
  return $result;
}

sub SolvationToken {
  my $result = "";
  if ($AbiDict{"ES.Theory.SCF.UseSolvation"} eq "1") {
    my $model = $AbiDict{"ES.Theory.SCF.SolvationModel"};
    my $solvent = $AbiDict{"ES.Theory.SCF.Solvent"};
    $solvent = "water" if ($solvent eq "");
    #  Compared against an explicit set rather than tested for "not SMD".
    #  The negative form silently treated ANY unrecognised model as CPCM,
    #  so a third entry added to the dialog later would quietly run as
    #  CPCM instead of failing -- the offered-but-unmapped shape this
    #  project has hit nine times in one afternoon across the Gaussian
    #  dialogs. The dialog suite flagged it here before it could bite.
    if ($model eq "CPCM") {
      $result = "CPCM(" . $solvent . ")";
    } elsif ($model eq "SMD") {
      #  Emitted as a %cpcm block by ORCABlocks, not as a route keyword.
      $result = "";
    } else {
      die "ai.orca error: solvation model '$model' is not supported.\n" .
          "  Supported: CPCM, SMD.\n";
    }
  }
  $_ = $result;
  return $result;
}

sub SCFConvergenceToken {
  my %map = (
    "Loose"      => "LooseSCF",
    "Tight"      => "TightSCF",
    "Very Tight" => "VeryTightSCF",
  );
  return $map{$AbiDict{"ES.Theory.SCF.ConvergenceTolerance"}} || "";
}

# "! LooseOpt|TightOpt|VeryTightOpt" for a geometry-optimization
# runtype -- "Normal" emits nothing. Verified against real ORCA 6.1.1:
# each keyword visibly changes the printed geometry-optimization
# "Convergence Tolerances" TolE value.
sub GeomConvergenceToken {
  my $runtype = $AbiDict{"RunType"};
  return "" if ($runtype !~ /Geo/i);
  my %map = (
    "Loose"      => "LooseOpt",
    "Tight"      => "TightOpt",
    "Very Tight" => "VeryTightOpt",
  );
  return $map{$AbiDict{"ES.Runtype.GeomOpt.ConvergenceGradient"}} || "";
}

# "! NumFreq" for a numerical-Hessian frequency calculation -- the
# default (Analytic, no extra keyword) is ORCA's own "Freq"/"Opt Freq"
# analytic-Hessian behavior. Verified against real ORCA 6.1.1: NumFreq
# runs a visibly distinct "ORCA NUMERICAL FREQUENCIES" module instead
# of the analytic Hessian path.
sub FreqMethodToken {
  my $runtype = $AbiDict{"RunType"};
  return "" if ($runtype !~ /Vib/i);
  return ($AbiDict{"ES.Runtype.Vibration.Method"} eq "Numerical") ?
    "NumFreq" : "";
}

# %scf / %geom blocks -- approximate, unverified (see header note).
# Per the modifyInputFile contract (see ai.gauss16's CheckpointFile), a
# sub returning "" must also set $_ = "" itself, or the ##tag## text is
# left in the output verbatim instead of being blanked.
sub ORCABlocks {
  my $result = "";
  # Unconditionally request full MO coefficient printing to the text
  # output -- without this, ORCA only prints orbital energies/occupations
  # (ORBITAL ENERGIES) and leaves the coefficient matrix in the binary
  # .gbw file, which orca.mo (the MO parser) cannot read. Verified this
  # flag makes ORCA print a "MOLECULAR ORBITALS" text block identical in
  # intent to Gaussian's fort.7 dump / NWChem's inline MO printing.
  #  Print[P_OrbEn] 2 lifts ORCA's default truncation of the "ORBITAL
  #  ENERGIES" block to the first ten virtuals (verified against ORCA
  #  6.1.1: def2-SVP water listed 16 of its 24 orbitals by default, all
  #  24 with this).  orca.orbsym reads the Irrep column out of that
  #  block, and a truncated symmetry vector would mislabel every row of
  #  the MO table rather than just stop early -- see that script's
  #  header.  Unconditional, like Print[P_MOs]: it only lengthens the
  #  listing of numbers ORCA already computed.
  $result .= "%output\n  Print[P_MOs] 1\n  Print[P_OrbEn] 2\nend\n";
  # Unconditionally request the quadrupole moment (not computed by
  # default) so orca.quadpole has something to parse -- verified this
  # alone is enough to make ORCA print a "QUADRUPOLE MOMENT" section; no
  # equivalent flag exists for octupole/hexadecapole moments in ORCA.
  $result .= "%elprop\n  Quadrupole true\nend\n";
  #  SMD solvation. Unlike CPCM there is no route-card form: ORCA takes
  #  it inside the %cpcm block. Verified against ORCA 6.1.1 -- this alone
  #  produces "CPCM SOLVATION MODEL" with the SMD-CDS descriptors.
  if ($AbiDict{"ES.Theory.SCF.UseSolvation"} eq "1" &&
      $AbiDict{"ES.Theory.SCF.SolvationModel"} eq "SMD") {
    my $solvent = $AbiDict{"ES.Theory.SCF.Solvent"};
    $solvent = "water" if ($solvent eq "");
    $result .= "%cpcm\n  smd true\n  SMDsolvent \"" . $solvent . "\"\nend\n";
  }
  # %maxcore is memory per core, in MB -- the Theory Details dialog takes
  # GB (per-core) for UX consistency with the other codes, so convert.
  my $maxcoreGB = $AbiDict{"ES.Theory.SCF.MemorySize"};
  if ($maxcoreGB ne "") {
    # Plausibility guard against legacy MB-era stored values.  This field
    # meant MB/core until 78bb8d0 (orcatheory.py default=1000, 6619e05);
    # it means GB/core now.  A calc saved before that change still has a
    # three- or four-digit number in it, and 1000 restored into a GB
    # field became "%maxcore 1000000" -- 1 TB per core, from a dialog
    # reading "1000 Gigabytes / core", with nothing typed.  Seen live on
    # a real ORCA job, 2026-09-21.
    #
    # templates.py now declines to restore a value whose stored unit no
    # longer matches the widget's, which catches calcs still carrying the
    # old label -- but not ones whose stale number has since been
    # re-saved under the new label, which is how the live case arose.
    # So also guard here, at the point closest to the generated input:
    # nobody has 512 GB per core, whereas 512 MB per core was an
    # ordinary old setting, so a value this large can only be legacy MB.
    my $maxcore;
    if ($maxcoreGB > 512) {
      $maxcore = int($maxcoreGB);
      print STDERR "ai.orca: MemorySize=$maxcoreGB is implausible as " .
                   "GB/core; treating it as a legacy MB/core value and " .
                   "writing %maxcore $maxcore. Re-save this calc's " .
                   "Theory Details to clear it.\n";
    } else {
      $maxcore = int($maxcoreGB * 1000);
    }
    $result .= "%maxcore $maxcore\n";
  }
  # %pal nprocs N: only written if the user explicitly set Processors>1
  # in the theory dialog. Left at the default (1, no block at all) lets
  # gensub's orca() sub inject the actual launch-time queue processor
  # count instead -- confirmed empirically that ORCA just uses the LAST
  # %pal block if there happen to be two, so gensub only adds its own
  # when this one is absent, rather than risking the launch-time
  # allocation being silently overridden by a stale edit-time choice.
  my $nprocs = $AbiDict{"ES.Theory.SCF.NumProcessors"};
  if ($nprocs ne "" && $nprocs > 1) {
    $result .= "%pal nprocs $nprocs end\n";
  }
  my $maxiter = $AbiDict{"ES.Theory.SCF.ConvergenceIterations"};
  if ($maxiter ne "") {
    $result .= "%scf\n  MaxIter $maxiter\nend\n";
  }
  my $runtype = $AbiDict{"RunType"};
  if ($runtype =~ /Geo/i) {
    my $maxsteps = $AbiDict{"ES.Runtype.GeomOpt.MaximumStepsValue"};
    if ($maxsteps ne "") {
      $result .= "%geom\n  MaxIter $maxsteps\nend\n";
    }
  }
  $_ = $result;
  return $result;
}

# Inline the already-translated %basis block written by wrORCAGBS.pm
# (via std2ORCA) into $BasisFILE -- unless it was a named-library
# shortcut ("useRouteCard <name>"), in which case the name already went
# onto the "!" line in ORCARoute and nothing needs to be inlined here.
sub ORCABasis {
  my $result = "";
  if ($useExplicitBasis == 1) {
    open(GBS, $BasisFILE) || die "ai.orca error: Couldn't open $BasisFILE\n";
    while (<GBS>) { $result .= $_; }
    close(GBS);
  }
  $_ = $result;
  return $result;
}

sub Theory {
  my ($category, $theory) = @_;
  my $result;

  if ($category eq "DFT") {
    my $functional = &DFTXCFun($AbiDict{"ES.Theory.DFT.XCFunctionals"});
    if ($theory eq "UDFT") {
      $result = "UKS $functional";
    } else {
      $result = "RKS $functional";
    }
  } elsif ($theory eq "RHF") {
    $result = "HF";
  } elsif ($theory eq "UHF") {
    $result = "UHF";
  } elsif ($theory eq "RMP2") {
    $result = "MP2";
  } elsif ($theory eq "UMP2") {
    #  ORCA needs the reference stated explicitly for an open-shell MP2.
    $result = "UHF MP2";
  } elsif ($theory eq "CCSD") {
    $result = "CCSD";
  } elsif ($theory eq "CCSD(T)") {
    $result = "CCSD(T)";
  } elsif ($theory eq "DLPNO-MP2") {
    $result = "DLPNO-MP2";
  } elsif ($theory eq "DLPNO-CCSD") {
    $result = "DLPNO-CCSD";
  } elsif ($theory eq "DLPNO-CCSD(T)") {
    $result = "DLPNO-CCSD(T)";
  } else {
    die "ai.orca error: unsupported theory '$theory'.\n" .
        "  Supported: RHF, UHF, RDFT, UDFT, RMP2, UMP2, CCSD, CCSD(T),\n" .
        "  DLPNO-MP2, DLPNO-CCSD, DLPNO-CCSD(T).\n";
  }
  return $result;
}

# Translate ECCE's descriptive functional label to ORCA's keyword. Only a
# handful of common functionals are mapped since orcatheory.py (the
# Theory Details dialog that will define the descriptive labels) hasn't
# been written yet -- extend this table to match whatever labels that
# dialog ends up using, the way DFTXCFun in ai.gauss16 does for Gaussian.
sub DFTXCFun {
  my ($xcFun) = @_;
  my %map = (
    "B3LYP"     => "B3LYP",
    "PBE0"      => "PBE0",
    "PBE"       => "PBE",
    "revPBE"    => "revPBE",
    "RPBE"      => "RPBE",
    "BP86"      => "BP86",
    "BLYP"      => "BLYP",
    "B97-D3"    => "B97-D3",
    "TPSS"      => "TPSS",
    "TPSSh"     => "TPSSh",
    "M06L"      => "M06L",
    "M06"       => "M06",
    "M062X"     => "M062X",
    "CAM-B3LYP" => "CAM-B3LYP",
    "wB97X-D3"  => "wB97X-D3",
    #  Verified against ORCA 6.1.1; see orcatheory.py for why SCAN, M11,
    #  MN15 and the "-3c" composites are deliberately not here.
    "r2SCAN"    => "r2SCAN",
    "revTPSS"   => "revTPSS",
    "wB97X-V"   => "wB97X-V",
    "wB97M-V"   => "wB97M-V",
    "B97M-V"    => "B97M-V",
    #  Double hybrids (issue #91). Keep in lockstep with
    #  orcatheory.py's list AND with IsDoubleHybrid above -- a
    #  functional missing from the latter generates a deck with no
    #  AuxC basis, which ORCA accepts and then kills at runtime.
    "B2PLYP"     => "B2PLYP",
    "B2GP-PLYP"  => "B2GP-PLYP",
    "mPW2PLYP"   => "mPW2PLYP",
    "wB2PLYP"    => "wB2PLYP",
    "DSD-BLYP"   => "DSD-BLYP",
    "DSD-PBEP86" => "DSD-PBEP86",
    "PWPB95"     => "PWPB95",
  );
  return $map{$xcFun} || $xcFun;
}

sub RunType {
  my ($runtype) = @_;
  my $result;

  if ($runtype eq "Energy") {
    $result = "";
  } elsif ($runtype eq "Gradient") {
    $result = "EnGrad";
  } elsif ($runtype eq "Geometry") {
    $result = "Opt";
  } elsif ($runtype eq "Vibration") {
    $result = "Freq";
  } elsif ($runtype eq "GeoVib") {
    $result = "Opt Freq";
  } elsif ($runtype eq "Magnetic") {
    $result = "NMR";
  } else {
    die "ai.orca error: unsupported runtype '$runtype' (reduced scope covers Energy/Gradient/Geometry/Vibration/GeoVib/Magnetic only)\n";
  }
  return $result;
}

sub ChargeAndMultiplicity {
  my $charge = ($AbiDict{"Charge"} eq "") ? 0 : $AbiDict{"Charge"};
  return $charge . " " . &Multiplicity;
}

sub Multiplicity {
  my $multiplicity = 1;
  if ($AbiDict{"ChemSys.Multiplicity"} =~ /(\d+)/) {
    $multiplicity = $1;
  }
  return $multiplicity;
}

# " Symbol X Y Z" per atom, one per line -- same format Gaussian's chemsys
# sub emits, and what ORCA's "* xyz charge mult ... *" block expects.
sub chemsys {
  ($chemsys_atoms != 0) || die "ai.orca error: Fragment has no atoms!\n";
  for (my $index = 0; $index < $chemsys_atoms; $index++) {
    my $symbol = $tags{$index};
    print(NEWFILE " $symbol     $coords{$index,0}     ");
    print(NEWFILE "$coords{$index,1}     $coords{$index,2}\n");
  }
  $_ = "";
}

################################################################################
# Generic file I/O -- copied from ai.gauss16, code-agnostic
################################################################################

sub verifyAbiFile {
  open(ABIDICT, $AbiFILE) || die "ai.orca error: Couldn't open $AbiFILE\n";
}

sub verifyFragFile {
  open(CHEMSYS, $FragFILE) || die "ai.orca error: Couldn't open $FragFILE\n";
}

sub verifyCnstrntFile {
  if ($CnstrntFILE ne "") {
    open(GEOCNST, $CnstrntFILE);
  }
}

# Mirrors ai.gauss16's verifyGBSFile: std2ORCA/wrORCAGBS.pm write either
# a single "useRouteCard <name>" line (named library basis, put on the
# "!" line instead) or the full explicit %basis block.
sub verifyGBSFile {
  $useExplicitBasis = 1;
  open(GBS, $BasisFILE) || die "ai.orca error: Couldn't open $BasisFILE\n";
  while (<GBS>) {
    if (/useRouteCard\s+(\S*)/) {
      $useExplicitBasis = 0;
      $NameBasis = $1;
    }
  }
  close(GBS);
}

sub cleanup {
  system("/bin/mv -f tmpfile '$inputFile'");
  close(ABIDICT);
}

sub readDict {
  while (<ABIDICT>) {
    $_ =~ s/\s*!.*$//;
    if (/:/) {
      my ($key, $value) = split(/:/);
      $key =~ s/^\s*//;
      $key =~ s/\s*$//;
      $value =~ s/^\s*//;
      $value =~ s/\s*$//;
      my $tagkey = $key;
      while ($tagkey ne "") {
        $AbiDict{$tagkey} = $value;
        $tagkey =~ s/^[^\.]*//;
        $tagkey =~ s/^\.//;
      }
    }
  }
}

sub readChemSys {
  my $symbols = 0;
  $chemsys_atoms = 0;
  $_ = <CHEMSYS>;
  while (<CHEMSYS>) {
    if (/^num_atoms:/) {
      (undef, $chemsys_atoms) = split;
    } elsif (/^title:/) {
      (undef, $chemsys_name) = split;
    } elsif (/^atom_info:/) {
      $symbols = /symbol/;
    } elsif (/^atom_list:/) {
      for (my $index = 0; $index < $chemsys_atoms; $index++) {
        $_ = <CHEMSYS>;
        ($tags{$index}, $coords{$index,0}, $coords{$index,1}, $coords{$index,2}) = split;
        if (!$symbols) {
          $tags{$index} = $number_to_symbol{$tags{$index}};
        }
      }
    }
  }
}

# Constraint file support is out of reduced scope -- stub so the pipeline
# doesn't break if calced ever writes a .con file. Revisit alongside
# GeometryConstraintRules in ORCA.edml.
sub readCnstrntFile {
}

sub usage {
  print "Usage: ai.orca -p -f -b -n <basename> -t <template>\n";
  print "Options:    -h        this help\n";
  print "            -v        version\n";
  exit;
}

sub handle_options {
  &usage && exit if ($opt_h || $opt_help);
  my $revision = '$Revision: 1 $';
  $revision =~ s/\$//g;
  print "$revision\n" if ($opt_v);
  exit if ($opt_v);
  $AbiFILE = "$opt_n.param" if ($opt_p);
  $FragFILE = "$opt_n.frag" if ($opt_f);
  $BasisFILE = "$opt_n.basis" if ($opt_b);
  $CnstrntFILE = "$opt_n.con" if ($opt_c);
  $TplFILE = $opt_t;
}
