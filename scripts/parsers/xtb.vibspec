#!/usr/bin/env python3
# xtb's `vibspectrum` (appended by gensub between ECCE-XTB-VIBSPECTRUM
# markers) lists all 3N modes, the 5 or 6 rigid ones first at 0.00, so
# VIBFREQ and VIBIR come out the same length and row-aligned like ORCA's.
# The symmetry column is blank when xtb found none, hence the optional word.
#   "    7        a           1539.10       133.26444         YES"
import re
import sys
from xtb_parse import configure_streams, scalar

configure_streams()
freq, ir = [], []
for line in sys.stdin:
    m = re.search(r"^\s*\d+\s+(?:[A-Za-z]\S*\s+)?(-?\d+\.\d+)\s+(-?\d+\.\d+)\s+(YES|NO|-)",
                  line, re.ASCII)
    if m:
        freq.append(m.group(1))
        ir.append(m.group(2))
if freq:
    for key, unit, values in (("VIBFREQ", "cm-1", freq), ("VIBIR", "KM/Mole", ir)):
        print("key: {}\nsize:\n{}\nrowlabels:".format(key, len(values)))
        for items in ([str(i) for i in range(1, len(values) + 1)], values):
            for i, value in enumerate(items, 1):
                print(" " + value, end="\n" if i % 10 == 0 else "")
            if len(values) % 10:
                print()
            if items is not values:
                print("values:")
        print("units:\n{}\nEND".format(unit))
