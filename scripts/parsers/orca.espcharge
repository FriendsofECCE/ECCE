#!/usr/bin/env perl
################################################################################
#
# Purpose:
# Extracts ORCA's "CHELPG Charges" block into ECCE's ESPFIT property.
# Only present when the job's input requests CHELPG (ORCA does not compute
# ESP charges by default).
#
# Sample real input, verified against a real ORCA 6.1.1 RHF/STO-3G
# CHELPG run:
#   CHELPG Charges
#   --------------------------------
#     0   O   :      -0.618788
#     1   H   :       0.309403
#     2   H   :       0.309386
#   --------------------------------
#   Total charge:    -0.000000
#
################################################################################

$| = 1;

($key, $runtype, $ucCategory, $theory) = @ARGV;

my (@rowlabels, @values);
while (<STDIN>) {
  if (/^\s*(\d+)\s+(\S+)\s*:\s*(-?\d+\.\d+)/) {
    push(@rowlabels, "$1-$2");
    push(@values, $3);
  }
}

my $n = $#rowlabels + 1;
exit(0) if ($n < 1);

# One property, a PropVector<Atom> (what the charge panel reads).  ESPCHARGE
# is not emitted too: it would list the same charges twice under Charges.
print "key: ESPFIT\n";
print "size:\n$n\n";
print "values:\n" . join(" ", @values) . "\n";
print "units:\ne\n";
print "END\n";

exit(0);
