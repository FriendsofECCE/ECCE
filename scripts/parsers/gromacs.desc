# Parse descriptor for GROMACS mdrun output (the .log file).
#
# Used by the GROMACS MD study tasks (data/client/cap/GROMACS.edml).  The
# monitoring half of the integration does not depend on how the inputs are
# made, so it was built and verified first -- see docs/GROMACS.md.
#
# Verified against real GROMACS 2025.2 output: a steepest-descents
# minimisation and a 500-step NVT run, both checked in under
# tests/parsers/fixtures/gromacs/.
#
# THE ANCHOR IS THE STEP HEADER, NOT THE ENERGIES. GROMACS ends a run
# with a summary block that carries the identical "Energies (kJ/mol)"
# marker:
#
#     <====  A V E R A G E S  ====>
#     Statistics over 501 steps using 6 frames
#        Energies (kJ/mol)
#        ...
#
# Anchoring on the energies would parse that as one more step, putting a
# final point on every energy-vs-step plot whose value is an AVERAGE OVER
# THE RUN. The 500-step fixture has 6 step markers and 7 energy blocks,
# which is how this was caught. Only real steps carry the "Step Time"
# header, so that is the Begin.
#
# FRAMING: anchored on the energies marker itself, which is
# self-delimiting -- Skip=0 feeds the marker, and a blank End closes the
# section correctly for BOTH shapes (one header/value pair for a
# minimisation, two for dynamics) and is immune to the messages GROMACS
# interleaves into a step block:
#
#     Step           Time
#       500        1.00000
#
#     Writing checkpoint, step 500 at Tue Sep 22 18:15:48 2026
#
#
#     Energies (kJ/mol)
#
# Anchoring on the "Step Time" header instead was tried and measured, and
# does not work. A blank End closes immediately on the blank that sits
# before the marker, so nothing is fed. A fixed Skip past that blank
# fails on the interleaved-message blocks above. And a line count cannot
# serve both shapes: Lines=9 frames a dynamics block exactly but
# over-reads a minimisation's shorter one and swallows the NEXT step's
# Begin -- eccejobmonitor will not open a block while one is being fed,
# so alternate steps vanish. Measured on the fixtures: 6 of 6 dynamics
# steps but only 3 of 5 minimisation steps.
#
# THE AVERAGES BLOCK IS SWALLOWED ON PURPOSE by the [NULL] entry below.
# GROMACS ends a run with a summary whose "Energies (kJ/mol)" marker is
# BYTE-IDENTICAL to a real step's, so no Begin pattern can tell them
# apart. Parsed as a step it would put a final point on every
# energy-vs-step plot whose value is an AVERAGE OVER THE RUN, and would
# leave the scalar TE holding that average rather than the last step.
[TE][TEVEC][PRESSURE][MDPEVEC][MDKEVEC][MDVOLVEC][MDDENSVEC]
Script=gromacs.energy
Begin=^\s*Energies \(kJ/mol\)
Frequency=all
Skip=0
End=^\s*$
[END]

# The averages summary is swallowed by this entry so that [TE] never sees its
# byte-identical "Energies (kJ/mol)" marker as a step: eccejobmonitor will
# not open a block while one is being fed.  The entry parses it instead
# (gromacs.mdavg, #334) and runs to "Total Virial", which closes the whole
# energies section.  "A V E R A G E S" appears once, at the end of a run, and
# a minimisation prints none.
[MDPEAVG][MDKEAVG][MDTEAVG][MDTEMPAVG][MDPRESAVG][MDVOLAVG][MDDENSAVG]
Script=gromacs.mdavg
Begin=A V E R A G E S
Frequency=last
Skip=0
End=Total Virial
[END]

# A minimisation's last force; mdrun prints it once, after the final step.
[FMAX]
Script=gromacs.fmax
Begin=^Maximum force\s*=
Frequency=last
Skip=0
Lines=1
[END]

# The trajectory gensub leaves in ecce-parse-traj.txt (<= 100 frames), one
# GEOMTRACE step per frame; a File= parse like Gaussian's fort.7.
[GEOMTRACE]
Script=gromacs.geomtrace
File=ecce-parse-traj.txt
Begin=ecce-parse-traj.txt
[END]

# Job progress for the Organizer's Progress box (#284).  No Script: these
# only feed the monitor's live snapshot.  mdrun echoes the integrator and
# nsteps in its log; the stage is named by the integrator (md, steep, ...)
# and the step line gives the bar.  A minimisation that converges early
# stops short of nsteps.
[PROGRESS]
Begin=^\s+integrator\s+=\s+(\S+)
Remember=integrator
[END]

[PROGRESS]
Begin=^\s+nsteps\s+=\s+(\d+)
Remember=nsteps
[END]

[PROGRESS]
Begin=^\s+(\d+)\s+-?\d+\.\d{5}\s*$
Progress={integrator} point=$1/{nsteps}
[END]

[PROGRESS]
Begin=^(?:Steepest Descents|Polak-Ribiere Conjugate Gradients|Low-Memory BFGS Minimizer) converged to
Progress={integrator} converged=yes
[END]

[PROGRESS]
Begin=^(?:Steepest Descents|Polak-Ribiere Conjugate Gradients|Low-Memory BFGS Minimizer) did not converge to
Progress={integrator} converged=no
[END]

# A GROMACS Prepare task (gensub echoes "ECCE-PREPARE ..." into the output
# file).  Stage "prepare": the step under way, then the result lines that
# the summary and the properties below read.
[PROGRESS]
Begin=^ECCE-PREPARE step (\d+)/(\d+) (\S+)
Progress=prepare point=$1/$2 tool=$3
[END]

[PROGRESS]
Begin=^ECCE-PREPARE system atoms=(\d+) residues=(\d*) waters=(\d+) pos=(\d+) neg=(\d+) posname=(\S+) negname=(\S+)
Progress=prepare atoms=$1 residues=$2 waters=$3 pos=$4 neg=$5 posname=$6 negname=$7
[END]

[PROGRESS]
Begin=^ECCE-PREPARE box charge0=(\S+) charge1=(\S+) box=(\S+) a=(\S+) b=(\S+) c=(\S+) alpha=(\S+) beta=(\S+) gamma=(\S+)
Progress=prepare charge0=$1 charge1=$2 box=$3 a=$4 b=$5 c=$6 alpha=$7 beta=$8 gamma=$9
[END]

[PROGRESS]
Begin=^ECCE-PREPARE done
Progress=prepare done=yes
[END]

# The same two result lines as properties.  Frequency=last: one Prepare
# prints them once, at the end, after the tools' own output.
[NATOMS][NRESIDUES][NWATERS][NIONSPOS][NIONSNEG][SYSCHARGE0][SYSCHARGE][BOXA][BOXB][BOXC][BOXALPHA][BOXBETA][BOXGAMMA]
Script=gromacs.prepare
Begin=^ECCE-PREPARE system
Frequency=last
Skip=0
Lines=2
[END]
