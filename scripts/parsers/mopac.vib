#!/usr/bin/env perl
################################################################################
#
# Purpose:
# Extracts MOPAC's "NORMAL COORDINATE ANALYSIS (Total motion = 1
# Angstrom)" block into ECCE's VIB (per-mode Cartesian atom
# displacements), VIBFREQ (frequencies) and VIBSYM (mode symmetry
# labels) properties -- all three from ONE block, on purpose.
#
# WHY ALL THREE COME FROM THIS BLOCK, and not VIBFREQ from the
# friendlier-looking "DESCRIPTION OF VIBRATIONS" section:
# MOPAC's DESCRIPTION OF VIBRATIONS COLLAPSES DEGENERATE MODES -- it
# prints one stanza per distinct frequency, not one per mode.  A real
# PM7 CH4 FORCE run prints 9 modes here (including both members of each
# doubly-degenerate E pair, 1306.5/1306.5 and 2689.5/2689.5) but only 7
# stanzas there.  Sourcing VIBFREQ from DESCRIPTION therefore produced a
# 7-row VIBFREQ against a 9-mode VIB, which NModePanel would have
# indexed row-by-row against each other -- the same row-alignment trap
# CLAUDE.md records for ORCA's VIBFREQ/VIBIR pair.  Found by running a
# real CH4 job through a simulation of eccejobmonitor's actual
# line-feeding algorithm and comparing the two counts; a water test
# molecule (no degeneracies) would never have shown it.
#
# Taking all three from this one block makes the alignment structural
# rather than something to re-check.  The cost is one decimal place of
# frequency precision (this block prints 1286.1 where DESCRIPTION prints
# 1286.05), which is well below the accuracy of a semiempirical
# harmonic frequency.
#
# Layout, verified against a real MOPAC 23.1.2 CH4 FORCE run (9 modes,
# so two column groups of 8 + 1):
#
#    Root No.       1         2         3         4  ...      8
#
#                  1 A1      1 B1      1 E       1 E  ...
#
#                 1286.1    1297.0    1306.5    1306.5 ...
#
#            1   -0.0000    0.0000    0.0074   -0.0513 ...
#            2    0.0000   -0.0000   -0.0050    0.0357 ...
#            ...
#           15   -0.1442   -0.0012    0.0805    0.0109 ...
#
#    Root No.       9
#    ...
#
# Displacement rows are flattened Cartesian degrees of freedom
# (atom*3+coord), so natoms = nrows/3.  Within a group the two lines
# after the "Root No." header are, in order, the symmetry labels
# (printed as "<n> <irrep>" pairs, rejoined here into "1A1" form to
# match the DESCRIPTION section's own spelling) and the frequencies.
#
# The modes are rotated into the stored geometry's frame, see
# rotateModesToInputFrame below.
#
# MOPAC lists only the genuine 3N-6 (3N-5) modes in this block -- no
# near-zero translation/rotation rows to filter, unlike ORCA/NWChem.
#
################################################################################

$| = 1;

($key, $runtype, $ucCategory, $theory) = @ARGV;

my %matrix;   # $matrix{row}{mode} = displacement; row/mode both 0-based
my %freq;     # $freq{mode} = frequency
my %sym;      # $sym{mode}  = symmetry label
my $nrows = 0;
my $nmodes = 0;

my @modeIdx = ();
my $expect = 0;   # 1 = next non-blank line is symmetry labels,
                  # 2 = next non-blank line is frequencies

while (<STDIN>) {
  chomp;
  if (/^\s*Root No\.\s+(\d+(?:\s+\d+)*)\s*$/) {
    @modeIdx = split(' ', $1);
    $nmodes = $modeIdx[$#modeIdx] if ($modeIdx[$#modeIdx] > $nmodes);
    $expect = 1;
    next;
  }
  next unless (@modeIdx);
  next if (/^\s*$/);

  if ($expect == 1) {
    # "  1 A1      1 B1      1 E   ..." -- number/irrep pairs
    my @tok = split(' ', $_);
    for my $j (0 .. $#modeIdx) {
      last if ((2 * $j + 1) > $#tok);
      $sym{$modeIdx[$j] - 1} = $tok[2 * $j] . $tok[2 * $j + 1];
    }
    $expect = 2;
    next;
  }
  if ($expect == 2) {
    my @vals = split(' ', $_);
    for my $j (0 .. $#modeIdx) {
      last if ($j > $#vals);
      $freq{$modeIdx[$j] - 1} = $vals[$j];
    }
    $expect = 0;
    next;
  }

  # displacement row: leading integer row index, then one value per mode
  # in the current column group
  if (/^\s*(\d+)\s+((?:-?\d+\.\d+\s*)+)$/) {
    my $row = $1 - 1;
    my @vals = split(' ', $2);
    for my $j (0 .. $#modeIdx) {
      last if ($j > $#vals);
      $matrix{$row}{$modeIdx[$j] - 1} = $vals[$j];
    }
    $nrows = $row + 1 if (($row + 1) > $nrows);
  }
}

my $natoms = int($nrows / 3);
exit(0) if ($natoms < 1 || $nmodes < 1);

rotateModesToInputFrame();

# ---- VIBFREQ -----------------------------------------------------------
print "key: VIBFREQ\n";
print "size:\n$nmodes\n";
print "rowlabels:\n";
for my $i (1 .. $nmodes) {
  print " $i ";
  print "\n" if (($i % 10) == 0);
}
print "\n" if (($nmodes % 10) != 0);
print "values:\n";
for my $i (1 .. $nmodes) {
  my $f = $freq{$i - 1};
  $f = 0.0 if (!defined($f));
  print " $f";
  print "\n" if (($i % 10) == 0);
}
print "\n" if (($nmodes % 10) != 0);
print "units:\ncm-1\n";
print "END\n";

# ---- VIBSYM ------------------------------------------------------------
# Only published if MOPAC labeled every mode, so it can never come back
# shorter than VIBFREQ.
my $haveAllSyms = 1;
for my $i (0 .. $nmodes - 1) {
  $haveAllSyms = 0 if (!defined($sym{$i}));
}
if ($haveAllSyms) {
  print "key: VIBSYM\n";
  print "size:\n$nmodes\n";
  print "values:\n";
  for my $i (1 .. $nmodes) {
    print " $sym{$i - 1}";
    print "\n" if (($i % 10) == 0);
  }
  print "\n" if (($nmodes % 10) != 0);
  print "END\n";
}

# ---- VIB ---------------------------------------------------------------
print "key: VIB\n";
print "size:\n$nmodes $natoms 3\n";
print "vectorlabels:\n";
for my $i (1 .. $nmodes) {
  print " NA ";
  print "\n" if (($i % 10) == 0);
}
print "\nrowlabels:\n";
for my $i (1 .. $natoms) {
  print " $i ";
  print "\n" if (($i % 10) == 0);
}
print "\ncolumnlabels:\nX Y Z\n";
print "values:\n";
for my $m (0 .. $nmodes - 1) {
  for my $a (0 .. $natoms - 1) {
    for my $c (0 .. 2) {
      my $v = $matrix{$a * 3 + $c}{$m};
      $v = 0.0 if (!defined($v));
      printf("%.15e ", $v);
    }
    print "\n";
  }
}
print "units:\nAngstrom\n";
print "END\n";
exit(0);

# A FORCE run prints its modes in "ORIENTATION OF MOLECULE IN FORCE
# CALCULATION" (mopac.forceframe leaves it in $key/mopacForceGeom), not in
# the frame of the stored geometry (mopac.geomtrace leaves that in
# $key/mopacInputGeom), so the arrows would point the wrong way.  Rotate the
# modes by the proper rotation that fits the one frame onto the other (Horn's
# quaternion method).
sub readGeom {
  my ($file) = @_;
  my @rows;
  return @rows unless (open(AUXFILE, "<" . $file));
  while (<AUXFILE>) {
    my @f = split(' ', $_);
    push(@rows, [@f]) if (@f == 4);
  }
  close(AUXFILE);
  return @rows;
}

# Both frames come from side files of the other parse scripts in this job
# directory.  When they are not there, or do not fit, the modes would be drawn
# in the wrong frame without a sign of it, so say so and store nothing: the
# exit status reaches the job's activity log as a parse error.
sub frameError {
  my ($why) = @_;
  print STDERR "mopac.vib: $why; the normal modes are not stored because they "
             . "would be drawn in a different orientation than the structure\n";
  exit(1);
}

sub rotateModesToInputFrame {
  my @in = readGeom($key . "/mopacInputGeom");
  my @orient = readGeom($key . "/mopacForceGeom");
  unlink($key . "/mopacInputGeom", $key . "/mopacForceGeom");
  frameError("mopac.geomtrace left no geometry in the job directory (the parse "
           . "scripts do not share one)") if (!@in);
  # MOPAC printed no force orientation: the modes are in the input frame.
  return if (!@orient);
  my $n = scalar(@orient);
  frameError("the geometry has " . scalar(@in) . " atoms and the force "
           . "orientation $n, for $nrows displacement rows")
    if (scalar(@in) != $n || $n * 3 != $nrows);
  for my $i (0 .. $n - 1) {
    frameError("atom " . ($i + 1) . " is " . $in[$i][0] . " in the geometry and "
             . $orient[$i][0] . " in the force orientation")
      if (lc($in[$i][0]) ne lc($orient[$i][0]));
  }

  my (@ca, @cb);
  for my $i (0 .. $n - 1) {
    for my $c (0 .. 2) {
      $ca[$c] += $orient[$i][$c + 1] / $n;
      $cb[$c] += $in[$i][$c + 1] / $n;
    }
  }
  my @s;   # s[a][b] = sum a_a * b_b, a = force frame, b = input frame
  for my $i (0 .. $n - 1) {
    for my $a (0 .. 2) {
      for my $b (0 .. 2) {
        $s[$a][$b] += ($orient[$i][$a + 1] - $ca[$a]) * ($in[$i][$b + 1] - $cb[$b]);
      }
    }
  }
  my @nm = (
    [$s[0][0] + $s[1][1] + $s[2][2], $s[1][2] - $s[2][1], $s[2][0] - $s[0][2], $s[0][1] - $s[1][0]],
    [$s[1][2] - $s[2][1], $s[0][0] - $s[1][1] - $s[2][2], $s[0][1] + $s[1][0], $s[2][0] + $s[0][2]],
    [$s[2][0] - $s[0][2], $s[0][1] + $s[1][0], -$s[0][0] + $s[1][1] - $s[2][2], $s[1][2] + $s[2][1]],
    [$s[0][1] - $s[1][0], $s[2][0] + $s[0][2], $s[1][2] + $s[2][1], -$s[0][0] - $s[1][1] + $s[2][2]]);
  my @q = largestEigenvector(@nm);
  my ($w, $x, $y, $z) = @q;
  my @r = (
    [$w*$w + $x*$x - $y*$y - $z*$z, 2*($x*$y - $w*$z), 2*($x*$z + $w*$y)],
    [2*($x*$y + $w*$z), $w*$w - $x*$x + $y*$y - $z*$z, 2*($y*$z - $w*$x)],
    [2*($x*$z - $w*$y), 2*($y*$z + $w*$x), $w*$w - $x*$x - $y*$y + $z*$z]);

  # Not the same structure (or a mirror image).
  my $sq = 0;
  for my $i (0 .. $n - 1) {
    for my $a (0 .. 2) {
      my $v = $cb[$a];
      for my $b (0 .. 2) { $v += $r[$a][$b] * ($orient[$i][$b + 1] - $ca[$b]); }
      $sq += ($v - $in[$i][$a + 1]) ** 2;
    }
  }
  frameError("the force orientation is not the stored structure rotated "
           . "(rms " . sqrt($sq / $n) . " A)") if (sqrt($sq / $n) > 0.01);

  for my $m (0 .. $nmodes - 1) {
    for my $i (0 .. $n - 1) {
      my @d = map { $matrix{$i * 3 + $_}{$m} || 0.0 } (0 .. 2);
      for my $a (0 .. 2) {
        $matrix{$i * 3 + $a}{$m} = $r[$a][0] * $d[0] + $r[$a][1] * $d[1] + $r[$a][2] * $d[2];
      }
    }
  }
}

# Jacobi iteration on a symmetric 4x4 matrix; the eigenvector of the largest
# eigenvalue, as (w, x, y, z).
sub largestEigenvector {
  my @a = map { [@$_] } @_;
  my @v = map { my $i = $_; [map { $_ == $i ? 1.0 : 0.0 } (0 .. 3)] } (0 .. 3);
  for my $sweep (1 .. 60) {
    my $off = 0;
    for my $p (0 .. 2) { for my $q ($p + 1 .. 3) { $off += $a[$p][$q] ** 2; } }
    last if ($off < 1e-30);
    for my $p (0 .. 2) {
      for my $q ($p + 1 .. 3) {
        next if (abs($a[$p][$q]) < 1e-300);
        my $theta = ($a[$q][$q] - $a[$p][$p]) / (2 * $a[$p][$q]);
        my $t = ($theta >= 0 ? 1 : -1) / (abs($theta) + sqrt($theta * $theta + 1));
        my $c = 1 / sqrt($t * $t + 1);
        my $sn = $t * $c;
        for my $k (0 .. 3) {
          my ($akp, $akq) = ($a[$k][$p], $a[$k][$q]);
          $a[$k][$p] = $c * $akp - $sn * $akq;
          $a[$k][$q] = $sn * $akp + $c * $akq;
        }
        for my $k (0 .. 3) {
          my ($apk, $aqk) = ($a[$p][$k], $a[$q][$k]);
          $a[$p][$k] = $c * $apk - $sn * $aqk;
          $a[$q][$k] = $sn * $apk + $c * $aqk;
        }
        for my $k (0 .. 3) {
          my ($vkp, $vkq) = ($v[$k][$p], $v[$k][$q]);
          $v[$k][$p] = $c * $vkp - $sn * $vkq;
          $v[$k][$q] = $sn * $vkp + $c * $vkq;
        }
      }
    }
  }
  my $best = 0;
  for my $i (1 .. 3) { $best = $i if ($a[$i][$i] > $a[$best][$best]); }
  return map { $v[$_][$best] } (0 .. 3);
}
