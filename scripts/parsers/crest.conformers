#!/usr/bin/env python3
# One conformer between the ECCE-CREST-FRAME markers that gensub appends to
# the output: a comment line "energy: <Eh> relative: <kcal/mol>", then the
# atoms.  GEOMTRACE and CONFREL come from the same frame so they stay the
# same length.  The relative energy is within the one method only.
import re
import sys
from xtb_parse import configure_streams

configure_streams()
coords, labels, relative = [], "", None
for line in sys.stdin:
    m = re.search(r"^\s*energy:\s*\S+\s+relative:\s*(-?\d+\.\d+)", line, re.ASCII)
    if m:
        relative = m.group(1)
        continue
    m = re.search(r"^\s*([A-Za-z]{1,2})\s+(-?\d+\.\d+)\s+(-?\d+\.\d+)\s+(-?\d+\.\d+)\s*$", line, re.ASCII)
    if m:
        coords.append(" ".join(m.groups()[1:]))
        labels += " {}-{}".format(len(coords), m.group(1))
if not coords:
    sys.exit(0)
print("key: GEOMTRACE\nsize:\n1 {} 3\nrowlabels:\n{}".format(len(coords), labels))
print("columnlabels:\nX Y Z\nvalues:")
for coord in coords:
    print(" " + coord)
print("units:\nAngstrom\nEND")
if relative is not None:
    print("key: CONFREL\nsize:\n1\nvalues:\n{}\nunits:\nkcal/mol\nEND".format(relative))
