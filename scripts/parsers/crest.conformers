#!/usr/bin/env perl
# One conformer between the ECCE-CREST-FRAME markers that gensub appends to
# the output: a comment line "energy: <Eh> relative: <kcal/mol>", then the
# atoms.  GEOMTRACE and CONFREL come from the same frame so they stay the
# same length.  The relative energy is within the one method only.
$| = 1;
($key, $runtype, $ucCategory, $theory) = @ARGV;

my (@coordlines, $rowLabels, $rel);
$rowLabels = "";
while (<STDIN>) {
  if (/^\s*energy:\s*\S+\s+relative:\s*(-?\d+\.\d+)/) {
    $rel = $1;
  } elsif (/^\s*([A-Za-z]{1,2})\s+(-?\d+\.\d+)\s+(-?\d+\.\d+)\s+(-?\d+\.\d+)\s*$/) {
    push(@coordlines, "$2 $3 $4");
    $rowLabels .= " " . scalar(@coordlines) . "-$1";
  }
}

my $size = scalar(@coordlines);
exit(0) if ($size < 1);

print "key: GEOMTRACE\nsize:\n1 $size 3\nrowlabels:\n$rowLabels\n";
print "columnlabels:\nX Y Z\nvalues:\n";
print " $_\n" foreach (@coordlines);
print "units:\nAngstrom\nEND\n";

if (defined($rel)) {
  print "key: CONFREL\nsize:\n1\nvalues:\n$rel\nunits:\nkcal/mol\nEND\n";
}
exit(0);
