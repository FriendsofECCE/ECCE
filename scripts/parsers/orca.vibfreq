#!/usr/bin/env perl
################################################################################
#
# Purpose:
# Extracts vibrational frequencies from ORCA's "VIBRATIONAL FREQUENCIES"
# block into ECCE's VIBFREQ property (a PropVector). Modeled on
# nwchem.vibfreq for the output shape. Includes the six (five for linear
# molecules) near-zero translation/rotation modes ORCA lists along with
# the real vibrations, same as the raw source -- not filtered here.
#
# Sample input lines:
#      0:       0.00 cm**-1
#      6:    2169.83 cm**-1
#
# When symmetry is in use (UseSym, or ORCA detects one on its own),
# ORCA inserts an extra "Point group:  <PG>" line plus an "Irrep"
# column header between the scaling-factor line and the first data
# line -- absent when symmetry is off. Skip=N in orca.desc is a fixed
# count and can't conditionally handle both shapes, so this used to
# stop at the first non-matching line (the natural, established
# pattern elsewhere in this codebase, e.g. GEOMTRACE's own script) --
# but that meant Skip's fixed offset landed one line short of real
# data whenever the point-group line was present, and the *first* fed
# line (the "Irrep" header) failed the match immediately, silently
# producing zero frequencies. Confirmed live against a real ORCA 6.1.1
# run with UseSym (this session) -- VIBFREQ came back empty. Fixed by
# skipping non-matching lines instead of stopping at the first one;
# orca.desc's Skip is set low enough to work as the common starting
# point for both shapes, and End=NORMAL MODES still bounds how far
# this reads, so there's nothing else in that window this could
# accidentally over-read into.
#
################################################################################

$| = 1;

($key, $runtype, $ucCategory, $theory) = @ARGV;

my @values;
while (<STDIN>) {
  if (/^\s*\d+:\s*(-?\d+\.\d+)\s*cm\*\*-1/) {
    push(@values, $1);
  }
}

my $nfrequencies = $#values + 1;
exit(0) if ($nfrequencies < 1);

print "key: VIBFREQ\n";
print "size:\n$nfrequencies\n";
print "rowlabels:\n";
foreach my $i (1 .. $nfrequencies) {
  print " $i ";
  print "\n" if (($i % 10) == 0);
}
print "\n" if (($nfrequencies % 10) != 0);
print "values:\n";
foreach my $i (1 .. $nfrequencies) {
  print " $values[$i-1]";
  print "\n" if (($i % 10) == 0);
}
print "\n" if (($nfrequencies % 10) != 0);
print "units:\ncm-1\n";
print "END\n";
exit(0);
