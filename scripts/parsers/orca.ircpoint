#!/usr/bin/env perl
# IRC (#949): the path as ORCA computes it, one point at a time, so a running
# IRC can be watched.  Two kinds of line come here:
#   the "FORWARD IRC" / "BACKWARD IRC" banner: the direction of the rows that
#     follow; the first banner starts the path with the TS (the last FINAL
#     SINGLE POINT ENERGY, kept by orca.energy, at coordinate 0);
#   a row of the iteration table ("k  E  dE  max(|G|)  RMS(G)"): point k+1 of
#     that direction, coordinate +(k+1) forward, -(k+1) backward, the numbers
#     the IRC PATH SUMMARY gives the same point (orca.irc).
# IRCCOORD/IRCENERGY are re-sent whole: in run order (TS, forward, backward,
# as received) once orca.irctrj has sent structures in that order, so point i
# is frame i; in path order while there are none (an import, which reads the
# structures at the end), as unsorted vectors without frames draw a zigzag.
# The summary replaces them at the end.
$| = 1;
($key, $runtype) = @ARGV;
exit(0) unless ($runtype =~ /IRC/i);

my $line = <STDIN>;
exit(0) unless (defined $line);

if ($line =~ /^\s*\*\s+(FORWARD|BACKWARD) IRC\s+\*/) {
  my $dir = $1;
  my ($old) = readLines("$key/orcaIrcDir");
  writeLine("$key/orcaIrcDir", $dir);
  # A backward run after a forward one continues the same path.
  unless ($dir eq "BACKWARD" && defined $old && $old eq "FORWARD") {
    unlink("$key/orcaIrcPoints");
    my ($ts) = readLines("$key/orcaIrcE");
    exit(0) unless (defined $ts);
    writeLine("$key/orcaIrcPoints", "0 $ts");
  }
} elsif ($line =~ /^\s+(\d+)\s+(-\d+\.\d+)\s+-?\d+\.\d+\s+\d+\.\d+\s+\d+\.\d+\s*$/) {
  my ($k, $e) = ($1, $2);
  my ($dir) = readLines("$key/orcaIrcDir");
  exit(0) unless (defined $dir);
  my $sign = ($dir eq "BACKWARD") ? -1 : 1;
  # Row k is the next point of this direction, or a stray table: skip it.
  my $have = grep { $_->[0] * $sign > 0 } points();
  exit(0) unless ($k == $have);
  if (open(my $fh, ">>", "$key/orcaIrcPoints")) {
    print $fh $sign * ($k + 1), " $e\n";
    close($fh);
  }
} else {
  exit(0);
}

my @pts = points();
@pts = sort { $a->[0] <=> $b->[0] } @pts unless (-e "$key/orcaIrcFrames");
exit(0) unless (@pts);
my $n = scalar(@pts);
print "key: IRCCOORD\nsize: \n$n\nvalues: \n", join("\n", map { $_->[0] } @pts),
      "\nunits:\nPoint\nEND\n";
print "key: IRCENERGY\nsize: \n$n\nvalues: \n", join("\n", map { $_->[1] } @pts),
      "\nunits:\nHartree\nEND\n";
exit(0);

sub points {
  return map { [split] } readLines("$key/orcaIrcPoints");
}

sub writeLine {
  if (open(my $fh, ">", $_[0])) { print $fh "$_[1]\n"; close($fh); }
}

sub readLines {
  my @l;
  if (open(my $fh, "<", $_[0])) { @l = <$fh>; close($fh); chomp @l; }
  return grep { length } @l;
}
