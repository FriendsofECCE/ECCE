#!/usr/bin/env python3
################################################################################
#
# Purpose:
# Extracts MOPAC's Cartesian gradient table into ECCE's EGRADVEC
# property (PropTable<Atom,Coordinate>).  Only present when the input
# carries the GRADIENTS keyword, which ai.mopac emits for the Gradient
# runtype.
#
# Block shape, verified against a real MOPAC 23.1.2 "1SCF GRADIENTS"
# run (the header line is consumed by Skip=1):
#       1          1  O    CARTESIAN X     0.000000      0.000000  KCAL/ANGSTROM
#       2          1  O    CARTESIAN Y     0.000000     -0.000000  KCAL/ANGSTROM
#       3          1  O    CARTESIAN Z     0.200000     97.413669  KCAL/ANGSTROM
#
# MOPAC reports the gradient in kcal/(mol*Angstrom); every other code's
# EGRADVEC script publishes Hartree/Bohr, so convert with the standard
# 1 Hartree/Bohr = 1185.8210 kcal/(mol*Angstrom) factor
# (627.509474 kcal/mol per Hartree divided by 0.52917721 Angstrom per
# Bohr) so gradients are comparable across codes in the GUI.
#
################################################################################

import re
import sys
from xtb_parse import configure_streams, number

configure_streams()

KCAL_ANG_PER_HARTREE_BOHR = 1185.82105

grad = {}  # grad[atom, coord] = value, both 0-based
natoms = 0
coord_index = {"X": 0, "Y": 1, "Z": 2}
for line in sys.stdin:
    match = re.search(r"^\s*\d+\s+(\d+)\s+\S+\s+CARTESIAN\s+([XYZ])\s+-?\d+\.\d+\s+(-?\d+\.\d+)", line, re.ASCII)
    if match:
        atom = number(match.group(1), integer=True) - 1
        coord = coord_index[match.group(2)]
        grad[atom, coord] = number(match.group(3)) / KCAL_ANG_PER_HARTREE_BOHR
        natoms = max(natoms, atom + 1)
if natoms < 1:
    sys.exit(0)
print("key: EGRADVEC\nsize:\n{} 3\nrowlabels:".format(natoms))
for i in range(1, natoms + 1):
    print(" {} ".format(i), end="")
    if i % 10 == 0:
        print()
print("\ncolumnlabels:\nX Y Z\nvalues:")
for atom in range(natoms):
    print("".join(" {:.10f}".format(grad.get((atom, coord), 0.0)) for coord in range(3)))
print("units:\nHartree/Bohr\nEND")
