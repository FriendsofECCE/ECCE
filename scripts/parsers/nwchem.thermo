#!/usr/bin/env perl
################################################################################
#
# Purpose:
# Reads NWChem's plain stdout (not the ecce_print trace, which carries no
# thermochemistry and no solvation data) and emits EZEROPT, ETHERM,
# ENTHALPY, ENTROPY, EGIBBS, THERMOTEMP and, for COSMO, ESOLV and
# SOLVMODEL ("COSMO, eps = 78.4"; NWChem prints no pressure).
#
# NWChem prints only corrections, so the absolute values ORCA and Gaussian
# report are rebuilt here.  The reference electronic energy is the first
# "Total <method> energy" after the Hessian banner, i.e. the energy at the
# analysed geometry, not a later displaced-geometry energy:
#   ETHERM   = E + thermal correction to energy
#   ENTHALPY = E + thermal correction to enthalpy
#   ENTROPY  = T * S (Hartree, as for ORCA)
#   EGIBBS   = ENTHALPY - T*S
#
#   Temperature                      =   298.15K
#   Zero-Point correction to Energy  =   16.145 kcal/mol  (  0.025729 au)
#   Thermal correction to Energy     =   17.922 kcal/mol  (  0.028561 au)
#   Thermal correction to Enthalpy   =   18.515 kcal/mol  (  0.029505 au)
#   Total Entropy                    =   45.039 cal/mol-K
#
# ESOLV = sol phase energy - gas phase energy from the COSMO summary.  The
# summary's own "(electrostatic) solvation energy" line is the magnitude
# of that difference, so the sign is taken from the two totals.
#
################################################################################

$| = 1;

use constant KCAL_PER_HARTREE => 627.5094740631;

my ($e, $temp, $zpe, $dE, $dH, $S, $gas, $sol, $eps, $solvname);
my $inHessian = 0;
while (<STDIN>) {
  $inHessian = 1 if (/NWChem Nuclear Hessian and Frequency Analysis/);
  if ($inHessian && !defined($e)
      && /^\s+Total [\w()\-\. ]*? energy\s+=\s+(-?\d+\.\d+)\s*$/) {
    $e = $1;
  }
  if (/^\s*Temperature\s+=\s+(\d+\.\d+)K/) { $temp = $1; }
  elsif (/Zero-Point correction to Energy\s+=.*\(\s*(-?\d+\.\d+)\s+au\)/) { $zpe = $1; }
  elsif (/Thermal correction to Energy\s+=.*\(\s*(-?\d+\.\d+)\s+au\)/) { $dE = $1; }
  elsif (/Thermal correction to Enthalpy\s+=.*\(\s*(-?\d+\.\d+)\s+au\)/) { $dH = $1; }
  elsif (/^\s*Total Entropy\s+=\s+(-?\d+\.\d+)\s+cal\/mol-K/) { $S = $1; }
  elsif (/^\s*dielectric constant -eps-\s+=\s+(\d+\.\d+)/) { $eps = $1; }
  elsif (/^\s*solvname_long:\s+(\S.*?)\s*$/) { $solvname = $1; }
  elsif (/^\s*gas phase energy\s+=\s+(-?\d+\.\d+)/) { $gas = $1; }
  elsif (/^\s*sol phase energy\s+=\s+(-?\d+\.\d+)/) { $sol = $1; }
}

sub emit {
  my ($key, $value, $units) = @_;
  print "key: $key\n";
  print "size:\n1\n";
  print "values:\n$value\n";
  print "units:\n$units\n";
  print "END\n";
}

if (defined($e) && defined($dE) && defined($dH) && defined($S) && defined($temp)) {
  my $ts = $S * $temp / 1000.0 / KCAL_PER_HARTREE;
  &emit("EZEROPT", $zpe, "Hartree") if (defined($zpe));
  &emit("ETHERM", sprintf("%.8f", $e + $dE), "Hartree");
  &emit("ENTHALPY", sprintf("%.8f", $e + $dH), "Hartree");
  &emit("ENTROPY", sprintf("%.8f", $ts), "Hartree");
  &emit("EGIBBS", sprintf("%.8f", $e + $dH - $ts), "Hartree");
  &emit("THERMOTEMP", $temp, "Kelvin");
}
if (defined($gas) && defined($sol)) {
  &emit("ESOLV", sprintf("%.10f", $sol - $gas), "Hartree");
}
if (defined($eps)) {
  my $text = "COSMO";
  if (defined($solvname) && lc($solvname) ne "unknown") {
    $text .= ", " . ucfirst(lc($solvname));
  } else {
    $text .= sprintf(", \xCE\xB5 = %.1f", $eps);
  }
  &emit("SOLVMODEL", $text, "NA");
}
exit(0);
