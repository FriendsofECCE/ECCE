#!/usr/bin/env perl
# The ECCE-MLP-VIB block of a Vibration run: "mode <k> <cm-1>" then one
# displacement row per atom.  ecce-mlp already orders the modes (rigid ones
# first, at 0) and normalises the Cartesian vectors, so this only reshapes
# them into VIBFREQ and VIB, row-aligned like xtb.vibspec/xtb.vib.
$| = 1;
my ($nmodes, $natoms, @freq, @rows);
while (<STDIN>) {
  if (/^ECCE-MLP-VIB\s+(\d+)\s+(\d+)/) { ($nmodes, $natoms) = ($1, $2); next; }
  if (/^mode\s+\d+\s+(-?\d+\.\d+)/) { push(@freq, $1); next; }
  if (/^\s*(-?\d+\.\d+)\s+(-?\d+\.\d+)\s+(-?\d+\.\d+)\s*$/) { push(@rows, "$1 $2 $3"); }
}
exit(0) if (!$nmodes || scalar(@freq) != $nmodes || scalar(@rows) != $nmodes * $natoms);

sub labels {
  my ($n, $word) = @_;
  my $s = "";
  foreach my $i (1 .. $n) {
    $s .= " " . (defined($word) ? $word : $i);
    $s .= "\n" if ($i % 10 == 0);
  }
  $s .= "\n" if ($n % 10);
  return $s;
}
print "key: VIBFREQ\nsize:\n$nmodes\nrowlabels:\n", &labels($nmodes),
      "values:\n", join("\n", @freq), "\nunits:\ncm-1\nEND\n";
print "key: VIB\nsize:\n$nmodes $natoms 3\nvectorlabels:\n", &labels($nmodes, "NA"),
      "rowlabels:\n", &labels($natoms), "columnlabels:\nX Y Z\nvalues:\n",
      join("\n", @rows), "\nunits:\nAngstrom\nEND\n";
exit(0);
