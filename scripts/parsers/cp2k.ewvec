#!/usr/bin/env python3
import io
import re
import sys

# Python 3.6 lacks reconfigure(); job output may contain stray bytes.
for name in ("stdin", "stdout"):
    stream = getattr(sys, name)
    if hasattr(stream, "reconfigure"):
        stream.reconfigure(encoding="utf-8", errors="replace", newline="\n")
    else:
        setattr(sys, name, io.TextIOWrapper(stream.buffer, encoding="utf-8",
                                           errors="replace", newline="\n"))

line = sys.stdin.readline()
match = re.search('^\\s+\\d+\\s+(?:OT\\s+\\w+|\\S+/\\S+)\\s+\\S+\\s+\\S+\\s+\\S+\\s+(-?\\d+\\.\\d+)\\s+(-?\\d+\\.\\d+E[-+]\\d+)\\s*$', line, re.ASCII | re.IGNORECASE)
if match:
    print("key: EWVEC\nsize:\n1\nvalues:\n{}\nunits:\nHartree\nEND".format(match[1]), flush=True)
    print("key: DELTAE\nsize:\n1\nvalues:\n{}\nunits:\nHartree\nEND".format(match[2]), flush=True)
