#!/usr/bin/env python3
import io
import re
import sys

# Python 3.6 lacks reconfigure(); job output may contain stray bytes.
for name in ("stdin", "stdout"):
    stream = getattr(sys, name)
    if hasattr(stream, "reconfigure"):
        stream.reconfigure(encoding="utf-8", errors="replace", newline="\n")
    else:
        setattr(sys, name, io.TextIOWrapper(stream.buffer, encoding="utf-8",
                                           errors="replace", newline="\n"))

charge, spin = [], []
for line in sys.stdin:
    if re.search(r"^\s*#\s+Total charge", line, re.ASCII):
        break
    match = re.search(r"^\s*\d+\s+[A-Za-z]{1,2}\s+\d+\s+(.*\S)\s*$", line, re.ASCII)
    if not match:
        continue
    fields = re.split(r"\s+", match[1], flags=re.ASCII)
    if any(not re.search(r"^-?\d+\.\d+$", value, re.ASCII) for value in fields):
        continue
    if len(fields) == 2:
        charge.append(fields[1])
    elif len(fields) == 4:
        charge.append(fields[2])
        spin.append(fields[3])

if charge:
    print("key: MULLIKEN\nsize:\n{}\nvalues:\n{}\nunits:\ne\nEND".format(
        len(charge), " ".join(charge)), flush=True)
    if len(spin) == len(charge):
        print("key: SPINMOM\nsize:\n{}\nvalues:\n{}\nunits:\ne\nEND".format(
            len(spin), " ".join(spin)), flush=True)
