#!/usr/bin/env python3
################################################################################
#
# Purpose:
# Keeps the atom table of MOPAC's "ORIENTATION OF MOLECULE IN FORCE
# CALCULATION" in key/mopacForceGeom, for mopac.vib to rotate the normal
# modes (printed in that frame) back into the stored geometry's frame.
# Publishes no property.
#
################################################################################

import re
import sys
import os
from xtb_parse import configure_streams

configure_streams()

rows = []
for line in sys.stdin:
    match = re.search(r"^\s*\d+\s+([A-Za-z]{1,2})\s+(-?\d+\.\d+)\s+(-?\d+\.\d+)\s+(-?\d+\.\d+)\s*$", line, re.ASCII)
    if match:
        rows.append(" ".join(match.groups()) + "\n")
path = os.path.join(sys.argv[1], "mopacForceGeom")
try:
    os.unlink(path)
except OSError:
    pass
if rows:
    try:
        with open(path, "w", encoding="utf-8", errors="replace", newline="\n") as stream:
            stream.writelines(rows)
    except OSError:
        pass
