#!/usr/bin/env python3
import io
import re
import sys

# Python 3.6 lacks reconfigure(); job output may contain stray bytes.
for name in ("stdin", "stdout"):
    stream = getattr(sys, name)
    if hasattr(stream, "reconfigure"):
        stream.reconfigure(encoding="utf-8", errors="replace", newline="\n")
    else:
        setattr(sys, name, io.TextIOWrapper(stream.buffer, encoding="utf-8",
                                           errors="replace", newline="\n"))

# One frame carries its own energy so the geometry and energy steps align.
energy = None
coords, labels = [], []
for line in sys.stdin:
    match = re.search(r"^\s*i =\s+\d+,\s+E =\s+(-?\d+\.\d+)\s*$", line, re.ASCII)
    if match:
        energy = match[1]
    elif energy is not None:
        match = re.search(r"^\s*([A-Za-z][A-Za-z]?)\d*\s+(-?\d+\.\d+)\s+(-?\d+\.\d+)\s+(-?\d+\.\d+)\s*$",
                          line, re.ASCII)
        if match:
            coords.append(" " + " ".join(match.groups()[1:]))
            labels.append("{}-{}".format(len(labels) + 1, match[1]))
if energy is not None and coords:
    print("key: GEOMTRACE\nsize:\n1 {} 3\nrowlabels:\n {}\ncolumnlabels:\nX Y Z".format(
        len(coords), " ".join(labels)))
    print("values:\n" + "\n".join(coords) + "\nunits:\nAngstrom\nEND")
    print("key: TEVEC\nsize:\n1\nvalues:\n{}\nunits:\nHartree\nEND".format(energy), flush=True)
