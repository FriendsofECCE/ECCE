#!/usr/bin/env python3
# The STATE listing supplies multiplicities and transitions; the electric
# dipole spectrum supplies the more precise energies and oscillator strengths.
import re
import sys

from excited import emit_excited

multiplicities = {"1": "Singlet", "2": "Doublet", "3": "Triplet"}
states = []
spectrum = {}
for line in sys.stdin:
    state = re.match(r"^STATE\s+(\d+):\s+E=\s*\S+ au\s+(-?\d+\.\d+) eV.*Mult\s+(\d+)", line)
    transition = re.match(r"^\s+(\d+)([ab])\s*->\s*(\d+)([ab])\s*:\s+\S+\s+\(c=\s*(-?\d+\.\d+)\)", line)
    row = re.match(r"^\s*\d+-\d+\S*\s+->\s+(\d+)-(\d+)\S*\s+(\d+\.\d+)\s+\d+\.\d+\s+\d+\.\d+\s+(\d+\.\d+)", line)
    if state:
        states.append(dict(n=state[1], m=state[3], ev=state[2], f="0.0",
                           label=multiplicities.get(state[3], f"Mult{state[3]}"), trans=[]))
    elif states and transition:
        # ORCA counts orbitals from zero; the MO panel counts from one.
        states[-1]["trans"].append(f"{int(transition[1]) + 1}{transition[2]}>"
                                   f"{int(transition[3]) + 1}{transition[4]}:{transition[5]}")
    elif row:
        spectrum[(row[2], row[1])] = (row[3], row[4])

for state in states:
    row = spectrum.get((state["m"], state["n"]))
    if row:
        state["ev"], state["f"] = row
emit_excited(states)
