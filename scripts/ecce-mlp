#!/usr/bin/env python3
"""ecce-mlp: energy, geometry, vibrations and dynamics with a machine-learned
potential.

    ecce-mlp <deck>
    ecce-mlp --worker          (started by ecce-mlp-driver)

The optimisers, cell relaxation, dynamics and vibrations are ECCE's own
(ecce-mlp-driver, C++, src/mlp); this script hands the deck to it and then
serves as its worker, which only runs the network: one request per
structure over a pipe, energy, forces and stress back.  ecce-mlp-driver is
looked for in $ECCE_MLP_DRIVER, next to this Python (ecce-mlp-setup builds it
there) and on PATH.  engine=ase in the deck, ECCE_MLP_ENGINE=ase, or no driver
found: the former ASE optimisers (kept as the reference the tests compare
with; no MD).

The deck is what scripts/parsers/ai.mlp writes: line 1 is "mlp key=value ...",
the rest an extended-xyz structure (a Lattice= entry makes it periodic).
Keys: runtype (Energy|Geometry|Vibration|MD), model, dtype (float32|float64),
dispersion (on|off), optimizer (FIRE|BFGS), relax (atoms|cell), fmax (eV/A),
steps, timelimit (minutes, 0 = none), pressure (GPa, with relax=cell),
delta (Vibration: displacement in A); MD: ensemble (NVE|NVT), timestep (fs),
temperature (K), tau (fs, NVT), mdsteps, every (frame interval), seed.

Everything goes to stdout, which ECCE reads: a header naming the model, one
Step/Energy/Fmax block per optimiser step, each structure between
ECCE-MLP-FRAME markers, then an ECCE-MLP-FINAL block (energy, forces, stress)
and, for Vibration, an ECCE-MLP-VIB block (frequencies and normal modes).
The trajectory is also written to ecce-mlp.extxyz as it goes.

ECCE_MLP_MOCK=lj|emt swaps the network for a calculator that needs no model:
lj is built into ecce-mlp-driver (no Python packages needed), emt is ASE's.
They exist for the tests and the numbers mean nothing.
"""

import io
import os
import sys
import time

# MIT models first; the others are Academic Software License (no commercial
# use) and the Calculation Editor warns about them.
MODELS = {
    "medium-mpa-0": "MIT",
    "medium-0b3": "MIT",
    "small": "MIT",
    "medium": "MIT",
    "large": "MIT",
    "medium-omat-0": "ASL",
    "small-omat-0": "ASL",
    "mace-matpes-pbe-0": "ASL",
    "mace-matpes-r2scan-0": "ASL",
}
ASL_NOTICE = ("This model is under the Academic Software License (no "
              "commercial use).")

EV_TO_HARTREE = 1.0 / 27.211386245988
BOHR = 0.529177210903
# ASE stress is (1/V) dE/dstrain in eV/A^3; ECCE stores kbar with the sign of
# the pressure (positive when compressed), as for Quantum ESPRESSO.
EV_A3_TO_KBAR = 1602.1766208


def say(text=""):
    print(text, flush=True)


def fail(text, code=2):
    say("ecce-mlp: ERROR: " + text)
    sys.exit(code)


def read_deck(path):
    with open(path) as handle:
        lines = handle.read().splitlines()
    if not lines or not lines[0].split() or lines[0].split()[0] != "mlp":
        fail("line 1 of the deck must start with \"mlp\" followed by key=value options")
    opts = {}
    for word in lines[0].split()[1:]:
        key, _, value = word.partition("=")
        opts[key] = value
    return opts, "\n".join(lines[1:]) + "\n"


def make_calculator(opts):
    """Return (calculator, description, version, licence)."""
    mock = os.environ.get("ECCE_MLP_MOCK", "")
    if mock:
        if mock == "emt":
            from ase.calculators.emt import EMT
            return EMT(), "mock (ASE EMT)", "ase", "none (test calculator)"
        from ase.calculators.lj import LennardJones
        return (LennardJones(sigma=2.5, epsilon=0.1, rc=8.0),
                "mock (ASE Lennard-Jones)", "ase", "none (test calculator)")

    # An environment built by ecce-mlp-setup holds the weights in
    # <env>/cache/mace, so compute nodes need no internet.
    cache = os.path.join(sys.prefix, "cache")
    if os.path.isdir(os.path.join(cache, "mace")):
        os.environ["XDG_CACHE_HOME"] = cache
    model = opts.get("model", "medium-mpa-0")
    if model not in MODELS:
        fail("unknown model '%s'; choose one of: %s" % (model, ", ".join(MODELS)))
    dtype = opts.get("dtype", "float32")
    if dtype not in ("float32", "float64"):
        fail("dtype must be float32 or float64")
    disp = opts.get("dispersion", "off") == "on"
    try:
        from mace.calculators import mace_mp
    except ImportError as err:
        fail("the mace package is not importable by this Python (%s). Install "
             "it in the environment registered for the ML Potential code: "
             "pip install mace-torch" % err)
    if disp:
        try:
            import torch_dftd  # noqa: F401
        except ImportError:
            fail("dispersion=on needs torch-dftd in this Python environment: "
                 "pip install torch-dftd")
    try:
        calc = mace_mp(model=model, default_dtype=dtype, dispersion=disp)
    except Exception as err:  # download or load failure
        fail("could not load model %s: %s" % (model, err))
    try:
        from importlib.metadata import version
        ver = "mace-torch " + version("mace-torch")
    except Exception:
        ver = "mace-torch (version unknown)"
    return calc, "MACE " + model, ver, MODELS[model]


def number(opts, key, default, cast=float):
    try:
        return cast(opts.get(key, default))
    except ValueError:
        fail("%s=%s is not a number" % (key, opts.get(key)))


def frame_block(index, atoms, energy):
    out = ["ECCE-MLP-FRAME %d %d" % (index, len(atoms)),
           "energy: %.10f" % energy]
    if atoms.pbc.any():
        out.append("cell: " + " ".join("%.10f" % v
                                       for v in atoms.cell.array.flatten()))
    for sym, pos in zip(atoms.get_chemical_symbols(), atoms.get_positions()):
        out.append("%-2s %16.10f %16.10f %16.10f" % (sym, pos[0], pos[1], pos[2]))
    out.append("ECCE-MLP-ENDFRAME")
    return "\n".join(out)


def hessian(atoms, delta, start):
    """Central differences of the forces, symmetrised (eV/A^2)."""
    import numpy as np
    pos0 = atoms.get_positions().copy()
    n = len(atoms)
    hess = np.zeros((3 * n, 3 * n))
    for i in range(3 * n):
        a, c = divmod(i, 3)
        forces = []
        for sign in (1, -1):
            pos = pos0.copy()
            pos[a, c] += sign * delta
            atoms.set_positions(pos)
            forces.append(atoms.get_forces().ravel())
        hess[i] = -(forces[0] - forces[1]) / (2 * delta)
        say("Displacement %d of %d   Time %.1f s" % (i + 1, 3 * n, time.time() - start))
    atoms.set_positions(pos0)
    return 0.5 * (hess + hess.T)


def rigid_vectors(atoms):
    """Mass-weighted translations, and for a molecule rotations, orthonormal."""
    import numpy as np
    m = np.sqrt(atoms.get_masses())
    n = len(atoms)
    vecs = []
    for k in range(3):
        v = np.zeros((n, 3))
        v[:, k] = m
        vecs.append(v.ravel())
    if not atoms.pbc.any():
        r = atoms.get_positions() - atoms.get_center_of_mass()
        for k in range(3):
            axis = np.zeros(3)
            axis[k] = 1.0
            vecs.append((np.cross(axis, r) * m[:, None]).ravel())
    u, s, _ = np.linalg.svd(np.array(vecs).T, full_matrices=False)
    # A linear molecule has one rotation fewer.
    return u[:, s > 1e-6 * s.max()]


def vibrations(atoms, delta, fmax, start):
    """Harmonic frequencies and normal modes at the Gamma point.

    The rigid motions (translations; rotations too for a molecule) are
    projected out and printed as 0 first, like ORCA; the vectors are
    Cartesian displacements normalised to 1, the form VIB holds."""
    import numpy as np
    from ase import units
    if fmax > 0.05:
        say("Warning:      the forces are not small (Fmax %.3f eV/A); the "
            "frequencies are only meaningful at a minimum." % fmax)
    hess = hessian(atoms, delta, start)
    inv = 1.0 / np.sqrt(np.repeat(atoms.get_masses(), 3))
    hm = hess * np.outer(inv, inv)
    rigid = rigid_vectors(atoms)
    proj = np.eye(len(hm)) - rigid @ rigid.T
    w, v = np.linalg.eigh(proj @ hm @ proj)
    # The same conversion as ase.vibrations: eV/A^2/amu to cm-1.
    to_cm = units._hbar * 1e10 / np.sqrt(units._e * units._amu) / units.invcm
    overlap = ((rigid.T @ v) ** 2).sum(axis=0)
    order = [i for i in np.argsort(w) if overlap[i] > 0.5][:rigid.shape[1]]
    order += [i for i in np.argsort(w) if i not in order]
    n = len(atoms)
    say("")
    say("ECCE-MLP-VIB %d %d" % (3 * n, n))
    for k, i in enumerate(order):
        if k < rigid.shape[1]:
            freq, disp = 0.0, np.zeros(3 * n)
        else:
            freq = to_cm * np.sign(w[i]) * np.sqrt(abs(w[i]))
            disp = v[:, i] * inv
            disp /= np.linalg.norm(disp)
        say("mode %d %.4f" % (k + 1, freq))
        for row in disp.reshape(n, 3):
            say("%16.10f %16.10f %16.10f" % tuple(row))
    say("ECCE-MLP-ENDVIB")
    say("")
    freqs = [to_cm * np.sign(w[i]) * np.sqrt(abs(w[i]))
             for i in order[rigid.shape[1]:]]
    say("Frequencies (cm-1; negative = imaginary), %d rigid motions removed:"
        % rigid.shape[1])
    for k in range(0, len(freqs), 6):
        say("  " + " ".join("%10.2f" % f for f in freqs[k:k + 6]))
    nimag = sum(1 for f in freqs if f < -1e-6)
    if nimag:
        say("Imaginary frequencies: %d" % nimag)


def find_driver():
    """ecce-mlp-driver, or None."""
    import shutil
    for path in (os.environ.get("ECCE_MLP_DRIVER", ""),
                 os.path.join(sys.prefix, "bin", "ecce-mlp-driver"),
                 shutil.which("ecce-mlp-driver") or ""):
        if path and os.path.isfile(path) and os.access(path, os.X_OK):
            return path
    return None


def worker():
    """Serve ecce-mlp-driver: the network only.  Requests on stdin, replies
    on fd 3, so that what torch and mace print stays in the job output."""
    import numpy as np
    reply = os.fdopen(3, "w")
    head = sys.stdin.readline().split()
    if len(head) != 6 or head[0] != "init":
        sys.exit("ecce-mlp --worker: bad init line")
    n, pbc = int(head[1]), head[2] == "1"
    symbols = sys.stdin.readline().split()
    opts = {"model": head[3], "dtype": head[4], "dispersion": head[5]}
    try:
        calc, name, version, licence = make_calculator(opts)
        from ase import Atoms
    except SystemExit:
        reply.write("error\tthe model could not be loaded (see above)\n")
        reply.flush()
        raise
    atoms = Atoms(symbols, positions=np.zeros((n, 3)), pbc=pbc)
    atoms.calc = calc
    cache = os.environ.get("XDG_CACHE_HOME", "")
    weights = cache if cache.startswith(sys.prefix) else "-"
    reply.write("ok\t%s\t%s\t%s\t%s\n" % (name, version, licence, weights))
    reply.flush()
    while True:
        line = sys.stdin.readline()
        if not line or line.strip() != "eval":
            break
        cell = sys.stdin.readline().split()
        pos = np.array(sys.stdin.readline().split(), dtype=float).reshape(n, 3)
        try:
            if pbc:
                atoms.set_cell(np.array(cell, dtype=float).reshape(3, 3))
            atoms.set_positions(pos)
            energy = atoms.get_potential_energy()
            forces = atoms.get_forces()
            stress = atoms.get_stress() if pbc else None
        except Exception as err:
            reply.write("error %s\n" % str(err).replace("\n", " "))
            reply.flush()
            break
        reply.write("ok %r\n%s\n%s\n" % (
            float(energy), " ".join(repr(float(v)) for v in forces.ravel()),
            "none" if stress is None else " ".join(repr(float(v)) for v in stress)))
        reply.flush()


def main():
    if sys.argv[1:] == ["--worker"]:
        worker()
        return
    if len(sys.argv) != 2:
        fail("usage: ecce-mlp <deck>")
    opts, body = read_deck(sys.argv[1])
    runtype = opts.get("runtype", "Energy")
    if runtype not in ("Energy", "Geometry", "Vibration", "MD"):
        fail("runtype must be Energy, Geometry, Vibration or MD")
    engine = os.environ.get("ECCE_MLP_ENGINE") or opts.get("engine", "ecce")
    driver = find_driver() if engine != "ase" else None
    if driver:
        sys.stdout.flush()
        os.execv(driver, [driver, sys.argv[1], sys.executable,
                          os.path.abspath(__file__)])
    if runtype == "MD":
        fail("molecular dynamics needs ecce-mlp-driver, which was not found "
             "(ECCE_MLP_DRIVER, %s, PATH); Set up in Register Machines builds "
             "it" % os.path.join(sys.prefix, "bin"))
    delta = number(opts, "delta", 0.01)
    if not 0 < delta <= 0.1:
        fail("delta must be between 0 and 0.1 A")
    fmax = number(opts, "fmax", 0.05)
    steps = number(opts, "steps", 200, int)
    limit = number(opts, "timelimit", 0.0) * 60.0
    optimizer = opts.get("optimizer", "FIRE")
    if optimizer not in ("FIRE", "BFGS"):
        fail("optimizer must be FIRE or BFGS")
    relax = opts.get("relax", "atoms")

    try:
        import numpy as np
        from ase.io import read, write
    except ImportError as err:
        fail("ASE is not importable by this Python (%s): pip install ase" % err)
    try:
        atoms = read(io.StringIO(body), format="extxyz")
    except Exception as err:
        fail("cannot read the structure in the deck: %s" % err)
    periodic = bool(atoms.pbc.any())
    if relax == "cell" and runtype == "Geometry" and not periodic:
        fail("relax=cell needs a periodic structure; this one has no cell")

    start = time.time()
    calc, name, version, licence = make_calculator(opts)
    atoms.calc = calc

    say("ecce-mlp 1.0")
    say("Model:        %s" % name)
    say("Version:      %s" % version)
    say("Licence:      %s" % licence)
    if licence == "ASL":
        say("Notice:       " + ASL_NOTICE)
    say("Precision:    %s" % opts.get("dtype", "float32"))
    say("Dispersion:   %s" % opts.get("dispersion", "off"))
    say("Engine:       ASE%s" % ("" if engine == "ase" else
                                  " (ecce-mlp-driver not found)"))
    say("Run type:     %s" % runtype)
    say("Atoms:        %d   periodic: %s" % (len(atoms), "yes" if periodic else "no"))
    if runtype == "Geometry":
        say("Optimiser:    %s%s" % (optimizer,
                                    ", atoms and cell (FrechetCellFilter)"
                                    if relax == "cell" else ", atoms only"))
        say("convergence: fmax %g eV/A" % fmax)
        say("Limits:       %d steps%s" % (steps, ", %g minutes" % (limit / 60)
                                         if limit > 0 else ""))
    if runtype == "Vibration":
        say("Hessian:      central differences of the forces, step %g A, "
            "%d force calls" % (delta, 6 * len(atoms)))
    if os.environ.get("XDG_CACHE_HOME", "").startswith(sys.prefix):
        say("Weights:      cached in %s" % os.environ["XDG_CACHE_HOME"])
    say("Note:         energies are for screening, not for reporting.")
    say("")

    trajectory = "ecce-mlp.extxyz"
    if os.path.exists(trajectory):
        os.remove(trajectory)
    state = {"frames": 0, "stopped": ""}

    def active_forces(target):
        return target.get_forces()

    def record(target):
        energy = atoms.get_potential_energy()
        forces = active_forces(target)
        fm = float(np.sqrt((forces ** 2).sum(axis=1)).max()) if len(forces) else 0.0
        state["frames"] += 1
        write(trajectory, atoms, format="extxyz", append=True)
        # As ecce-mlp-driver: steps only for an optimisation, Eh for the box.
        if runtype == "Geometry":
            say("Step %4d" % (state["frames"] - 1))
            say("  Energy %.8f eV  %.8f Eh" % (energy, energy * EV_TO_HARTREE))
            say("  Fmax   %.5f eV/A" % fm)
            say("  Time   %.1f s" % (time.time() - start))
        else:
            say("Energy:       %.8f eV" % energy)
            say("Fmax:         %.5f eV/A" % fm)
        say(frame_block(state["frames"], atoms, energy))
        return fm

    converged = True
    if runtype in ("Energy", "Vibration"):
        fm = record(atoms)
        if runtype == "Vibration":
            vibrations(atoms, delta, fm, start)
    else:
        from ase.optimize import BFGS, FIRE
        target = atoms
        if relax == "cell":
            try:
                from ase.filters import FrechetCellFilter
            except ImportError:
                fail("relax=cell needs ASE 3.23 or newer (FrechetCellFilter)")
            target = FrechetCellFilter(
                atoms, scalar_pressure=number(opts, "pressure", 0.0) / 160.21766208)
        opt = (FIRE if optimizer == "FIRE" else BFGS)(target, logfile=None)
        opt.attach(lambda: record(target), interval=1)
        converged = False
        for converged in opt.irun(fmax=fmax, steps=steps):
            if converged:
                break
            if limit > 0 and time.time() - start > limit:
                state["stopped"] = "time limit of %g minutes" % (limit / 60)
                break
        if not converged and not state["stopped"]:
            state["stopped"] = "step limit of %d" % steps

    energy = atoms.get_potential_energy()
    forces = atoms.get_forces()
    say("")
    say("ECCE-MLP-FINAL")
    say("energy: %.10f" % energy)
    say("forces:")
    for sym, f in zip(atoms.get_chemical_symbols(), forces):
        say("%-2s %16.10f %16.10f %16.10f" % (sym, f[0], f[1], f[2]))
    if periodic:
        try:
            s = atoms.get_stress(voigt=False)
        except Exception:
            s = None
        if s is not None:
            say("stress (kbar):")
            for row in s:
                say(" ".join("%16.8f" % (-v * EV_A3_TO_KBAR) for v in row))
    say("ECCE-MLP-ENDFINAL")
    say("")
    if runtype == "Geometry":
        if converged:
            say("Optimisation converged after %d steps." % (state["frames"] - 1))
        else:
            say("ecce-mlp: NOT CONVERGED: stopped at the %s; the last "
                "structure is kept." % state["stopped"])
    say("Total energy: %.8f eV (%.8f Hartree)" % (energy, energy * EV_TO_HARTREE))
    say("ecce-mlp terminated normally")


if __name__ == "__main__":
    main()
