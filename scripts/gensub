}


###########################################################################
# Shell text the generated script is made of.  Everything gensub writes
# itself is POSIX sh; text a site or user supplies in CONFIG.<machine> (setup,
# wrapup, <code>Command, <code>_loophole, ...) is checked by shSnippet().
###########################################################################

# "$var = path", then the path replaced by $ECCE_<CODE> when that is set.
sub pathVar()
{
  my ($var, $path, $envVar) = @_;
  # Quoted when it needs it: "C:/Program Files/..." on Windows.
  if ($path =~ m{[^\w/.,:+@%=-]}) { (my $q = $path) =~ s/'/'\\''/g; $path = "'$q'"; }
  return "$var=$path\n" .
         "if [ -n \"\${$envVar+set}\" ]; then\n  $var=\$$envVar\nfi\n";
}

# A code's custom command from CONFIG, checked and translated.
sub userCmd()
{
  my ($key) = @_;
  return &shSnippet($key, $::config{$key});
}

# Returns the snippet as sh.  Plain `setenv N V`, `set N = V`, csh redirections
# and `exit (n)` are translated; anything else csh is collected in
# @::shErrors and reported once the script is generated, so a site sees every
# offending line in one run.  The rules are CshToSh's, shared with ecce-csh2sh,
# which also rewrites the structured forms (if, foreach, source) on request.
sub shSnippet()
{
  my ($key, $text) = @_;
  return $text if (!defined($text) || $text eq "");
  my $res = CshToSh::snippet($text);
  foreach my $iss (@{$res->{issues}}) {
    push @::shErrors, sprintf("  %s, line %d: %s\n      ECCE job scripts are POSIX sh; write: %s\n",
                              $key, $iss->{line}, $iss->{text}, $iss->{want});
  }
  return $res->{text};
}

# `module` and `ml` are shell functions that Lmod and Environment Modules
# define for interactive and bash shells only, so under /bin/sh (dash) a
# site's "module load" is "not found".  When the script uses either as a
# command, define the module command once, before the first use.  Lmod's
# prefix is found from the environment, then from the LMOD_PKG= line of the
# distribution's profile.d file (grepped, not sourced: those are bash).
sub modulePrologue()
{
  return <<'EOT';
# Make the module command available (job scripts are sh, not bash)
if ! command -v module >/dev/null 2>&1; then
  _ecce_p=$(sed -n 's/^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}LMOD_PKG=["'"'"']\{0,1\}\([^"'"'"'; ]*\).*/\2/p' /etc/profile.d/*lmod*.sh 2>/dev/null | head -n 1)
  case $_ecce_p in *'$'*) _ecce_p= ;; esac
  for _ecce_m in "${LMOD_PKG:+$LMOD_PKG/init/sh}" "${MODULESHOME:+$MODULESHOME/init/sh}" "${LMOD_CMD:+${LMOD_CMD%/libexec/*}/init/sh}" "${_ecce_p:+$_ecce_p/init/sh}" /etc/profile.d/lmod.sh /usr/share/lmod/lmod/init/sh /etc/profile.d/modules.sh /usr/share/Modules/init/sh /etc/profile.d/z00_lmod.sh; do
    [ -n "$_ecce_m" ] && [ -r "$_ecce_m" ] && . "$_ecce_m" && break
  done
fi
if ! command -v module >/dev/null 2>&1; then
  echo "module command not available in sh; 'module load' will fail (no Lmod or Environment Modules init file found)" >&2
  echo "module command not available in sh; 'module load' will fail (no Lmod or Environment Modules init file found)" >> LOGFILE
fi
EOT
}

sub addModulePrologue()
{
  my ($file) = @_;
  open(my $in, "<", $file) || return;
  my @lines = <$in>;
  close($in);
  my $cmd = qr/(?:^|[;&|(`{]|\b(?:then|do|else|elif|if|while|until)\b)\s*(?:module|ml)(?:\s|;|$)/;
  my $at;
  for (my $i = 0; $i < @lines; $i++) {
    next if $lines[$i] =~ /^\s*#/;
    if ($lines[$i] =~ $cmd) { $at = $i; last; }
  }
  return if !defined($at);
  my $pro = &modulePrologue();
  $pro =~ s/LOGFILE/$logfile/;
  splice(@lines, $at, 0, $pro, "\n");
  open(my $out, ">", $file) || return;
  print $out @lines;
  close($out);
}

sub shErrorReport()
{
  return "The job script would contain csh syntax, which ECCE no longer runs " .
         "(job scripts are POSIX sh, #!/bin/sh).\n" .
         "Fix these entries (line numbers count within the entry) in the config " .
         "file that defines them, one of those listed below; see " .
         "GETTING_STARTED.md, \"Job scripts are POSIX sh\".  " .
         "ecce-csh2sh --check (--user or --siteconfig) lists them with the file " .
         "and line, and ecce-csh2sh --convert rewrites what can be rewritten:\n" .
         join("", @::shErrors) .
         "Config files read: " . join(", ", @configFiles) . "\n";
}

###########################################################################
#         Code/QueueManager Implementation Subroutines
###########################################################################


###########################################################################
# Gaussian 98/03/09/16 differ only in names.  $tag is the variable holding
# the path ("g16"), $envOverride the environment variable that may replace
# it, $cmdKey the config key of a custom command.
###########################################################################
sub gaussianScript()
{
  my ($tag, $label, $envOverride, $cmdKey) = @_;
  my ($retval,$exe,$cmd);
  $retval = "";
  $exe = $config{$lccode};
  if ($exe eq "") { die "Path for $label not found"; }
  $cmd = &userCmd($cmdKey);

  # We still need to check the environment to allow the user
  # to override the path like we did with the previous implementation
  $retval .= &pathVar($tag, $exe, $envOverride);
  $retval .= "if [ -n \"\${GAUSS_EXEDIR+set}\" ]; then\n";
  $retval .= "  export GAUSS_EXEDIR=\"\${GAUSS_EXEDIR}:\${$tag%/*}\"\n";
  $retval .= "else\n";
  $retval .= "  export GAUSS_EXEDIR=\"\${$tag%/*}\"\n";
  $retval .= "fi\n";
  $retval .= "if [ -n \"\${LD_LIBRARY_PATH+set}\" ]; then\n";
  $retval .= "  export LD_LIBRARY_PATH=\"\${$tag%/*}:\${LD_LIBRARY_PATH}\"\n";
  $retval .= "else\n";
  $retval .= "  export LD_LIBRARY_PATH=\"\${$tag%/*}\"\n";
  $retval .= "fi\n";
  $retval .= "echo \"Using $tag path: \$$tag\" >> $::logfile\n";

  # For NQS and NQE systems use the system defined $TMPDIR, if available,
  # otherwise use the user configured scratch directory (if defined)
  if (defined($::scratchDir)) {
    $retval .= "export GAUSS_SCRDIR=$::scratchDir\n";
    $retval .= "echo \"Using $::scratchDir as GAUSS_SCRDIR\" >> $::logfile\n";
  } elsif ($::qMgr eq "NQS" || $::qMgr eq "NQE") {
    $retval .= "if [ -n \"\${TMPDIR+set}\" ]; then\n  export GAUSS_SCRDIR=\$TMPDIR\n";
    $retval .= "  echo \"Using \$TMPDIR as GAUSS_SCRDIR\" >> $::logfile\n";
    $retval .= "fi\n";
  }

  if ($cmd ne "") {
    $retval .= "$cmd\n";
  } else {
    $retval .= "\"\$$tag\" < $::inFile > $::outFile 2>&1\n";
  }
  return $retval;
}

sub gaussian98() { return &gaussianScript("g98", "G98", "ECCE_GAUSSIAN98", "gaussian-98command"); }
sub gaussian16() { return &gaussianScript("g16", "G16", "ECCE_GAUSSIAN16", "gaussian-16command"); }
sub gaussian09() { return &gaussianScript("g09", "G09", "ECCE_GAUSSIAN09", "gaussian-09command"); }
sub gaussian03() { return &gaussianScript("g03", "G03", "ECCE_GAUSSIAN03", "gaussian-03command"); }

###########################################################################
# Description
#   Use parallel for multiple nodes.
#
#   To Run nwchem under Maui/LL.
#   In the future, run under /scratch and use a poe commands file
#   that uses copyexe to copy nwchem to all the /scratch directories.
#   Heres the nwchem.ll snipet:
#     cp /u/windus/nwchem/bin/SP1/nwchem /scratch/nwchem
#     cat << EOFcat > poe.commands
#     /u1/d3g681/bin/copyexe /scratch/nwchem
#     /scratch/nwchem /u/windus/h2o.2.nw
#     quit
#     EOFcat
#     time poe -procs 1 -newjob yes -cmdfile poe.commands
#
#    Notice that nwchem does not allow the full domain name for
#    the host in the nwchem.p file.  You will get a very confusing
#    "Permission denied" error.
###########################################################################
sub nwchem() 
{
  use strict vars;
  my ($retval,$nwchem,$parallel,$cmd);
  $retval = "";
  $nwchem = $::config{$::lccode};
  if ($nwchem eq "") { die "Path for nwchem not found"; }
  $cmd = &userCmd("nwchemcommand");

  # We still need to check the environment to allow the user
  # to override the path like we did with the previous implementation
  $retval .= &pathVar("nwchem", "$nwchem", "ECCE_NWCHEM");

  # For running the ECCE distribution of NWChem, set $LD_LIBRARY_PATH to
  # find libgfortran.so.1
  if ($nwchem =~ /3rdparty\/nwchem\/bin/) {
    $retval .= "if [ -n \"\${LD_LIBRARY_PATH+set}\" ]; then\n";
    $retval .= "  export LD_LIBRARY_PATH=\"\${nwchem%/*}/../lib:\${LD_LIBRARY_PATH}\"\n";
    $retval .= "else\n";
    $retval .= "  export LD_LIBRARY_PATH=\"\${nwchem%/*}/../lib\"\n";
    $retval .= "fi\n";
  }

  # For NQS and NQE systems use the system defined $TMPDIR, if available,
  # otherwise use the user configured scratch directory (if defined)
  if (defined($::scratchDir)) {
    $retval .= "export SCRATCH_DIR=$::scratchDir\n";
    $retval .= "echo \"Using $::scratchDir as nwchem SCRATCH_DIR\" >> $::logfile\n";
  } elsif ($::qMgr eq "NQS" || $::qMgr eq "NQE") {
    $retval .= "if [ -n \"\${TMPDIR+set}\" ]; then\n  export SCRATCH_DIR=\$TMPDIR\n";
    $retval .= "  echo \"Using \$TMPDIR as nwchem SCRATCH_DIR\" >> $::logfile\n";
    $retval .= "fi\n";
  }

  if ($cmd ne "") {
    $retval .= "$cmd\n";
  } elsif ($::totalprocs <= 1) {
    $retval .= "\"\$nwchem\" $::inFile > $::outFile 2>&1\n";
  } elsif ($::totalprocs > 1) {
    $retval .= "\n$::CC - Generating submit file for NWChem built with MPI\n";
    $retval .= "\n$::CC - Path to mpirun if running an ECCE deployed NWChem\n";
    $retval .= "mpibindir=\${nwchem%/*}/../../system/bin\n";
    $retval .= "if [ -d \$mpibindir ]; then\n";
    $retval .= "  PATH=\"\$mpibindir:\$PATH\"; export PATH\n";
    $retval .= "fi\n";
    $retval .= "mpirun -np $::totalprocs \"\$nwchem\" $::qRunDir/$::inFile > $::qRunDir/$::outFile 2>&1 < /dev/null\n";
  }
  return $retval;
  nouse strict vars;
}

sub nwchemmd() 
{
  use strict vars;
  my ($retval,$nwchem,$parallel,$cmd);
  $retval = "";
  # $nwchem = $::config{$::lccode};
  # hardwire the configured code to nwchem so all the machine registration
  # <machine>.CONFIG files don't have to change
  $nwchem = $::config{"nwchem"};
  if ($nwchem eq "") { die "Path for nwchem not found"; }
  $cmd = &userCmd("nwchemcommand");

  # We still need to check the environment to allow the user
  # to override the path like we did with the previous implementation
  $retval .= &pathVar("nwchem", "$nwchem", "ECCE_NWCHEM");

  # For NQS and NQE systems use the system defined $TMPDIR, if available,
  # otherwise use the user configured scratch directory (if defined)
  if (defined($::scratchDir)) {
    $retval .= "export SCRATCH_DIR=$::scratchDir\n";
    $retval .= "echo \"Using $::scratchDir as nwchem SCRATCH_DIR\" >> $::logfile\n";
  } elsif ($::qMgr eq "NQS" || $::qMgr eq "NQE") {
    $retval .= "if [ -n \"\${TMPDIR+set}\" ]; then\n  export SCRATCH_DIR=\$TMPDIR\n";
    $retval .= "  echo \"Using \$TMPDIR as nwchem SCRATCH_DIR\" >> $::logfile\n";
    $retval .= "fi\n";
  }

  if ($cmd ne "") {
    $retval .= "$cmd\n";
  } elsif ($::totalprocs <= 1) {
    $retval .= "\"\$nwchem\" $::inFile > $::outFile 2>&1\n";
  } elsif ($::totalprocs > 1) {
    # parallel is assumed to be in the same location as nwchem itself.
    $retval .= "\n$::CC - Generating setup file for use with Parallel\n";
    $retval .= "rm -f nwchem.p\n";
    $retval .= "if [ -n \"\${ECCE_NWCHEM_P+set}\" ]; then\n";
    $retval .= "cp \$ECCE_NWCHEM_P nwchem.p\n";
    $retval .= "else\n";
    $retval .= "cat << EOCAT > nwchem.p\n";
    $retval .= "\$USER `hostname` $::totalprocs \"\$nwchem\" $::qRunDir\n";
    $retval .= "EOCAT\n";
    $retval .= "fi\n";
    $retval .= "loc=\${nwchem%/*}\n";
    $retval .= "\$loc/parallel nwchem $::qRunDir/$::inFile > $::qRunDir/$::outFile 2>&1\n";
  }
  return $retval;
  nouse strict vars;
}

###########################################################################
# Description
###########################################################################
sub amica() 
{
  use strict vars;
  my ($retval,$amica,$parallel,$cmd);
  $retval = "";
  $amica = $::config{$::lccode};
  if ($amica eq "") { die "Path for amica not found"; }
  $cmd = &userCmd("amicacommand");

  # We still need to check the environment to allow the user
  # to override the path like we did with the previous implementation
  $retval .= &pathVar("amica", "$amica", "ECCE_AMICA");
  $retval .= "echo \"Using amica path: \$amica\" >> $::logfile\n";
  $retval .= "PATH=\"\$amica:/usr/bsd:\$PATH\"; export PATH\n";
  $retval .= "alias which=/usr/bsd/which\n";

  # For NQS and NQE systems use the system defined $TMPDIR, if available,
  # otherwise use the user configured scratch directory (if defined)
  if (defined($::scratchDir)) {
    $retval .= "export AMICA_SCR=$::scratchDir\n";
    $retval .= "echo \"Using $::scratchDir as AMICA_SCR\" >> $::logfile\n";
  } elsif ($::qMgr eq "NQS" || $::qMgr eq "NQE") {
    $retval .= "if [ -n \"\${TMPDIR+set}\" ]; then\n  export AMICA_SCR=\$TMPDIR\n";
    $retval .= "  echo \"Using \$TMPDIR as AMICA_SCR\" >> $::logfile\n";
    $retval .= "fi\n";
  }

  if ($cmd ne "") {
    $retval .= "$cmd\n";
  } else {
    $retval .= "amica -P $::totalprocs < $::inFile\n";
  }
  return $retval;
  nouse strict vars;
}

###########################################################################
# Description
#   GAMESS-UK
###########################################################################
###########################################################################
# Description
#   ORCA (issue #38)
#
#   Unlike NWChem/GAMESS-UK/etc, ORCA must never be wrapped in an
#   external "mpirun -np N" -- its own driver launches mpirun
#   internally, controlled by a "%pal nprocs N end" block that has to
#   be IN THE INPUT FILE. ai.orca (scripts/parsers/ai.orca) can write
#   that block itself now, from a Processors setting in the theory
#   dialog -- but only if the user explicitly set it above the default
#   of 1, since the real launch-time processor count isn't known yet
#   when the calc editor built the input file. If the user didn't set
#   it explicitly, it's prepended here instead, right before running,
#   now that $::totalprocs is finally known. Confirmed against a real
#   ORCA 6.1.1 install: plain "orca file.inp" with a %pal block (either
#   one) runs a real multi-process MPI job; wrapping it in mpirun
#   yourself is not how ORCA parallelism works and was not tested (nor
#   needed). Also confirmed: ORCA silently uses the LAST %pal block if
#   there happen to be two, so this checks the input file directly
#   rather than risking an explicit edit-time choice getting overridden
#   by (or itself overriding) the queue's actual allocation.
###########################################################################
sub orca()
{
  use strict vars;
  my ($retval,$orca,$cmd,$hasOwnPal,$content);
  $retval = "";
  $orca = $::config{$::lccode};
  if ($orca eq "") { die "Path for ORCA not found"; }
  $cmd = &userCmd("orcacommand");

  $retval .= &pathVar("orca", "$orca", "ECCE_ORCA");
  $retval .= "echo \"Using ORCA path: \$orca\" >> $::logfile\n";

  if ($cmd ne "") {
    $retval .= "$cmd\n";
  } else {
    $hasOwnPal = 0;
    if (open(my $fh, "<", $::inFile)) {
      local $/;
      $content = <$fh>;
      close($fh);
      $hasOwnPal = 1 if (defined($content) && $content =~ /%pal\b/i);
    }
    if ($::totalprocs > 1 && !$hasOwnPal) {
      $retval .= "\n$::CC - Prepend %pal so ORCA's own driver launches mpirun itself\n";
      $retval .= "if [ ! -e $::inFile.orig ]; then cp $::inFile $::inFile.orig; fi\n";
      $retval .= "echo '%pal nprocs $::totalprocs end' > $::inFile.tmp\n";
      $retval .= "cat $::inFile.orig >> $::inFile.tmp\n";
      $retval .= "mv $::inFile.tmp $::inFile\n";
    }
    # ORCA starts its parallel part with mpiexec (Windows, Microsoft MPI)
    # or mpirun; without one it stops at once, so run on one core instead.
    $retval .= "case \"\$(uname -s)\" in MINGW*|MSYS*|CYGWIN*) orcampi=mpiexec ;; *) orcampi=mpirun ;; esac\n";
    $retval .= "if grep -qi '^[[:space:]]*%pal' $::inFile && ! command -v \$orcampi >/dev/null 2>&1; then\n";
    $retval .= "  echo \"ORCA: \$orcampi not found, running on 1 core. Parallel ORCA needs Microsoft MPI (Windows) or Open MPI.\" >> $::logfile\n";
    $retval .= "  perl -i -ne 'print unless /^\\s*%pal\\b/i' $::inFile\n";
    $retval .= "fi\n";
    $retval .= "\"\$orca\" $::inFile > $::outFile 2>&1\n";
  }
  return $retval;
  nouse strict vars;
}

#############################################################################
# ECCE-QM, the engine bundled with ECCE (src/qm).  It is not installed
# anywhere a CONFIG file would name, so with no path configured the copy next
# to ECCE's own programs is used; ECCE_ECCEQM in the environment, or an
# "ecce-qm:" line in CONFIG.<machine>, replaces it.  The report goes to the
# declared output file on stdout, errors after it, and the job's thread count
# is the processor count asked for.
#############################################################################
sub ecceqm()
{
  use strict vars;
  my ($retval,$exe,$cmd);
  $retval = "";
  $exe = $::config{$::lccode};
  $exe = "$::ecceHome/bin/ecce-qm" if (!defined($exe) || $exe eq "");
  $cmd = &userCmd("ecce-qmcommand");

  $retval .= &pathVar("ecceqm", "$exe", "ECCE_ECCEQM");
  $retval .= "echo \"Using ecce-qm path: \$ecceqm\" >> $::logfile\n";
  $retval .= "OMP_NUM_THREADS=$::totalprocs\nexport OMP_NUM_THREADS\n";
  $retval .= "ECCE_BASIS_DIR=\"$::ecceHome/data/admin/basissets\"\nexport ECCE_BASIS_DIR\n";
  if ($cmd ne "") {
    $retval .= "$cmd\n";
  } else {
    $retval .= "\"\$ecceqm\" $::inFile > $::outFile 2>&1\n";
  }
  return $retval;
  nouse strict vars;
}

###########################################################################
# MOPAC.
#
# Two things make this different from every other code's sub here:
#
#   1. MOPAC takes its data set as a plain argument and writes almost
#      nothing to stdout (just a one-line "Job ... ended normally"), so
#      the usual "$code $inFile > $outFile" shape produces an empty
#      output file.  The real output goes to a file MOPAC names itself.
#
#   2. MOPAC names that file by stripping a known extension out of the
#      INPUT file name -- by substring, which is why MOPAC.edml has to
#      call the input "mopac.mop" and nothing more inventive (feeding it
#      "mopac.mopin" makes it write "mopac    in.out"; verified against
#      the real MOPAC 23.1.2 binary).  So the output is always
#      "<basename>.out", a generic extension Apache has no MIME mapping
#      for, which is exactly the failure mode the ORCA .in/.out episode
#      documented.
#
# Both are handled by symlinking the distinctive name MOPAC.edml
# declares (mopac.mopout) onto the file MOPAC will write (mopac.out),
# BEFORE running -- not by moving the file afterwards, because
# eccejobmonitor tails the declared output file live while the job runs
# and would have nothing to read until the very end.
#
# THREADS=n is MOPAC's only parallelism control and it is shared-memory
# threading, so there is no mpirun wrapper here; the thread count is
# injected into the input file's keyword line by mopac.launchpp
# (<LaunchPreprocessor>) before this script ever runs.
###########################################################################
# GROMACS, run as a task of a GROMACS MD study (docs/GROMACS.md).
#
# GROMACS is not one binary reading one deck: grompp turns the .mdp (written
# by md.gmxtask), the topology and the starting structure into a binary .tpr,
# and mdrun runs the .tpr.  Both steps run here, on the machine that runs
# the job, because that is where gmx is known to exist; gromacs.launchpp
# has already tried grompp on the launching machine when it could, so
# a mistake in the inputs normally never gets this far.
#
# Launch stages the inputs under fixed names: gromacs.mdp (the declared
# input), topol.top, conf.gro, and any .itp/.ndx files the topology
# includes.  The final structure is written under the name the MD task
# code looks it up by (<system>_<calc>.gro, MdTask::getRestartName) and as
# chemsys.pdb (the output fragment name, which is VDoc's constant) for the
# Builder.
#
# If grompp fails its output is copied into the declared output file, so
# the reason is in the output the user opens, not only in the job log.
#
# The processor count goes on mdrun's command line, not into the .mdp:
# -ntmpi 1 -ntomp N for gmx, whose thread-MPI would otherwise try a domain
# decomposition a small box cannot have.  A program called gmx_mpi is an
# MPI build and is started with mpirun instead.
sub gromacs()
{
  use strict vars;
  my ($retval,$gmx,$cmd,$restart,$run,$mpi,$log);
  $retval = "";
  $gmx = $::config{$::lccode};
  if ($gmx eq "") { die "Path for GROMACS not found"; }
  $cmd = &userCmd("gromacscommand");

  $retval .= &pathVar("gmx", "$gmx", "ECCE_GROMACS");
  $retval .= "echo \"Using GROMACS path: \$gmx\" >> $::logfile\n";

  if ($cmd ne "") {
    $retval .= "$cmd\n";
  } else {
    $restart = $::mdSystemName . "_" . $::mdCalcName . ".gro";
    $mpi = ($gmx =~ /gmx_mpi[^\/]*$/) ? 1 : 0;

    #  What follows is one if/else so that the status the script goes on
    #  to read as "the code's exit status" is grompp's when it failed and
    #  mdrun's when it ran, not that of the editconf after it.
    $retval .= "\n$::CC - grompp builds the .tpr; its complaints, which are\n";
    $retval .= "$::CC - mostly about the topology, go where the user will look.\n";
    #  -r: position restraints are held to the starting structure; grompp
    #  refuses a restrained topology without it and ignores it otherwise.
    $retval .= "\"\$gmx\" grompp -f $::inFile -c conf.gro -r conf.gro -p topol.top -o topol.tpr -maxwarn 0 > grompp.out 2>&1\n";
    $retval .= "if [ \$? -ne 0 ]; then\n";
    $retval .= "  cat grompp.out >> $::logfile\n";
    $retval .= "  cp grompp.out $::outFile\n";
    $retval .= "  echo \"grompp failed; see $::outFile\" >> $::logfile\n";
    $retval .= "  false\n";
    $retval .= "else\n";

    #  mdrun insists on a .log name for its log (given another extension
    #  it adds .log), so it writes <base>.log and the declared output name
    #  is a symlink to it for the length of the run, so that the monitor
    #  can follow it live; afterwards the symlink is replaced by a copy,
    #  because a symlink does not survive being uploaded.
    $log = $::outFile;
    $log =~ s/\.[^.]*$//;
    $log .= ".log";
    $retval .= "  rm -f $::outFile\n";
    $retval .= "  ln -s $log $::outFile\n";
    $run = "mdrun -s topol.tpr -g $log -c $restart -e ener.edr -x traj.xtc";
    if ($mpi) {
      $retval .= "  mpirun -np $::totalprocs \"\$gmx\" $run -ntomp 1 >> $::logfile 2>&1\n";
    } else {
      $retval .= "  \"\$gmx\" $run -ntmpi 1 -ntomp $::totalprocs >> $::logfile 2>&1\n";
    }
    $retval .= "  mdrunStatus=\$?\n";
    $retval .= "  rm -f $::outFile\n";
    $retval .= "  cp $log $::outFile\n";
    $retval .= "  $::CC - The final structure as PDB: what the Builder shows.\n";
    $retval .= "  \"\$gmx\" editconf -f $restart -o chemsys.pdb >> $::logfile 2>&1\n";
    $retval .= "  ( exit \$mdrunStatus )\n";
    $retval .= "fi\n";
  }
  return $retval;
  nouse strict vars;
}

sub mopac()
{
  use strict vars;
  my ($retval,$mopac,$cmd,$base);
  $retval = "";
  $mopac = $::config{$::lccode};
  if ($mopac eq "") { die "Path for MOPAC not found"; }
  $cmd = &userCmd("mopaccommand");

  $retval .= &pathVar("mopac", "$mopac", "ECCE_MOPAC");
  $retval .= "echo \"Using MOPAC path: \$mopac\" >> $::logfile\n";

  if ($cmd ne "") {
    $retval .= "$cmd\n";
  } else {
    $base = $::inFile;
    $base =~ s/\.[^.]*$//;
    $retval .= "\n$::CC - MOPAC writes $base.out itself; expose it under the\n";
    $retval .= "$::CC - declared output name so live monitoring can follow it.\n";
    $retval .= "if [ \"$base.out\" != \"$::outFile\" ]; then\n";
    $retval .= "  rm -f $::outFile\n";
    $retval .= "  ln -s $base.out $::outFile 2>/dev/null || :\n";
    $retval .= "fi\n";
    $retval .= "\"\$mopac\" $::inFile >> $::logfile 2>&1\n";
    $retval .= "\n$::CC - Now the run is finished, replace that symlink with a\n";
    $retval .= "$::CC - real copy. The symlink is only needed DURING the run,\n";
    $retval .= "$::CC - so live monitoring has the declared name to follow;\n";
    $retval .= "$::CC - afterwards ECCE uploads the declared output file to the\n";
    $retval .= "$::CC - data server, and a symlink does not survive that -- the\n";
    $retval .= "$::CC - job's Outputs/ collection came back with only\n";
    $retval .= "$::CC - eccejobstorelog in it while every regular file (the\n";
    $retval .= "$::CC - input) and all 12 parsed properties uploaded fine.\n";
    $retval .= "if [ \"$base.out\" != \"$::outFile\" ] && [ -e $base.out ]; then\n";
    $retval .= "  rm -f $::outFile\n";
    $retval .= "  cp $base.out $::outFile\n";
    $retval .= "fi\n";
  }
  return $retval;
  nouse strict vars;
}

###########################################################################
# Quantum ESPRESSO (pw.x), phase 1 -- see docs/QE_ROADMAP.md.
#
# The sub name is not a free choice: the dispatcher above does
#   $fct = $lccode; $fct =~ s/-//g; eval "&$fct()"
# with $lccode = lc($applicationType), so this sub's name has to be
# exactly lc("QuantumESPRESSO") = "quantumespresso".  Both
# data/client/config/ResourceDescriptor.xml and ...Rxn.xml declare
# applicationType="QuantumESPRESSO" for qe_es, and $::config{$::lccode}
# (the machine-registration path key) is "quantumespresso" as a
# consequence, so the spelling is deliberately unhyphenated in all three
# places.  A hyphenated "Quantum-ESPRESSO" would reach this same sub (the
# dispatcher strips hyphens) but would look the binary path up under a
# DIFFERENT config key, which is exactly the kind of mismatch that fails
# only once a real machine is registered.
#
# Two notes on how pw.x is run:
#
#   * "-in <file>" (its own flag), not "< file" and not a bare argument.
#     pw.x writes its whole report to stdout, so the output redirect is
#     what produces the file QuantumESPRESSO.edml declares.  This is why
#     no symlink dance like MOPAC's is needed here.
#
#   * MPI: pw.x is a plain MPI program (unlike ORCA, which launches
#     mpirun itself from a %pal block in the input file), so wrapping it
#     in "mpirun -np N" is the correct and only way to parallelize it.
#     No "-nk" pool count is emitted: -nk must divide the process count
#     exactly or pw.x aborts at startup, and choosing it well needs the
#     k-point count, which is not known here.  Serial and plain-MPI both
#     verified against the real Quantum ESPRESSO 6.7 at /usr/bin/pw.x.
###########################################################################
sub quantumespresso()
{
  use strict vars;
  my ($retval,$pw,$cmd);
  $retval = "";
  $pw = $::config{$::lccode};
  if ($pw eq "") { die "Path for Quantum ESPRESSO not found"; }
  $cmd = &userCmd("quantumespressocommand");

  $retval .= &pathVar("pw", "$pw", "ECCE_PWSCF");
  $retval .= "echo \"Using Quantum ESPRESSO path: \$pw\" >> $::logfile\n";

  if ($cmd ne "") {
    $retval .= "$cmd\n";
  } elsif ($::totalprocs <= 1) {
    $retval .= "\"\$pw\" -in $::inFile > $::outFile 2>&1\n";
  } else {
    $retval .= "\n$::CC - pw.x is a plain MPI program; mpirun wraps it.\n";
    $retval .= "mpirun -np $::totalprocs \"\$pw\" -in $::inFile > $::outFile 2>&1 < /dev/null\n";
  }
  return $retval;
  nouse strict vars;
}

