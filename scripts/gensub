#!/usr/bin/env perl
#
# Filename: gensub
#
# Description
#   Based on command-line arguments and config files, generate an ecce 
#   job submission script.
#
#   See handleOptions() for description of command line args.
#
#   A submit script from ECCE can be considered to consist of the following:
#     .  header section with gen data ... followed by queue mgr keywords if any
#     .  a env setup section
#     .  custom setup stuff
#     .  running the code
#     .  determination of status (ie ECCE RUN_STATE)
#     .  custom wrapup stuff
#     .  cleanup of files (core scratch...whatever)
#
#   The following options are considered mandatory:
#     . -c code
#     . -Q qmanager
#          a value of "Silver" has special implications (meta scheduler)
#     . -H host machine logical key
#     . -r run directory ( it must already exist)
#     . -i input file
#     . -o output file
#
# WARNING
#  On some platforms (unicos), there is a maximum length for shell variable
#  names.  I think it is 16. (eg EXIT_UNCONVERGED_MIN doesn't work)
#
# --------------------------------------------------------------------
# Notes to those who are supporting new codes or queue managers
# --------------------------------------------------------------------
# The key design elements of this script are:
#   . you extend it for new codes and queues by writing the subroutines
#     named like <code>_<queuemanager>.  For example nwchem_maui (lower case).
#     The queue manager name for non-queued workstations is shell.
#     Illegal subroutine name characters are stripped out (eg '-').
#     This subroutine returns a string which is sh code to be added to
#     the generated submit script.  IMPORTANT: The last thing this
#     subroutine should do is run the code since code that gets added
#     after that, gets and evaluates the exit status.
#     These scripts are at the bottom of this file.  However this can
#     be overridden in the config file too.  If the attribute of the
#     same name (ie nwchem_maui) exists in a config file, it will be used
#     instead of the subroutine.
#   . This script reads configuration information out of a series of
#     config files.  This information is put into %config and can be
#     used to configure different machines/platforms differently.
#
# --------------------------------------------------------------------
# TODO List for this whole module - not just this script.
# --------------------------------------------------------------------
# . combine all the machine related stuff.  Currently there is the
#   Queues file, the CONFIG.* files, submit.* files and the Machines file.
#   See getConfigFileNames to see how many different files I look for
#   just to get the right config information.
# . merge the format and content of the CONFIG.* files and submit.*
#   files.  Currently we only use submit.site so there hasn't been
#   to much of an issue.  The readConfig subroutine tries to handle
#   everything.
# . add more logging to the generated script.  There is less now than
#   there was in the old scripts.
# . Add more error handling to the gensub script so that the launcher
#   gui can potentially capture more errors.  Currently you could
#   specify a Queue Manager but not a Queue and this script would
#   generate an incomplete script.  Of course the launcher gui should
#   not allow that so its not a big deal.
# . have the generated submit script detect errors and return a success
#   or fail status.  Might not be useful since I think it gets run in
#   the background on workstations anyway.
# . test use of 'loop hole'.
# . cleanup of nwchem.p file.  This may mean that we need to have the
#   filestoremove stuff be code dependent which I guess makes sense
#   anyway.
#     

{
  use Getopt::Std;
  use Sys::Hostname;
  use Socket;
  use FindBin;
  use lib $FindBin::RealBin;
  use CshToSh;
  #use strict vars;

  # These are all the command line args (optionally) needed for generating input
  local ($host, $qMgr, $queue, $code, $account, $nodes, $totalprocs,
         $cpuTime, $wallTime, $wallHrMin, $runDir, $scratchDir,
         $inFile, $outFile, $memory, $mem_x_1024, $scratchSpace);
  local ($submitFile);  # this is a cmd line arg too
  local ($jobName);     # extracted for $submitFile
  local ($verbose);     # -v option
  local ($mdSystemName);# -S option -- md jobs only
  local ($mdCalcName);  # -C option -- md jobs only
  local ($metascheduler);    # -Q "Silver"

  local ($CC);        # comment character(s)
  local ($ecceHome);  # since we use it often
  local (%config);    # stuff from config files
  local (%history);   # per key: the layers that set or cleared it, in order
  local (@msgs);      # error messages

  # -m (memory) and -x (scratch space) USE a value -- handleOptions does
  # "$memory = $opt_m" and multiplies it by 1024 -- but were declared here
  # without the trailing colon, i.e. as booleans. On the command line that
  # made $opt_m the flag value 1, so "gensub -m 4000" produced a submit
  # script requesting 1 unit of memory and left "4000" as a stray argument.
  # Production launches go through the -p param file, which parses these
  # correctly, which is why it never showed up there.
  getopts(':p:f:H:Q:q:c:a:n:N:t:T:w:r:s:i:o:S:C:m:x:hv');

  # get this from config files
  $CC = "# ";

  $ecceHome = $ENV{'ECCE_HOME'};

  &handleOptions();

  # keep around the lower case version of the code name
  $lccode = lc($code);

  local (@configFiles);
  @configFiles = &getConfigFileNames();

  # $logFile is temporary - the output is concatenated to the actual
  # output file after the job is run.  You cannot just write to the
  # output file from the beginning since the code may overwrite it.
  # The run directory as one shell word for the lines written below: a
  # Windows run directory is under the user's folder, which can hold a space.
  local $qRunDir = &shWord($runDir);
  local $logfile = "$qRunDir/ecce.submit.log";
  local $statusFile = "$qRunDir/.ecce.status";

  # GENSUB_EXPLAIN=1: where each key's value came from, as JSON lines.  Runs
  # the same readConfig as a real run, before the submit file is touched.
  if ($ENV{'GENSUB_EXPLAIN'}) {
    &readConfig();
    &printExplain();
    exit 0;
  }

  open(SUBMIT,"> $submitFile") || die "Unable to open $submitFile for write";
  print SUBMIT &getHeader();
  &readConfig();
  ##&printConfig();
  # Test hook (tests/queues/config_test.py): the merged key/value pairs.
  if ($ENV{'GENSUB_DUMP_CONFIG'}) {
    &printConfig();
    exit 0;
  }

  # HTCondor gives every job a private /tmp and /var/tmp (MOUNT_UNDER_SCRATCH),
  # so a run directory there does not exist for the job and it is held with
  # "Cannot access initial working directory".  Say so now, not from the pool.
  if (lc($qMgr) eq "htcondor" && $runDir =~ m{^/(?:var/)?tmp(?:/|$)} &&
      $::config{"condorallowtmp"} ne "true") {
    die "HTCondor jobs cannot use a run directory under /tmp or /var/tmp " .
        "($runDir): the pool mounts a private /tmp over it.  Choose a run " .
        "directory under your home directory, or set condorAllowTmp: true " .
        "in CONFIG.$host if your pool does not do that.\n";
  }

  # If using a Queued system, you probably have a header to generate
  if ($metascheduler ne "true") {
    print SUBMIT &mark("request", lc($qMgr)), &provideVariables(&getQMgrKeys),
                 &mark("ecce");
  }

  print SUBMIT "\n$CC Handle interrupts\n";
  print SUBMIT "canceljob() {\n";
  print SUBMIT "  echo \$X_INTERRUPTED > $statusFile\n";
  print SUBMIT "  exit 1\n";
  print SUBMIT "}\n";
  print SUBMIT "trap canceljob INT\n";

  # Always run from the run directory.
  print SUBMIT "\n$CC Change to the run directory\n";
  print SUBMIT "cd $qRunDir || exit 1\n";

  print SUBMIT "\n$CC Remove any left-over ecce files from previous runs\n";
  print SUBMIT "rm -f $statusFile core\n";
  # Do this so we don't have to know when to use > vs >>
  print SUBMIT "rm -f $logfile\n";
  print SUBMIT "touch $logfile\n";  

  local ($preFileExpr);
  $preFileExpr = $::config{$lccode . "prelimfilestoremove"};
  if ($preFileExpr ne "") {
    print SUBMIT "\n$::CC Removing files specified by PrelimFilesToRemove\n";
    print SUBMIT "rm -f $preFileExpr >/dev/null 2>&1\n";
  }

  # create back files if configured to do so
  print SUBMIT &backFiles();

  # Define the various exit state checking at might get used
  print SUBMIT "\n$CC Exit status and ECCE states...\n";
  print SUBMIT &defineStatusSymbols();

  # If there is a specific setup registered, add it
  if (defined($config{$lccode . "_setup"})) {
    $out = &shSnippet($lccode . "_setup", $config{$lccode . "_setup"});
    print SUBMIT &mark("before", $lccode . "_setup"), &provideVariables($out);
    print SUBMIT "\n", &mark("ecce");
  } else {
    if (defined($config{"setup"})) {
      $out = &shSnippet("setup", $config{"setup"});
      print SUBMIT &mark("before", "setup"), &provideVariables($out);
      print SUBMIT "\n", &mark("ecce");
    }
  }

  # Set environment variables per code...
  print SUBMIT "\n$CC Setting environment variables...\n";
  print SUBMIT &mark("environment", $lccode . "environment"),
               &doEnvironment($lccode), &mark("ecce");

  # Keep Open MPI's shared memory backing files out of /dev/shm, which
  # is RAM.
  #
  # Open MPI writes one 16MB backing file per run into /dev/shm by
  # default and removes it only on a CLEAN shutdown -- so every job that
  # is cancelled, crashes, times out or is killed by the queue leaves
  # one behind for good.  They accumulate silently on the submitting
  # machine and on every compute server, and push real memory into swap.
  # 404 had collected on one development machine before anyone noticed.
  #
  # Written here, once, rather than beside each code's mpirun line: the
  # code that launches mpirun is not always the one that says so.  ORCA
  # runs it from a %pal block in its own input file, so a per-code fix
  # covered NWChem and Quantum ESPRESSO and silently missed ORCA.  Doing
  # it in the preamble covers every code, including ones added later.
  #
  # Harmless where there is no MPI: an unused environment variable.
  print SUBMIT "\n$CC Keep Open MPI shared memory files with the job, not in /dev/shm\n";
  print SUBMIT "export OMPI_MCA_btl_sm_backing_directory=$qRunDir\n";


  # For loadleveler...
  # Some day we'll need to do copies too.
  if (defined($scratchDir) && $qMgr eq "Maui") {
    print SUBMIT "# Make scratch dir on all nodes.\n";
    print SUBMIT "if [ ! -e ~/.rhosts ]; then touch ~/.rhosts; fi\n";
    print SUBMIT "for node in \$LOADL_PROCESSOR_LIST; do\n";
    print SUBMIT "  if [ `grep -c \"\${node} \$USER\" ~/.rhosts` -eq 0 ]; then echo \"\${node} \$USER\" >> ~/.rhosts; fi\n";
    print SUBMIT "done\n";
    # mkdir -p is the same in the remote login shell whichever it is.
    print SUBMIT "for node in \$LOADL_PROCESSOR_LIST; do\n";
    print SUBMIT "  echo rsh \${node} 'mkdir -p $scratchDir'\n";
    print SUBMIT "  rsh \${node} \"mkdir -p $scratchDir\"\n";
    print SUBMIT "done\n";
  }

  print SUBMIT "\n";
  print SUBMIT "printf \"Starting Job: \" >> $::logfile\n";
  print SUBMIT "date >> $::logfile\n";

  print SUBMIT "\n$CC - code/queue manager section...\n";
  print SUBMIT &mark("command", $lccode . "_loophole", $lccode . "command");
  $fct = $lccode . "_loophole";
  # Apparently, subroutine names with '-' characters are illegal.
  $fct =~ s/-//g;
  if (defined($config{$fct})) {
    print SUBMIT &shSnippet($fct, $config{$fct}), "\n";
  } else {
    $fct = $lccode;
    $fct =~ s/-//g;
    $out = eval "&$fct()";
    if ($@ ne "") {
      die "Missing function $fct because $@";
    }
  }

  print SUBMIT &provideVariables($out), &mark("ecce");

  ## NOTE##
  # There should NOT be any extra commands betweent the main body
  # and the call to determineStatus or we'll get the wrong status.
  # So the date has to come later...
  #########
  print SUBMIT "\n$CC - determine state...\n";
  print SUBMIT  &determineStatus();


  if ($sendMetrics) {
    print SUBMIT "\n$CC - capture completed job metrics \n\n";
    print SUBMIT '  Mail ecce_tracking@emsl.pnl.gov << EOM >/dev/null 2>&1'."\n";
    print SUBMIT "$completedTag ".
                 '`date +"%T %d-%h-%y"`: $USER job completed, job was started from '.
                 $domainAddress.
                 ", running ".
                 $code.
                 " on ".
                 $hostFull.
                 " using ".
                 $totalprocs.
                 " processors\n";
    print SUBMIT 'EOM'."\n";
    print SUBMIT "\n\n";
  }


  print SUBMIT "\n";
  print SUBMIT "printf \"Completed Job: \" >> $::logfile\n";
  print SUBMIT "date >> $::logfile\n\n";

  # If there is a specific wrapup registered, add it
  if (defined($config{$lccode . "_wrapup"})) {
    $out = &shSnippet($lccode . "_wrapup", $config{$lccode . "_wrapup"});
    print SUBMIT &mark("after", $lccode . "_wrapup"), &provideVariables($out),
                 &mark("ecce");
  } else {
    if (defined($config{"wrapup"})) {
      $out = &shSnippet("wrapup", $config{"wrapup"});
      print SUBMIT &mark("after", "wrapup"), &provideVariables($out),
                   &mark("ecce");
    }
  }

  print SUBMIT &cleanup();

  # Now write the $statusFile file for oc_server
  # Its assumed to have been removed at the start of the job
  # but may have been created externally by the kill process.
  print SUBMIT "if [ ! -e $statusFile ]; then\n  echo \$exitStatus > $statusFile\nfi\n";

  # Concatenate log info to output file and remove log file
  print SUBMIT "\n$CC Adding ecce log info to output file for debugging...";
  print SUBMIT "\nif [ ! -e $::outFile ]; then touch $::qRunDir/$::outFile; fi\n";
  print SUBMIT "echo \"\" >> $::qRunDir/$::outFile \n";
  print SUBMIT "echo \"-----ECCE Log Information-----\" >> $qRunDir/$::outFile \n";
  print SUBMIT "cat $logfile >> $qRunDir/$::outFile \n";
  print SUBMIT "rm -f $logfile\n\n";

  # Probably need to have exit status values here
  print SUBMIT "exit 0\n";

  close(SUBMIT);
  &addModulePrologue($submitFile) if (!@shErrors);
  if (@shErrors) {
    unlink($submitFile);
    die &shErrorReport();
  }
  `chmod 744 $submitFile`;
}

##########################################################################
##########################################################################
# A path as one sh word; a leading ~ or ~/ stays bare so the shell expands it,
# and a plain path is left as it is.
sub shWord($)
{
  my ($p) = @_;
  my $pre = "";
  return $p if $p !~ m{[^A-Za-z0-9_./~+\@%:=,-]};
  $pre = "~/", $p = substr($p, 2) if substr($p, 0, 2) eq "~/";
  $p =~ s/'/'\\''/g;
  return "$pre'$p'";
}

sub defineStatusSymbols() 
{
  use strict vars;
  my ($retval);

  $retval .= "X_INTERRUPTED=302       # caught interrupt - kill \n";
  $retval .= "X_FILE_EXIST=211        # in/out file does not exist\n";
  $retval .= "X_UNEXPECTED_CORE=221   # code exit 0 but core exists\n";
  $retval .= "X_NOT_NORMAL=231        # code exit 0 but no normal-termination line\n";

  return $retval;
  nouse strict vars;
}

##########################################################################
# Later determine whether to back up files from config files.  For
# example, back up the output file to *.out *.out.1.  For now, just 
# remove them.
##########################################################################
sub backFiles() 
{
  my $retval = "";
#  $retval = "\n$CC Removing old output file if it exists\n";
#  $retval .= "if ( -e $outFile) rm -f $outFile\n";
  return $retval;
}

##########################################################################
# Description
#   Remove any files specified by the filestoremove keyword in any
#   of the config files.  If this keyword is missing, it really doesn't
#   matter.
##########################################################################
sub cleanup() 
{
  my ($retval);
  my ($fileExpr);
  $retval = "";

  $fileExpr = $::config{$lccode . "filestoremove"};
  if ($fileExpr ne "") {
    $retval .= "\n$::CC Removing files specified by FilesToRemove\n";
    $retval .= "rm -f $fileExpr >/dev/null 2>&1\n\n";
  }
  return $retval;
}

##########################################################################
# Description
#  Grab any keys of the form <code>Environment and add them to the 
#  generated script.  Handle any vars with PATH in them as you would
#  any UNIX path.
#
#  Its questionable whether this section is useful or if its better to
#  handle it in sub <code>_<qmgr>.
##########################################################################
sub doEnvironment() 
{
  use strict vars;
  my ($retval);
  my ($code,$key,@vars,$var);
  my ($evar,$rhs);
  ($code) = @_;
  $key = $code . "environment";
  @vars = split(/\n/,$::config{$key});
  foreach $var (@vars) {
    $var =~ s/^\s*//;
    ($evar,$rhs) = split(/ +/,$var);
    # For any path variables, append if defined
    if ($evar =~ /PATH/i) {
      $retval .= "if [ -n \"\${$evar+set}\" ]; then\n";
      $retval .= "  export $evar=\"\$\{${evar}\}:$rhs\"\n";
      $retval .= "else\n";
      $retval .= "  export $evar=\"$rhs\"\n";
      $retval .= "fi\n";
    } else {
      $retval .= "export $evar=\"$rhs\"\n";
    }
  }
  return $retval;
  nouse strict vars;
}

##########################################################################
# Descrition
#   Do replacements on "exposed" variables.  I could not figure out how
#   to do this gracefully.  All variables are globals.
##########################################################################
sub provideVariables()
{
  use strict vars;
  my ($fixedString);
  ($fixedString) = @_;
  $fixedString =~ s/\$account/$::account/gi;
  # This one has to be case sensitive so as not to accidentally
  # replace $HOST which is intended to be the unix env variable.

  # Need for PBS
  my ($ppn, $wallSeconds);
  $ppn = $::totalprocs/$::nodes;
  $wallSeconds = "";
  if ($::wallTime =~ /^(\d+):(\d+):(\d+)$/) {
    $wallSeconds = $1*3600 + $2*60 + $3;
  }

  $fixedString =~ s/\$host/$::host/g;
  $fixedString =~ s/\$qMgr/$::qMgr/gi;
  $fixedString =~ s/\$queue/$::queue/gi;
  $fixedString =~ s/\$code/$::code/gi;
  $fixedString =~ s/\$nodes/$::nodes/gi;
  $fixedString =~ s/\$totalprocs/$::totalprocs/gi;
  $fixedString =~ s/\$ppn/$ppn/gi;
  $fixedString =~ s/\$cpuTime/$::cpuTime/gi;
  $fixedString =~ s/\$wallTime/$::wallTime/gi;
  $fixedString =~ s/\$wallHrMin/$::wallHrMin/gi;
  $fixedString =~ s/\$wallSeconds/$wallSeconds/gi;
  $fixedString =~ s/\$runDir/$::runDir/gi;
  $fixedString =~ s/\$scratchDir/$::scratchDir/gi;
  $fixedString =~ s/\$inFile/$::inFile/gi;
  $fixedString =~ s/\$outFile/$::outFile/gi;
  $fixedString =~ s/\$memory/$::memory/gi;
  $fixedString =~ s/\$mem_x_1024/$::mem_x_1024/gi;
  $fixedString =~ s/\$scratchSpace/$::scratchSpace/gi;
  $fixedString =~ s/\$submitFile/$::jobName/gi;
  $fixedString =~ s/\$mdSystemName/$::mdSystemName/gi;
  $fixedString =~ s/\$mdCalcName/$::mdCalcName/gi;

  $fixedString .= "\n";

  # Drop batch directives whose value did not resolve.  The queue-manager
  # blocks in submit.site are hand-written per site, and a variable that
  # is simply not set for this job (no memory requested, no allocation
  # account) used to be substituted with the empty string and emitted
  # anyway -- producing a directive like "#SBATCH --mem=" or a bare
  # "#PBS -A", which sbatch/qsub reject outright, so the whole job fails
  # to submit over a field the user deliberately left blank.  The right
  # thing is to omit the directive and let the scheduler apply its own
  # default.
  #
  # The test is made against the ORIGINAL line, by looking up each
  # variable it names: a substituted line cannot be judged afterwards,
  # because "#PBS -A" (an emptied $account) and "#PBS -nr" (a legitimate
  # flag that never had a value) are indistinguishable by then.
  #
  # Only comment-style directive lines are filtered (#SBATCH, #PBS, #BSUB,
  # #MSUB, #CONDOR, and SGE's "#$ ").  The same function
  # also processes real shell code from CONFIG.<machine>'s setup/wrapup
  # blocks, where "$var" is a shell variable the running script resolves
  # for itself and an "X=" assignment is perfectly legal.
  my %vals = (
    'account'     => $::account,     'host'         => $::host,
    'qmgr'        => $::qMgr,        'queue'        => $::queue,
    'code'        => $::code,        'nodes'        => $::nodes,
    'totalprocs'  => $::totalprocs,  'cputime'      => $::cpuTime,
    'walltime'    => $::wallTime,    'wallhrmin'    => $::wallHrMin,
    'wallseconds' => $wallSeconds,
    'rundir'      => $::runDir,      'scratchdir'   => $::scratchDir,
    'infile'      => $::inFile,      'outfile'      => $::outFile,
    'memory'      => $::memory,      'mem_x_1024'   => $::mem_x_1024,
    'scratchspace'=> $::scratchSpace,'submitfile'   => $::jobName,
    'mdsystemname'=> $::mdSystemName,'mdcalcname'   => $::mdCalcName,
  );

  my @orig = split(/\n/, $_[0], -1);
  my @fixd = split(/\n/, $fixedString, -1);
  my @kept;
  for (my $i = 0; $i < scalar(@fixd); $i++) {
    my $src = ($i < scalar(@orig)) ? $orig[$i] : "";
    if ($src =~ /^\s*\#(?:(?:SBATCH|PBS|BSUB|MSUB|CONDOR)\b|\$\s)/) {
      my $drop = 0;
      # Longest names first, so $mem_x_1024 is not matched as $memory.
      foreach my $name (sort { length($b) <=> length($a) } keys %vals) {
        next unless $src =~ /\$$name/i;
        my $v = $vals{$name};
        if (!defined($v) || $v eq "" || $v eq "0") { $drop = 1; last; }
      }
      next if $drop;
    }
    push @kept, $fixd[$i];
  }
  $fixedString = join("\n", @kept);

  return $fixedString;
  nouse strict vars;
}


##########################################################################
# $? is the code's own exit value.  Checking for a core file could be more
# robust - make sure there is no core to start with - make sure its
# associated with the current run...
##########################################################################
sub determineStatus()
{
  my ($reval);
  $retval = "exitStatus=\$?\n";
  $retval .= "echo \"$lccode exit status = \$exitStatus\" >> $logfile\n";
  $retval .= "\n$CC look for suspicious core\n";
  $retval .= "if [ -e core ]; then\n";
  $retval .= "  echo \"Unexpected core - setting status to X_UNEXPECTED_CORE\" >> $logfile\n";
  $retval .= "  exitStatus=\$X_UNEXPECTED_CORE\n";
  $retval .= "fi\n";

  # If the output file doesn't even exist, something bad happened.
  $retval .= "\n";
  $retval .= "if [ ! -e $qRunDir/$outFile ]; then\n";
  $retval .= "  echo \"Output file $outFile does not exist - setting status to failed\" >> $logfile\n";
  $retval .= "  exitStatus=\$X_FILE_EXIST\n";

  $retval .= "fi\n";

  # Some codes exit 0 after aborting -- ORCA does when its MPI start-up
  # fails ("binding more processes than cpus"), and the job was then
  # reported as completed with no results.  Where a code prints a line
  # only on success, require it.
  my %normalTermination = (
    'orca' => 'ORCA TERMINATED NORMALLY',
    'ecce-qm' => 'end_of_output',
  );
  if (defined $normalTermination{$lccode}) {
    my $marker = $normalTermination{$lccode};
    $retval .= "\nif [ \"\$exitStatus\" = 0 ]; then\n";
    $retval .= "  if ! grep -q \"$marker\" $qRunDir/$outFile; then\n";
    $retval .= "    echo \"No '$marker' in $outFile - setting status to failed\" >> $logfile\n";
    $retval .= "    exitStatus=\$X_NOT_NORMAL\n";
    $retval .= "  fi\n";
    $retval .= "fi\n";
  }
  $retval .= "echo \"Final exit status = \$exitStatus\" >> $logfile\n";
  return $retval; 
}

##########################################################################
# Description
#  By knowing the Queue Manager and the config file information,
#  we know which Keys to write out.
#
#  Note the strings that we compare to below should match those in the
#  data/client/config/QueueManagers file.
##########################################################################
sub getQMgrKeys() 
{
  my ($header);

  if (lc($qMgr) ne "shell") {
    $header =  $::config{lc($qMgr)} . "\n";
  } else {
    $header =  "";
  }

  return $header;
}

##########################################################################
# Description
#   Returns default header information that we put at the beginning
#   of each script.
##########################################################################
sub getHeader() 
{
  my ($header);
  $header = "#!/bin/sh\n";
  $header .= "$CC ECCE Submit Script\n";
  $date = `date`;
  chop ($date);
  $version = &getVersion();
  $header .= "$CC Generated $date with ECCE Version $version.\n";
  if (defined($verbose)) {

    # echo all the command line args here
    $header .= "$CC\n";
    $header .= &listOptions($CC);

    # echo the config file name(s)
    $header .= "$CC\n";
    $header .= "$CC Config Files Used:\n";
    foreach $f (@configFiles) {
      $header .= "$CC";
      $header .= "$f\n";
    }
  }
  return $header;
}

##########################################################################
# Description
#   Return name(s) of config file name. 
#   The way this works is that multiple config files can be used if
#   they exist.  They will be read in order of most general to most
#   specific (site, hardware type, machine, user).  If the same
#   attribute exists in more than one file, the last one encountered
#   rules.
##########################################################################
sub getConfigFileNames() 
{
  my (@files,@dirs,@siteDirs,$dir);
  my (@machines,$junk1,$junk2,$vendor,$mode,$processor);

  # ECCE_SITECONFIG_DIRS (set by ECCE's own launcher, from
  # Ecce::siteConfigLayers): the directories the configuration is read from,
  # highest priority first, the user's first and the install's last.
  $home = $ENV{"ECCE_REALUSERHOME"};
  if ($ENV{"ECCE_SITECONFIG_DIRS"} ne "") {
    # ";" on Windows, where a directory starts with "C:".
    my $sep = ($^O eq "MSWin32" || $ENV{"ECCE_SITECONFIG_DIRS"} =~ /;/) ? ";" : ":";
    @dirs = split(/\Q$sep\E/, $ENV{"ECCE_SITECONFIG_DIRS"});
    s{/+$}{} for @dirs;
  } else {
    @dirs = ("$home/.ECCE", "$ecceHome/siteconfig");
  }
  $userConfigDir = shift(@dirs);
  @siteDirs = @dirs;

  # The first site directory that has a file; the whole file, never merged.
  my $siteFile = sub {
    my ($name) = @_;
    foreach $dir (@siteDirs) {
      return "$dir/$name" if (-e "$dir/$name");
    }
    return "";
  };

  my $f = &$siteFile("submit.site");
  push(@files,$f) if ($f ne "");

  # Use the platform info in the Machines files to figure out the
  # hardware architecture config file: the user's machine list first, as
  # the C++ side does, then the site's in order.
  my ($line,$machineDir) = ("","");
  foreach $dir ($userConfigDir, @siteDirs) {
    my $list = ($dir eq $userConfigDir) ? "MyMachines" : "Machines";
    if (open(MACHINES,"<$dir/$list")) {
      @machines = <MACHINES>;
      close(MACHINES);
      ($line) = grep(/$host	/,@machines);
      if ($line ne "") {
        $machineDir = $dir if ($dir ne $userConfigDir);
        last;
      }
    }
  }
  die "Unable to open Machines file" if (!grep(-e "$_/Machines", @siteDirs));

  ($junk1,$junk2,$vendor,$model,$processor)= split(/\t+/,$line);
  $vendor = uc($vendor);
  if ($vendor ne "" && $vendor ne "UNSPECIFIED") {
    $f = &$siteFile("CONFIG.$vendor");
    push(@files,$f) if ($f ne "");

    $model = uc($model);
    if ($model ne "" && $model ne "UNSPECIFIED") {
      $f = &$siteFile("CONFIG.$vendor.$model");
      push(@files,$f) if ($f ne "");

      $processor = uc($processor);
      if ($processor ne "" && $processor ne "UNSPECIFIED") {
        $f = &$siteFile("CONFIG.$vendor.$model.$processor");
        push(@files,$f) if ($f ne "");
      }
    }
  }

  # CONFIG.<host>: the site file of the layer whose Machines defines the
  # machine, else the first layer that has one.
  # GENSUB_SITE_CONFIG / GENSUB_USER_CONFIG: a draft file in place of the
  # machine's site or user file (Register Machines' preview of unsaved edits).
  my $siteConfig = $ENV{'GENSUB_SITE_CONFIG'} ne "" ? $ENV{'GENSUB_SITE_CONFIG'}
                 : $machineDir ne "" ? "$machineDir/CONFIG.$host"
                 : &$siteFile("CONFIG.$host");
  my $userConfig = $ENV{'GENSUB_USER_CONFIG'} ne "" ? $ENV{'GENSUB_USER_CONFIG'}
                                                    : "$userConfigDir/CONFIG.$host";
  push(@files,$siteConfig) if ($siteConfig ne "" && -e $siteConfig);
  push(@files,$userConfig) if (-e $userConfig);

  return @files;
}

##########################################################################
# Description
#  Returns version number that generated the script.
##########################################################################
sub getVersion() 
{
  my ($version);
  $version = `cat $ecceHome/data/client/config/Version`;
  chop $version;
  return $version;
}

##########################################################################
# Description
#   Read in site-specified config file to control this script.
#   Later maybe override with user file if it exists.
#   The file format can be one of three things:
#  key: value pairs like the old CONFIG.* files
#  key  value pairs
#  key {...}
#   A value of "-" clears the key (it removes what an earlier file set).
##########################################################################
sub readConfig() 
{
  foreach $file (@configFiles) {
    if (open(CONFIG,"< $file")) {
      while (<CONFIG>) {
        if (/^\s*\/\//) { next };
        if (/^\s*#/) { next };
        if (/^\s*$/) { next };

        if (/^\s*(.*)\s*\{(.*)\}/) {
          $value = $2;
          $key = $1;
        } elsif (/^\s*(.*)\s*\{/) {
         # read block
         $key = $1;
         $key =~ s/\s*$//;
         $value = "";
         while (<CONFIG>) {
           if (/^\}/) { last} ;
           $value .= $_;
         }
        } else {
          # one-liner: "key: value" (old CONFIG.* files) or "key value".
          # A colon form needs the colon right after the first word, so
          # "key value:with:colons" is a space form.
          if (/^\s*([^\s:]+)\s*:\s*(.*)/) {
            $key = $1;
            $value = $2;
          } elsif (/^\s*(\S+)\s+(.*)/) {
            $key = $1;
            $value = $2;
          } else {
            $key = $_;
            $value = "";
          }
        }
        $key =~ s/^\s*//;
        $key =~ s/\s*$//;
        $value =~ s/^\s*//;
        $value =~ s/\s*$//;
        # "key: -" in a later file clears the key; it is never a value.
        if ($value eq "-") {
          delete $config{lc($key)};
          push @{$::history{lc($key)}}, [$file, undef];
        } elsif ($value ne "") {
          $config{lc($key)} = $value;
          push @{$::history{lc($key)}}, [$file, $value];
        }
      }
      close CONFIG;
    } else {
      print "WARNING: Unable to open $file for read.\n";
    }
  }
}


##########################################################################
# Description
#   Print the config file associative array.
##########################################################################
sub printConfig()
{
  foreach $key (sort keys %config) {
    ($v = $config{$key}) =~ s/\n/\\n/g;
    print "$key: $v\n";
  }
}

##########################################################################
# Description
#   Which layer a config file is: submit.site, vendor (CONFIG.VENDOR[.MODEL
#   [.PROC]]), site (CONFIG.<host> in siteconfig) or user (~/.ECCE).
##########################################################################
sub sourceTag($)
{
  my ($f) = @_;
  my $uh = $ENV{"ECCE_REALUSERHOME"};
  return "user" if ($ENV{"GENSUB_USER_CONFIG"} ne "" && $f eq $ENV{"GENSUB_USER_CONFIG"});
  return "site" if ($ENV{"GENSUB_SITE_CONFIG"} ne "" && $f eq $ENV{"GENSUB_SITE_CONFIG"});
  return "user" if ($userConfigDir ne "" && index($f, "$userConfigDir/") == 0);
  return "user" if ($uh ne "" && index($f, "$uh/.ECCE/") == 0);
  return "submit.site" if ($f =~ m{/submit\.site$});
  return "site" if ($f =~ m{/CONFIG\.\Q$host\E$});
  return "vendor";
}

##########################################################################
# Description
#   GENSUB_ANNOTATE=1 (Register Machines' job script preview): a comment line
#   "#@ecce-section <part> <layer>" where a part of the script that a CONFIG
#   key supplies starts, and "ecce" where ECCE's own text resumes.  The layer
#   is the file that last set the first of `keys` that has a value (user,
#   site, vendor or submit.site), else built-in.  Without the variable the
#   script is unchanged.
##########################################################################
sub mark()
{
  return "" unless $ENV{'GENSUB_ANNOTATE'};
  my ($part, @keys) = @_;
  my $layer = "built-in";
  foreach my $k (@keys) {
    my $h = $::history{$k};
    next unless $h && @$h && defined($h->[-1][1]);
    $layer = &sourceTag($h->[-1][0]);
    last;
  }
  $layer = "" if ($part eq "ecce");
  return "#\@ecce-section $part $layer\n";
}

##########################################################################
# Description
#   One JSON object per key that any layer set or cleared.  "value" is null
#   and "source" is "cleared" when the last layer was a "key: -"; "overridden"
#   lists the earlier layers (value null = that layer cleared).  Keys in no
#   layer are absent: the built-in default applies.
##########################################################################
sub printExplain()
{
  require JSON::PP;
  my $json = JSON::PP->new->canonical->ascii;
  foreach my $key (sort keys %::history) {
    my @h = @{$::history{$key}};
    my $last = pop @h;
    my $cleared = !defined($last->[1]);
    my %o = (key => $key,
             value => $cleared ? undef : $last->[1],
             source => $cleared ? "cleared" : &sourceTag($last->[0]),
             file => $last->[0],
             overridden => [map { {source => &sourceTag($_->[0]),
                                   file => $_->[0], value => $_->[1]} } @h]);
    print $json->encode(\%o), "\n";
  }
}

##########################################################################
# Description
#   Assign $opt_* to reasonable variable names  
#   Take arguments either at the command line or from a param file.
#   The latter is necessary to handle problems with shell cmd length
#   overflow.
##########################################################################
sub handleOptions()
{
  # Default where not provided
  $submitFile = "submit__";
  $nodes = 1;
  $totalprocs = 1;

  $host = $opt_H if defined ($opt_H);
  $qMgr = $opt_Q if defined ($opt_Q);
  $queue = $opt_q if defined ($opt_q);
  $code = $opt_c  if defined ($opt_c);
  $account = $opt_a  if defined ($opt_a);
  $nodes = $opt_N  if defined ($opt_N);
  $totalprocs = $opt_n  if defined ($opt_n);
  $cpuTime = $opt_t  if defined ($opt_t);
  $wallTime = $opt_T  if defined ($opt_T);
  $wallHrMin = $opt_w  if defined ($opt_w);
  $runDir   = $opt_r  if defined ($opt_r);
  $scratchDir   = $opt_s  if defined ($opt_s);
  $inFile   = $opt_i  if defined ($opt_i);
  $outFile   = $opt_o  if defined ($opt_o);
  if (defined ($opt_m)) {
    $memory     = $opt_m;
    $mem_x_1024 = $opt_m * 1024;
  }
  $scratchSpace = $opt_x  if defined ($opt_x);
  $verbose   = "true" if defined ($opt_v);
  $submitFile   = $opt_f if defined ($opt_f);
  $mdSystemName = $opt_S  if defined ($opt_S);
  $mdCalcName = $opt_C  if defined ($opt_C);

  # The parameters can be sent in via a param file also.  They
  # override anything specified at the command line.
  if ($opt_p) {
     open (PARAM,"<$opt_p") || die ("Param file specified but not found.");
#open(DEBUG,">/tmp/klsgensub");
     while (<PARAM>) {
#print DEBUG;
      s/\r?\n\z//;
      $_ =~ s/^\s*//;
      # The value is the rest of the line: a path can hold a space.
      ($opt,$value) = split(/ +/,$_,2);
      $value =~ s/\s+\z// if defined($value);

      $host = $value if ($opt =~ /-H/);
      $hostFull = $value if ($opt =~ /-d/);
      $qMgr = $value if ($opt =~ /-Q/);
      $queue = $value if ($opt =~ /-q/);
      $code = $value  if ($opt =~ /-c/);
      $account = $value  if ($opt =~ /-a/);
      $nodes = $value  if ($opt =~ /-N/);
      $totalprocs = $value  if ($opt =~ /-n/);
      $cpuTime = $value  if ($opt =~ /-t/);
      $wallTime = $value  if ($opt =~ /-T/);
      $wallHrMin = $value  if ($opt =~ /-w/);
      $runDir   = $value  if ($opt =~ /-r/);
      $scratchDir   = $value  if ($opt =~ /-s/);
      $inFile   = $value  if ($opt =~ /-i/);
      $outFile   = $value  if ($opt =~ /-o/);
      if ($opt =~ /-m/) {
        $memory     = $value;
        $mem_x_1024 = $value * 1024;
      }
      $scratchSpace = $value  if ($opt =~ /-x/);
      $verbose   = "true" if ($opt =~ /-v/);
      $submitFile   = $value if ($opt =~ /-f/);
      $mdSystemName = $value  if ($opt =~ /-S/);
      $mdCalcName = $value  if ($opt =~ /-C/);
     }
     close(PARAM);
#close(DEBUG);
  }

  # Make the job name the tail of the submit file path
  (@tmp) = split(/\//,$submitFile);
  $size = $tmp;
  $jobName = @tmp[$size-1];
  $jobName =~ s/submit__//;
  $jobName = substr($jobName,0,14);

  $metascheduler   = "true" if ($opt_Q =~ /Silver/i);

  if ($opt_h) {
    &usage();
    exit(-1);
  }

  if ( !defined($qMgr) || !defined($code) || !defined($host) ||
       !defined($runDir) || !defined($inFile) || !defined($outFile)) {
    ##&listOptions();
    die "QueueManager, Code, Machine, Run Dir, Input File, Output File must be specified\n";
  }
}

###########################################################################
# Description
#   Echo the options specified on the command line in comment form.
###########################################################################
sub listOptions()
{
  ($CP) = @_;    # comment prefix - optional 
  my ($info);

  $info = "$CP Machine: $host\n"  if defined($host);
  $info .= "$CP QueueManager: $qMgr\n"  if defined($qMgr);
  $info .= "$CP Queue: $queue\n"  if defined($queue);
  $info .= "$CP Code: $code\n"  if defined($code);
  $info .= "$CP Account: $account\n"  if defined($account);
  $info .= "$CP CPU Time: $cpuTime\n"  if defined($cpuTime);
  $info .= "$CP Wall Time: $wallTime\n"  if defined($wallTime);
  # Decide what to show based on whether its a queued system or not
  $info .= "$CP # Processors: $nodes\n"  if  !defined($queue);
  $info .= "$CP # Nodes: $nodes\n"  if defined($queue);
  $info .= "$CP # TotalProcessors: $totalprocs\n"  if defined($queue);

  $info .= "$CP Run Directory: $runDir\n"  if defined($runDir);
  $info .= "$CP Scratch Directory: $scratchDir\n"  if defined($scratchDir);
  $info .= "$CP Input File: $inFile\n"  if defined($inFile);
  $info .= "$CP Output File: $outFile\n"  if defined($outFile);
  $info .= "$CP Memory: $memory\n"  if defined($memory);
  $info .= "$CP Scratch Space: $scratchSpace\n"  if defined($scratchSpace);

  return $info;
}

