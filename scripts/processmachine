#!/usr/bin/env python3
# Machine Registration's save handler: a CGI-style POST form on stdin
# (CONTENT_LENGTH bytes), as ProcessMachine::run sends it.  Rewrites the
# Machines/MyMachines, Queues, <machine>.Q and CONFIG.<machine> files.
#
# All text is handled as latin-1 so every byte of a name or value reaches
# the files unchanged, whatever its encoding.
import math
import os
import re
import sys

RE_FLAGS = re.ASCII
# Files are written as the platform's text mode would.
NL = None if os.name == "nt" else "\n"


class Die(Exception):
    def __init__(self, msg, code=255):
        Exception.__init__(self, msg)
        self.msg = msg
        self.code = code or 255


def perl_num(s):
    m = re.match(r"\s*[+-]?(?:\d+\.?\d*|\.\d+)(?:[eE][+-]?\d+)?", s or "", RE_FLAGS)
    return float(m.group(0)) if m else 0.0


def split(sep, s, limit=0):
    # Trailing empty fields are dropped unless a limit is given, and ""
    # gives no fields at all.
    if s == "":
        return []
    parts = re.split(sep, s, maxsplit=limit - 1 if limit > 0 else 0)
    if limit <= 0:
        while parts and parts[-1] == "":
            parts.pop()
    return parts


def key_value(pair, limit=0):
    f = split(r"\|", pair, limit)
    return (f[0] if f else ""), (f[1] if len(f) > 1 else None)


def form_decode(text):
    text = text.replace("+", " ")
    return re.sub(r"%([a-fA-F0-9]{2})", lambda m: chr(int(m.group(1), 16)), text)


def read_lines(path):
    try:
        with open(path, "r", encoding="latin-1", newline=NL) as f:
            return f.readlines()
    except OSError:
        return []


def open_write(path, msg):
    try:
        return open(path, "w", encoding="latin-1", newline=NL)
    except OSError as e:
        raise Die(msg, e.errno)


def emit(stream, text):
    if NL is None:
        text = text.replace("\n", "\r\n")
    stream.buffer.write(text.encode("latin-1", "replace"))
    stream.flush()


class Handler(object):
    def __init__(self, contents):
        self.c = contents
        self.registered = split(",", self.get("registeredcodes"))
        self.siteflag = self.get("siteconfig")
        if self.siteflag == "true":
            self.path = os.environ.get("ECCE_HOME", "") + "/siteconfig"
        else:
            self.path = os.environ.get("ECCE_REALUSERHOME", "") + "/.ECCE"
        self.changeperms = {}
        self.machine = self.get("name")
        self.mfile = self.path + ("/Machines" if self.siteflag == "true"
                                  else "/MyMachines")
        self.cfile = "CONFIG." + self.machine
        self.qsfile = "Queues"
        self.qfile = self.machine + ".Q"
        self.qmgr = self.get("qmgr") or "None"

        # No GUI paths means CONFIG is still stripped of the keys the GUI
        # owns, but never deleted if anything else is in it.
        self.configflag = any(self.get(code) not in ("", "EMSL")
                              for code in self.registered)
        if self.get("perlPath") not in ("", "EMSL"):
            self.configflag = True
        if self.get("qmgrPath") != "":
            self.configflag = True

    def get(self, key):
        return self.c.get(key, "")

    def nqueues(self):
        return perl_num(self.get("numQueues"))

    def queue_indexes(self):
        return range(int(math.ceil(self.nqueues())))

    def queue_pairs(self, idx):
        return split(",", self.get("q" + str(idx)))

    def run(self):
        if "\t" in self.machine:
            raise Die("machine name may not contain a tab - bailing...")
        if self.get("type") == "delete":
            self.do_delete()
            return
        if "/" in self.machine:
            raise Die("machine name may not contain '/' - bailing...")
        for var in ("machine", "vendor", "model", "processor"):
            if "\t" in self.get(var):
                raise Die(var + " may not contain a tab - bailing...")
        # <machine>.Q separates queue names with spaces and keys with '|'.
        for idx in self.queue_indexes():
            for pair in self.queue_pairs(idx):
                key, value = key_value(pair, 2)
                if key == "name" and not (
                        value is not None and
                        re.fullmatch(r"[A-Za-z0-9_.-]+", value)):
                    raise Die("queue name '%s' is not valid - bailing..."
                              % (value or ""))
        self.do_accept()

    # -- files ---------------------------------------------------------

    def check_out(self, path):
        # User files stay writable; a read-only site file is made writable
        # and locked again by check_in.
        self.changeperms[path] = False
        if os.path.exists(path) and not os.access(path, os.W_OK):
            self.changeperms[path] = self.siteflag == "true"
            try:
                os.chmod(path, (os.stat(path).st_mode & 0o7777) | 0o200)
            except OSError:
                pass

    def check_in(self, path):
        if self.changeperms.get(path):
            try:
                os.chmod(path, (os.stat(path).st_mode & 0o7777) & ~0o222)
            except OSError:
                pass

    def remove_file(self, path):
        if os.path.exists(path):
            try:
                os.unlink(path)
            except OSError:
                pass

    def drop_machine(self, lines):
        prefix = self.machine + "\t"
        return [ln for ln in lines if not ln.startswith(prefix)]

    # -- Queues file ---------------------------------------------------

    def read_queues(self):
        """Returns (was_there, machines on the Queues: line, other lines,
        this machine's own lines the GUI does not manage)."""
        was_there, other, own = False, [], []
        path = self.path + "/" + self.qsfile
        if not os.path.exists(path):
            return was_there, "", other, own
        try:
            f = open(path, "r", encoding="latin-1", newline=NL)
        except OSError as e:
            raise Die("Unable to open " + path, e.errno)
        with f:
            it = iter(f.readlines())
        machines = ""
        mine = re.compile(r"^\s*" + re.escape(self.machine) + r"\|", RE_FLAGS)
        managed = re.compile(r"^\s*" + re.escape(self.machine) +
                             r"\|(queueMgrName|queueMgrVersion|prefFile)\s*:",
                             RE_FLAGS)
        for line in it:
            if line.startswith("Queues:"):
                # the machine list continues over lines ending in a backslash
                machines = line.replace("Queues:", "", 1)
                cur = machines
                while "\\" in cur:
                    cur = next(it, "")
                    machines += cur
            elif not mine.match(line):
                other.append(line)
            else:
                was_there = True
                if not managed.match(line):
                    own.append(line)
        machines = machines.replace("\\", "").replace("\n", "")
        m = re.escape(self.machine)
        machines = re.sub(" " + m + " ", " ", machines)
        machines = re.sub(" " + m + "$", "", machines)
        machines = re.sub(r"\s+", " ", machines, flags=RE_FLAGS)
        return was_there, machines, other, own

    # -- add / modify --------------------------------------------------

    def do_accept(self):
        machine, path = self.machine, self.path
        qpath = path + "/" + self.qsfile
        self.check_out(self.mfile)
        was_there = self.read_queues()[0]
        if was_there or self.qmgr != "None":
            self.check_out(qpath)
        self.check_out(path + "/" + self.qfile)
        if self.get("config") != "external":
            self.check_out(path + "/" + self.cfile)

        lines = read_lines(self.mfile)
        out = open_write(self.mfile, "Unable to open %s for write" % self.mfile)
        with out:
            for ln in self.drop_machine(lines):
                out.write(ln)
            line = machine + "\t" + self.get("machine") + "\t"
            line += self.get("vendor") + "\t" + self.get("model") + "\t"
            line += self.get("processor") + "\t"
            line += self.get("procs")
            if perl_num(self.get("nodes")) > 0:
                line += ":" + self.get("nodes")
            line += "\t"
            # ssh is the only remote shell.
            line += "ssh\t"
            codes = "".join(":" + code for code in self.registered
                            if self.get(code) != "")
            line += (codes or ":") + "\t"

            keys = "MN:RD:SD:UN:PW"
            if self.get("AA") == "true":
                keys += ":AA"
            nq = self.nqueues()
            if nq > 0:
                keys += ":Q"
            # A capability is on if any queue sets its limit non-zero.  Each
            # scan stops after the first queue whose value is non-empty, and
            # the value carries over from one scan to the next.
            value = ""
            for token, cap in (("maxCPU", ":TL"), ("maxMemory", ":MM"),
                               ("minScratch", ":SS")):
                for idx in self.queue_indexes():
                    for pair in self.queue_pairs(idx):
                        if token in pair:
                            value = key_value(pair)[1]
                            if value is None:
                                value = ""
                            if value != "" and perl_num(value) != 0:
                                keys += cap
                                break
                    if value != "":
                        break
            line += keys

            if self.qmgr.lower() == "slurm" and not re.search(r":TL\b", keys):
                emit(sys.stdout,
                     "note: machine '%s' does not pass a time limit: the "
                     "stored wall time will not be passed to Slurm (#SBATCH "
                     "--time) unless the time-limit capability is enabled.\n"
                     % machine)
            out.write(line + "\n")
        self.check_in(self.mfile)

        was_there, qline, other, own = self.read_queues()
        # Rewritten whenever the machine has an entry, so a changed queue
        # manager reaches <m>|queueMgrName.
        if was_there or self.qmgr != "None":
            while other and not other[-1].strip(" \t\n\r\f\v"):
                other.pop()
            with open_write(qpath, "Unable to open %s for write" % qpath) as q:
                q.write("Queues: " + qline)
                if self.qmgr != "None":
                    q.write(" " + machine)
                q.write("\n")
                q.writelines(other)
                if self.qmgr != "None":
                    q.write("\n")
                    q.write("%s|queueMgrName:    %s\n" % (machine, self.qmgr))
                    q.write("%s|queueMgrVersion: 2.0~\n" % machine)
                    q.write("%s|prefFile:        %s.Q\n" % (machine, machine))
                    q.writelines(own)
            self.check_in(qpath)

        if nq == 0:
            self.remove_file(path + "/" + self.qfile)
        else:
            qnames, qdetail, sent = "", {}, {}
            for idx in self.queue_indexes():
                name = ""
                for pair in self.queue_pairs(idx):
                    key, value = key_value(pair)
                    if "name|" in pair:
                        value = value or ""
                        qnames += value + " "
                        name = re.sub(r"^\s*", "", value, flags=RE_FLAGS)
                        continue
                    if value is None:
                        value = ""
                    # A key the GUI sent, even empty, replaces the file's line.
                    sent.setdefault(name, set()).add(key.lower())
                    if key.lower() == "requestlines":
                        # %-escaped on the wire; a .Q value is one line, so
                        # the lines are joined by a literal \n.
                        value = re.sub(r"%([0-9A-Fa-f]{2})",
                                       lambda m: chr(int(m.group(1), 16)),
                                       value)
                        value = value.replace("\n", "\\n")
                        if value != "":
                            qdetail[name] = qdetail.get(name, "") + \
                                name + "|requestLines:       " + value + "\n"
                    elif value != "":
                        for pat, new in (("minNodes", "minProcessors"),
                                         ("maxNodes", "maxProcessors"),
                                         ("maxCPU", "runLimit"),
                                         ("maxMemory", "memLimit"),
                                         ("minScratch", "scratchLimit")):
                            if pat in key:
                                key = new
                        qdetail[name] = qdetail.get(name, "") + \
                            name + "|" + key + ":       " + value + "\n"
            self.write_qfile(qnames, qdetail, sent)
            self.check_in(path + "/" + self.qfile)

        if self.get("config") != "external":
            self.write_config()

    def write_config(self):
        cpath = self.path + "/" + self.cfile
        existed = os.path.exists(cpath)
        if not self.configflag and not existed:
            return
        lines = read_lines(cpath)

        managed = list(self.registered) + ["perlPath", "qmgrPath"]
        opens = [re.compile(r"^\s*" + re.escape(code) + r"(?:\s*:|\s)",
                            RE_FLAGS | re.I) for code in managed]
        blocks = [re.compile(r"^\s*" + re.escape(code) + r"\s*:?\s*\{",
                             RE_FLAGS | re.I) for code in managed]
        kept, inblock = [], False
        for line in lines:
            if inblock:
                if line.startswith("}"):
                    inblock = False
                kept.append(line)
                continue
            if any(o.match(line) and not b.match(line)
                   for o, b in zip(opens, blocks)):
                continue
            if re.search(r"\{\s*$", line, RE_FLAGS) and \
                    not re.match(r"^\s*#", line, RE_FLAGS):
                inblock = True
            kept.append(line)

        # GUI lines go after the leading comment block.
        first = 0
        while first < len(kept) and re.match(r"^\s*#", kept[first], RE_FLAGS):
            first += 1
        done = kept[:first]
        for code in self.registered:
            if self.get(code) not in ("", "EMSL"):
                done.append("%s: %s\n" % (code, self.get(code)))
        if self.get("perlPath") not in ("", "EMSL"):
            done.append("perlPath: %s\n" % self.get("perlPath"))
        if self.get("qmgrPath") != "":
            done.append("qmgrPath: %s\n" % self.get("qmgrPath"))
        done.extend(kept[first:])

        if not any(not re.match(r"^\s*(#.*)?$", ln, RE_FLAGS) for ln in done):
            self.remove_file(cpath)
            return
        with open_write(cpath, "Unable to open Config File " + cpath) as f:
            f.writelines(done)
        self.check_in(cpath)

    def write_qfile(self, qnames, qdetail, sent):
        """The GUI's queues replace the file's lines for the keys it owns;
        other keys of those queues and lines not tied to a queue are kept,
        and queues the GUI dropped lose their lines."""
        qpath = self.path + "/" + self.qfile
        guikeys = ["minprocessors", "maxprocessors", "runlimit", "memlimit",
                   "scratchlimit", "defprocessors", "defrun", "defmemory",
                   "defscratch", "requestlines"]
        # Perl's split(' '): ASCII whitespace only; a latin-1 NBSP is a name byte (#1331).
        names = [n for n in re.split(r"[ \t\n\r\f\v]+", qnames) if n]
        wanted = set(names)
        header, loose, own = [], [], {}
        seen_queues, skip = False, False
        for line in read_lines(qpath):
            if skip:
                skip = bool(re.search(r"\\\s*$", line, RE_FLAGS))
                continue
            if re.match(r"^\s*Queues\s*:", line, RE_FLAGS):
                seen_queues = True
                skip = bool(re.search(r"\\\s*$", line, RE_FLAGS))
                continue
            m = re.match(r"^\s*(\S+?)\|(\w+)\s*:", line, RE_FLAGS)
            if m:
                queue, key = m.group(1), m.group(2).lower()
                if key in guikeys[:5]:
                    continue
                if key in sent.get(queue, ()) and key in guikeys[5:]:
                    continue
                if queue not in wanted:
                    continue
                own[queue] = own.get(queue, "") + line
            elif re.match(r"^\s*#", line, RE_FLAGS) or \
                    re.match(r"^\s*$", line, RE_FLAGS):
                if not seen_queues:
                    header.append(line)
                elif not re.match(r"^\s*$", line, RE_FLAGS):
                    loose.append(line)
            else:
                loose.append(line)
        if not header:
            header = ["# Queue details for %s \n" % self.machine, "\n"]
        with open_write(qpath, "Unable to open " + qpath) as f:
            f.writelines(header)
            f.write("Queues:    %s\n\n" % qnames)
            for queue in names:
                f.write(own.get(queue, ""))
                f.write(qdetail.get(queue, ""))
            f.writelines(loose)

    # -- delete --------------------------------------------------------

    def do_delete(self):
        machine, path = self.machine, self.path
        qpath = path + "/" + self.qsfile
        self.check_out(self.mfile)
        existed, qmachines, lines, _ = self.read_queues()
        if existed:
            self.check_out(qpath)
        # A name holding '/' (hand-written) has no files here.
        if "/" not in machine:
            self.remove_file(path + "/" + self.cfile)
            self.remove_file(path + "/" + self.qfile)
        if existed:
            with open_write(qpath, "Unable to open %s for write" % qpath) as q:
                q.write("Queues: " + qmachines)
                q.write("\n")
                q.writelines(lines)
            self.check_in(qpath)
        try:
            f = open(self.mfile, "r", encoding="latin-1", newline=NL)
        except OSError as e:
            raise Die("Unable to open " + self.mfile, e.errno)
        with f:
            lines = f.readlines()
        with open_write(self.mfile,
                        "Unable to open %s for write" % self.mfile) as out:
            out.writelines(self.drop_machine(lines))
        self.check_in(self.mfile)


def main():
    n = int(perl_num(os.environ.get("CONTENT_LENGTH", "")))
    buf = sys.stdin.buffer.read(n).decode("latin-1") if n > 0 else ""
    contents = {}
    for pair in split("&", buf):
        name, _, value = pair.partition("=")
        value = form_decode(value)
        # Every value lands on one line of a file.
        if re.search(r"[\r\n]", value):
            raise Die("line break in %s - bailing..." % name)
        contents[form_decode(name)] = value
    Handler(contents).run()


if __name__ == "__main__":
    try:
        main()
    except Die as e:
        emit(sys.stderr, e.msg + "\n")
        sys.exit(e.code)
