#!/usr/bin/env python3
"""Report stored properties whose value count disagrees with their shape (#719).

    ecce-check-props <data folder> [<data folder> ...]

Walks every Props/ folder below the given folders (read-only) and prints one
line per property whose values do not fill its header: a vector needs `rows`
values, a table `rows` x `columns`, and each matrix/step of a vectable,
tstable and tsvectable the same.  The Organizer and Viewer warn "input vector
length does not match rows*columns" for these.  Exit status 1 if any is found.
A cut-off property usually comes from a calculation parsed before value lines
of any length were read (2026-10-16); Re-Parse Outputs rewrites it.
"""
import os
import re
import sys

ROOT_RE = re.compile(r"<(vector|table|vectable|tstable|tsvectable)\b([^>]*?)/?>")
ATTR_RE = re.compile(r'(\w+)="([^"]*)"')
CHILD_RE = re.compile(r"<(step|matrix)\b[^>]*?(?:/>|>(.*?)</\1>)", re.S)
META = "http://www.emsl.pnl.gov/ecce:application"


def application(calc):
    try:
        with open(os.path.join(calc, ".ecce-meta"), errors="replace") as f:
            for line in f:
                parts = line.rstrip("\n").split("\t")
                if len(parts) >= 3 and parts[1] == META:
                    return parts[-1] or "?"
    except OSError:
        pass
    return "?"


def check(path):
    """-> list of (rows, columns, count, where) for each bad value block."""
    with open(path, errors="replace") as f:
        text = f.read()
    m = ROOT_RE.search(text)
    if not m:
        return []
    kind = m.group(1)
    a = dict(ATTR_RE.findall(m.group(2)))
    try:
        rows = int(a.get("rows", ""))
        cols = int(a.get("columns", "1")) if kind != "vector" else 1
    except ValueError:
        return [(a.get("rows", "?"), a.get("columns", "?"), -1, "bad header")]
    want = rows * cols
    if kind in ("vector", "table"):
        body = text[m.end():text.rfind("</")] if not m.group(0).endswith("/>") else ""
        blocks = [("", body)]
    else:
        blocks = [("%s %s" % (c.group(1), i + 1), c.group(2) or "")
                  for i, c in enumerate(CHILD_RE.finditer(text))
                  if c.group(1) == ("matrix" if kind == "vectable" else "step")]
    bad = []
    for where, body in blocks:
        n = len(body.split())
        if n != want:
            bad.append((rows, cols, n, where))
    return bad


def main(argv):
    if not argv:
        print(__doc__)
        return 2
    found = checked = 0
    for top in argv:
        for dirpath, dirs, files in os.walk(top):
            if os.path.basename(dirpath) != "Props":
                continue
            dirs[:] = []
            calc = os.path.dirname(dirpath)
            code = application(calc)
            for name in sorted(files):
                checked += 1
                try:
                    bad = check(os.path.join(dirpath, name))
                except OSError as e:
                    print("%s: %s: cannot read: %s" % (calc, name, e))
                    continue
                for rows, cols, n, where in bad:
                    found += 1
                    print("%s\t%s\t%s\trows=%s columns=%s values=%s%s" % (
                        calc, name, code, rows, cols, n,
                        " (%s)" % where if where else ""))
    print("%d properties checked, %d with the wrong value count" %
          (checked, found), file=sys.stderr)
    return 1 if found else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
