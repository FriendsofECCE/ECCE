#!/bin/sh
# ssh's SSH_ASKPASS program for ECCE: asks in ECCE's own dialogs what ssh
# asks while ECCE opens a shared connection for the user.  The prompt is
# $1; the answer goes on stdout; exit 1 cancels.  ECCE_ASKPASS_HOST and
# ECCE_ASKPASS_USER say what the dialog is for.  ssh asks again after a
# refusal, so a cancel is remembered in ECCE_ASKPASS_STATE for the rest of
# that ssh run: one cancel, one dialog.
prompt=$1
here=$(dirname "$0")
bin=${ECCE_HOME:+$ECCE_HOME/bin}
[ -x "$bin/passdialog" ] || bin=$here/../bin
host=${ECCE_ASKPASS_HOST:-}
user=${ECCE_ASKPASS_USER:-}

cancel() {
  [ -z "${ECCE_ASKPASS_STATE:-}" ] || : > "$ECCE_ASKPASS_STATE"
  exit 1
}

# A prompt of the form user@host's password names the machine it is for,
# which a front end makes different from the target.
case $prompt in
  *@*"'s "*)
    who=${prompt%%"'s "*}
    user=${who%@*}
    host=${who#*@}
    ;;
esac

kind=${SSH_ASKPASS_PROMPT:-}
# Older ssh does not say that this is a yes/no question.
case $prompt in *"continue connecting"*) kind=confirm ;; esac
[ "$kind" = none ] && exit 0
[ -z "${ECCE_ASKPASS_STATE:-}" ] || [ ! -e "$ECCE_ASKPASS_STATE" ] || exit 1

case $kind in
  confirm)
    # Only an unknown host key is answered; any other question is "no".
    h=$(printf '%s\n' "$prompt" | sed -n "s/.*authenticity of host '\([^' ]*\).*/\1/p" | head -n 1)
    f=$(printf '%s\n' "$prompt" | sed -n 's/^\([A-Za-z0-9-]*\) key fingerprint is \(.*\)\.$/\2/p' | head -n 1)
    t=$(printf '%s\n' "$prompt" | sed -n 's/^\([A-Za-z0-9-]*\) key fingerprint is .*/\1/p' | head -n 1)
    [ -n "$h" ] && [ -n "$f" ] || exit 1
    [ -x "$bin/hostkeydialog" ] || exit 1
    "$bin/hostkeydialog" "$h" "$f" "$t" >/dev/null || cancel
    echo yes
    ;;
  *)
    case $(printf '%s' "$prompt" | tr 'A-Z' 'a-z') in
      *passcode*|*verification*|*token*|*otp*|*duo*|*code*) what=passcode ;;
      *) what=password ;;
    esac
    # A password ECCE already has comes once, through a FIFO, for the
    # password prompt only; a retry (or a passcode) goes to the dialog.
    if [ "$what" = password ] && [ -n "${ECCE_ASKPASS_PWFIFO:-}" ] && [ -p "$ECCE_ASKPASS_PWFIFO" ]; then
      fifo=$ECCE_ASKPASS_PWFIFO
      pw=
      IFS= read -r pw < "$fifo"
      rm -f "$fifo"
      if [ -n "$pw" ]; then
        printf '%s\n' "$pw"
        exit 0
      fi
    fi
    [ -x "$bin/passdialog" ] || exit 1
    # The answer, not the exit status, decides: an older passdialog exits
    # 255 after OK.  It prints nothing when it is cancelled.
    answer=$("$bin/passdialog" "$what" "$host" "$user")
    [ -n "$answer" ] || cancel
    printf '%s\n' "$answer"
    ;;
esac
