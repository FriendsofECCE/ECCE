################
# Queue Manager
# Typically overridden for queued machines - in CONFIG.<machine> file.
################



PBS {
#PBS -N $submitFile
#PBS -q $queue
#PBS -l select=$nodes:ncpus=$ppn
#PBS -l walltime=$wallTime
#PBS -l mem=$memorymb
#PBS -A $account
#PBS -j oe
#PBS -o pbs.out
#PBS -S /bin/sh
}

LSF {
#BSUB -J $submitFile
#BSUB -q $queue
#BSUB -n $totalprocs
#BSUB -W $wallHrMin
#BSUB -M $memory
#BSUB -P $account
#BSUB -o $submitFile.out
#BSUB -e $submitFile.err
#BSUB -L /bin/sh
}
Moab {
#MSUB -N $submitFile
#MSUB -q $queue
#MSUB -l nodes=$nodes:ppn=$ppn
#MSUB -l walltime=$wallTime
#MSUB -l mem=$memorymb
#MSUB -A $account
#MSUB -j oe
#MSUB -o moab.out
}

#
# Slurm
#
# QueueManagers has defined Slurm's submit/cancel/query commands (sbatch,
# scancel, squeue) for a long time, but there was no directive block here --
# and gensub builds the script header from $::config{lc($qMgr)}, so a Slurm
# site got a submit script containing NO #SBATCH lines at all: no partition,
# no node count, no wall time. Slurm is the common scheduler on new clusters,
# so this was worth having.
#
# Deliberately minimal. Anything site-specific -- --account, --qos,
# --constraint, --gres=gpu:N, module loads -- goes in YOUR OWN
# ~/.ECCE/CONFIG.<host>, which gensub reads last and which therefore wins
# over this file (see gensub's file cascade, and GETTING_STARTED.md).
#
# --account is left out on purpose: many sites do not require one, and an
# empty "--account=" is a syntax error rather than a no-op.
#
# Note $wallTime is formatted "H:M:00" by the launcher and is not zero
# padded; Slurm accepts that, but if your site is fussy, override --time in
# your own CONFIG file using $wallHrMin instead.
Slurm {
#SBATCH --partition=$queue
#SBATCH --nodes=$nodes
#SBATCH --ntasks=$totalprocs
#SBATCH --time=$wallTime
# The memory value carries whatever unit the machine's .Q file declares in
# memUnits (MB for the ones shipped here), so the suffix is spelled out
# rather than left to sbatch's default. Change it if your .Q uses GB.
# Both of these lines are dropped entirely when the field is unset, so a
# blank memory or account box does not emit "--mem=" and fail the submit.
#SBATCH --mem=$memoryM
#SBATCH --account=$account
#SBATCH --output=slurm.out
#SBATCH --error=slurm.err
}

#
# SGE (Grid Engine)
#
# Restored from siteconfig/disabled-queuemanagers-archive.txt, where it had
# only -pe/-v/-cwd; queue, wall time, memory, account and the shell were
# missing, so the job ran in whatever queue and shell the site defaulted to.
# "-pe smp" is a parallel environment of that name; sites name theirs
# differently (mpi, orte, make), so override it in your own CONFIG.<host>.
# Memory is requested as mem_free, which only places the job on a host with
# that much free.  h_vmem is NOT used: it is a hard limit on virtual memory,
# and NWChem with OpenBLAS and MPI maps more than it uses, so the job spun
# at 100% CPU in malloc once the limit was reached, and never ended.
# Lines whose value is unset are dropped.
#
SGE {
#$ -N $submitFile
#$ -q $queue
#$ -pe smp $totalprocs
#$ -l h_rt=$wallTime
#$ -l mem_free=$memoryM
#$ -A $account
#$ -S /bin/sh
#$ -cwd
#$ -v SHELL
#$ -j y
#$ -o sge.out
}

#
# HTCondor
#
# condor_submit reads a submit description, not this script.  The lines below
# are that description; QueueManagers' submitCommand cuts them out of the
# script into <script>.sub and submits it, with @SCRIPT@ standing for the
# script itself.  Jobs run in the run directory and nothing is transferred
# (should_transfer_files = NO), which needs a shared file system, or a pool
# of one machine.  request_memory is in MB.  A wall time limit is enforced by
# removing the job when it has run longer, since HTCondor has no such request.
# HOME is set because a job starts without one, and Open MPI, which NWChem
# uses, then stops with "Unable to get the user home directory".
# The account is a job attribute (+ProjectName) and not an accounting group,
# which a pool only accepts if the group is configured.
#
HTCondor {
#CONDOR executable = @SCRIPT@
#CONDOR initialdir = $runDir
#CONDOR should_transfer_files = NO
#CONDOR notification = never
#CONDOR environment = "HOME=$ENV(HOME)"
#CONDOR request_cpus = $totalprocs
#CONDOR request_memory = $memory
#CONDOR periodic_remove = (JobStatus == 2) && ((time() - EnteredCurrentStatus) > $wallSeconds)
#CONDOR +ProjectName = "$account"
#CONDOR output = condor.out
#CONDOR error = condor.err
#CONDOR log = condor.log
#CONDOR queue
}
